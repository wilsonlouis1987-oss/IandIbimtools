{
  "Uuid": "e0d7c072-02fb-40d8-a9ec-6f72de4a07e1",
  "IsCustomNode": false,
  "Description": "False ceilings per room with bulkheads from Revit lines or CAD layers, cove option",
  "Name": "CAD2BIM_Ceilings_Bulkheads",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "7355f660ef9447ca9e94edc217977fd8",
      "Name": "SELECT ROOMS  (click Select, pick rooms, Finish)",
      "Type": "selection",
      "Type2": "hostSelection",
      "Value": "",
      "Description": "Select multiple elements from the Revit document."
    },
    {
      "Id": "1085e36c61054869a13f6aa1f51e821d",
      "Name": "Use ALL rooms  (ignore the selection)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "false",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "735c92676015453b82109572e9245796",
      "Name": "Lines drawn in REVIT  (detail / model lines in plan or ceiling plan)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "25c61db6afd14b4a9a4de7cdf8ae41c9",
      "Name": "Revit line style contains  ( blank = any line style )",
      "Type": "string",
      "Type2": "string",
      "Value": "",
      "Description": "Creates a string."
    },
    {
      "Id": "cf001dee7d534d1db54ef9b30bc8742e",
      "Name": "Lines from linked CAD",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "6a39f25770a44a8f99f87cd7ba15e623",
      "Name": "CAD name contains  ( blank = all CAD links )",
      "Type": "string",
      "Type2": "string",
      "Value": "",
      "Description": "Creates a string."
    },
    {
      "Id": "c6741c3b7b55471b84f92d87df62a3f7",
      "Name": "CAD layers  ( AUTO = BULK / CEIL / CLG / FC / DROP / COVE / GYP )",
      "Type": "string",
      "Type2": "string",
      "Value": "AUTO",
      "Description": "Creates a string."
    },
    {
      "Id": "7efa13938ce94f2fb292cff8725cfe9f",
      "Name": "Closed loop = BULKHEAD  (off = loop is the PLAIN ceiling, bulkhead all around)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "7fd0e127f0ce46499332df6a4d065b36",
      "Name": "Ceiling HEIGHT from floor (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "2400",
      "MaximumValue": 6000.0,
      "MinimumValue": 1800.0,
      "StepValue": 25.0,
      "NumberType": "Double",
      "Description": "Produces numeric values"
    },
    {
      "Id": "b316958534ed486693880dd017e27ebe",
      "Name": "Ceiling THICKNESS (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "15",
      "MaximumValue": 150.0,
      "MinimumValue": 5.0,
      "StepValue": 1.0,
      "NumberType": "Double",
      "Description": "Produces numeric values"
    },
    {
      "Id": "dc7bf69863f644578ed2cd1bdfdc7f40",
      "Name": "Bulkhead HEIGHT from floor (mm)  - lower = drop, higher = raised / coffer",
      "Type": "number",
      "Type2": "number",
      "Value": "2700",
      "MaximumValue": 6000.0,
      "MinimumValue": 1500.0,
      "StepValue": 25.0,
      "NumberType": "Double",
      "Description": "Produces numeric values"
    },
    {
      "Id": "ae530aa807ff44198ab62da0ba5e1136",
      "Name": "Bulkhead THICKNESS (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "15",
      "MaximumValue": 150.0,
      "MinimumValue": 5.0,
      "StepValue": 1.0,
      "NumberType": "Double",
      "Description": "Produces numeric values"
    },
    {
      "Id": "695230ea86a442c4b552648835e03ae1",
      "Name": "Side covering board THICKNESS (mm)  - its height follows automatically",
      "Type": "number",
      "Type2": "number",
      "Value": "15",
      "MaximumValue": 100.0,
      "MinimumValue": 5.0,
      "StepValue": 1.0,
