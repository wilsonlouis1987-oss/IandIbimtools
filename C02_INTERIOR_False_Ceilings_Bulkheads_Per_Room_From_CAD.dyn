      "Description": "Produces numeric values"
    },
    {
      "Id": "042dc853dda34f5083abb22113ebe02b",
      "Name": "Cove TROUGH width - bulkhead runs past the edge (mm)",
      "Type": "number",
      "Type2": "number",
      "Value": "150",
      "MaximumValue": 600.0,
      "MinimumValue": 50.0,
      "StepValue": 10.0,
      "NumberType": "Double",
      "Description": "Produces numeric values"
    },
    {
      "Id": "4c588c33d5db4560874a045a1f4d1a7c",
      "Name": "Replace OTHER ceilings in these rooms",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "false",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "5bd4352569ea40238347a2a642f3ef64",
      "Name": "CEILINGS ON  (off = remove script ceilings from these rooms)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    }
  ],
