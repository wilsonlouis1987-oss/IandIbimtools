    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - CEILINGS + BULKHEADS (professional)\n#  every Room gets a false ceiling: height / thickness controlled\n#  BULKHEAD areas come from lines: Revit detail / model lines (plan or ceiling plan) and / or linked CAD layers\n#    closed loop  = bulkhead area (or, switch off, the PLAIN ceiling with bulkhead all around = peripheral bulkhead)\n#    line from wall to wall = the smaller side is bulkhead\n#  bulkhead: own height / thickness, vertical side board (covering) of its own thickness,\n#            closed drop or COVE TROUGH (bulkhead runs past the edge with an upstand lip, LED in the trough)\n#  no lines in a room -> plain ceiling.  Re-run = replaced, never doubled.\nimport os\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\ndef log(msg):\n    try:\n        with open(LOG, 'a') as fh:\n            fh.write(str(msg) + '\\n')\n    except Exception:\n        pass\nlog('--- ceilings v6 started')\nimport clr, math, re, traceback\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Architecture import *        # Stairs, StairsRun, StairsLanding, Railing ...\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nclr.AddReference('System')\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\nMMF = 1.0 / 304.8\nCOL_PARAMS = [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')]\nout = []\n\n\ndef num(v, d=0.0):\n    try:\n        return float(v)\n    except Exception:\n        return d\n\n\ndef f(v):\n    return '{0:.0f}'.format(v)\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\n_CAT = {}\ndef catid(bic):\n    if bic not in _CAT:\n        _CAT[bic] = idv(Category.GetCategory(doc, bic).Id)\n    return _CAT[bic]\n\n\ndef cat_is(e, bic):\n    return e is not None and e.Category is not None and idv(e.Category.Id) == catid(bic)\n\n\ndef tname(t):\n    p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\n\ndef setp(e, bip, val):\n    p = e.get_Parameter(bip)\n    if p is not None and not p.IsReadOnly:\n        p.Set(val)\n        return True\n    return False\n\n\ndef getd(e, bip):\n    p = e.get_Parameter(bip)\n    return p.AsDouble() if p is not None else None\n\n\ndef getlvl(e, bip):\n    p = e.get_Parameter(bip)\n    if p is None:\n        return None\n    x = doc.GetElement(p.AsElementId())\n    return x if isinstance(x, Level) else None\n\n\n\ndef tagged(e):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    return (p.AsString() or '') if p is not None else ''\n\n\ndef to_mm(v):\n    return v / MMF\n\n\ndef pt(p):\n    return (to_mm(p.X), to_mm(p.Y))\n\n\ndef layer_name(g, inherited):\n    name = None\n    try:\n        gs = doc.GetElement(g.GraphicsStyleId)\n        if gs is not None and gs.GraphicsStyleCategory is not None:\n            name = gs.GraphicsStyleCategory.Name\n    except Exception:\n        name = None\n    if not name or name == '0':\n        return inherited or name or '0'\n    return name\n\n\nCIRCLES = {}\n\n\ndef read_layers(cad):\n    \"\"\"{layer: [segments]} in mm; arcs and splines are split into short straight pieces.\"\"\"\n    opt = Options()\n    opt.ComputeReferences = False\n    if cad.ViewSpecific:\n        opt.View = doc.GetElement(cad.OwnerViewId)\n    data = {}\n\n    def add(ln, ps):\n        for i in range(len(ps) - 1):\n            if ps[i] != ps[i + 1]:\n                data.setdefault(ln, []).append((ps[i], ps[i + 1]))\n\n    def walk(geom, inherited):\n        for g in geom:\n            ln = layer_name(g, inherited)\n            if isinstance(g, GeometryInstance):\n                walk(g.GetInstanceGeometry(), ln)\n            elif isinstance(g, Arc) and (not g.IsBound or abs(g.Length - 2 * math.pi * g.Radius) < 1e-3):\n                c = g.Center\n                CIRCLES.setdefault(ln, []).append((to_mm(c.X), to_mm(c.Y), to_mm(g.Radius)))\n            elif isinstance(g, Line):\n                if g.IsBound:\n                    add(ln, [pt(g.GetEndPoint(0)), pt(g.GetEndPoint(1))])\n            elif isinstance(g, PolyLine):\n                add(ln, [pt(p) for p in g.GetCoordinates()])\n            elif isinstance(g, Curve):\n                try:\n                    add(ln, [pt(p) for p in g.Tessellate()])\n                except Exception:\n                    pass\n    top = cad.get_Geometry(opt)\n    for g in top:\n        if isinstance(g, GeometryInstance):\n            walk(g.GetInstanceGeometry(), None)\n    return data\n\n\n\n# ================================================================== CEILING ENGINE\nTAG = 'CAD2BIM-CEILING'\nSQM = 0.09290304\nZ = XYZ.BasisZ\n\n\ndef solid_from_loops(loops, z0, h):\n    lst = List[CurveLoop]()\n    for lp in loops:\n        lst.Add(lp)\n    return GeometryCreationUtilities.CreateExtrusionGeometry(lst, Z, h)\n\n\ndef poly_loop(pts, z):\n    \"\"\"closed CurveLoop (counter-clockwise) through 2D mm points\"\"\"\n    a = 0.0\n    for i in range(len(pts)):\n        x0, y0 = pts[i]\n        x1, y1 = pts[(i + 1) % len(pts)]\n        a += x0 * y1 - x1 * y0\n    if a < 0:\n        pts = pts[::-1]\n    lp = CurveLoop()\n    n = len(pts)\n    for i in range(n):\n        p, q = pts[i], pts[(i + 1) % n]\n        lp.Append(Line.CreateBound(XYZ(p[0] * MMF, p[1] * MMF, z), XYZ(q[0] * MMF, q[1] * MMF, z)))\n    return lp\n\n\ndef loop_area(lp):\n    pts = []\n    for c in lp:\n        pts.extend(list(c.Tessellate())[:-1])\n    a = 0.0\n    for i in range(len(pts)):\n        p, q = pts[i], pts[(i + 1) % len(pts)]\n        a += p.X * q.Y - q.X * p.Y\n    return abs(a) / 2.0\n\n\ndef ceiling_loops(face):\n    \"\"\"outer loop counter-clockwise first, holes clockwise\"\"\"\n    lps = list(face.GetEdgesAsCurveLoops())\n    lps.sort(key=loop_area, reverse=True)\n    res = List[CurveLoop]()\n    for i, lp in enumerate(lps):\n        ccw = lp.IsCounterclockwise(Z)\n        if (i == 0 and not ccw) or (i > 0 and ccw):\n            lp.Flip()\n        res.Add(lp)\n    return res\n\n\ndef boolean(a, b, op):\n    if a is None:\n        return b if op == BooleanOperationsType.Union else None\n    if b is None:\n        return a if op != BooleanOperationsType.Intersect else None\n    try:\n        r = BooleanOperationsUtils.ExecuteBooleanOperation(a, b, op)\n        return r if r is not None and r.Volume > 1e-6 else None\n    except Exception as ex:\n        log('boolean {0}: {1}'.format(op, ex))\n        return a if op == BooleanOperationsType.Union else None\n\n\ndef union_all(solids):\n    u = None\n    for s in solids:\n        u = boolean(u, s, BooleanOperationsType.Union)\n    return u\n\n\ndef bottom_faces(sol):\n    if sol is None:\n        return []\n    return [f for f in sol.Faces if isinstance(f, PlanarFace) and f.FaceNormal.Z < -0.99]\n\n\ndef inside(faces, x, y, z):\n    p = XYZ(x, y, z)\n    for f in faces:\n        try:\n            r = f.Project(p)\n            if r is not None and r.Distance < 1e-3:\n                return True\n        except Exception:\n            pass\n    return False\n\n\n# ------------------------------------------------------------------ lines -> chains\ndef simplify(pts, closed):\n    \"\"\"drop points that are on a straight line (CAD polylines often have many)\"\"\"\n    if closed and len(pts) > 1 and pts[0] == pts[-1]:\n        body, tail = pts[:-1], [pts[0]]\n    else:\n        body, tail = pts, []\n    changed = True\n    while changed and len(body) > 3:\n        changed = False\n        n = len(body)\n        keep = []\n        for i in range(n):\n            if not closed and (i == 0 or i == n - 1):\n                keep.append(body[i])\n                continue\n            a, b, c = body[i - 1], body[i], body[(i + 1) % n]\n            ux, uy = b[0] - a[0], b[1] - a[1]\n            vx, vy = c[0] - b[0], c[1] - b[1]\n            lu, lv = math.hypot(ux, uy), math.hypot(vx, vy)\n            if lu < 1.0 or lv < 1.0 or abs(ux * vy - uy * vx) / (lu * lv) < 0.009 and (ux * vx + uy * vy) > 0:\n                changed = True\n                continue\n            keep.append(b)\n        body = keep\n    return body + tail\n\n\ndef chains_from_segments(segs, tol=3.0):\n    \"\"\"segments (mm) -> list of (points, closed). Chains run through nodes with 2 connections.\"\"\"\n    keys = []\n    cell = {}\n\n    def key(p):\n        cx, cy = int(p[0] // 10), int(p[1] // 10)\n        for dx in (-1, 0, 1):\n            for dy in (-1, 0, 1):\n                for k in cell.get((cx + dx, cy + dy), []):\n                    q = keys[k]\n                    if abs(q[0] - p[0]) <= tol and abs(q[1] - p[1]) <= tol:\n                        return k\n        keys.append(p)\n        cell.setdefault((cx, cy), []).append(len(keys) - 1)\n        return len(keys) - 1\n\n    adj = {}\n    edges = []\n    for p, q in segs:\n        a, b = key(p), key(q)\n        if a == b:\n            continue\n        ei = len(edges)\n        edges.append((a, b))\n        adj.setdefault(a, []).append(ei)\n        adj.setdefault(b, []).append(ei)\n    used = set()\n    out = []\n\n    def walk(start, ei):\n        pts = [start]\n        cur = start\n        while True:\n            used.add(ei)\n            a, b = edges[ei]\n            nxt = b if a == cur else a\n            pts.append(nxt)\n            if nxt == start:\n                return pts, True\n            nexts = [e for e in adj[nxt] if e not in used]\n            if len(adj[nxt]) != 2 or not nexts:\n                return pts, False\n            cur, ei = nxt, nexts[0]\n\n    # open chains first (start at ends / junctions), then the remaining closed loops\n    for n in adj:\n        if len(adj[n]) != 2:\n            for ei in adj[n]:\n                if ei not in used:\n                    pts, closed = walk(n, ei)\n                    out.append(([keys[i] for i in pts], closed))\n    for ei in range(len(edges)):\n        if ei not in used:\n            pts, closed = walk(edges[ei][0], ei)\n            out.append(([keys[i] for i in pts], closed))\n    res = []\n    for pts, closed in out:\n        pts = simplify(pts, closed)\n        if closed:\n            pts = pts[:-1]\n            if len(pts) >= 3:\n                res.append((pts, True))\n        elif len(pts) >= 2:\n            res.append((pts, False))\n    return res\n\n\ndef revit_line_segments(style_txt):\n    \"\"\"{level id: [segments mm]} from model / detail lines (plan + ceiling plan views)\"\"\"\n    levels = sorted([l for l in FilteredElementCollector(doc).OfClass(Level)], key=lambda l: l.Elevation)\n    data = {}\n    n_all = 0\n    for ce in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Lines).WhereElementIsNotElementType():\n        n_all += 1\n        if not isinstance(ce, CurveElement):\n            continue\n        try:\n            if style_txt:\n                ls = ce.LineStyle\n                if ls is None or style_txt.upper() not in ls.Name.upper():\n                    continue\n            cv = ce.GeometryCurve\n            lid = None\n            if ce.ViewSpecific:\n                v = doc.GetElement(ce.OwnerViewId)\n                if not isinstance(v, ViewPlan) or v.GenLevel is None:\n                    continue\n                lid = idv(v.GenLevel.Id)\n            else:\n                z = cv.GetEndPoint(0).Z\n                below = [l for l in levels if l.Elevation <= z + 0.05]\n                lid = idv((below[-1] if below else levels[0]).Id)\n            pts = [cv.GetEndPoint(0), cv.GetEndPoint(1)] if isinstance(cv, Line) else list(cv.Tessellate())\n            for i in range(len(pts) - 1):\n                data.setdefault(lid, []).append(((pts[i].X / MMF, pts[i].Y / MMF), (pts[i + 1].X / MMF, pts[i + 1].Y / MMF)))\n        except Exception as ex:\n            log('line {0}: {1}'.format(idv(ce.Id), ex))\n    log('revit lines in model: {0}'.format(n_all))\n    return data\n\n\nCAD_WORDS = ('BULK', 'CEIL', 'CLG', 'FALSE', 'DROP', 'COVE', 'GYP', 'F.C', 'F-C', 'RCP')\n\n\ndef cad_segments(name_txt, layer_txt):\n    cads = [c for c in FilteredElementCollector(doc).OfClass(ImportInstance)]\n    if name_txt:\n        cads = [c for c in cads if c.Category is not None and name_txt.lower() in c.Category.Name.lower()]\n    auto = layer_txt.upper() in ('', 'AUTO', '*')\n    keys = [k.strip().upper() for k in layer_txt.split(',') if k.strip()] if not auto else []\n    levels = sorted([l for l in FilteredElementCollector(doc).OfClass(Level)], key=lambda l: l.Elevation)\n    by_level, used = {}, set()\n    for c in cads:\n        # which floor does this CAD belong to? (view-specific -> its view's level, else the link's level / height)\n        lid = None\n        try:\n            if c.ViewSpecific:\n                v = doc.GetElement(c.OwnerViewId)\n                if isinstance(v, ViewPlan) and v.GenLevel is not None:\n                    lid = idv(v.GenLevel.Id)\n            if lid is None and c.LevelId is not None and idv(c.LevelId) > 0:\n                lid = idv(c.LevelId)\n            if lid is None:\n                z = c.GetTotalTransform().Origin.Z\n                below = [l for l in levels if l.Elevation <= z + 0.05]\n                lid = idv((below[-1] if below else levels[0]).Id) if levels else 'all'\n        except Exception:\n            lid = 'all'\n        segs = by_level.setdefault(lid, [])\n        try:\n            CIRCLES.clear()\n            layers = read_layers(c)\n            for ln, ss in layers.items():\n                u = ln.upper()\n                toks = set(re.split(r'[^A-Z0-9]+', u))\n                hit = any(k in u for k in keys) if not auto else (any(k in u for k in CAD_WORDS) or 'FC' in toks)\n                if hit:\n                    segs.extend(ss)\n                    used.add(ln)\n            for ln, cs in CIRCLES.items():          # round bulkheads / cut-outs\n                u = ln.upper()\n                hit = any(k in u for k in keys) if not auto else any(k in u for k in CAD_WORDS)\n                if hit:\n                    for cx, cy, r in cs:\n                        n = 48\n                        ps = [(cx + r * math.cos(2 * math.pi * i / n), cy + r * math.sin(2 * math.pi * i / n)) for i in range(n)]\n                        segs.extend((ps[i], ps[(i + 1) % n]) for i in range(n))\n                    used.add(ln)\n        except Exception as ex:\n            log('cad {0}: {1}'.format(c.Category.Name if c.Category else '?', ex))\n    return by_level, sorted(used), len(cads)\n\n\n# ------------------------------------------------------------------ types\ndef gyp_material():\n    for m in FilteredElementCollector(doc).OfClass(Material):\n        if m.Name == 'CAD2BIM Gypsum Board':\n            return m.Id\n    mid = Material.Create(doc, 'CAD2BIM Gypsum Board')\n    try:\n        m = doc.GetElement(mid)\n        m.Color = Color(250, 250, 248)\n    except Exception:\n        pass\n    return mid\n\n\ndef ceiling_type(name, t_mm, mat):\n    for ct in FilteredElementCollector(doc).OfClass(CeilingType):\n        if tname(ct) == name:\n            cs = ct.GetCompoundStructure()\n            if cs is None or abs(cs.GetWidth() - t_mm * MMF) > 1e-4 or cs.LayerCount != 1:\n                one_layer(ct, t_mm, mat)                  # repair a type left by an older run\n            return ct\n    base = [ct for ct in FilteredElementCollector(doc).OfClass(CeilingType) if ct.GetCompoundStructure() is not None]\n    if not base:\n        raise Exception('no compound ceiling type in this project to copy (Architecture > Ceiling > Compound Ceiling)')\n    nt = base[0].Duplicate(name)\n    one_layer(nt, t_mm, mat)\n    return nt\n\n\ndef one_layer(ht, t_mm, mat):\n    \"\"\"keep the type's own compound structure (end caps etc.), replace its layers by one t_mm gypsum layer\"\"\"\n    cs = ht.GetCompoundStructure()\n    lay = List[CompoundStructureLayer]()\n    lay.Add(CompoundStructureLayer(t_mm * MMF, MaterialFunctionAssignment.Structure, mat))\n    cs.SetLayers(lay)\n    for side in (ShellLayerType.Exterior, ShellLayerType.Interior):\n        try:\n            cs.SetNumberOfShellLayers(side, 0)\n        except Exception:\n            pass\n    try:\n        cs.StructuralMaterialIndex = 0\n    except Exception:\n        pass\n    ht.SetCompoundStructure(cs)\n\n\ndef board_wall_type(t_mm, mat):\n    name = 'A_CLG_GYP_Bulkhead_Side_{0}'.format(f(t_mm))\n    for wt in FilteredElementCollector(doc).OfClass(WallType):\n        if tname(wt) == name:\n            cs = wt.GetCompoundStructure()\n            if cs is None or abs(cs.GetWidth() - t_mm * MMF) > 1e-4:\n                one_layer(wt, t_mm, mat)\n            return wt\n    base = [wt for wt in FilteredElementCollector(doc).OfClass(WallType) if wt.Kind == WallKind.Basic]\n    nt = base[0].Duplicate(name)\n    one_layer(nt, t_mm, mat)\n    try:\n        setp(nt, BuiltInParameter.FUNCTION_PARAM, 0)\n    except Exception:\n        pass\n    return nt\n\n\ndef mark(e, uid):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    if p is not None:\n        p.Set(TAG + '|' + uid)\n\n\ndef offset_toward(cv, dist, faces, z):\n    \"\"\"curve offset by dist to the side that lies inside 'faces' (None if neither)\"\"\"\n    for ref in (Z, Z.Negate()):\n        try:\n            oc = cv.CreateOffset(dist, ref)\n            m = oc.Evaluate(0.5, True)\n            if inside(faces, m.X, m.Y, z):\n                return oc, ref\n        except Exception:\n            pass\n    return None, None\n\n\ndef edge_curves(face):\n    res = []\n    for lp in face.EdgeLoops:\n        for e in lp:\n            res.append(e.AsCurve())\n    return res\n\n\ntry:\n    PICKED = IN[0]\n    ALL_ROOMS = bool(IN[1])\n    USE_RVT, STYLE = bool(IN[2]), str(IN[3] or '').strip()\n    USE_CAD, CAD_TXT, LAYER_TXT = bool(IN[4]), str(IN[5] or '').strip(), str(IN[6] or 'AUTO').strip()\n    LOOP_IS_BULK = bool(IN[7])\n    HC, TC = num(IN[8], 2700), num(IN[9], 15)\n    HB, TB, TS = num(IN[10], 2400), num(IN[11], 15), num(IN[12], 15)\n    COVE, LIP, CW = bool(IN[13]), num(IN[14], 100), num(IN[15], 150)\n    GAP = 0.0\n    REPLACE_OTHER, DO = bool(IN[16]), bool(IN[17])\n    log('inputs all {0} rvt {1} \"{2}\" cad {3} \"{4}\" \"{5}\" loop_is_bulk {6} | ceiling {7}/{8} | bulkhead {9}/{10} side {11} '\n        '| cove {12} lip {13} width {14} | replace {15} run {16}'.format(ALL_ROOMS, USE_RVT, STYLE, USE_CAD, CAD_TXT,\n                                                                      LAYER_TXT, LOOP_IS_BULK, HC, TC, HB, TB, TS,\n                                                                      COVE, LIP, CW, REPLACE_OTHER, DO))\n    RAISED = HB > HC                     # bulkhead ABOVE the main ceiling = raised / coffer ceiling\n    LOW, HIGH = min(HB, HC), max(HB, HC)\n    notes = []\n    if COVE and RAISED:\n        COVE = False\n        notes.append('cove ignored: the bulkhead is HIGHER than the main ceiling (raised / coffer)')\n    if COVE and LIP >= HC - HB:\n        raise Exception('Cove lip ({0}) must be lower than the drop ceiling - bulkhead ({1})'.format(f(LIP), f(HC - HB)))\n\n    # ---------------- rooms\n    rooms, scope = [], ''\n    if not ALL_ROOMS:\n        picked = PICKED if isinstance(PICKED, (list, tuple)) else ([PICKED] if PICKED is not None else [])\n        for x in picked:\n            e = getattr(x, 'InternalElement', None)\n            if e is None:\n                try:\n                    e = doc.GetElement(ElementId(int(x.Id)))\n                except Exception:\n                    e = x\n            rooms.append(e)\n        rooms = [r for r in rooms if isinstance(r, SpatialElement) and r.Area > 0]\n        scope = 'rooms picked in the SELECT ROOMS node'\n        if not rooms:\n            rooms = [doc.GetElement(i) for i in uidoc.Selection.GetElementIds()]\n            rooms = [r for r in rooms if isinstance(r, SpatialElement) and r.Area > 0]\n            scope = 'rooms selected in Revit'\n    if not rooms:\n        rooms = [r for r in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Rooms).WhereElementIsNotElementType()\n                 if r.Area > 0]\n        scope = 'ALL rooms'\n    if not rooms:\n        raise Exception('No placed rooms in the model - place Rooms first (Architecture > Room), then Run')\n\n    # ---------------- bulkhead lines\n    rvt = revit_line_segments(STYLE) if USE_RVT else {}\n    cad, cad_layers, n_cad = (cad_segments(CAD_TXT, LAYER_TXT) if USE_CAD else ({}, [], 0))\n    log('lines: revit {0} by level, cad {1} by level on {2}'.format(dict((k, len(v)) for k, v in rvt.items()),\n                                                                   dict((k, len(v)) for k, v in cad.items()), cad_layers))\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    mat = gyp_material()\n    uids = set(r.UniqueId for r in rooms)\n    removed = 0\n    for bic in (BuiltInCategory.OST_Ceilings, BuiltInCategory.OST_Walls):\n        for e in list(FilteredElementCollector(doc).OfCategory(bic).WhereElementIsNotElementType()):\n            c = tagged(e)\n            if c.startswith(TAG + '|') and c.split('|', 1)[1] in uids:\n                doc.Delete(e.Id)\n                removed += 1\n    rep, tot = [], {'plain': 0.0, 'bulk': 0.0, 'side': 0.0, 'ceil': 0, 'walls': 0, 'other': 0}\n    if DO:\n        ct_plain = ceiling_type('A_CLG_GYP_Plain_{0}'.format(f(TC)), TC, mat)\n        ct_bulk = ceiling_type('A_CLG_GYP_Bulkhead_{0}'.format(f(TB)), TB, mat)\n        wt_side = board_wall_type(TS, mat)\n        opt = SpatialElementBoundaryOptions()\n        opt.SpatialElementBoundaryLocation = SpatialElementBoundaryLocation.Finish\n        others = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Ceilings).WhereElementIsNotElementType()) \\\n            if REPLACE_OTHER else []\n        for room in rooms:\n            rname = '{0} {1}'.format(room.Number, room.get_Parameter(BuiltInParameter.ROOM_NAME).AsString() or '')\n            try:\n                # room region\n                loops = []\n                for segl in room.GetBoundarySegments(opt):\n                    lp = CurveLoop()\n                    for sgm in segl:\n                        lp.Append(sgm.GetCurve())\n                    loops.append(lp)\n                if not loops:\n                    continue\n                z0 = None\n                for c0 in loops[0]:\n                    z0 = c0.GetEndPoint(0).Z\n                    break\n                if not loops[0].IsCounterclockwise(Z):\n                    loops[0].Flip()\n                for lp in loops[1:]:\n                    if lp.IsCounterclockwise(Z):\n                        lp.Flip()\n                room_sol = solid_from_loops(loops, z0, 1.0)\n                rfaces = bottom_faces(room_sol)\n                lvid = room.LevelId\n                # lines of this room\n                segs = list(rvt.get(idv(lvid), [])) + list(cad.get(idv(lvid), [])) + list(cad.get('all', []))\n                chains = chains_from_segments(segs) if segs else []\n                mine = []\n                for pts, closed in chains:\n                    n_in = sum(1 for i in range(len(pts) - 1)\n                               if inside(rfaces, (pts[i][0] + pts[i + 1][0]) / 2.0 * MMF, (pts[i][1] + pts[i + 1][1]) / 2.0 * MMF, z0))\n                    if n_in * 2 >= max(1, len(pts) - 1):\n                        mine.append((pts, closed))\n                closed_sol = union_all([solid_from_loops([poly_loop(p, z0 - 0.5)], z0 - 0.5, 2.0) for p, c in mine if c])\n                cutters = []\n                for pts, c in mine:\n                    if c:\n                        continue\n                    pts = list(pts)\n                    for end in (0, -1):                      # extend open lines 300 mm into the walls\n                        a, b = (pts[0], pts[1]) if end == 0 else (pts[-1], pts[-2])\n                        L = math.hypot(a[0] - b[0], a[1] - b[1]) or 1.0\n                        e = (a[0] + (a[0] - b[0]) / L * 300.0, a[1] + (a[1] - b[1]) / L * 300.0)\n                        if end == 0:\n                            pts.insert(0, e)\n                        else:\n                            pts.append(e)\n                    for i in range(len(pts) - 1):\n                        (x0, y0), (x1, y1) = pts[i], pts[i + 1]\n                        L = math.hypot(x1 - x0, y1 - y0)\n                        if L < 1.0:\n                            continue\n                        nx, ny = -(y1 - y0) / L * 1.0, (x1 - x0) / L * 1.0        # 2 mm wide slit\n                        cutters.append(solid_from_loops([poly_loop([(x0 - nx, y0 - ny), (x1 - nx, y1 - ny), (x1 + nx, y1 + ny),\n                                                                    (x0 + nx, y0 + ny)], z0 - 0.5)], z0 - 0.5, 2.0))\n                bulk_open = None\n                n_open = 0\n                if cutters:\n                    cut = boolean(room_sol, union_all(cutters), BooleanOperationsType.Difference)\n                    pieces = list(SolidUtils.SplitVolumes(cut)) if cut is not None else []\n                    pieces = [p for p in pieces if p.Volume > 1e-4]\n                    if len(pieces) > 1:\n                        pieces.sort(key=lambda p: p.Volume)\n                        bulk_open = union_all(pieces[:-1])            # smaller parts = bulkhead\n                        n_open = len(pieces) - 1\n                if closed_sol is not None:\n                    bc = boolean(room_sol, closed_sol, BooleanOperationsType.Intersect if LOOP_IS_BULK\n                                 else BooleanOperationsType.Difference)\n                else:\n                    bc = None\n                bulk = union_all([s for s in (bulk_open, bc) if s is not None])\n                bfaces = bottom_faces(bulk)\n                # side boards on the edges between bulkhead and plain ceiling\n                sides, bands = [], []\n                for bf in bfaces:\n                    for cv in edge_curves(bf):\n                        m = cv.Evaluate(0.5, True)\n                        try:\n                            d = cv.ComputeDerivatives(0.5, True).BasisX.Normalize()\n                        except Exception:\n                            continue\n                        nrm = XYZ(-d.Y, d.X, 0)\n                        o = 30.0 * MMF\n                        if not (inside(rfaces, m.X + nrm.X * o, m.Y + nrm.Y * o, z0) and\n                                inside(rfaces, m.X - nrm.X * o, m.Y - nrm.Y * o, z0)):\n                            continue                                    # on the room boundary (wall)\n                        if cv.Length < 50 * MMF:\n                            continue\n                        wc, ref = offset_toward(cv, TS / 2.0 * MMF, bfaces, z0)\n                        if wc is None:\n                            continue\n                        if RAISED:                   # board sits above the main ceiling, outside the coffer\n                            wc = cv.CreateOffset(TS / 2.0 * MMF, ref.Negate())\n                        sides.append(wc)\n                        if COVE and CW > 0:          # cove trough: strip CW wide on the PLAIN side of the edge\n                            oc = cv.CreateOffset(CW * MMF, ref.Negate())\n                            try:\n                                lp = CurveLoop()\n                                lp.Append(cv)\n                                lp.Append(Line.CreateBound(cv.GetEndPoint(1), oc.GetEndPoint(1)))\n                                lp.Append(oc.CreateReversed())\n                                lp.Append(Line.CreateBound(oc.GetEndPoint(0), cv.GetEndPoint(0)))\n                                if not lp.IsCounterclockwise(Z):\n                                    lp.Flip()\n                                tr = Transform.CreateTranslation(XYZ(0, 0, -0.5))\n                                lp2 = CurveLoop.CreateViaTransform(lp, tr)\n                                bands.append(solid_from_loops([lp2], z0 - 0.5, 2.0))\n                            except Exception as ex:\n                                log('cove band: {0}'.format(ex))\n                # plain (main) ceiling = room minus bulkhead; it also covers the trough\n                plain = boolean(room_sol, bulk, BooleanOperationsType.Difference) if bulk is not None else room_sol\n                # bulkhead ceiling: in cove mode it runs CW past the edge to form the trough bottom\n                bulk_ext = bulk\n                lips = []\n                if COVE and bands and bulk is not None:\n                    band_in = boolean(room_sol, union_all(bands), BooleanOperationsType.Intersect)\n                    bulk_ext = union_all([bulk, band_in]) if band_in is not None else bulk\n                    xfaces = bottom_faces(bulk_ext)\n                    opening = boolean(room_sol, bulk_ext, BooleanOperationsType.Difference)\n                    for of in bottom_faces(opening):            # edges of the opening = trough lips\n                        for cv in edge_curves(of):\n                            if cv.Length < 50 * MMF:\n                                continue\n                            m = cv.Evaluate(0.5, True)\n                            try:\n                                d = cv.ComputeDerivatives(0.5, True).BasisX.Normalize()\n                            except Exception:\n                                continue\n                            nrm = XYZ(-d.Y, d.X, 0)\n                            o = 30.0 * MMF\n                            if not (inside(rfaces, m.X + nrm.X * o, m.Y + nrm.Y * o, z0) and\n                                    inside(rfaces, m.X - nrm.X * o, m.Y - nrm.Y * o, z0)):\n                                continue\n                            lc, _ = offset_toward(cv, TS / 2.0 * MMF, xfaces, z0)\n                            if lc is not None:\n                                lips.append(lc)\n                a_plain = a_bulk = 0.0\n                for pf in bottom_faces(plain):\n                    if pf.Area * SQM < 0.05:\n                        continue\n                    c = Ceiling.Create(doc, ceiling_loops(pf), ct_plain.Id, lvid)\n                    setp(c, BuiltInParameter.CEILING_HEIGHTABOVELEVEL_PARAM, HC * MMF)\n                    mark(c, room.UniqueId)\n                    a_plain += pf.Area * SQM\n                    tot['ceil'] += 1\n                for bf in bottom_faces(bulk_ext):\n                    if bf.Area * SQM < 0.05:\n                        continue\n                    c = Ceiling.Create(doc, ceiling_loops(bf), ct_bulk.Id, lvid)\n                    setp(c, BuiltInParameter.CEILING_HEIGHTABOVELEVEL_PARAM, HB * MMF)\n                    mark(c, room.UniqueId)\n                    a_bulk += bf.Area * SQM\n                    tot['ceil'] += 1\n                side_len = 0.0\n                h_side = HIGH - LOW\n                boards = [(wc, h_side) for wc in sides] if h_side > 1.0 else []\n                boards += [(lc, LIP) for lc in lips] if LIP > 1.0 else []\n                for wc, hh in boards:\n                    try:\n                        w = Wall.Create(doc, wc, wt_side.Id, lvid, hh * MMF, LOW * MMF, False, False)\n                        setp(w, BuiltInParameter.WALL_ATTR_ROOM_BOUNDING, 0)\n                        for k in (0, 1):\n                            try:\n                                WallUtils.DisallowWallJoinAtEnd(w, k)\n                            except Exception:\n                                pass\n                        mark(w, room.UniqueId)\n                        side_len += wc.Length * 0.3048\n                        tot['walls'] += 1\n                    except Exception as ex:\n                        log('side board {0}: {1}'.format(rname, ex))\n                for oc_ in others:                               # optional: other ceilings in this room\n                    try:\n                        if tagged(oc_).startswith(TAG):\n                            continue\n                        bb = oc_.get_BoundingBox(None)\n                        if bb is not None and idv(oc_.LevelId) == idv(lvid) and \\\n                                inside(rfaces, (bb.Min.X + bb.Max.X) / 2.0, (bb.Min.Y + bb.Max.Y) / 2.0, z0):\n                            doc.Delete(oc_.Id)\n                            tot['other'] += 1\n                    except Exception:\n                        pass\n                tot['plain'] += a_plain\n                tot['bulk'] += a_bulk\n                tot['side'] += side_len\n                rep.append('  {0:<24} plain {1:6.2f} m2 | bulkhead {2:6.2f} m2 | side board {3:5.1f} m{4}'.format(\n                    rname[:24], a_plain, a_bulk, side_len,\n                    '' if (mine or a_bulk) else '   (no lines - plain ceiling)'))\n            except Exception as ex:\n                rep.append('  {0:<24} FAILED: {1}'.format(rname[:24], ex))\n                log(traceback.format_exc())\n    TransactionManager.Instance.TransactionTaskDone()\n\n    out.append('CAD2BIM CEILINGS + BULKHEADS  -  {0} ({1})'.format('DONE' if DO else 'REMOVED', scope))\n    if DO:\n        out.append('Plain ceiling : {0} mm from floor, {1} mm thick  (type A_CLG_GYP_Plain_{1})'.format(f(HC), f(TC)))\n        out.append('Bulkhead      : {0} mm from floor, {1} mm thick, side board {2} mm  ({3})'.format(\n            f(HB), f(TB), f(TS), 'COVE trough {0} mm wide, lip {1} mm high, side board {2} mm'.format(f(CW), f(LIP), f(HC - HB)) if COVE\n            else ('RAISED {0} mm above the ceiling (coffer), side board {0} mm'.format(f(HB - HC)) if RAISED\n                  else ('same height - no side board' if HB == HC else 'drop {0} mm, side board {0} mm high'.format(f(HC - HB))))))\n        for n_ in notes:\n            out.append('Note          : ' + n_)\n        src = []\n        if USE_RVT:\n            src.append('Revit lines ({0})'.format(sum(len(v) for v in rvt.values())))\n        if USE_CAD:\n            src.append('CAD {0} links, layers: {1}'.format(n_cad, ', '.join(cad_layers) or 'none found'))\n        out.append('Bulkhead lines: ' + (' + '.join(src) or 'not used'))\n        out.append('Closed loop   = ' + ('BULKHEAD area' if LOOP_IS_BULK else 'PLAIN ceiling (bulkhead around it)') +\n                   ';  line wall-to-wall = smaller side is bulkhead')\n        out.append('Rooms: {0}   ceilings {1}   side boards {2}{3}'.format(\n            len(rooms), tot['ceil'], tot['walls'], '   other ceilings removed {0}'.format(tot['other']) if tot['other'] else ''))\n        out.extend(rep[:60])\n        out.append('TOTAL  plain {0:.2f} m2 | bulkhead {1:.2f} m2 | side board {2:.1f} m'.format(tot['plain'], tot['bulk'], tot['side']))\n    if removed:\n        out.append('Old script ceilings / boards replaced: {0}'.format(removed))\n    out.append('Save / Sync with Central to keep the changes.')\nexcept Exception as ex:\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n    out.insert(0, 'FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nOUT = out\n",
      "Engine": "CPython3",
