    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =====================================================================\n#  A07 PROJECT + DIMENSION UNITS - one click mm / cm / m / feet-inches / decimal feet   (Revit 2026)   v2\n#  Sets the project's display units (Manage > Project Units) for\n#    Length (+ the other length-type specs you tick: slab / wall thickness use Length),\n#    Area and Volume  -> metric (m2, m3) or imperial (ft2, ft3), with sensible rounding.\n#  Dimension types (linear, radial, diameter, arc, spot elevation / coordinate) get the same unit, so the\n#  dimensions in every view change too (angular + slope stay).  Optional: name filter, rounding, unit symbol.\n#  Nothing in the model moves or changes size - only how numbers are shown (dims, schedules, tags, properties).\n#  PREVIEW (make = False) reports old -> new and changes nothing.  One undo (Ctrl+Z).\n#  Runs in pyRevit (IronPython 2.7) and Dynamo CPython3.\n# =====================================================================\nimport os\n\nimport clr\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *                           # noqa\n\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'A07_units_log.txt')\n\n# choice -> (label, length unit, length accuracy, area unit, area accuracy, volume unit, volume accuracy)\n#   accuracy is in the unit itself (Revit rule); feet-inches accuracy is in feet (1/8\" = 1/96 ft)\nCHOICES = {\n    'MM': ('millimetres', 'Millimeters', 1.0, 'SquareMeters', 0.01, 'CubicMeters', 0.01),\n    'CM': ('centimetres', 'Centimeters', 0.1, 'SquareMeters', 0.01, 'CubicMeters', 0.01),\n    'M': ('metres', 'Meters', 0.001, 'SquareMeters', 0.01, 'CubicMeters', 0.01),\n    'FT-IN': ('feet-inches', 'FeetFractionalInches', 1.0 / 96.0, 'SquareFeet', 0.01, 'CubicFeet', 0.01),\n    'FT': ('decimal feet', 'Feet', 0.01, 'SquareFeet', 0.01, 'CubicFeet', 0.01),\n}\n\n\ndef log(msg):\n    try:\n        with open(LOG, 'a') as f:\n            f.write(str(msg) + '\\n')\n    except Exception:\n        pass\n\n\ndef norm_choice(choice):\n    c = str(choice or 'MM').strip().upper().replace(' ', '').replace('_', '-')\n    if c in CHOICES:\n        return c\n    if c.startswith('MM') or c.startswith('MILLI'):\n        return 'MM'\n    if c.startswith('CM') or c.startswith('CENTI'):\n        return 'CM'\n    if c in ('METRE', 'METER', 'METRES', 'METERS'):\n        return 'M'\n    if c.startswith('FEETINCH') or c.startswith('FT-IN') or c.startswith('FTIN') or \"'-\" in c or 'INCH' in c:\n        return 'FT-IN'\n    if c.startswith('DEC') or c in ('FEET', 'FOOT', \"'\"):\n        return 'FT' if c.startswith('DEC') else 'FT-IN'\n    raise Exception('Units \"{0}\" not known - use MM, CM, M, FT-IN (feet-inches) or FT (decimal feet)'.format(choice))\n\n\ndef unit_name(fo):\n    \"\"\"readable name of a FormatOptions' unit\"\"\"\n    try:\n        if fo.UseDefault:\n            return 'default'\n    except Exception:\n        pass\n    try:\n        tid = fo.GetUnitTypeId()\n        try:\n            return LabelUtils.GetLabelForUnit(tid)\n        except Exception:\n            return tid.TypeId.split(':')[-1].split('-')[0]\n    except Exception:\n        return '?'\n\n\ndef current_units(doc):\n    u = doc.GetUnits()\n    out = {}\n    for key, spec in (('Length', SpecTypeId.Length), ('Area', SpecTypeId.Area), ('Volume', SpecTypeId.Volume)):\n        try:\n            out[key] = unit_name(u.GetFormatOptions(spec))\n        except Exception:\n            out[key] = '?'\n    return out\n\n\ndef _fo(unit_attr, acc, symbol=False):\n    tid = getattr(UnitTypeId, unit_attr)\n    fo = FormatOptions(tid)\n    try:\n        fo.UseDefault = False\n    except Exception:\n        pass\n    try:\n        if fo.IsValidAccuracy(acc):\n            fo.Accuracy = acc\n    except Exception as ex:\n        log('accuracy {0} {1}: {2}'.format(unit_attr, acc, ex))\n    try:                                                  # 350 cm, 11.5 cm - not 350.0\n        if fo.CanSuppressTrailingZeros():\n            fo.SuppressTrailingZeros = True\n    except Exception:\n        pass\n    if symbol:\n        try:\n            syms = [x for x in fo.GetValidSymbols() if x is not None and x.TypeId]\n            if syms:\n                fo.SetSymbolTypeId(syms[0])\n        except Exception as ex:\n            log('symbol {0}: {1}'.format(unit_attr, ex))\n    return fo\n\n\ndef dim_accuracy(c, rounding, default):\n    \"\"\"rounding typed by the user: metric / decimal feet = number of decimals (0, 1, 2);\n    feet-inches = 1/x inch (8 = 1/8\", 16 = 1/16\", 1 = whole inches).  blank = default\"\"\"\n    r = str(rounding if rounding is not None else '').strip().replace('\"', '')\n    if not r:\n        return default\n    if '/' in r:\n        r = r.split('/')[-1]\n    try:\n        n = float(r)\n    except Exception:\n        raise Exception('Rounding \"{0}\" - use decimals (0, 1, 2) or for feet-inches 1/x inch (8, 16)'.format(rounding))\n    if c == 'FT-IN':\n        return 1.0 / (12.0 * max(1.0, n))\n    return 10.0 ** (-int(n))\n\n\nSKIP_STYLES = ('Angular', 'SpotSlope')\n\n\ndef dim_types(doc, name_filter=''):\n    \"\"\"length-type dimension types (linear, aligned, radial, diameter, arc length, spot elevation / coordinate)\"\"\"\n    words = [w.strip().upper() for w in str(name_filter or '').split(',') if w.strip() and w.strip().upper() != 'ALL']\n    skip_vals = []\n    for nm in SKIP_STYLES:\n        try:\n            skip_vals.append(getattr(DimensionStyleType, nm))\n        except Exception:\n            pass\n    out, skipped = [], []\n    for dt in FilteredElementCollector(doc).OfClass(DimensionType):\n        try:\n            nm = dt.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM).AsString() or ''\n        except Exception:\n            nm = ''\n        if not nm:                                        # system \"family\" rows have no name\n            continue\n        try:\n            st = dt.StyleType\n            if any(st == v for v in skip_vals):\n                continue\n        except Exception:\n            pass\n        if words and not any(w in nm.upper() for w in words):\n            continue\n        try:\n            fo = dt.GetUnitsFormatOptions()\n            if not fo.UseDefault and not UnitUtils.IsValidUnit(SpecTypeId.Length, fo.GetUnitTypeId()):\n                skipped.append(nm)\n                continue\n        except Exception:\n            skipped.append(nm)\n            continue\n        out.append((dt, nm))\n    return out, skipped\n\n\ndef dim_unit_name(dt):\n    try:\n        fo = dt.GetUnitsFormatOptions()\n        return 'project' if fo.UseDefault else unit_name(fo)\n    except Exception:\n        return '?'\n\n\ndef run(doc, choice='MM', area_volume=True, make=True, project=True, dims=True, dim_filter='', rounding='',\n        dim_symbol=False):\n    if doc is None:\n        raise Exception('No Revit document open.')\n    c = norm_choice(choice)\n    label, lu, la, au, aa, vu, va = CHOICES[c]\n    before = current_units(doc)\n    out, specs, drows, dskip = [], [], [], []\n    if project:\n        specs = [('Length', SpecTypeId.Length, lu, la)]\n        if area_volume:\n            specs += [('Area', SpecTypeId.Area, au, aa), ('Volume', SpecTypeId.Volume, vu, va)]\n    dacc = dim_accuracy(c, rounding, la)\n    t = Transaction(doc, 'A07 Units -> ' + label)\n    t.Start()\n    try:\n        if specs:\n            units = doc.GetUnits()\n            for key, spec, ua, acc in specs:\n                units.SetFormatOptions(spec, _fo(ua, acc))\n            doc.SetUnits(units)\n        if dims:\n            types, dskip = dim_types(doc, dim_filter)\n            for dt, nm in types:\n                old = dim_unit_name(dt)\n                try:\n                    dt.SetUnitsFormatOptions(_fo(lu, dacc, dim_symbol))\n                    drows.append((nm, old, dim_unit_name(dt)))\n                except Exception as ex:\n                    dskip.append('{0} ({1})'.format(nm, str(ex).splitlines()[0][:60]))\n        after = current_units(doc)\n    except Exception:\n        if t.HasStarted() and not t.HasEnded():\n            t.RollBack()\n        raise\n    if make:\n        t.Commit()\n        out.append('Units set to {0} in \"{1}\"'.format(label.upper(), doc.Title))\n    else:\n        t.RollBack()\n        out.append('PREVIEW (RUN = False): nothing changed - \"{0}\" would get {1}'.format(doc.Title, label.upper()))\n    if specs:\n        out.append('PROJECT UNITS:')\n        for key, spec, ua, acc in specs:\n            out.append('  {0}: {1}  ->  {2}'.format(key, before.get(key, '?'), after.get(key, '?')))\n        if not area_volume:\n            out.append('  Area / Volume left as they were ({0} / {1})'.format(before.get('Area'), before.get('Volume')))\n    else:\n        out.append('PROJECT UNITS: not changed (still {0})'.format(before.get('Length')))\n    if dims:\n        out.append('DIMENSION TYPES: {0} set to {1}{2}{3}'.format(\n            len(drows), label, ' with unit symbol' if dim_symbol else '',\n            '' if not str(rounding or '').strip() else ', rounding ' + str(rounding)))\n        for nm, old, new in drows[:12]:\n            out.append('  {0}: {1} -> {2}'.format(nm, old, new))\n        if len(drows) > 12:\n            out.append('  ... and {0} more'.format(len(drows) - 12))\n        if dskip:\n            out.append('  left alone: ' + ', '.join(dskip[:8]))\n        if not drows and not dskip:\n            out.append('  no dimension type matched \"{0}\"'.format(dim_filter))\n        out.append('  (angular and slope dimensions are never changed)')\n    out.append('Only the display changes - the model keeps its real sizes.  Ctrl+Z undoes it.')\n    log('\\n'.join(out))\n    return out\n\n\n# =====================================================================\n#  DYNAMO / DYNAMO PLAYER PART  -  inputs:\n#    0  Units                MM / CM / M / FT-IN (feet-inches) / FT (decimal feet)\n#    1  Change project units True  (Manage > Project Units: length)\n#    2  Change dimensions    True  (every linear / radial / diameter / arc / spot dimension type)\n#    3  Area + volume too    True  (m2 + m3, or ft2 + ft3)\n#    4  Dimension types      ALL, or words the type name contains (comma list)\n#    5  Dim rounding         blank = normal,  0 / 1 / 2 decimals,  feet-inches: 8 = 1/8 inch, 16 = 1/16\n#    6  Unit symbol on dims  False (True = 350 cm, 3500 mm ...)\n#    7  RUN                  False = PREVIEW (shows old -> new, changes nothing),  True = change\n#  Only the display changes - the model keeps its real sizes.  Ctrl+Z in Revit undoes.\n# =====================================================================\nimport traceback\n\ntry:\n    IN                                                    # noqa - Dynamo\n    DYNAMO = True\nexcept NameError:\n    DYNAMO = False\nTM = None\ndoc = globals().get('doc')\nif DYNAMO:\n    try:\n        clr.AddReference('RevitServices')\n        from RevitServices.Persistence import DocumentManager\n        from RevitServices.Transactions import TransactionManager\n        _d = DocumentManager.Instance.CurrentDBDocument\n        if _d is not None:\n            doc = _d\n            TM = TransactionManager\n    except Exception:\n        pass\n    RAW = list(IN)\nelse:\n    RAW = list(globals().get('UNIT_INPUTS', []))\n\n\ndef _inp(i, default):\n    try:\n        v = RAW[i]\n    except Exception:\n        return default\n    if v is None or (isinstance(v, str) and not v.strip()):\n        return default\n    return v\n\n\ndef _flag(i, default):\n    v = _inp(i, default)\n    if isinstance(v, str):\n        return v.strip().upper() in ('TRUE', 'YES', '1', 'Y')\n    return bool(v)\n\n\nout = []\ntry:\n    if TM is not None:\n        TM.Instance.ForceCloseTransaction()\n    out = run(doc, str(_inp(0, 'MM')), _flag(3, True), _flag(7, False), _flag(1, True), _flag(2, True),\n              str(_inp(4, 'ALL')), str(_inp(5, '')), _flag(6, False))\nexcept Exception as ex:\n    out.append('FAILED: ' + str(ex))\n    log(traceback.format_exc())\nif DYNAMO and not globals().get('NO_DIALOG'):\n    try:\n        clr.AddReference('RevitAPIUI')\n        from Autodesk.Revit.UI import TaskDialog\n        td = TaskDialog('A07 Units')\n        td.MainInstruction = 'Failed' if any(l.startswith('FAILED') for l in out) else (\n            'Preview - nothing changed' if out and out[0].startswith('PREVIEW') else 'Units changed')\n        td.MainContent = '\\n'.join(out)[:1900]\n        td.Show()\n    except Exception:\n        pass\nOUT = out\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "2927b02072ee498797d902e4ad897c77",
      "NodeType": "PythonScriptNode",
