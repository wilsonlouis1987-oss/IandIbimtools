{
  "Uuid": "638901a8-574e-46e3-8370-8bae1e773b77",
  "IsCustomNode": false,
  "Description": "Plan views for every level from an Excel list: floor / ceiling / structural / area plans with names, view templates and scales",
  "Name": "CAD2BIM_Views_Setup",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.Filename, CoreNodeModels",
      "Id": "e2835dc20f1e422e863fde75e70e9c40",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "1b39a9f3af0f49c89439903791ab7065",
          "Name": "",
          "Description": "File Path",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows you to select a file on the system and returns its file path",
      "HintPath": "",
      "InputValue": "No file selected."
    },
    {
      "ConcreteType": "CoreNodeModels.Input.FileObject, CoreNodeModels",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "928b2441b30344ee9a351304a8b897a5",
          "Name": "path",
          "Description": "Path to the file.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0eadb6066a7e4ba793c3f1e6e2cedd9c",
          "Name": "file",
          "Description": "File object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a file object from the given path",
      "Id": "86337e6929b34db8a0abe470f28ed0e9"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "3c535e8d6607453bbb34dd05968bb1cd",
      "NodeType": "BooleanInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "f805a5952b2846c5a4872752b6961cd7",
          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Enables selection between True and False",
      "InputValue": true
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - VIEWS SETUP (plan views for every level, with names, templates and scales)\n#  VIEW SETS tab: which views each level gets  (kind, name pattern with {LEVEL}, view template, scale)\n#  LEVELS tab   : which levels get views (YES / NO) - the result per level is written back\n#  missing views are created; existing views (same name) are left alone; nothing is deleted\nimport os\nimport re\nimport traceback\n\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\n\n\ndef log(msg):\n    try:\n        with open(LOG, 'a') as fh:\n            fh.write(str(msg) + '\\n')\n    except Exception:\n        pass\n\n\nimport os\nimport re\nimport zipfile\nimport xml.etree.ElementTree as ET\n\n# ======================================================================== tiny .xlsx reader / writer\nNS = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'\nRNS = '{http://schemas.openxmlformats.org/officeDocument/2006/relationships}'\n\n\ndef _esc(s):\n    s = re.sub(u'[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]', '', u'%s' % s)\n    return s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('\"', '&quot;')\n\n\ndef _ref(ci, ri):\n    s, ci = '', ci + 1\n    while ci:\n        ci, rem = divmod(ci - 1, 26)\n        s = chr(65 + rem) + s\n    return '%s%d' % (s, ri + 1)\n\n\ndef _colidx(ref):\n    n = 0\n    for ch in ''.join(c for c in ref if c.isalpha()):\n        n = n * 26 + (ord(ch.upper()) - 64)\n    return n - 1\n\n\ndef xlsx_read(path, sheet_name):\n    z = zipfile.ZipFile(path)\n    try:\n        shared = []\n        if 'xl/sharedStrings.xml' in z.namelist():\n            for si in ET.fromstring(z.read('xl/sharedStrings.xml')).iter(NS + 'si'):\n                shared.append(''.join(t.text or '' for t in si.iter(NS + 't')))\n        wb = ET.fromstring(z.read('xl/workbook.xml'))\n        rmap = dict((r.get('Id'), r.get('Target')) for r in ET.fromstring(z.read('xl/_rels/workbook.xml.rels')))\n        target = None\n        for sh in wb.iter(NS + 'sheet'):\n            if sh.get('name', '').strip().upper() == sheet_name.upper():\n                target = rmap.get(sh.get(RNS + 'id'))\n        if target is None:\n            return None\n        target = target.lstrip('/')\n        if not target.startswith('xl/'):\n            target = 'xl/' + target\n        root = ET.fromstring(z.read(target))\n    finally:\n        z.close()\n    rows = []\n    for r in root.iter(NS + 'row'):\n        vals = {}\n        for c in r.iter(NS + 'c'):\n            t, v = c.get('t'), c.find(NS + 'v')\n            if t == 's' and v is not None:\n                val = shared[int(v.text)]\n            elif t == 'inlineStr':\n                val = ''.join(x.text or '' for x in c.iter(NS + 't'))\n            elif v is not None and v.text not in (None, ''):\n                val = v.text\n                if t not in ('str', 'e', 'b'):\n                    try:\n                        fl = float(val)\n                        val = str(int(fl)) if fl == int(fl) else str(fl)\n                    except ValueError:\n                        pass\n            else:\n                val = ''\n            vals[_colidx(c.get('r'))] = (val or '').strip()\n        rno = int(r.get('r')) if r.get('r') else len(rows) + 1\n        while len(rows) < rno - 1:\n            rows.append([])\n        rows.append([vals.get(i, '') for i in range(max(vals) + 1)] if vals else [])\n    return rows\n\n\nSTYLES = ('<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n          '<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">'\n          '<fonts count=\"5\"><font><sz val=\"11\"/><name val=\"Arial\"/></font>'\n          '<font><b/><sz val=\"10\"/><color rgb=\"FFFFFFFF\"/><name val=\"Arial\"/></font>'\n          '<font><sz val=\"11\"/><color rgb=\"FF0000FF\"/><name val=\"Arial\"/></font>'\n          '<font><b/><sz val=\"14\"/><name val=\"Arial\"/></font>'\n          '<font><i/><sz val=\"10\"/><color rgb=\"FF595959\"/><name val=\"Arial\"/></font></fonts>'\n          '<fills count=\"4\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill>'\n          '<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FF1F3864\"/><bgColor indexed=\"64\"/></patternFill></fill>'\n          '<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FFF2F2F2\"/><bgColor indexed=\"64\"/></patternFill></fill></fills>'\n          '<borders count=\"2\"><border><left/><right/><top/><bottom/><diagonal/></border>'\n          '<border><left style=\"thin\"><color rgb=\"FFBFBFBF\"/></left><right style=\"thin\"><color rgb=\"FFBFBFBF\"/></right>'\n          '<top style=\"thin\"><color rgb=\"FFBFBFBF\"/></top><bottom style=\"thin\"><color rgb=\"FFBFBFBF\"/></bottom><diagonal/></border></borders>'\n          '<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>'\n          '<cellXfs count=\"7\">'\n          '<xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>'                                         # 0 normal\n          '<xf numFmtId=\"49\" fontId=\"1\" fillId=\"2\" borderId=\"1\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\" applyAlignment=\"1\">'\n          '<alignment wrapText=\"1\" vertical=\"center\" horizontal=\"center\"/></xf>'                                  # 1 header\n          '<xf numFmtId=\"49\" fontId=\"2\" fillId=\"0\" borderId=\"1\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\" applyBorder=\"1\"/>'  # 2 blue input (text)\n          '<xf numFmtId=\"49\" fontId=\"0\" fillId=\"3\" borderId=\"1\" xfId=\"0\" applyNumberFormat=\"1\" applyFill=\"1\" applyBorder=\"1\"/>'  # 3 grey calculated\n          '<xf numFmtId=\"0\" fontId=\"3\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\"/>'                           # 4 title\n          '<xf numFmtId=\"49\" fontId=\"4\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\"/>'     # 5 note\n          '<xf numFmtId=\"49\" fontId=\"0\" fillId=\"3\" borderId=\"1\" xfId=\"0\" applyNumberFormat=\"1\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\"/>'  # 6 grey key\n          '</cellXfs><cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles></styleSheet>')\n\n\ndef _sheet_xml(rows, widths, freeze=None, validations=None, col_styles=None, heights=None):\n    \"\"\"rows: list of lists; a cell = value, or (value, style), or ('=formula', cached, style)\"\"\"\n    cs = col_styles or {}\n    out = ['<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n           '<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">']\n    if freeze:\n        out.append('<sheetViews><sheetView workbookViewId=\"0\"><pane ySplit=\"%d\" topLeftCell=\"A%d\" activePane=\"bottomLeft\" '\n                   'state=\"frozen\"/></sheetView></sheetViews>' % (freeze, freeze + 1))\n    out.append('<cols>' + ''.join('<col min=\"%d\" max=\"%d\" width=\"%s\" customWidth=\"1\"%s/>'\n                                  % (i + 1, i + 1, w, (' style=\"%d\"' % cs[i]) if i in cs else '')\n                                  for i, w in enumerate(widths)) + '</cols><sheetData>')\n    for ri, row in enumerate(rows):\n        cells = []\n        for ci, cell in enumerate(row):\n            ref, style, f = _ref(ci, ri), cs.get(ci, 0), None\n            if isinstance(cell, tuple):\n                if len(cell) == 3:\n                    f, val, style = cell\n                else:\n                    val, style = cell\n            else:\n                val = cell\n            sa = ' s=\"%d\"' % style if style else ''\n            if f:\n                cells.append('<c r=\"%s\"%s t=\"str\"><f>%s</f><v>%s</v></c>' % (ref, sa, _esc(f.lstrip('=')), _esc(val)))\n            elif val is None or val == '':\n                if style:\n                    cells.append('<c r=\"%s\"%s/>' % (ref, sa))\n            else:\n                cells.append('<c r=\"%s\"%s t=\"inlineStr\"><is><t xml:space=\"preserve\">%s</t></is></c>' % (ref, sa, _esc(val)))\n        ht = (' ht=\"%s\" customHeight=\"1\"' % heights[ri]) if heights and ri in heights else ''\n        out.append('<row r=\"%d\"%s>%s</row>' % (ri + 1, ht, ''.join(cells)))\n    out.append('</sheetData>')\n    if validations:\n        out.append('<dataValidations count=\"%d\">' % len(validations))\n        for sqref, formula in validations:\n            out.append('<dataValidation type=\"list\" allowBlank=\"1\" showErrorMessage=\"0\" sqref=\"%s\"><formula1>%s</formula1>'\n                       '</dataValidation>' % (sqref, _esc(formula)))\n        out.append('</dataValidations>')\n    out.append('</worksheet>')\n    return ''.join(out)\n\n\ndef xlsx_write(path, sheets):\n    \"\"\"sheets: list of (name, sheet_xml)\"\"\"\n    n = len(sheets)\n    ct = ('<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n          '<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">'\n          '<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>'\n          '<Default Extension=\"xml\" ContentType=\"application/xml\"/>'\n          '<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>'\n          '<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>'\n          + ''.join('<Override PartName=\"/xl/worksheets/sheet%d.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>' % (i + 1)\n                    for i in range(n)) + '</Types>')\n    rels = ('<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n            '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">'\n            '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>'\n            '</Relationships>')\n    wb = ('<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n          '<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" '\n          'xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">'\n          '<bookViews><workbookView activeTab=\"0\"/></bookViews><sheets>'\n          + ''.join('<sheet name=\"%s\" sheetId=\"%d\" r:id=\"rId%d\"/>' % (_esc(s[0]), i + 1, i + 1) for i, s in enumerate(sheets))\n          + '</sheets><calcPr calcId=\"191029\" fullCalcOnLoad=\"1\"/></workbook>')\n    wrels = ('<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n             '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">'\n             + ''.join('<Relationship Id=\"rId%d\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" '\n                       'Target=\"worksheets/sheet%d.xml\"/>' % (i + 1, i + 1) for i in range(n))\n             + '<Relationship Id=\"rId%d\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" '\n               'Target=\"styles.xml\"/></Relationships>' % (n + 1))\n    tmp = path + '.tmp'\n    z = zipfile.ZipFile(tmp, 'w', zipfile.ZIP_DEFLATED)\n    try:\n        z.writestr('[Content_Types].xml', ct)\n        z.writestr('_rels/.rels', rels)\n        z.writestr('xl/workbook.xml', wb)\n        z.writestr('xl/_rels/workbook.xml.rels', wrels)\n        z.writestr('xl/styles.xml', STYLES)\n        for i, (name, xml) in enumerate(sheets):\n            z.writestr('xl/worksheets/sheet%d.xml' % (i + 1), xml.encode('utf-8'))\n    finally:\n        z.close()\n    try:\n        if os.path.exists(path):\n            os.remove(path)\n        os.rename(tmp, path)\n    except Exception:\n        os.remove(tmp)\n        raise\n\n\n\n\nKINDS = ['Floor Plan', 'Ceiling Plan', 'Structural Plan']          # + 'Area Plan - <scheme>' from the project\nDEFAULT_SETS = [\n    ['YES', 'Floor Plan', '{LEVEL} - FLOOR PLAN', '', '100'],\n    ['YES', 'Ceiling Plan', '{LEVEL} - REFLECTED CEILING PLAN', '', '100'],\n    ['NO', 'Floor Plan', '{LEVEL} - FURNITURE LAYOUT', '', '100'],\n    ['NO', 'Floor Plan', '{LEVEL} - DIMENSION PLAN', '', '100'],\n    ['NO', 'Structural Plan', '{LEVEL} - STRUCTURAL PLAN', '', '100'],\n    ['NO', 'Area Plan - Gross Building', '{LEVEL} - GROSS AREA PLAN', '', '200'],\n]\nSET_COLS = [('CREATE\\n(YES/NO)', 9), ('VIEW KIND', 26), ('VIEW NAME  ({LEVEL} = level name)', 40), ('VIEW TEMPLATE  (optional)', 34), ('SCALE  1:', 9)]\nLVL_COLS = [('LEVEL', 22), ('ELEVATION (m)\\n(written)', 13), ('MAKE VIEWS\\n(YES/NO)', 11), ('RESULT\\n(written)', 70)]\n\n\ndef yes(v):\n    return str(v).strip().upper() in ('YES', 'Y', 'X', 'TRUE', '1')\n\n\ndef write_book(path, sets, lvl_rows, kinds, templates, title):\n    sh = [[('CAD2BIM  VIEWS SETUP  -  ' + (title or 'PROJECT'), 4)],\n          [('One row per view every level gets.  Rows of the same kind are fine (e.g. FLOOR PLAN + FURNITURE LAYOUT).', 5)],\n          [(c[0], 1) for c in SET_COLS]]\n    for r in sets:\n        r = (list(r) + [''] * 5)[:5]\n        sh.append([(x, 2) for x in r])\n    for i in range(20):\n        sh.append([('', 2)] * 5)\n    n = len(sh) + 1\n    val = [('A4:A%d' % n, '\"YES,NO\"'), ('B4:B%d' % n, 'LISTS!$A$2:$A$%d' % (len(kinds) + 1))]\n    if templates:\n        val.append(('D4:D%d' % n, 'LISTS!$B$2:$B$%d' % (len(templates) + 1)))\n    lv = [[('CAD2BIM  LEVELS', 4)], [('YES = this level gets the views of the VIEW SETS tab.', 5)], [(c[0], 1) for c in LVL_COLS]]\n    for r in lvl_rows:\n        r = (list(r) + [''] * 4)[:4]\n        lv.append([(r[0], 6), (r[1], 3), (r[2], 2), (r[3], 3)])\n    lists = [[('View kinds', 1), ('View templates in this project', 1)]]\n    for i in range(max(len(kinds), len(templates))):\n        lists.append([(kinds[i] if i < len(kinds) else '', 0), (templates[i] if i < len(templates) else '', 0)])\n    help_rows = [[('HOW TO USE', 4)], [],\n                 ['1.  VIEW SETS: CREATE = YES for each view every level should have.  VIEW NAME uses {LEVEL} for the level name.'],\n                 ['    VIEW TEMPLATE (optional) is applied to new views; SCALE is used when the template does not control the scale.'],\n                 ['2.  LEVELS: MAKE VIEWS = YES for the levels that need views (by default the building storeys).'],\n                 ['3.  Save, close, run CAD2BIM_Views_Setup (APPLY on).  Missing views are created, existing views are left alone.'],\n                 ['    Nothing is deleted or renamed.  Run with APPLY off to preview.'],\n                 ['4.  Area plans need the area scheme (Gross Building / Rentable ...) - the kinds list shows the schemes of this project.'],\n                 ['5.  Next: put the views on sheets with CAD2BIM_Sheets_From_Excel.']]\n    xlsx_write(path, [('VIEW SETS', _sheet_xml(sh, [c[1] for c in SET_COLS], freeze=3, heights={2: 32}, validations=val)),\n                      ('LEVELS', _sheet_xml(lv, [c[1] for c in LVL_COLS], freeze=3, heights={2: 32},\n                                            validations=[('C4:C%d' % (len(lv) + 1), '\"YES,NO\"')])),\n                      ('LISTS', _sheet_xml(lists, [32, 40])),\n                      ('HOW TO USE', _sheet_xml(help_rows, [120]))])\n\n\ndef read_book(path):\n    rows = xlsx_read(path, 'VIEW SETS')\n    if rows is None:\n        raise Exception('the Excel has no VIEW SETS tab - leave the file box empty once to create a new Excel')\n    hi = next((i for i, r in enumerate(rows) if r and r[0].strip().upper().startswith('CREATE')), 2)\n    sets = []\n    for n, r in enumerate(rows[hi + 1:], start=hi + 2):\n        r = (list(r) + [''] * 5)[:5]\n        if not (r[1].strip() and r[2].strip()):\n            continue\n        sets.append({'row': n, 'create': r[0], 'kind': r[1].strip(), 'pattern': r[2].strip(), 'template': r[3].strip(),\n                     'scale': r[4].strip(), 'raw': r})\n    lrows = xlsx_read(path, 'LEVELS') or []\n    hi = next((i for i, r in enumerate(lrows) if r and r[0].strip().upper() == 'LEVEL'), 2)\n    lv = {}\n    for r in lrows[hi + 1:]:\n        r = (list(r) + [''] * 4)[:4]\n        if r[0].strip():\n            lv[r[0].strip().lower()] = r[2]\n    return sets, lv\n\n\n# ======================================================================== Revit part\ndef run(doc, XL, APPLY, out):\n    from Autodesk.Revit.DB import (FilteredElementCollector, Level, View, ViewPlan, ViewFamilyType, ViewFamily, ViewType,\n                                   AreaScheme, BuiltInParameter, Element)\n\n    def nm(e):\n        for get in (lambda: Element.Name.GetValue(e), lambda: Element.Name.__get__(e), lambda: e.Name):\n            try:\n                n = get()\n                if n:\n                    return n\n            except Exception:\n                pass\n        p = e.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM) if e is not None else None\n        return p.AsString() if p is not None else ''\n\n    def idv(eid):\n        try:\n            return eid.Value\n        except Exception:\n            return eid.IntegerValue\n\n    levels = sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)\n    schemes = dict((nm(a), a) for a in FilteredElementCollector(doc).OfClass(AreaScheme))\n    kinds = KINDS + ['Area Plan - ' + s for s in sorted(schemes)]\n    plan_types = (int(ViewType.FloorPlan), int(ViewType.CeilingPlan), int(ViewType.EngineeringPlan), int(ViewType.AreaPlan))\n    all_views = [v for v in FilteredElementCollector(doc).OfClass(View)]\n    templates = [v for v in all_views if v.IsTemplate and int(v.ViewType) in plan_types]\n    tpl_by = dict((nm(t).lower(), t) for t in templates)\n    names = set(nm(v).lower() for v in all_views if not v.IsTemplate)\n\n    def story(l):\n        p = l.get_Parameter(BuiltInParameter.LEVEL_IS_BUILDING_STORY)\n        return p is None or p.AsInteger() == 1\n\n    if not os.path.exists(XL):\n        lvl_rows = [[l.Name, '%.3f' % (l.Elevation * 0.3048), 'YES' if story(l) else 'NO', ''] for l in levels]\n        write_book(XL, DEFAULT_SETS, lvl_rows, kinds, sorted(nm(t) for t in templates), doc.Title)\n        out.append('CAD2BIM VIEWS SETUP  -  EXCEL CREATED')\n        out.append('File   : ' + XL)\n        out.append('%d level(s), %d view set(s) (%d set to YES).  Edit, save, Browse... to this file and Run.'\n                   % (len(levels), len(DEFAULT_SETS), len([s for s in DEFAULT_SETS if s[0] == 'YES'])))\n        return\n\n    sets, lv_flags = read_book(XL)\n    vft = {}\n    for t in FilteredElementCollector(doc).OfClass(ViewFamilyType):\n        vft.setdefault(int(t.ViewFamily), t)\n    fam = {'floor plan': int(ViewFamily.FloorPlan), 'ceiling plan': int(ViewFamily.CeilingPlan),\n           'structural plan': int(ViewFamily.StructuralPlan)}\n    acts, notes = [], []\n    result = dict((idv(l.Id), []) for l in levels)\n    active = [s for s in sets if yes(s['create'])]\n    for s in sets:\n        if not yes(s['create']):\n            continue\n        k = s['kind'].lower()\n        if k.startswith('area plan'):\n            sch = k.split('-', 1)[1].strip() if '-' in k else ''\n            if not any(n.lower() == sch for n in schemes):\n                notes.append('row %d: area scheme \"%s\" not in this project (%s)' % (s['row'], sch, ', '.join(sorted(schemes)) or 'none'))\n                s['bad'] = True\n        elif k not in fam:\n            notes.append('row %d: unknown view kind \"%s\" - use %s' % (s['row'], s['kind'], ', '.join(kinds)))\n            s['bad'] = True\n        elif fam[k] not in vft:\n            notes.append('row %d: no \"%s\" view type in this project' % (s['row'], s['kind']))\n            s['bad'] = True\n        if '{level}' not in s['pattern'].lower():\n            notes.append('row %d: VIEW NAME has no {LEVEL} - every level would get the same name, only the first is made' % s['row'])\n        if s['template'] and s['template'].lower() not in tpl_by:\n            notes.append('row %d: view template \"%s\" not found - views made without it' % (s['row'], s['template']))\n    lvl_rows = []\n    made = 0\n    for l in levels:\n        flag = lv_flags.get(l.Name.lower())\n        on = yes(flag) if flag is not None else story(l)\n        res = []\n        if on:\n            for s in active:\n                if s.get('bad'):\n                    continue\n                vname = re.sub(r'\\{level\\}', l.Name, s['pattern'], flags=re.I)\n                if vname.lower() in names:\n                    res.append('ok')\n                    continue\n                if APPLY:\n                    k = s['kind'].lower()\n                    if k.startswith('area plan'):\n                        sch = k.split('-', 1)[1].strip()\n                        a = next(a for n, a in schemes.items() if n.lower() == sch)\n                        v = ViewPlan.CreateAreaPlan(doc, a.Id, l.Id)\n                    else:\n                        v = ViewPlan.Create(doc, vft[fam[k]].Id, l.Id)\n                    v.Name = vname\n                    t = tpl_by.get(s['template'].lower()) if s['template'] else None\n                    if t is not None:\n                        v.ViewTemplateId = t.Id\n                    sc = 0\n                    try:\n                        sc = int(float(s['scale'])) if s['scale'] else 0\n                        if sc > 0 and v.Scale != sc:\n                            v.Scale = sc\n                    except Exception:\n                        pass\n                    if sc > 0 and t is not None:\n                        doc.Regenerate()          # the template's scale is only enforced on regenerate\n                    if sc > 0 and v.Scale != sc and not s.get('scale_note'):\n                        s['scale_note'] = True\n                        notes.append('row %d: view template \"%s\" controls the scale - views are 1:%d, not 1:%s '\n                                     '(change the scale in the template, or untick Scale in it)' % (s['row'], s['template'], v.Scale, s['scale']))\n                names.add(vname.lower())\n                res.append('NEW')\n                made += 1\n                acts.append('%-8s %s' % ('NEW', vname))\n        n_new = res.count('NEW')\n        txt = ('-' if not on else ('%d new, %d already there' % (n_new, res.count('ok')) if res else 'no view sets'))\n        lvl_rows.append([l.Name, '%.3f' % (l.Elevation * 0.3048), 'YES' if on else 'NO', txt])\n\n    out.append('CAD2BIM VIEWS SETUP  -  %s' % ('APPLIED' if APPLY else 'CHECK ONLY (APPLY is off - Revit not changed)'))\n    out.append('File   : ' + XL)\n    if acts:\n        out.append('Changes (%d view%s):' % (made, '' if made == 1 else 's'))\n        out.extend('  ' + a for a in acts[:60])\n        if len(acts) > 60:\n            out.append('  ... %d more' % (len(acts) - 60))\n    else:\n        out.append('Revit already matches the Excel - nothing to change.')\n    try:\n        write_book(XL, [s['raw'] for s in sets], lvl_rows, kinds, sorted(nm(t) for t in templates), doc.Title)\n        out.append('Excel updated: LEVELS result and template list written.')\n    except Exception:\n        notes.append('the Excel is open - close it and Run again to get the results written back')\n    if notes:\n        out.append('')\n        out.append('Notes:')\n        out.extend('  ' + n for n in notes)\n\n\n# ======================================================================== Dynamo entry point\ntry:\n    IN\n    _IN_DYNAMO = True\nexcept NameError:\n    _IN_DYNAMO = False\n\nif _IN_DYNAMO:\n    import clr\n    clr.AddReference('RevitAPI')\n    clr.AddReference('RevitServices')\n    from RevitServices.Persistence import DocumentManager\n    from RevitServices.Transactions import TransactionManager\n\n    def file_path(x):\n        if x is None:\n            return ''\n        for a in ('FullName', 'FullPath'):\n            v = getattr(x, a, None)\n            if v:\n                return str(v)\n        s = str(x)\n        return '' if s.strip().lower() in ('', 'no file selected.', 'none', 'null') else s.strip().strip('\"')\n\n    def good_xl(p):\n        if not p:\n            return ''\n        base = os.path.basename(p).lower()\n        if base.startswith('no file selected') or not base.endswith(('.xlsx', '.xlsm')):\n            return ''\n        return p\n\n    out = []\n    doc = DocumentManager.Instance.CurrentDBDocument\n    _sub = None\n    try:\n        XL = good_xl(file_path(IN[0]))\n        APPLY = bool(IN[1])\n        log('--- views setup started  xl \"%s\" apply %s' % (XL, APPLY))\n        if not XL:\n            folder = os.path.dirname(doc.PathName) if doc.PathName else os.path.join(os.environ.get('USERPROFILE', ''), 'Documents')\n            XL = os.path.join(folder, '%s_VIEWS.xlsx' % doc.Title)\n        if APPLY and os.path.exists(XL):\n            from Autodesk.Revit.DB import SubTransaction\n            TransactionManager.Instance.EnsureInTransaction(doc)\n            _sub = SubTransaction(doc)\n            _sub.Start()\n        run(doc, XL, APPLY, out)\n        if _sub is not None:\n            _sub.Commit()\n            TransactionManager.Instance.TransactionTaskDone()\n    except Exception as ex:\n        try:\n            if _sub is not None:\n                _sub.RollBack()\n                out.append('Nothing was changed in Revit (the whole run was undone).')\n            TransactionManager.Instance.TransactionTaskDone()\n        except Exception:\n            pass\n        out.insert(0, 'FAILED: ' + str(ex))\n        log(traceback.format_exc())\n    log('\\n'.join(out))\n    OUT = out\n",
      "Engine": "CPython3",
