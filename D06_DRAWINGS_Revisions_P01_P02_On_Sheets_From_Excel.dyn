{
  "Uuid": "671c7d42-2612-4765-b413-5e66e30abdfd",
  "IsCustomNode": false,
  "Description": "Revisions from an Excel (P01, P02 / C01 ...): created, dated, put on the sheets with X marks; each sheet's Revision text = latest revision",
  "Name": "CAD2BIM_Revisions_From_Excel",
