    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - STAIRS FROM CAD (professional)\n#  reads the stair layers of the linked CAD: every flight = a set of parallel, evenly spaced tread lines\n#  -> concrete Revit stair (runs + landings + handrails), riser height from the floor-to-floor height,\n#  repeated storey by storey (L1->L2, L2->L3 ...). Re-run = the stairs of this CAD are rebuilt, never doubled.\nimport os\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\ndef log(msg):\n    try:\n        with open(LOG, 'a') as fh:\n            fh.write(str(msg) + '\\n')\n    except Exception:\n        pass\nlog('--- stairs from CAD v5 started')\nimport clr, math, traceback\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Architecture import *        # Stairs, StairsRun, StairsLanding, Railing ...\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\nMMF = 1.0 / 304.8\nCOL_PARAMS = [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')]\nout = []\n\n\ndef num(v, d=0.0):\n    try:\n        return float(v)\n    except Exception:\n        return d\n\n\ndef f(v):\n    return '{0:.0f}'.format(v)\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\n_CAT = {}\ndef catid(bic):\n    if bic not in _CAT:\n        _CAT[bic] = idv(Category.GetCategory(doc, bic).Id)\n    return _CAT[bic]\n\n\ndef cat_is(e, bic):\n    return e is not None and e.Category is not None and idv(e.Category.Id) == catid(bic)\n\n\ndef tname(t):\n    p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\n\ndef setp(e, bip, val):\n    p = e.get_Parameter(bip)\n    if p is not None and not p.IsReadOnly:\n        p.Set(val)\n        return True\n    return False\n\n\ndef getd(e, bip):\n    p = e.get_Parameter(bip)\n    return p.AsDouble() if p is not None else None\n\n\ndef getlvl(e, bip):\n    p = e.get_Parameter(bip)\n    if p is None:\n        return None\n    x = doc.GetElement(p.AsElementId())\n    return x if isinstance(x, Level) else None\n\n\ndef tagged(e):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    return (p.AsString() or '') if p is not None else ''\n\n\ndef mark(e, txt):\n    setp(e, BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS, txt)\n\n\ndef workset_for(keys):\n    if not doc.IsWorkshared:\n        return None\n    for ws in FilteredWorksetCollector(doc).OfKind(WorksetKind.UserWorkset):\n        if any(k in ws.Name.upper() for k in keys):\n            return ws.Id.IntegerValue\n    return None\n\n\ndef put_ws(e, wid):\n    if wid is not None:\n        try:\n            setp(e, BuiltInParameter.ELEM_PARTITION_PARAM, wid)\n        except Exception:\n            pass\n\n\ndef material(keys):\n    mats = list(FilteredElementCollector(doc).OfClass(Material))\n    for k in keys:\n        hit = [m for m in mats if k in m.Name.upper()]\n        if hit:\n            hit.sort(key=lambda m: len(m.Name))\n            return hit[0].Id\n    return ElementId.InvalidElementId\n\n\nLEVELS = sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.ProjectElevation)\nLIDX = dict((idv(l.Id), i) for i, l in enumerate(LEVELS))\n\n\ndef parse_levels(text, base=None):\n    \"\"\"'L2, L3' / 'L2..L5' / 'ALL' (= every level above base)\"\"\"\n    res = []\n    names = dict((l.Name.strip().upper(), l) for l in LEVELS)\n    for tok in [t.strip() for t in str(text or '').replace(';', ',').split(',') if t.strip()]:\n        T = tok.upper()\n        if T in ('ALL', '*', 'ALL ABOVE'):\n            b = LIDX[idv(base.Id)] if base is not None else -1\n            res += LEVELS[b + 1:]\n        elif '..' in T:\n            a, b = [names.get(x.strip()) for x in T.split('..', 1)]\n            if a is None or b is None:\n                raise Exception('Unknown level in \"{0}\". Levels: {1}'.format(tok, ', '.join(l.Name for l in LEVELS)))\n            i, j = sorted([LIDX[idv(a.Id)], LIDX[idv(b.Id)]])\n            res += LEVELS[i:j + 1]\n        else:\n            if T not in names:\n                raise Exception('Unknown level \"{0}\". Levels: {1}'.format(tok, ', '.join(l.Name for l in LEVELS)))\n            res.append(names[T])\n    seen, uniq = set(), []\n    for l in res:\n        if idv(l.Id) not in seen:\n            seen.add(idv(l.Id))\n            uniq.append(l)\n    return uniq\n\n\ndef col_size(c):\n    sym = c.Symbol\n    for a, b in COL_PARAMS:\n        if sym.LookupParameter(a) is not None and sym.LookupParameter(b) is not None:\n            return sym.LookupParameter(a).AsDouble() / MMF, sym.LookupParameter(b).AsDouble() / MMF\n    bb = c.get_BoundingBox(None)\n    return (bb.Max.X - bb.Min.X) / MMF, (bb.Max.Y - bb.Min.Y) / MMF\n\n\ndef angle_of(e):\n    bx = e.GetTransform().BasisX\n    return math.degrees(math.atan2(bx.Y, bx.X))\n\n\n\n# ---------------------------------------------------------------- CAD reading\ndef layer_name(g, inherited):\n    name = None\n    try:\n        gs = doc.GetElement(g.GraphicsStyleId)\n        if gs is not None and gs.GraphicsStyleCategory is not None:\n            name = gs.GraphicsStyleCategory.Name\n    except Exception:\n        name = None\n    if not name or name == '0':\n        return inherited or name or '0'\n    return name\n\n\ndef read_layers(cad):\n    \"\"\"{layer: [segments]} in mm; arcs and splines are split into short straight pieces.\"\"\"\n    opt = Options()\n    opt.ComputeReferences = False\n    if cad.ViewSpecific:\n        opt.View = doc.GetElement(cad.OwnerViewId)\n    data = {}\n\n    def add(ln, ps):\n        for i in range(len(ps) - 1):\n            if ps[i] != ps[i + 1]:\n                data.setdefault(ln, []).append((ps[i], ps[i + 1]))\n\n    def walk(geom, inherited):\n        for g in geom:\n            ln = layer_name(g, inherited)\n            if isinstance(g, GeometryInstance):\n                walk(g.GetInstanceGeometry(), ln)\n            elif isinstance(g, Line):\n                if g.IsBound:\n                    add(ln, [pt(g.GetEndPoint(0)), pt(g.GetEndPoint(1))])\n            elif isinstance(g, PolyLine):\n                add(ln, [pt(p) for p in g.GetCoordinates()])\n            elif isinstance(g, Curve):\n                try:\n                    add(ln, [pt(p) for p in g.Tessellate()])\n                except Exception:\n                    pass\n    top = cad.get_Geometry(opt)\n    for g in top:\n        if isinstance(g, GeometryInstance):\n            walk(g.GetInstanceGeometry(), None)\n    return data\n\n\n\n# ---------------------------------------------------------------- stair recognition (pure python, mm)\ndef _ang(s):\n    (x0, y0), (x1, y1) = s\n    return math.degrees(math.atan2(y1 - y0, x1 - x0)) % 180.0\n\n\ndef _merge_collinear(segs, ang_tol=1.0, off_tol=15.0, gap=100.0):\n    \"\"\"join pieces of one tread line that the walk-line / arrow split\"\"\"\n    groups = {}\n    for s in segs:\n        a = round(_ang(s) / ang_tol) * ang_tol % 180.0\n        t = math.radians(a)\n        d = (math.cos(t), math.sin(t)); n = (-d[1], d[0])\n        off = s[0][0] * n[0] + s[0][1] * n[1]\n        key = (a, round(off / off_tol))\n        t0 = s[0][0] * d[0] + s[0][1] * d[1]; t1 = s[1][0] * d[0] + s[1][1] * d[1]\n        groups.setdefault(key, []).append((min(t0, t1), max(t0, t1), off, d, n))\n    out = []\n    for key, iv in groups.items():\n        iv.sort()\n        cur = list(iv[0])\n        offs = [cur[2]]\n        for a, b, off, d, n in iv[1:]:\n            # join pieces split by a walk-line; two full-width flights side by side (dog-leg) stay apart\n            if a <= cur[1] + gap and max(cur[1] - cur[0], b - a) < 750.0:\n                cur[1] = max(cur[1], b); offs.append(off)\n            else:\n                out.append((cur, sum(offs) / len(offs))); cur = [a, b, off, d, n]; offs = [off]\n        out.append((cur, sum(offs) / len(offs)))\n    res = []\n    for (a, b, _, d, n), off in out:\n        p = (d[0] * a + n[0] * off, d[1] * a + n[1] * off)\n        q = (d[0] * b + n[0] * off, d[1] * b + n[1] * off)\n        res.append((p, q))\n    return res\n\n\ndef find_flights(segs, tmin=90.0, tmax=420.0, wmin=600.0, wmax=3500.0, min_lines=6, max_lines=22):\n    \"\"\"flights = >= min_lines parallel, equally long, evenly spaced, overlapping lines (the treads / risers)\n    that are NOT crossed by many perpendicular lines (that would be a tile grid / hatch)\"\"\"\n    merged = _merge_collinear(segs)\n    lines = [s for s in merged if wmin <= math.hypot(s[1][0] - s[0][0], s[1][1] - s[0][1]) <= wmax]\n    by_ang = {}\n    for s in lines:\n        by_ang.setdefault(round(_ang(s)) % 180, []).append(s)\n    flights, used = [], set()\n    for a, ss in by_ang.items():\n        t = math.radians(a)\n        v = (math.cos(t), math.sin(t)); u = (-v[1], v[0])        # v along the tread, u = walking direction\n        info = []\n        for s in ss:\n            s0 = s[0][0] * u[0] + s[0][1] * u[1]\n            l0 = s[0][0] * v[0] + s[0][1] * v[1]; l1 = s[1][0] * v[0] + s[1][1] * v[1]\n            info.append((s0, min(l0, l1), max(l0, l1), s))\n        info.sort(key=lambda i: i[0])\n        perp = None\n        for i0 in range(len(info)):\n            if id(info[i0][3]) in used:\n                continue\n            chain = [info[i0]]\n            for j in range(i0 + 1, len(info)):\n                cand = info[j]\n                if id(cand[3]) in used:\n                    continue\n                last = chain[-1]\n                gap = cand[0] - last[0]\n                if gap < tmin:\n                    continue\n                if gap > tmax:\n                    break\n                L1, L2 = last[2] - last[1], cand[2] - cand[1]\n                ov = min(last[2], cand[2]) - max(last[1], cand[1])\n                if abs(L1 - L2) > 0.15 * max(L1, L2) or ov < 0.8 * min(L1, L2):\n                    continue\n                if len(chain) >= 2:\n                    sp = chain[1][0] - chain[0][0]\n                    if abs(gap - sp) > max(15.0, 0.1 * sp):\n                        continue\n                chain.append(cand)\n            if len(chain) > max_lines:                                # > 22 risers in one flight = not a stair\n                for c in chain:\n                    used.add(id(c[3]))                                # ... and no part of it either\n                continue\n            if len(chain) < min_lines:\n                continue\n            pos = [c[0] for c in chain]\n            lo = sorted(c[1] for c in chain)[len(chain) // 2]\n            hi = sorted(c[2] for c in chain)[len(chain) // 2]\n            # tile grid / hatch test: perpendicular lines running through the flight\n            if perp is None:\n                perp = []\n                for q in merged:\n                    if abs(((_ang(q) - a + 90.0) % 180.0) - 90.0) > 88.0:      # ~perpendicular\n                        q0 = q[0][0] * u[0] + q[0][1] * u[1]; q1 = q[1][0] * u[0] + q[1][1] * u[1]\n                        lat = q[0][0] * v[0] + q[0][1] * v[1]\n                        perp.append((min(q0, q1), max(q0, q1), lat))\n            span = pos[-1] - pos[0]\n            cross = sum(1 for q0, q1, lat in perp\n                        if lo + 50 < lat < hi - 50 and min(q1, pos[-1]) - max(q0, pos[0]) > 0.5 * span)\n            if cross > 2:\n                continue\n            for c in chain:\n                used.add(id(c[3]))\n            if any(abs(g['s'][0] - pos[0]) < 20 and abs(g['s'][-1] - pos[-1]) < 20 and\n                   abs(g['lat'] - (lo + hi) / 2.0) < 20 and g['u'] == u for g in flights):\n                continue                                              # duplicate (overlapping copy)\n            flights.append({'u': u, 'v': v, 's': pos, 'lat': (lo + hi) / 2.0, 'w': hi - lo,\n                            'spacing': span / (len(pos) - 1)})\n    return flights\n\n\ndef _pt(f, s, lat=None):\n    lat = f['lat'] if lat is None else lat\n    return (f['u'][0] * s + f['v'][0] * lat, f['u'][1] * s + f['v'][1] * lat)\n\n\ndef group_stairs(flights, near=1.6):\n    \"\"\"flights close to each other belong to one stair\"\"\"\n    n = len(flights); par = list(range(n))\n    def fnd(a):\n        while par[a] != a:\n            par[a] = par[par[a]]; a = par[a]\n        return a\n    ends = [[_pt(f, f['s'][0]), _pt(f, f['s'][-1])] for f in flights]\n    for i in range(n):\n        for j in range(i + 1, n):\n            d = min(math.hypot(a[0] - b[0], a[1] - b[1]) for a in ends[i] for b in ends[j])\n            if d < near * max(flights[i]['w'], flights[j]['w']):          # same core: ends within ~1.6 x width\n                par[fnd(i)] = fnd(j)\n    groups = {}\n    for i in range(n):\n        groups.setdefault(fnd(i), []).append(flights[i])\n    return list(groups.values())\n\n\ndef order_stair(flights, segs, flip=False):\n    \"\"\"returns flights bottom -> top, each with 's' sorted in walking order (first riser .. last riser)\"\"\"\n    def gap(f, end):                     # free space in front of this flight end (to the next wall line)\n        u, v = f['u'], f['v']\n        s_end = f['s'][end]\n        sgn = 1.0 if (end == -1) == (f['s'][-1] > f['s'][0]) else -1.0\n        best = 6000.0\n        a0 = math.degrees(math.atan2(v[1], v[0])) % 180.0\n        for q in segs:\n            if abs(((_ang(q) - a0 + 90.0) % 180.0) - 90.0) > 5.0:\n                continue\n            l0 = q[0][0] * v[0] + q[0][1] * v[1]; l1 = q[1][0] * v[0] + q[1][1] * v[1]\n            ov = min(max(l0, l1), f['lat'] + f['w'] / 2.0) - max(min(l0, l1), f['lat'] - f['w'] / 2.0)\n            if ov < 0.5 * f['w']:\n                continue\n            d = (q[0][0] * u[0] + q[0][1] * u[1] - s_end) * sgn\n            if 30.0 < d < best:\n                best = d\n        return best\n    if len(flights) == 1:\n        f = dict(flights[0]); s = list(f['s'])\n        # bottom = the end with less free space in front of it (the top usually opens onto a floor / landing)\n        if (gap(f, 0) > gap(f, -1)) != flip:\n            s.reverse()\n        f['s'] = s\n        return [f]\n    # connect flights end-to-end (closest ends, preferring the ends with more free space = landings)\n    n = len(flights)\n    cands = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            for ei in (0, -1):\n                for ej in (0, -1):\n                    a, b = _pt(flights[i], flights[i]['s'][ei]), _pt(flights[j], flights[j]['s'][ej])\n                    score = math.hypot(a[0] - b[0], a[1] - b[1]) - 0.5 * (gap(flights[i], ei) + gap(flights[j], ej))\n                    cands.append((score, i, ei, j, ej))\n    cands.sort()\n    deg = [0] * n; used_end = set(); links = {}\n    par = list(range(n))\n    def fnd(a):\n        while par[a] != a:\n            a = par[a]\n        return a\n    for score, i, ei, j, ej in cands:\n        if (i, ei) in used_end or (j, ej) in used_end or fnd(i) == fnd(j):\n            continue\n        used_end.add((i, ei)); used_end.add((j, ej))\n        links.setdefault(i, []).append((j, ei, ej)); links.setdefault(j, []).append((i, ej, ei))\n        par[fnd(i)] = fnd(j)\n        deg[i] += 1; deg[j] += 1\n        if sum(deg) == 2 * (n - 1):\n            break\n    starts = [i for i in range(n) if deg[i] <= 1]\n    starts.sort(key=lambda i: (flights[i]['lat'], flights[i]['s'][0]))\n    cur = starts[-1] if flip else starts[0]\n    order, prev, into_end = [], None, None\n    while cur is not None:\n        f = dict(flights[cur]); s = list(f['s'])\n        nxt = [l for l in links.get(cur, []) if l[0] != prev]\n        if nxt:\n            out_end = nxt[0][1]                       # this flight leaves through out_end (top)\n            if out_end == 0:\n                s.reverse()\n        else:\n            if into_end == -1:                        # we came in through the last line -> reverse\n                s.reverse()\n        f['s'] = s\n        order.append(f)\n        if nxt:\n            prev, cur, into_end = cur, nxt[0][0], nxt[0][2]\n        else:\n            cur = None\n    return order\n\nSTAIR_TAG = 'CAD2BIM-STAIR'\n\n\ndef to_mm(v):\n    return v / MMF\n\n\ndef pt(p):\n    return (to_mm(p.X), to_mm(p.Y))\n\n\ndef pick_cad(name_part):\n    cads = [c for c in FilteredElementCollector(doc).OfClass(ImportInstance)]\n    if name_part:\n        m = [c for c in cads if c.Category is not None and name_part.lower() in c.Category.Name.lower()]\n        if m:\n            return m[0]\n        raise Exception('No linked CAD whose name contains \"{0}\". CADs: {1}'.format(\n            name_part, ', '.join(c.Category.Name for c in cads if c.Category is not None)))\n    for eid in uidoc.Selection.GetElementIds():\n        e = doc.GetElement(eid)\n        if isinstance(e, ImportInstance):\n            return e\n    if len(cads) == 1:\n        return cads[0]\n    raise Exception('Select the CAD with the stair in Revit (or type part of its name). CADs: ' +\n                    ', '.join(c.Category.Name for c in cads if c.Category is not None))\n\n\ndef cad_level(cad):\n    if cad.ViewSpecific:\n        v = doc.GetElement(cad.OwnerViewId)\n        if v is not None and getattr(v, 'GenLevel', None) is not None:\n            return v.GenLevel\n    l = doc.GetElement(cad.LevelId)\n    if isinstance(l, Level):\n        return l\n    bb = cad.get_BoundingBox(None)\n    z = bb.Min.Z if bb is not None else 0.0\n    below = [l for l in LEVELS if l.ProjectElevation <= z + 0.01]\n    return below[-1] if below else LEVELS[0]\n\n\ndef stair_type(rh_max, tread, width):\n    types = list(FilteredElementCollector(doc).OfClass(StairsType))\n    if not types:\n        raise Exception('No stair type in the project')\n    name = 'CAD2BIM Concrete Stair'\n    st = [t for t in types if tname(t) == name]\n    if st:\n        st = st[0]\n    else:\n        pref = [t for t in types if any(k in tname(t).upper() for k in ('CAST', 'MONOLITHIC', 'CONCRETE'))]\n        st = (pref or types)[0].Duplicate(name)\n    try:\n        st.MaxRiserHeight = max(st.MaxRiserHeight, (rh_max + 1.0) * MMF)\n        st.MinTreadDepth = min(st.MinTreadDepth, (tread - 1.0) * MMF)\n        st.MinRunWidth = min(st.MinRunWidth, (width - 1.0) * MMF)\n    except Exception as ex:\n        log('stair type limits: ' + str(ex))\n    conc = material(['CONCRETE, CAST', 'CONCRETE'])\n    for tid in (getattr(st, 'RunType', None), getattr(st, 'LandingType', None)):\n        t = doc.GetElement(tid) if tid is not None else None\n        if t is None:\n            continue\n        for pn in ('Monolithic Material', 'Structural Material', 'Material'):\n            p = t.LookupParameter(pn)\n            if p is not None and not p.IsReadOnly and conc != ElementId.InvalidElementId:\n                try:\n                    p.Set(conc)\n                except Exception:\n                    pass\n    return st\n\n\ndef railing_type():\n    rts = list(FilteredElementCollector(doc).OfClass(RailingType))\n    for keys in (('HANDRAIL',), ('900',), ('1100',), ('GUARD',)):\n        for t in rts:\n            if any(k in tname(t).upper() for k in keys):\n                return t\n    return rts[0] if rts else None\n\n\nPRE = None\ntry:\n    import uuid as _uuid\n    _ns = 'CAD2BIM_' + _uuid.uuid4().hex[:10]\n\n    class _Quiet(IFailuresPreprocessor):\n        __namespace__ = _ns\n\n        def PreprocessFailures(self, fa):\n            try:\n                for m in fa.GetFailureMessages():\n                    if m.GetSeverity() == FailureSeverity.Warning:\n                        fa.DeleteWarning(m)\n            except Exception:\n                pass\n            return FailureProcessingResult.Continue\n    PRE = _Quiet()\nexcept Exception as ex:\n    log('failure handler not available: ' + str(ex))\n\n\ndef risers_per_flight(flights, H, maxr, from_cad):\n    \"\"\"number of risers of every flight for a storey of height H (mm)\"\"\"\n    if from_cad:\n        return [len(f['s']) for f in flights]\n    R = int(math.ceil(H / maxr - 1e-6))\n    base = [len(f['s']) for f in flights]\n    tot = float(sum(base))\n    rs = [max(2, int(round(R * b / tot))) for b in base]\n    while sum(rs) > R:\n        rs[rs.index(max(rs))] -= 1\n    while sum(rs) < R:\n        rs[rs.index(min(rs))] += 1\n    return rs\n\n\ndef build_stair(base, top, flights, rs, tread, width_ovr, stype, tag):\n    H = (top.ProjectElevation - base.ProjectElevation)\n    R = sum(rs)\n    rh = H / R\n    scope = StairsEditScope(doc, 'CAD2BIM stair')\n    sid = scope.Start(base.Id, top.Id)\n    t = Transaction(doc, 'CAD2BIM stair runs')\n    t.Start()\n    notes = []\n    try:\n        st = doc.GetElement(sid)\n        try:                                            # (new stairs already use it as default type)\n            tp = st.get_Parameter(BuiltInParameter.ELEM_TYPE_PARAM)\n            if tp is not None and not tp.IsReadOnly and idv(tp.AsElementId()) != idv(stype.Id):\n                tp.Set(stype.Id)\n        except Exception as ex:\n            notes.append('type: {0}'.format(ex))\n        st.DesiredRisersNumber = R\n        st.ActualTreadDepth = tread * MMF\n        runs, zrel = [], 0.0\n        for f, r in zip(flights, rs):\n            s0 = f['s'][0]\n            sgn = 1.0 if f['s'][-1] > f['s'][0] else -1.0\n            a = _pt(f, s0)\n            b = _pt(f, s0 + sgn * (r - 1) * tread)\n            ln = Line.CreateBound(XYZ(a[0] * MMF, a[1] * MMF, zrel), XYZ(b[0] * MMF, b[1] * MMF, zrel))\n            run = StairsRun.CreateStraightRun(doc, sid, ln, StairsRunJustification.Center)\n            run.ActualRunWidth = (width_ovr if width_ovr > 0 else f['w']) * MMF\n            try:\n                if abs(run.BaseElevation - zrel) > 1e-4:\n                    run.TopElevation = zrel + r * rh\n                    run.BaseElevation = zrel\n            except Exception as ex:\n                notes.append('run elevation: {0}'.format(ex))\n            runs.append(run)\n            zrel += r * rh\n        for i in range(len(runs) - 1):\n            try:\n                StairsLanding.CreateAutomaticLanding(doc, runs[i].Id, runs[i + 1].Id)\n            except Exception as ex:\n                notes.append('landing {0}-{1} not automatic - sketch it in Edit Stairs'.format(i + 1, i + 2))\n        mark(st, tag)\n        t.Commit()\n    except Exception:\n        if t.HasStarted() and not t.HasEnded():\n            t.RollBack()\n        scope.Cancel()\n        raise\n    scope.Commit(PRE)\n    return sid, rh / MMF, notes\n\n\ntry:\n    CAD_NAME = str(IN[0] or '').strip()\n    LAYER_TXT = str(IN[1] or '').strip()\n    AUTO = LAYER_TXT.upper() in ('', 'AUTO', '*', 'ALL')\n    LAYER_KEYS = [k.strip().upper() for k in LAYER_TXT.split(',') if k.strip()]\n    BASE_LV = str(IN[2] or '').strip(); TOP_LV = str(IN[3] or '').strip()\n    TREAD = num(IN[4], 300); MAXR = num(IN[5], 150); FROM_CAD = bool(IN[6])\n    W_OVR = num(IN[7], 0); FLIP = bool(IN[8]); RAILS = bool(IN[9]); DO = bool(IN[10])\n    log('inputs: cad \"{0}\" layers {1} base \"{2}\" top \"{3}\" tread {4} maxriser {5} fromcad {6} width {7} flip {8} rails {9} run {10}'.format(\n        CAD_NAME, LAYER_KEYS, BASE_LV, TOP_LV, TREAD, MAXR, FROM_CAD, W_OVR, FLIP, RAILS, DO))\n    if not DO:\n        raise Exception('Switch on PLACE / UPDATE STAIRS, then Run')\n\n    cad = pick_cad(CAD_NAME)\n    cad_name = cad.Category.Name if cad.Category is not None else 'CAD'\n    layers = read_layers(cad)\n    STAIR_WORDS = ('STAIR', 'STRS', 'STEP', 'TREAD', 'RISER', 'STAIRCASE')\n    SKIP = ('HATCH', 'TEXT', 'DIM', 'ANNO', 'TITLE', 'GRID', 'DEFPOINTS', 'VIEWPORT', 'LEGEND', 'NPLT',\n            'AXN', 'AX-', 'BOUNDARY', 'PLOT')\n    if AUTO:\n        use = [n for n in layers if any(k in n.upper() for k in STAIR_WORDS)]\n        how = 'stair layers'\n        if not use:                               # most CADs: no stair layer -> look at every layer\n            use = [n for n in layers if not any(k in n.upper() for k in SKIP)]\n            how = 'all layers (no stair layer in this CAD)'\n    else:\n        use = [n for n in layers if any(k in n.upper() for k in LAYER_KEYS)]\n        how = 'chosen layers'\n        if not use:\n            raise Exception('No layer matching {0} in {1}. Layers: {2}'.format(\n                ', '.join(LAYER_KEYS), cad_name, ', '.join(sorted(layers))))\n    segs = [s for n in use for s in layers[n]]\n    try:                                            # geometry dump for support / tuning\n        import json as _json\n        with open(os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_stairs_debug.json'), 'w') as fh:\n            _json.dump({'cad': cad_name, 'used': use,\n                        'layers': dict((n, [[[round(a[0]), round(a[1])], [round(b[0]), round(b[1])]] for a, b in v])\n                                       for n, v in layers.items())}, fh)\n    except Exception as ex:\n        log('debug dump failed: ' + str(ex))\n    flights = find_flights(segs, min_lines=(6 if how.startswith('all') else 3))\n    if not flights:\n        raise Exception('No stair found ({0}): a flight = 6+ parallel tread lines, same length (600-2500 mm), '\n                        'evenly 90-420 mm apart. Type the stair layer name if it is a block. Layers: {1}'.format(\n                            how, ', '.join(sorted(layers))))\n    stairs = group_stairs(flights)\n    if TREAD <= 0:\n        TREAD = round(sum(f['spacing'] for f in flights) / len(flights) / 5.0) * 5.0\n\n    base = parse_levels(BASE_LV)[0] if BASE_LV else cad_level(cad)\n    if TOP_LV:\n        top = parse_levels(TOP_LV)[0]\n    else:\n        above = [l for l in LEVELS if l.ProjectElevation > base.ProjectElevation + 0.01]\n        if not above:\n            raise Exception('No level above {0} - add the next floor level or type the top level'.format(base.Name))\n        top = above[0]\n    chain = [l for l in LEVELS if base.ProjectElevation - 0.01 <= l.ProjectElevation <= top.ProjectElevation + 0.01]\n    storeys = [(chain[i], chain[i + 1]) for i in range(len(chain) - 1)]\n    if not storeys:\n        raise Exception('Top level must be above the base level')\n\n    # remove the stairs this tool made from this CAD before (update = rebuild)\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    old = [e for e in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Stairs).WhereElementIsNotElementType()\n           if tagged(e).startswith(STAIR_TAG + '|' + cad_name + '|')]\n    for e in old:\n        doc.Delete(e.Id)\n    TransactionManager.Instance.ForceCloseTransaction()\n\n    widths = [W_OVR if W_OVR > 0 else f['w'] for st_ in stairs for f in st_]\n    max_rh = 0.0\n    for st_ in stairs:\n        fl = order_stair(st_, segs, FLIP)\n        for b, t_ in storeys:\n            H = (t_.ProjectElevation - b.ProjectElevation) / MMF\n            max_rh = max(max_rh, H / max(1, sum(risers_per_flight(fl, H, MAXR, FROM_CAD))))\n    tt = Transaction(doc, 'CAD2BIM stair type')\n    tt.Start()\n    stype = stair_type(max_rh, TREAD, min(widths))\n    try:\n        doc.SetDefaultElementTypeId(ElementTypeGroup.StairsType, stype.Id)\n    except Exception as ex:\n        log('default stair type: ' + str(ex))\n    rtype = railing_type() if RAILS else None\n    tt.Commit()\n\n    out.append('CAD2BIM STAIRS FROM CAD  -  DONE')\n    out.append('CAD {0}'.format(cad_name))\n    out.append('Searched {0}  ->  {1} stair(s), {2} flight(s) of {3} tread lines, CAD spacing {4} mm'.format(\n        how, len(stairs), len(flights), '/'.join(str(len(f['s'])) for f in flights),\n        '/'.join('{0:.0f}'.format(f['spacing']) for f in flights)))\n    made, rails, warn = 0, 0, []\n    for k, st_ in enumerate(stairs):\n        fl = order_stair(st_, segs, FLIP)\n        for b, t_ in storeys:\n            H = (t_.ProjectElevation - b.ProjectElevation) / MMF\n            rs = risers_per_flight(fl, H, MAXR, FROM_CAD)\n            try:\n                sid, rh, notes = build_stair(b, t_, fl, rs, TREAD, W_OVR, stype,\n                                             '{0}|{1}|{2}|{3}'.format(STAIR_TAG, cad_name, k + 1, b.Name))\n                made += 1\n                line = '  stair {0}  {1} -> {2}  H {3:.0f}  |  {4} flight(s) {5} risers  |  riser {6:.1f} x tread {7:.0f}'.format(\n                    k + 1, b.Name, t_.Name, H, len(fl), '+'.join(str(r) for r in rs), rh, TREAD)\n                out.append(line)\n                if rh > MAXR + 0.5:\n                    warn.append('stair {0} {1}: riser {2:.1f} > max {3:.0f} - switch off \"risers from CAD\" to add risers'.format(\n                        k + 1, b.Name, rh, MAXR))\n                cadsp = [f['spacing'] for f in fl]\n                if any(abs(sp - TREAD) > 15 for sp in cadsp):\n                    warn.append('stair {0}: CAD tread spacing {1} mm, built with {2:.0f} mm'.format(\n                        k + 1, '/'.join('{0:.0f}'.format(sp) for sp in cadsp), TREAD))\n                warn.extend('stair {0} {1}: {2}'.format(k + 1, b.Name, n) for n in notes)\n                if rtype is not None:\n                    tr = Transaction(doc, 'CAD2BIM handrails')\n                    tr.Start()\n                    try:\n                        ids = Railing.Create(doc, sid, rtype.Id, RailingPlacementPosition.Treads)\n                        rails += ids.Count\n                        tr.Commit()\n                    except Exception as ex:\n                        tr.RollBack()\n                        if 'already has associated railings' in str(ex):\n                            rails += 2                        # Revit added them automatically\n                        else:\n                            warn.append('handrails stair {0}: {1}'.format(k + 1, str(ex).split(chr(10))[0]))\n            except Exception as ex:\n                log(traceback.format_exc())\n                warn.append('stair {0} {1}->{2} FAILED: {3}'.format(k + 1, b.Name, t_.Name, ex))\n    out.insert(1, 'Stairs placed : {0}  ({1} storey(s) each)  |  type {2}  |  handrails {3}{4}'.format(\n        made, len(storeys), tname(stype), rails, (' (' + tname(rtype) + ')') if rtype is not None else ''))\n    if old:\n        out.append('Replaced {0} stair(s) from the previous run'.format(len(old)))\n    if warn:\n        out.append('Check:')\n        out.extend('  - ' + w for w in warn[:15])\n    out.append('Wrong way up? switch \"Flip direction\" and Run again.  Save / Sync with Central.')\nexcept Exception as ex:\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n    out.insert(0, 'FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nOUT = out\n",
