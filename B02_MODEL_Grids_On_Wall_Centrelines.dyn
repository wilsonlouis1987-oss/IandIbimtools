    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - GRIDS FROM WALLS (professional)\n#  select walls -> a grid on the CENTRE of every wall line\n#  VERTICAL walls -> numbers 1,2,3 .. (left -> right)   HORIZONTAL walls -> letters A,B,C .. (bottom -> top, no I / O)\n#  walls on the same line share one grid; grids span the whole building + extension; bubbles, dash-dot line,\n#  ISO grid dimensions. Re-run = grids updated / renamed, never doubled.\nimport os\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\ndef log(msg):\n    try:\n        with open(LOG, 'a') as fh:\n            fh.write(str(msg) + '\\n')\n    except Exception:\n        pass\nlog('--- grids from walls v2 started')\nimport clr, math, traceback\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Architecture import *        # Stairs, StairsRun, StairsLanding, Railing ...\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\nMMF = 1.0 / 304.8\nCOL_PARAMS = [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')]\nout = []\n\n\ndef num(v, d=0.0):\n    try:\n        return float(v)\n    except Exception:\n        return d\n\n\ndef f(v):\n    return '{0:.0f}'.format(v)\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\n_CAT = {}\ndef catid(bic):\n    if bic not in _CAT:\n        _CAT[bic] = idv(Category.GetCategory(doc, bic).Id)\n    return _CAT[bic]\n\n\ndef cat_is(e, bic):\n    return e is not None and e.Category is not None and idv(e.Category.Id) == catid(bic)\n\n\ndef tname(t):\n    p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\n\ndef setp(e, bip, val):\n    p = e.get_Parameter(bip)\n    if p is not None and not p.IsReadOnly:\n        p.Set(val)\n        return True\n    return False\n\n\ndef getd(e, bip):\n    p = e.get_Parameter(bip)\n    return p.AsDouble() if p is not None else None\n\n\ndef getlvl(e, bip):\n    p = e.get_Parameter(bip)\n    if p is None:\n        return None\n    x = doc.GetElement(p.AsElementId())\n    return x if isinstance(x, Level) else None\n\n\n\n\ndef _letters(start='A', skip=('I', 'O')):\n    alpha = [c for c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' if c not in skip]\n    seq = alpha + [a + b for a in alpha for b in alpha]\n    i = seq.index(start.upper()) if start.upper() in seq else 0\n    return seq[i:]\n\n\ndef collinear(g, p, q):\n    \"\"\"existing Revit grid on the same line as p-q (mm)?\"\"\"\n    cv = g.Curve\n    if not isinstance(cv, Line):\n        return False\n    a, b = cv.GetEndPoint(0), cv.GetEndPoint(1)\n    d1 = (b.X - a.X, b.Y - a.Y); L1 = math.hypot(*d1)\n    d2 = (q[0] - p[0], q[1] - p[1]); L2 = math.hypot(*d2)\n    if L1 < 1e-9 or L2 < 1e-9:\n        return False\n    cross = abs(d1[0] * d2[1] - d1[1] * d2[0]) / (L1 * L2)\n    if cross > 0.01:\n        return False\n    px, py = p[0] * MMF - a.X, p[1] * MMF - a.Y\n    return abs(px * d1[1] - py * d1[0]) / L1 < 50.0 * MMF\n\n\ndef grid_type(both, phantom):\n    gts = list(FilteredElementCollector(doc).OfClass(GridType))\n    if not gts:\n        return None\n    name = 'CAD2BIM Grid'\n    gt = [t for t in gts if tname(t) == name]\n    gt = gt[0] if gt else gts[0].Duplicate(name)\n    for bip, val in ((BuiltInParameter.GRID_BUBBLE_END_1, 1), (BuiltInParameter.GRID_BUBBLE_END_2, 1 if both else 0)):\n        try:\n            setp(gt, bip, val)\n        except Exception:\n            pass\n    if phantom:\n        pats = list(FilteredElementCollector(doc).OfClass(LinePatternElement))\n        pat = None\n        for k in ('PHANTOM', 'CENTER', 'CENTRE', 'DASH DOT', 'DASH-DOT'):\n            pat = next((p for p in pats if k in p.Name.upper()), None)\n            if pat is not None:\n                break\n        if pat is not None:\n            for bip in ('GRID_CENTER_SEGMENT_PATTERN', 'GRID_END_SEGMENT_PATTERN'):\n                try:\n                    setp(gt, getattr(BuiltInParameter, bip), pat.Id)\n                except Exception:\n                    pass\n            try:\n                setp(gt, BuiltInParameter.GRID_CENTER_SEGMENT_STYLE, 0)      # continuous line, dash-dot pattern\n            except Exception:\n                pass\n    return gt\n\n\ndef iso_dim_type(name, text_mm=2.5):\n    lin = [t for t in FilteredElementCollector(doc).OfClass(DimensionType) if t.StyleType == DimensionStyleType.Linear]\n    for t in lin:\n        if tname(t) == name:\n            dt = t\n            break\n    else:\n        if not lin:\n            return None\n        dt = lin[0].Duplicate(name)\n    def sp(pname, val):\n        p = dt.LookupParameter(pname)\n        if p is not None and not p.IsReadOnly:\n            try:\n                p.Set(val)\n            except Exception:\n                pass\n    sp('Text Size', text_mm * MMF)\n    sp('Text Font', 'Arial')\n    sp('Width Factor', 1.0)\n    sp('Text Offset', 1.0 * MMF)\n    sp('Witness Line Gap to Element', 2.0 * MMF)\n    sp('Witness Line Extension', 2.0 * MMF)\n    sp('Dimension Line Extension', 2.0 * MMF)\n    try:\n        ticks = [a for a in FilteredElementCollector(doc).OfClass(ElementType)\n                 if a.Category is None and 'DIAGONAL' in tname(a).upper()]\n        ticks.sort(key=lambda a: ('3MM' not in tname(a).upper().replace(' ', ''), len(tname(a))))\n        if ticks:\n            sp('Tick Mark', ticks[0].Id)\n    except Exception:\n        pass\n    try:\n        fo = FormatOptions(UnitTypeId.Millimeters)\n        fo.UseDefault = False\n        fo.Accuracy = 1.0\n        dt.SetUnitsFormatOptions(fo)\n    except Exception as ex:\n        log('dim units: ' + str(ex))\n    return dt\n\n\ndef grid_dims(view, dt, off_mm, gap_mm):\n    \"\"\"chain (grid to grid) + overall dimension for each grid direction, between the grids and the bubbles\"\"\"\n    z = view.GenLevel.ProjectElevation if view.GenLevel is not None else 0.0\n    sc = max(1, view.Scale) * MMF\n    groups = {}\n    for g in FilteredElementCollector(doc, view.Id).OfClass(Grid):\n        cv = g.Curve\n        if isinstance(cv, Line):\n            d = cv.Direction\n            a = round(math.degrees(math.atan2(d.Y, d.X)) % 180.0) % 180\n            groups.setdefault(a, []).append(g)\n    made = 0\n    keys = list(groups)\n    for a in keys:\n        gs = groups[a]\n        if len(gs) < 2:\n            continue\n        d = XYZ(math.cos(math.radians(a)), math.sin(math.radians(a)), 0)\n        n = XYZ(-d.Y, d.X, 0)\n        lst = sorted([(g.Curve.GetEndPoint(0).DotProduct(n), g) for g in gs], key=lambda t: t[0])\n        perp = [g for k in keys if k != a for g in groups[k]]\n        if perp:\n            ts = [g.Curve.GetEndPoint(0).DotProduct(d) for g in perp]\n            edge = min(ts)\n        else:\n            edge = min(min(g.Curve.GetEndPoint(0).DotProduct(d), g.Curve.GetEndPoint(1).DotProduct(d)) for _, g in lst) + 2000 * MMF\n        for k, extra in ((0, 0.0), (1, gap_mm)):\n            t = edge - (off_mm + extra) * sc\n            p = d.Multiply(t).Add(n.Multiply(lst[0][0] - 1.0))\n            q = d.Multiply(t).Add(n.Multiply(lst[-1][0] + 1.0))\n            ra = ReferenceArray()\n            for _, g in (lst if k == 0 else [lst[0], lst[-1]]):\n                ra.Append(Reference(g))\n            try:\n                doc.Create.NewDimension(view, Line.CreateBound(XYZ(p.X, p.Y, z), XYZ(q.X, q.Y, z)), ra, dt)\n                made += 1\n            except Exception as ex:\n                log('grid dim {0}: {1}'.format(view.Name, ex))\n    return made\n\n\n# ------------------------------------------------------------------ wall centre lines\ndef plane_dist(face, p):\n    o, n = face.Origin, face.FaceNormal\n    return (p.X - o.X) * n.X + (p.Y - o.Y) * n.Y + (p.Z - o.Z) * n.Z\n\n\ndef side_face(w, side):\n    best = None\n    try:\n        for r in HostObjectUtils.GetSideFaces(w, side):\n            fc = w.GetGeometryObjectFromReference(r)\n            if isinstance(fc, PlanarFace) and (best is None or fc.Area > best.Area):\n                best = fc\n    except Exception as ex:\n        log('side face {0}: {1}'.format(idv(w.Id), ex))\n    return best\n\n\ndef centre_line(w):\n    \"\"\"(p, q) in mm on the CENTRE of the wall thickness (whatever its location line), None for curved walls\"\"\"\n    lc = w.Location\n    if lc is None or not isinstance(lc.Curve, Line):\n        return None\n    p0, p1 = lc.Curve.GetEndPoint(0), lc.Curve.GetEndPoint(1)\n    d = lc.Curve.Direction\n    shift, how = None, ''\n    fe, fi = side_face(w, ShellLayerType.Exterior), side_face(w, ShellLayerType.Interior)\n    if fe is not None and fi is not None:\n        ne = fe.FaceNormal\n        if abs(ne.X * d.X + ne.Y * d.Y) < 0.01:\n            sE, sI = plane_dist(fe, p0), plane_dist(fi, p0)\n            s = (-sE + sI) / 2.0\n            if abs(s) <= w.Width + 1e-6:\n                shift, how, nrm = s, 'faces', ne\n    if shift is None:                                     # location line parameter\n        o = w.Orientation\n        nrm = o\n        try:\n            k = w.get_Parameter(BuiltInParameter.WALL_KEY_REF_PARAM).AsInteger()\n        except Exception:\n            k = 0\n        shift = {2: -w.Width / 2.0, 3: w.Width / 2.0}.get(k, 0.0)\n        how = 'location line {0}'.format(k)\n    c0 = XYZ(p0.X + nrm.X * shift, p0.Y + nrm.Y * shift, 0)\n    c1 = XYZ(p1.X + nrm.X * shift, p1.Y + nrm.Y * shift, 0)\n    return (c0.X / MMF, c0.Y / MMF), (c1.X / MMF, c1.Y / MMF), how\n\n\ndef group_lines(segs, tol_mm):\n    \"\"\"segs: [(p, q, wall)] -> list of groups on one straight line {'d':(dx,dy), 'o':(x,y), 'segs':[...]}\"\"\"\n    groups = []\n    for p, q, w in segs:\n        dx, dy = q[0] - p[0], q[1] - p[1]\n        L = math.hypot(dx, dy)\n        if L < 1.0:\n            continue\n        dx, dy = dx / L, dy / L\n        horiz = abs(dx) >= abs(dy)\n        if (horiz and dx < 0) or (not horiz and dy < 0):  # H lines point +X, V lines point +Y\n            dx, dy = -dx, -dy\n        for g in groups:\n            gd = g['d']\n            if abs(gd[0] * dy - gd[1] * dx) > math.sin(math.radians(1.0)):\n                continue\n            mx, my = (p[0] + q[0]) / 2.0, (p[1] + q[1]) / 2.0\n            off = abs((mx - g['o'][0]) * gd[1] - (my - g['o'][1]) * gd[0])\n            if off <= tol_mm:\n                g['segs'].append((p, q, w))\n                break\n        else:\n            groups.append({'d': (dx, dy), 'o': ((p[0] + q[0]) / 2.0, (p[1] + q[1]) / 2.0), 'segs': [(p, q, w)],\n                           'h': horiz})\n    for g in groups:                                      # line through the average position of its walls\n        d = g['d']\n        n = (-d[1], d[0])\n        offs = [((p[0] + q[0]) / 2.0 * n[0] + (p[1] + q[1]) / 2.0 * n[1]) for p, q, _ in g['segs']]\n        g['n'] = n\n        g['off'] = sum(offs) / len(offs)\n    return groups\n\n\ntry:\n    SEL_ONLY = bool(IN[0]); SKIP_ANG = bool(IN[1]); IN = [IN[0]] + list(IN[2:])\n    NUM_START = int(num(IN[1], 1)); LET_START = (str(IN[2] or 'A').strip() or 'A')\n    LET_BOTTOM, NUM_LEFT, SKIP_IO = bool(IN[3]), bool(IN[4]), bool(IN[5])\n    EXT, FULL, TOL = num(IN[6], 1500), bool(IN[7]), num(IN[8], 100)\n    BOTH, PHANTOM = bool(IN[9]), bool(IN[10])\n    DIMS, D_OFF, D_GAP = bool(IN[11]), num(IN[12], 10), num(IN[13], 8)\n    CLEAN, DO = bool(IN[14]), bool(IN[15])\n    log('inputs: sel {0} start {1}/{2} letters_bottom {3} numbers_left {4} skipIO {5} ext {6} full {7} tol {8} '\n        'both {9} phantom {10} dims {11} clean {12} run {13}'.format(SEL_ONLY, NUM_START, LET_START, LET_BOTTOM, NUM_LEFT,\n                                                                    SKIP_IO, EXT, FULL, TOL, BOTH, PHANTOM, DIMS, CLEAN, DO))\n    if not DO:\n        raise Exception('Switch on PLACE / UPDATE GRIDS, then Run')\n    if SEL_ONLY:\n        cand = [doc.GetElement(i) for i in uidoc.Selection.GetElementIds()]\n        scope = 'selected walls'\n    else:\n        cand = list(FilteredElementCollector(doc, doc.ActiveView.Id).OfClass(Wall))\n        scope = 'walls in view \"{0}\"'.format(doc.ActiveView.Name)\n    walls = [w for w in cand if isinstance(w, Wall)]\n    if not walls:\n        raise Exception('No walls ' + ('selected - select the walls in the plan first, then Run' if SEL_ONLY\n                                       else 'in the active view'))\n    segs, curved, angled, hows = [], 0, 0, {}\n    for w in walls:\n        r = centre_line(w)\n        if r is None:\n            curved += 1\n            continue\n        dx, dy = r[1][0] - r[0][0], r[1][1] - r[0][1]\n        a = abs(math.degrees(math.atan2(dy, dx))) % 90.0\n        if SKIP_ANG and 5.0 < a < 85.0:\n            angled += 1\n            continue\n        segs.append((r[0], r[1], w))\n        hows[r[2]] = hows.get(r[2], 0) + 1\n    # building extents = ALL straight walls in the view (so grids of a partial selection still span the building)\n    bpts = []\n    for w in FilteredElementCollector(doc, doc.ActiveView.Id).OfClass(Wall):\n        lc = w.Location\n        if lc is not None and isinstance(lc.Curve, Line):\n            for k in (0, 1):\n                e = lc.Curve.GetEndPoint(k)\n                bpts.append((e.X / MMF, e.Y / MMF))\n    groups = group_lines(segs, TOL)\n    if not groups:\n        raise Exception('No straight walls found ({0} curved, {1} angled walls skipped)'.format(curved, angled))\n\n    # ---- names: vertical -> numbers left -> right, horizontal -> letters bottom -> top\n    vert = sorted([g for g in groups if not g['h']], key=lambda g: g['off'] * (-1 if g['n'][0] < 0 else 1))\n    hor = sorted([g for g in groups if g['h']], key=lambda g: g['off'] * (1 if g['n'][1] > 0 else -1))\n    # (off is measured along the normal; the sign fix makes it 'x' for vertical and 'y' for horizontal lines)\n    if not NUM_LEFT:\n        vert = vert[::-1]\n    if not LET_BOTTOM:\n        hor = hor[::-1]\n    letters = _letters(LET_START, ('I', 'O') if SKIP_IO else ())\n    named = [(str(NUM_START + i), g) for i, g in enumerate(vert)] + \\\n            [(letters[i % len(letters)], g) for i, g in enumerate(hor)]\n\n    # ---- extents\n    allpts = bpts or [pt for p, q, _ in segs for pt in (p, q)]\n    for name, g in named:\n        d, n, off = g['d'], g['n'], g['off']\n        pts = allpts if FULL else [pt for p, q, _ in g['segs'] for pt in (p, q)]\n        ts = [pt[0] * d[0] + pt[1] * d[1] for pt in pts]\n        t0, t1 = min(ts) - EXT, max(ts) + EXT\n        g['p'] = (d[0] * t0 + n[0] * off, d[1] * t0 + n[1] * off)\n        g['q'] = (d[0] * t1 + n[0] * off, d[1] * t1 + n[1] * off)\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    gt = grid_type(BOTH, PHANTOM)\n    existing = list(FilteredElementCollector(doc).OfClass(Grid))\n    used, made, reused, renamed_old, removed = set(), 0, 0, [], 0\n    result = []\n    for name, g in named:\n        p, q = g['p'], g['q']\n        hit = next((e for e in existing if idv(e.Id) not in used and collinear(e, p, q)), None)\n        line = Line.CreateBound(XYZ(p[0] * MMF, p[1] * MMF, 0), XYZ(q[0] * MMF, q[1] * MMF, 0))\n        if hit is None:\n            hit = Grid.Create(doc, line)\n            made += 1\n        else:\n            reused += 1\n            try:                                      # stretch the old grid to the new extents\n                if not hit.IsCurved:\n                    hit.SetCurveInView(DatumExtentType.Model, doc.ActiveView, line)\n            except Exception as ex:\n                log('extend grid {0}: {1}'.format(hit.Name, ex))\n        used.add(idv(hit.Id))\n        if gt is not None and idv(hit.GetTypeId()) != idv(gt.Id):\n            try:\n                hit.ChangeTypeId(gt.Id)\n            except Exception:\n                setp(hit, BuiltInParameter.ELEM_TYPE_PARAM, gt.Id)\n        result.append((hit, name))\n    want = set(n for _, n in result)\n    for e in existing:\n        if idv(e.Id) in used:\n            continue\n        if CLEAN:\n            try:\n                doc.Delete(e.Id)\n                removed += 1\n                continue\n            except Exception:\n                pass\n        if e.Name in want:\n            k = 1\n            while True:\n                nn = '{0}-OLD{1}'.format(e.Name, '' if k == 1 else k)\n                if not any(x.Name == nn for x in existing):\n                    break\n                k += 1\n            renamed_old.append('{0} -> {1}'.format(e.Name, nn))\n            e.Name = nn\n    for i, (e, _) in enumerate(result):              # two steps so swapped names never clash\n        e.Name = 'tmp_cad2bim_{0}'.format(i)\n    for e, n in result:\n        e.Name = n\n    n_dims, n_views = 0, 0\n    if DIMS:\n        doc.Regenerate()\n        dt = iso_dim_type('CAD2BIM ISO 2.5 Grid')\n        if dt is not None:\n            for v in FilteredElementCollector(doc).OfClass(ViewPlan):\n                if v.IsTemplate or v.ViewType not in (ViewType.FloorPlan, ViewType.EngineeringPlan):\n                    continue\n                for dm in list(FilteredElementCollector(doc, v.Id).OfClass(Dimension)):\n                    try:\n                        if idv(dm.GetTypeId()) == idv(dt.Id):\n                            doc.Delete(dm.Id)          # re-run: replace, never stack\n                    except Exception:\n                        pass\n                m = grid_dims(v, dt, D_OFF, D_GAP)\n                if m:\n                    n_dims += m\n                    n_views += 1\n    TransactionManager.Instance.TransactionTaskDone()\n\n    out.append('CAD2BIM GRIDS FROM WALLS  -  DONE  ({0})'.format(scope))\n    out.append('Walls: {0} -> {1} grid lines on the wall centres{2}{3}'.format(\n        len(walls), len(named), ', {0} curved walls skipped'.format(curved) if curved else '',\n        ', {0} angled walls skipped'.format(angled) if angled else ''))\n    out.append('Numbers (vertical walls, {0}) : {1}'.format('left -> right' if NUM_LEFT else 'right -> left',\n                                                           ', '.join(n for n, _ in named[:len(vert)])))\n    out.append('Letters (horizontal walls, {0}) : {1}'.format('bottom -> top' if LET_BOTTOM else 'top -> bottom',\n                                                             ', '.join(n for n, _ in named[len(vert):])))\n    out.append('Grids: {0} new, {1} updated (same line already had a grid){2}'.format(\n        made, reused, ', {0} other grids removed'.format(removed) if removed else ''))\n    skew = [n for n, g in named if min(abs(g['d'][0]), abs(g['d'][1])) > math.sin(math.radians(1.0))]\n    if skew:\n        out.append('Angled walls (grid follows the wall angle): ' + ', '.join(skew))\n    if renamed_old:\n        out.append('Renamed old grids that used these names: ' + '; '.join(renamed_old[:10]))\n    if DIMS:\n        out.append('Dimensions: {0} (grid-to-grid + overall) in {1} plan views - ISO 2.5 mm Arial, oblique ticks, mm'.format(\n            n_dims, n_views))\n    if not vert or not hor:\n        out.append('NOTE: only {0} walls in this run. To add the {1} grids: select those walls, change any input '\n                   '(e.g. switch PLACE / UPDATE GRIDS off and on) and Run - Dynamo only runs again when an input '\n                   'changes.'.format('horizontal' if not vert else 'vertical', 'number' if not vert else 'letter'))\n    out.append('Centre found by: ' + ', '.join('{0} {1}'.format(v, k) for k, v in hows.items()))\nexcept Exception as ex:\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n    out.insert(0, 'FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nOUT = out\n",
      "Engine": "CPython3",
