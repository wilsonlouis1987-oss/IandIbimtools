      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "8252e30b58c241ed9cef7a02c5d0c0e4",
      "Name": "DELETE Revit levels whose row was removed from the Excel  (levels with walls etc. on them are kept)",
      "Type": "boolean",
