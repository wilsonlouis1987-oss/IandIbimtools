    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =====================================================================\n#  A09  CLIENT BIM REQUIREMENTS  ->  REVIT PROJECT SETUP + BEP / ISO 19650 CHECKS\n#  Svarda Design - SD Tools.   Part 1: read + analyse the client documents, report.\n#  Reads PDF, XLSX/XLSM, DOCX, CSV, TXT/MD from one folder (sub-folders too):\n#  BEP / EIR, BIM execution schedule (MIDP/TIDP), AIR, COBie template, FM asset\n#  information package, ISO 19650 checklist, workflow packages, material register.\n#  Runs in Dynamo CPython3 and in IronPython (no f-strings).\n# =====================================================================\nimport os, re, io, json, zipfile, zlib, difflib, datetime, traceback, subprocess, sys\nimport xml.etree.ElementTree as ET\n\ntry:\n    basestring\nexcept NameError:\n    basestring = str\ntry:\n    unicode\nexcept NameError:\n    unicode = str\n\nLOG = []\n\n\ndef log(msg):\n    try:\n        LOG.append(unicode(msg))\n    except Exception:\n        LOG.append(repr(msg))\n\n\ndef _s(v):\n    if v is None:\n        return ''\n    if isinstance(v, float) and v == int(v):\n        v = int(v)\n    try:\n        return unicode(v).strip()\n    except Exception:\n        return str(v).strip()\n\n\ndef norm(s):\n    s = _s(s).lower()\n    s = re.sub(r'[^a-z0-9]+', ' ', s)\n    return ' '.join(s.split())\n\n\nSPELL = [('centre', 'center'), ('metre', 'meter'), ('millimetre', 'millimeter'), ('colour', 'color'),\n         ('organisation', 'organization'), ('programme', 'program'), ('authorised', 'authorized'),\n         ('aluminium', 'aluminum')]\n\n\ndef norm_spell(s):\n    s = ' ' + norm(s) + ' '\n    for a, b in SPELL:\n        s = s.replace(a, b)\n    return s.strip()\n\n\ndef key(s):\n    return re.sub(r'[^a-z0-9]', '', _s(s).lower())\n\n\n# ===================================================================== readers\nNS_X = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'\nNS_R = '{http://schemas.openxmlformats.org/officeDocument/2006/relationships}'\nNS_W = '{http://schemas.openxmlformats.org/wordprocessingml/2006/main}'\n\n\ndef _col_index(ref):\n    m = re.match(r'([A-Z]+)', ref or '')\n    if not m:\n        return None\n    n = 0\n    for ch in m.group(1):\n        n = n * 26 + (ord(ch) - 64)\n    return n - 1\n\n\ndef read_xlsx(path):\n    \"\"\"-> list of (sheet name, rows as lists of strings)\"\"\"\n    z = zipfile.ZipFile(path)\n    names = z.namelist()\n    shared = []\n    if 'xl/sharedStrings.xml' in names:\n        root = ET.fromstring(z.read('xl/sharedStrings.xml'))\n        for si in root.findall(NS_X + 'si'):\n            shared.append(''.join([t_.text or '' for t_ in si.iter(NS_X + 't')]))\n    wb = ET.fromstring(z.read('xl/workbook.xml'))\n    rels = {}\n    try:\n        rr = ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))\n        for r in rr:\n            rels[r.get('Id')] = r.get('Target')\n    except Exception:\n        pass\n    out = []\n    sheets = wb.find(NS_X + 'sheets')\n    for i, sh in enumerate(sheets if sheets is not None else []):\n        title = sh.get('name')\n        rid = sh.get(NS_R + 'id')\n        target = rels.get(rid, 'worksheets/sheet%d.xml' % (i + 1))\n        target = target.lstrip('/')\n        if not target.startswith('xl/'):\n            target = 'xl/' + target\n        if target not in names:\n            continue\n        root = ET.fromstring(z.read(target))\n        rows = []\n        for row in root.iter(NS_X + 'row'):\n            cells = {}\n            for c in row.findall(NS_X + 'c'):\n                idx = _col_index(c.get('r'))\n                if idx is None:\n                    idx = len(cells)\n                t = c.get('t')\n                val = ''\n                if t == 'inlineStr':\n                    val = ''.join([x_.text or '' for x_ in c.iter(NS_X + 't')])\n                else:\n                    v = c.find(NS_X + 'v')\n                    if v is not None and v.text is not None:\n                        val = v.text\n                        if t == 's':\n                            try:\n                                val = shared[int(val)]\n                            except Exception:\n                                pass\n                        elif t == 'b':\n                            val = 'TRUE' if val == '1' else 'FALSE'\n                        elif t is None or t == 'n':\n                            try:\n                                f = float(val)\n                                val = _s(f) if f == int(f) else _s(round(f, 6))\n                            except Exception:\n                                pass\n                cells[idx] = _s(val)\n            if cells:\n                n = max(cells.keys()) + 1\n                rows.append([cells.get(k_, '') for k_ in range(n)])\n            else:\n                rows.append([])\n        out.append((title, rows))\n    z.close()\n    return out\n\n\ndef read_docx(path):\n    \"\"\"-> blocks: ('h', text) headings, ('p', text) paragraphs, ('t', rows) tables - in document order\"\"\"\n    z = zipfile.ZipFile(path)\n    root = ET.fromstring(z.read('word/document.xml'))\n    z.close()\n    body = root.find(NS_W + 'body')\n    blocks = []\n\n    def ptext(p):\n        return ''.join([t_.text or '' for t_ in p.iter(NS_W + 't')]).strip()\n\n    for el in list(body):\n        if el.tag == NS_W + 'p':\n            txt = ptext(el)\n            if not txt:\n                continue\n            style = ''\n            ppr = el.find(NS_W + 'pPr')\n            if ppr is not None:\n                ps = ppr.find(NS_W + 'pStyle')\n                if ps is not None:\n                    style = (ps.get(NS_W + 'val') or '').lower()\n            blocks.append(('h' if ('heading' in style or style == 'title') else 'p', txt))\n        elif el.tag == NS_W + 'tbl':\n            rows = []\n            for tr in el.iter(NS_W + 'tr'):\n                rows.append([' '.join([ptext(p_) for p_ in tc_.iter(NS_W + 'p')]).strip() for tc_ in tr.findall(NS_W + 'tc')])\n            blocks.append(('t', rows))\n    return blocks\n\n\nPDF_HELPER = r'''\nimport sys\nfrom pypdf import PdfReader\nr = PdfReader(sys.argv[1])\nout = []\nfor p in r.pages:\n    try:\n        out.append(p.extract_text() or '')\n    except Exception:\n        out.append('')\nsys.stdout.buffer.write('\\n\\f\\n'.join(out).encode('utf-8'))\n'''\n\n\ndef _find_python():\n    cands = []\n    try:\n        import shutil\n        for n in ('python', 'python3', 'py'):\n            p = shutil.which(n)\n            if p and 'WindowsApps' not in p:\n                cands.append(p)\n    except Exception:\n        pass\n    base = os.path.join(os.environ.get('LOCALAPPDATA', ''), 'Programs', 'Python')\n    if os.path.isdir(base):\n        for d in sorted(os.listdir(base), reverse=True):\n            p = os.path.join(base, d, 'python.exe')\n            if os.path.isfile(p):\n                cands.append(p)\n    for d in ('C:\\\\Python312', 'C:\\\\Python311', 'C:\\\\Python310', 'C:\\\\Program Files\\\\Python312'):\n        p = os.path.join(d, 'python.exe')\n        if os.path.isfile(p):\n            cands.append(p)\n    return cands\n\n\ndef read_pdf(path):\n    \"\"\"-> (text, method).  pypdf in this Python  ->  pypdf in the PC's normal Python  ->  built-in basic reader\"\"\"\n    try:\n        from pypdf import PdfReader\n        r = PdfReader(path)\n        return '\\n\\f\\n'.join([(p_.extract_text() or '') for p_ in r.pages]), 'pypdf'\n    except Exception:\n        pass\n    for py in _find_python():\n        try:\n            flags = 0x08000000 if os.name == 'nt' else 0\n            p = subprocess.Popen([py, '-I', '-c', PDF_HELPER, path], stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n                                 creationflags=flags)\n            o, e = p.communicate()\n            if p.returncode == 0 and o:\n                return o.decode('utf-8', 'replace'), 'pypdf (' + os.path.basename(os.path.dirname(py)) + ')'\n        except Exception:\n            continue\n    try:\n        return basic_pdf_text(path), 'basic reader - CHECK the result'\n    except Exception as ex:\n        return '', 'FAILED: ' + str(ex)\n\n\n# ---- minimal PDF text reader (no libraries): Flate streams, ToUnicode cmaps, Tj/TJ text\ndef _pdf_objects(data):\n    objs = {}\n    for m in re.finditer(br'(\\d+)\\s+(\\d+)\\s+obj\\b(.*?)\\bendobj', data, re.S):\n        objs[int(m.group(1))] = m.group(3)\n    return objs\n\n\ndef _pdf_stream(body):\n    m = re.search(br'stream\\r?\\n(.*?)\\r?\\n?endstream', body, re.S)\n    if not m:\n        return b''\n    raw = m.group(1)\n    if b'FlateDecode' in body.split(b'stream')[0]:\n        try:\n            return zlib.decompress(raw)\n        except Exception:\n            try:\n                return zlib.decompressobj().decompress(raw)\n            except Exception:\n                return b''\n    return raw\n\n\ndef _hexbytes(h):\n    h = re.sub(br'[^0-9A-Fa-f]', b'', h)\n    if len(h) % 2:\n        h += b'0'\n    return bytearray([int(h[i_:i_ + 2], 16) for i_ in range(0, len(h), 2)])\n\n\ndef _parse_cmap(txt):\n    cmap = {}\n    width = 1\n    for blk in re.findall(br'beginbfchar(.*?)endbfchar', txt, re.S):\n        for a, b in re.findall(br'<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>', blk):\n            width = max(width, len(a) // 2)\n            cmap[int(a, 16)] = _hexbytes(b)\n    for blk in re.findall(br'beginbfrange(.*?)endbfrange', txt, re.S):\n        for m in re.finditer(br'<([0-9A-Fa-f]+)>\\s*<([0-9A-Fa-f]+)>\\s*(<[0-9A-Fa-f]+>|\\[[^\\]]*\\])', blk):\n            lo, hi = int(m.group(1), 16), int(m.group(2), 16)\n            width = max(width, len(m.group(1)) // 2)\n            dst = m.group(3)\n            if dst.startswith(b'['):\n                items = re.findall(br'<([0-9A-Fa-f]+)>', dst)\n                for i, it in enumerate(items):\n                    cmap[lo + i] = _hexbytes(it)\n            else:\n                base = _hexbytes(dst[1:-1])\n                bv = 0\n                for x in base:\n                    bv = bv * 256 + x\n                for c in range(lo, min(hi, lo + 4000) + 1):\n                    v = bv + (c - lo)\n                    bb = bytearray()\n                    n = max(2, len(base))\n                    for k in range(n - 1, -1, -1):\n                        bb.append((v >> (8 * k)) & 255)\n                    cmap[c] = bb\n    return cmap, width\n\n\ndef _u16(bb):\n    try:\n        return bytes(bb).decode('utf-16-be', 'ignore')\n    except Exception:\n        return ''\n\n\ndef basic_pdf_text(path):\n    data = open(path, 'rb').read()\n    objs = _pdf_objects(data)\n    fonts = {}                                                  # resource name -> (cmap, width)\n    tounicode = {}\n    for n, body in objs.items():\n        m = re.search(br'/ToUnicode\\s+(\\d+)\\s+0\\s+R', body)\n        if m and int(m.group(1)) in objs:\n            tounicode[n] = _parse_cmap(_pdf_stream(objs[int(m.group(1))]))\n    for n, body in objs.items():                                # font dicts inline or as their own object\n        for name, ref in re.findall(br'/([A-Za-z0-9_.+-]+)\\s+(\\d+)\\s+0\\s+R', body):\n            if int(ref) in tounicode and name not in (b'ToUnicode', b'FontDescriptor', b'DescendantFonts'):\n                fonts[name] = tounicode[int(ref)]\n    # pages in order\n    pages = []\n\n    def walk(num, depth=0):\n        body = objs.get(num, b'')\n        if depth > 30:\n            return\n        if re.search(br'/Type\\s*/Pages\\b', body):\n            km = re.search(br'/Kids\\s*\\[(.*?)\\]', body, re.S)\n            for k in re.findall(br'(\\d+)\\s+0\\s+R', km.group(1) if km else b''):\n                walk(int(k), depth + 1)\n        elif re.search(br'/Type\\s*/Page\\b', body):\n            pages.append(num)\n\n    root = None\n    for n, body in objs.items():\n        if re.search(br'/Type\\s*/Catalog', body):\n            m = re.search(br'/Pages\\s+(\\d+)\\s+0\\s+R', body)\n            if m:\n                root = int(m.group(1))\n    if root:\n        walk(root)\n    if not pages:\n        pages = [n_ for n_, b_ in sorted(objs.items()) if re.search(br'/Type\\s*/Page\\b', b_)]\n    out = []\n    for pn in pages:\n        body = objs[pn]\n        cm = re.search(br'/Contents\\s*(\\[.*?\\]|\\d+\\s+0\\s+R)', body, re.S)\n        refs = [int(x_) for x_ in re.findall(br'(\\d+)\\s+0\\s+R', cm.group(1))] if cm else []\n        content = b'\\n'.join([_pdf_stream(objs.get(r_, b'')) for r_ in refs])\n        out.append(_pdf_content_text(content, fonts))\n    return '\\n\\f\\n'.join(out)\n\n\ndef _pdf_content_text(c, fonts):\n    \"\"\"text runs placed by Td/TD/Tm/T* -> grouped into lines by height on the page, left to right\"\"\"\n    segs = []                                                  # (y, x, text)\n    state = {'x': 0.0, 'y': 0.0, 'lx': 0.0, 'ly': 0.0, 'lead': 12.0, 'font': (None, 1)}\n    tok = re.compile(br'\\((?:\\\\.|[^\\\\)])*\\)|<[0-9A-Fa-f\\s]*>|\\[|\\]|/[^\\s/\\[\\]()<>]+|[-+]?\\d*\\.?\\d+|[A-Za-z\\'\"*]+')\n    numre = re.compile(br'[-+]?\\d*\\.?\\d+$')\n    stack = []\n\n    def emit(txt):\n        if txt:\n            segs.append((round(state['y'], 0), state['x'], txt))\n            state['x'] += len(txt) * 5.0\n\n    def newline(dx, dy):\n        state['lx'] += dx\n        state['ly'] += dy\n        state['x'], state['y'] = state['lx'], state['ly']\n\n    for m in tok.finditer(c):\n        t = m.group(0)\n        if t[:1] in (b'(', b'<', b'[', b']', b'/') or numre.match(t):\n            stack.append(t)\n            continue\n        nums = []\n        for x in stack:\n            if numre.match(x):\n                try:\n                    nums.append(float(x))\n                except Exception:\n                    pass\n        if t == b'BT':\n            state.update({'x': 0.0, 'y': 0.0, 'lx': 0.0, 'ly': 0.0})\n        elif t == b'Tf':\n            names = [x_ for x_ in stack if x_.startswith(b'/')]\n            if names:\n                state['font'] = fonts.get(names[-1][1:], (None, 1))\n        elif t in (b'Td', b'TD') and len(nums) >= 2:\n            if t == b'TD':\n                state['lead'] = -nums[-1]\n            newline(nums[-2], nums[-1])\n        elif t == b'Tm' and len(nums) >= 6:\n            state['lx'], state['ly'] = nums[-2], nums[-1]\n            state['x'], state['y'] = nums[-2], nums[-1]\n        elif t == b'TL' and nums:\n            state['lead'] = nums[-1]\n        elif t == b'T*':\n            newline(0, -state['lead'])\n        elif t in (b'Tj', b\"'\", b'\"'):\n            if t != b'Tj':\n                newline(0, -state['lead'])\n            strs = [x_ for x_ in stack if x_[:1] in (b'(', b'<')]\n            if strs:\n                emit(_pdf_decode(strs[-1], state['font']))\n        elif t == b'TJ':\n            parts = []\n            for x in stack:\n                if x[:1] in (b'(', b'<'):\n                    parts.append(_pdf_decode(x, state['font']))\n                elif numre.match(x):\n                    try:\n                        if float(x) < -200:\n                            parts.append(' ')\n                    except Exception:\n                        pass\n            emit(''.join(parts))\n        stack = []\n    rows = {}\n    for y, x, txt in segs:\n        k = None\n        for yy in rows:\n            if abs(yy - y) <= 2:\n                k = yy\n                break\n        rows.setdefault(y if k is None else k, []).append((x, txt))\n    out = []\n    for y in sorted(rows.keys(), reverse=True):\n        items = sorted(rows[y])\n        line, last_end = '', None\n        for x, txt in items:\n            if last_end is not None and x - last_end > 15:\n                line += '  '\n            line += txt\n            last_end = x + len(txt) * 5.0\n        if line.strip():\n            out.append(line.strip())\n    return '\\n'.join(out)\n\n\ndef _pdf_decode(s, font):\n    if s.startswith(b'<'):\n        bb = _hexbytes(s[1:-1])\n    else:\n        raw = s[1:-1]\n        bb = bytearray()\n        i = 0\n        while i < len(raw):\n            ch = raw[i:i + 1]\n            if ch == b'\\\\' and i + 1 < len(raw):\n                nx = raw[i + 1:i + 2]\n                if nx in b'01234567':\n                    m = re.match(br'[0-7]{1,3}', raw[i + 1:i + 4])\n                    bb.append(int(m.group(0), 8) & 255)\n                    i += 1 + len(m.group(0))\n                    continue\n                bb.extend({b'n': b'\\n', b'r': b'\\r', b't': b'\\t', b'b': b'\\b', b'f': b'\\f'}.get(nx, nx))\n                i += 2\n                continue\n            bb.extend(ch)\n            i += 1\n    cmap, w = font\n    if cmap:\n        txt = []\n        for i in range(0, len(bb) - w + 1, w):\n            code = 0\n            for k in range(w):\n                code = code * 256 + bb[i + k]\n            txt.append(_u16(cmap[code]) if code in cmap else '')\n        return ''.join(txt)\n    return bytes(bb).decode('latin-1', 'ignore')\n\n\ndef load_document(path):\n    ext = os.path.splitext(path)[1].lower()\n    d = {'path': path, 'name': os.path.basename(path), 'ext': ext, 'lines': [], 'tables': [], 'blocks': [],\n         'method': '', 'error': ''}\n    try:\n        if ext in ('.xlsx', '.xlsm'):\n            for title, rows in read_xlsx(path):\n                d['tables'].append({'title': title, 'heading': title, 'rows': rows})\n                d['blocks'].append(('h', title))\n                d['blocks'].append(('t', rows))\n                for r in rows:\n                    cells = [c_ for c_ in r if c_]\n                    if cells:\n                        d['lines'].append('  '.join(cells))\n            d['method'] = 'xlsx'\n        elif ext == '.docx':\n            blocks = read_docx(path)\n            d['blocks'] = blocks\n            head = ''\n            for b in blocks:\n                if b[0] == 't':\n                    d['tables'].append({'title': head, 'heading': head, 'rows': b[1]})\n                    for r in b[1]:\n                        cells = [c_ for c_ in r if c_]\n                        if cells:\n                            d['lines'].append('  '.join(cells))\n                else:\n                    if b[0] == 'h':\n                        head = b[1]\n                    d['lines'].append(b[1])\n            d['method'] = 'docx'\n        elif ext == '.pdf':\n            txt, method = read_pdf(path)\n            d['method'] = method\n            txt = re.sub(r'(?<=[A-Za-z])-\\s*\\n\\s*(?=[A-Za-z])', '-', txt)\n            d['lines'] = [l_.strip() for l_ in txt.replace('\\f', '\\n').split('\\n') if l_.strip()]\n            d['blocks'] = [('p', l_) for l_ in d['lines']]\n        elif ext in ('.csv', '.tsv'):\n            import csv\n            raw = io.open(path, 'r', encoding='utf-8-sig', errors='replace').read()\n            delim = '\\t' if ext == '.tsv' else (';' if raw.count(';') > raw.count(',') else ',')\n            rows = [[_s(c_) for c_ in r_] for r_ in csv.reader(raw.splitlines(), delimiter=delim)]\n            d['tables'].append({'title': d['name'], 'heading': d['name'], 'rows': rows})\n            d['blocks'] = [('t', rows)]\n            d['lines'] = ['  '.join([c_ for c_ in r_ if c_]) for r_ in rows if any(r_)]\n            d['method'] = 'csv'\n        elif ext in ('.txt', '.md'):\n            txt = io.open(path, 'r', encoding='utf-8', errors='replace').read()\n            d['lines'] = [l_.strip() for l_ in txt.splitlines() if l_.strip()]\n            d['blocks'] = [('p', l_) for l_ in d['lines']]\n            d['method'] = 'text'\n        elif ext in ('.xls', '.doc'):\n            d['error'] = 'old binary format - save it as ' + ('.xlsx' if ext == '.xls' else '.docx') + ' and run again'\n        else:\n            d['error'] = 'format not read'\n    except Exception as ex:\n        d['error'] = 'could not read: ' + str(ex)\n    return d\n\n\n# ===================================================================== classification\nDOC_TYPES = [\n    ('MATERIALS', ['material register', 'approved material', 'material code', 'materials register', 'material schedule'],\n     ['material', 'materials']),\n    ('COBIE', ['cobie'], ['cobie']),\n    ('AIR', ['asset information requirement', 'asset information requirements'], ['air']),\n    ('FM', ['asset information package', 'facility management', 'facilities management', 'fm handover',\n            'asset information model'], ['fm', 'aim']),\n    ('CHECKLIST', ['compliance checklist', 'checklist', 'compliance'], ['checklist', 'compliance']),\n    ('MIDP', ['master information delivery plan', 'task information delivery plan', 'execution schedule',\n              'information delivery plan', 'drawing register', 'deliverables schedule'], ['midp', 'tidp', 'schedule', 'register']),\n    ('WORKFLOW', ['workflow', 'approval process', 'cde workflow'], ['workflow', 'workflows', 'process']),\n    ('EIR', ['exchange information requirement', 'employer s information requirement', 'employers information requirement'],\n     ['eir', 'oir', 'pir']),\n    ('BEP', ['bim execution plan', 'execution plan', 'bim plan'], ['bep']),\n]\n# which document wins when two documents disagree (1 = strongest)\nPRECEDENCE_FACTS = {'BEP': 1, 'EIR': 2, 'MIDP': 3, 'AIR': 4, 'FM': 5, 'COBIE': 6, 'WORKFLOW': 7, 'CHECKLIST': 8,\n                    'MATERIALS': 9, 'OTHER': 10}\nPRECEDENCE_PARAMS = {'AIR': 1, 'FM': 2, 'EIR': 3, 'BEP': 4, 'COBIE': 5, 'MIDP': 8, 'OTHER': 9}\nTYPE_LABEL = {'BEP': 'BIM Execution Plan', 'EIR': 'Exchange Information Requirements', 'MIDP': 'BIM execution schedule / MIDP',\n              'AIR': 'Asset Information Requirements', 'COBIE': 'COBie template', 'FM': 'FM asset information package',\n              'CHECKLIST': 'ISO 19650 compliance checklist', 'WORKFLOW': 'BIM workflow package',\n              'MATERIALS': 'Approved material register', 'OTHER': 'Other / not recognised'}\n\n\ndef classify(d):\n    fname = norm(os.path.splitext(d['name'])[0])\n    ftoks = set(fname.split())\n    text = norm(' '.join(d['lines'][:400]))\n    best, score = 'OTHER', 0\n    for typ, phrases, toks in DOC_TYPES:\n        s = 0\n        for p in phrases:\n            if p in fname:\n                s += 12\n            s += min(text.count(p), 5) * 2\n        for t in toks:\n            if t in ftoks:\n                s += 8\n        if typ == 'COBIE':\n            titles = set([norm(t_['title']) for t_ in d['tables']])\n            s += 6 * len(titles & set(['facility', 'floor', 'space', 'type', 'component', 'system']))\n        if s > score:\n            best, score = typ, s\n    return best if score >= 6 else 'OTHER'\n\n\n# ===================================================================== table schemas\nSCHEMAS = {\n    # field order matters (first field claims its column first) - lists, not dicts, so IronPython keeps the order\n    'deliverables': {'req': ['number', 'title'], 'fields': [\n        ('number', ['container id', 'container name', 'document number', 'information container', 'drawing number',\n                    'sheet number', 'document no', 'drawing no', 'doc no', 'doc number', 'file name', 'document reference',\n                    'deliverable reference', 'container']),\n        ('title', ['title', 'document title', 'drawing title', 'sheet name', 'sheet title', 'deliverable', 'description',\n                   'information container title']),\n        ('originator', ['task team originator', 'originator', 'originator code', 'task team']),\n        ('type', ['type', 'document type', 'information type', 'container type']),\n        ('role', ['role', 'discipline']),\n        ('scale', ['scale']),\n        ('size', ['size', 'sheet size', 'paper size']),\n        ('stage', ['stage', 'project stage']),\n        ('milestone', ['milestone']),\n        ('status', ['suitability at delivery', 'status', 'suitability', 'status code', 'suitability code']),\n        ('revision', ['revision', 'rev']),\n        ('due', ['due date', 'delivery date', 'planned date', 'date due', 'target date', 'deadline', 'due']),\n        ('responsible', ['responsible', 'responsibility', 'author', 'responsible party', 'producer'])]},\n    'params': {'req': ['attribute'], 'fields': [\n        ('attribute', ['attribute', 'attribute name', 'parameter', 'parameter name', 'property', 'property name',\n                       'field', 'data field', 'information requirement']),\n        ('category', ['revit category', 'revit family category', 'category', 'element category', 'applies to',\n                      'object type', 'asset category', 'asset class', 'element', 'class']),\n        ('datatype', ['data type', 'datatype', 'type of data', 'format', 'value type', 'data format']),\n        ('unit', ['unit', 'units', 'unit of measure']),\n        ('stage', ['required at stage', 'required by stage', 'due at', 'stage', 'required by', 'milestone',\n                   'delivery stage']),\n        ('binding', ['instance or type', 'instance type', 'type or instance', 'binding', 'parameter type']),\n        ('required', ['required', 'mandatory', 'compulsory']),\n        ('cobie', ['cobie field', 'cobie mapping', 'cobie property', 'cobie']),\n        ('description', ['description', 'definition', 'notes', 'comment'])]},\n    'checklist': {'req': ['requirement'], 'fields': [\n        ('ref', ['ref', 'reference', 'item', 'no', 'id', 'number']),\n        ('requirement', ['requirement', 'title', 'check', 'item description', 'description', 'criteria', 'question']),\n        ('clause', ['iso 19650 clauses', 'iso 19650 clause', 'clause', 'iso clause', 'standard reference']),\n        ('applicability', ['applicability', 'applicable']),\n        ('status', ['compliance status', 'status', 'compliant', 'complied', 'compliance', 'response', 'result']),\n        ('action', ['action', 'missing inputs']),\n        ('closed', ['closed', 'date closed']),\n        ('comment', ['comment', 'comments', 'remarks', 'notes'])]},\n    'materials': {'req': ['code', 'name'], 'fields': [\n        ('code', ['material code', 'mat code', 'material ref', 'material reference', 'code', 'item code', 'ref',\n                  'reference']),\n        ('name', ['material name', 'material', 'name', 'material description']),\n        ('category', ['category', 'material class', 'class', 'group', 'type']),\n        ('description', ['description', 'specification', 'notes']),\n        ('manufacturer', ['manufacturer', 'supplier', 'brand', 'make']),\n        ('product', ['product reference', 'product', 'product code', 'model', 'product ref']),\n        ('approved', ['approved', 'approval', 'status', 'approval status'])]},\n}\n\n\ndef map_header(row, schema):\n    cells = [norm(c_) for c_ in row]\n    cols = {}\n    used = set()\n    for field, syns in schema['fields']:\n        found = None\n        for mode in ('exact', 'contains'):\n            for syn in syns:\n                for i, c in enumerate(cells):\n                    if i in used or not c:\n                        continue\n                    if (mode == 'exact' and c == syn) or (mode == 'contains' and len(syn) > 4 and len(c.split()) <= 5 and\n                                                          (c.startswith(syn + ' ') or (' ' in syn and syn in c))):\n                        found = i\n                        break\n                if found is not None:\n                    break\n            if found is not None:\n                break\n        if found is not None:\n            cols[field] = found\n            used.add(found)\n    return cols\n\n\ndef find_table(rows, schema_name):\n    schema = SCHEMAS[schema_name]\n    for hi, row in enumerate(rows[:25]):\n        if len([c_ for c_ in row if c_]) < 2:\n            continue\n        cols = map_header(row, schema)\n        if all([r_ in cols for r_ in schema['req']]) and len(cols) >= 2:\n            recs = []\n            for r in rows[hi + 1:]:\n                if not any(r):\n                    continue\n                rec = {}\n                for f, i in cols.items():\n                    rec[f] = r[i] if i < len(r) else ''\n                if not any(rec.values()):\n                    continue\n                recs.append(rec)\n            return cols, recs, row\n    return None, [], None\n\n\n# ===================================================================== facts (key -> value)\nFACT_LABELS = [\n    ('project_name', ['project name', 'project title', 'name of project', 'projectname']),\n    ('project_number', ['project number', 'project no', 'job number', 'job no', 'project ref', 'project reference']),\n    ('project_code', ['project code', 'project identifier']),\n    ('client', ['client name', 'client', 'employer', 'owner']),\n    ('appointing_party', ['appointing party']),\n    ('lead_appointed_party', ['lead appointed party']),\n    ('address', ['site address', 'project address', 'address']),\n    ('building_name', ['building name', 'facility name', 'building']),\n    ('stage', ['project stage', 'current stage', 'riba stage', 'stage']),\n    ('originator', ['originator code', 'originator', 'company code', 'organisation code', 'organization code']),\n    ('units', ['units', 'unit of measurement', 'measurement units', 'linear units', 'linearunits']),\n    ('software', ['authoring software', 'authoring tool', 'software']),\n    ('ifc', ['exchange format', 'ifc version', 'ifc schema', 'schema model view', 'model exchange open', 'open format', 'ifc']),\n    ('cde', ['cde platform', 'common data environment', 'cde', 'platform']),\n    ('clash_tolerance', ['clash tolerance', 'tolerance']),\n    ('coordinate_system', ['coordinate reference system', 'project crs', 'coordinate system', 'shared coordinates',\n                           'coordinates', 'survey point']),\n    ('sheet_size', ['sheet size', 'paper size', 'drawing size']),\n    ('title_block', ['title block', 'titleblock']),\n]\nFACT_TITLE = {'project_name': 'Project name', 'project_number': 'Project number', 'project_code': 'Project code',\n              'client': 'Client', 'appointing_party': 'Appointing party', 'lead_appointed_party': 'Lead appointed party',\n              'address': 'Site address', 'building_name': 'Building name', 'stage': 'Project stage',\n              'originator': 'Originator code', 'units': 'Units', 'software': 'Authoring software',\n              'ifc': 'IFC / exchange format', 'cde': 'CDE platform', 'clash_tolerance': 'Clash tolerance',\n              'coordinate_system': 'Coordinate system', 'sheet_size': 'Sheet size', 'title_block': 'Title block'}\nNO_COLON_OK = set(['client', 'units'])\nTABLE_ONLY = set(['platform', 'building', 'owner', 'tolerance', 'coordinates'])\n\n\ndef _label_match(label, text):\n    \"\"\"text starts with the label (as whole words) -> rest, else None\"\"\"\n    t = text.strip()\n    tl = t.lower()\n    if not tl.startswith(label):\n        return None\n    rest = t[len(label):]\n    if rest[:1].isalnum():\n        return None\n    rest = rest.lstrip(' .:-\\t=')\n    return rest.strip() or None\n\n\nFACT_CHECK = {'originator': r'^[A-Z0-9]{2,6}$', 'project_code': r'^[A-Za-z0-9][A-Za-z0-9-]{1,14}$',\n              'project_number': r'^[A-Za-z0-9][A-Za-z0-9 ./-]{1,24}$'}\n\n\ndef _clean_value(v, from_text, k=''):\n    v = _s(v).strip(' .;:-')\n    if from_text:\n        v = re.split(r'\\.\\s+(?=[A-Z])', v)[0]                    # first sentence only\n    if len(v.split()) > (14 if from_text else 25):\n        return ''\n    if re.match(r'^[A-L]\\.\\d+(\\s*[-,/]\\s*[A-L]?\\.?\\d+)*$', v):     # a BEP section reference, not a value\n        return ''\n    if re.match(r'^\\d+\\s*(-|to)\\s*\\d+$', v) and k not in ('clash_tolerance',):\n        return ''\n    if k in FACT_CHECK and not re.match(FACT_CHECK[k], v):\n        return ''\n    return v\n\n\ndef extract_orgs(d):\n    \"\"\"stakeholder table (Code | Organisation | ISO 19650 role) -> {code: (organisation, role)}\"\"\"\n    orgs = {}\n    for t in d['tables']:\n        rows = [r_ for r_ in t['rows'] if any(r_)]\n        if len(rows) < 2:\n            continue\n        hdr = [norm(c_) for c_ in rows[0]]\n        ci = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('code', 'organisation code', 'organization code', 'originator')])), None)\n        oi = next((iter([i_ for i_, h_ in enumerate(hdr) if h_.startswith('organi') or h_ == 'company' or h_ == 'party'])), None)\n        ri = next((iter([i_ for i_, h_ in enumerate(hdr) if 'role' in h_])), None)\n        if ci is None or oi is None:\n            continue\n        for r in rows[1:]:\n            code = r[ci].strip() if ci < len(r) else ''\n            if re.match(r'^[A-Z0-9]{2,6}$', code):\n                role = r[ri] if ri is not None and ri < len(r) else ''\n                if code not in orgs or (role and not orgs[code][1]):\n                    orgs[code] = (r[oi] if oi < len(r) else '', role)\n    return orgs\n\n\ndef extract_facts(d):\n    found = {}\n\n    def put(k, v, how):\n        v = _clean_value(v, how != 'table', k)\n        if not v or len(v) > 160 or k in found:\n            return\n        found[k] = (v, how)\n\n    # 1  tables: stakeholders first, then label cell + value cell, header row + one data row (COBie Facility), software, units\n    for code, (org, role) in extract_orgs(d).items():\n        rl = role.lower()\n        if 'lead appointed' in rl:\n            put('originator', code, 'table')\n            put('lead_appointed_party', org, 'table')\n        elif 'appointing party' in rl:\n            put('appointing_party', org, 'table')\n            put('client', org, 'table')\n    for t in d['tables']:\n        rows = [r_ for r_ in t['rows'] if any(r_)]\n        if not rows:\n            continue\n        hdr = [norm(c_) for c_ in rows[0]]\n        if any(['software' in h_ for h_ in hdr]) and any(['version' in h_ for h_ in hdr]):\n            si = next(iter([i_ for i_, h_ in enumerate(hdr) if 'software' in h_]))\n            vi = next(iter([i_ for i_, h_ in enumerate(hdr) if 'version' in h_]))\n            for r in rows[1:]:\n                if si < len(r) and 'revit' in r[si].lower():\n                    put('software', r[si] + ' ' + (r[vi] if vi < len(r) else ''), 'table')\n                    break\n        if any(['unit' in h_ for h_ in hdr]):\n            for r in rows[1:]:\n                if r and norm(r[0]) == 'length' and len(r) > 1:\n                    put('units', r[1], 'table')\n        valueish = len(hdr) > 1 and hdr[1] in ('value', 'values', 'detail', 'details', 'requirement', 'information',\n                                               'description', 'entry', 'data', 'answer')\n        for r in rows:\n            cells = [c_ for c_ in r if c_]\n            if len(cells) == 2 or (len(cells) > 2 and valueish):\n                for k, labels in FACT_LABELS:\n                    if norm(cells[0]) in labels:\n                        put(k, cells[1], 'table')\n        data = rows[1:]\n        if len(data) == 1:\n            for k, labels in FACT_LABELS:\n                for i, h in enumerate(hdr):\n                    if h in labels and i < len(data[0]) and data[0][i]:\n                        put(k, data[0][i], 'table')\n    # 2  \"Label: value\" anywhere in a line\n    for line in d['lines']:\n        for k, labels in FACT_LABELS:\n            for lab in labels:\n                if lab in TABLE_ONLY:\n                    continue\n                m = re.search(r'(?i)(?:^|[\\s(])' + re.escape(lab) + r'\\s*[:=]\\s*(.+?)(?:\\s{2,}|\\s\\|\\s|$)', line)\n                if m:\n                    put(k, m.group(1), 'line')\n                    break\n    # 3  \"Label value\" at the start of a line (PDF tables)\n    if d['ext'] in ('.pdf', '.txt', '.md'):\n        for line in d['lines']:\n            if len(line) > 120:\n                continue\n            for k, labels in FACT_LABELS:\n                for lab in labels:\n                    if (' ' not in lab and lab not in NO_COLON_OK) or lab in TABLE_ONLY:\n                        continue\n                    v = _label_match(lab, line)\n                    if v:\n                        put(k, v, 'pdf line')\n                        break\n    return found\n\n\n# ===================================================================== naming convention + code lists\nFIELD_WORDS = {\n    'project': 'Project', 'project code': 'Project', 'originator': 'Originator', 'originator code': 'Originator',\n    'company': 'Originator', 'volume': 'Volume', 'zone': 'Volume', 'system': 'Volume', 'volume system': 'Volume',\n    'functional breakdown': 'Volume', 'level': 'Level', 'location': 'Level', 'levels': 'Level',\n    'spatial breakdown': 'Level', 'level location': 'Level', 'type': 'Type', 'document type': 'Type',\n    'information type': 'Type', 'form': 'Type', 'role': 'Role', 'discipline': 'Role', 'number': 'Number',\n    'sequence': 'Number', 'sequential number': 'Number', 'sequence number': 'Number', 'level sequence': 'Number',\n    'level and sequence': 'Number', 'levelseq': 'Number', 'level seq': 'Number', 'lvlseq': 'Number', 'stage': 'Stage', 'classification': 'Classification',\n    'suitability': 'Suitability', 'status': 'Suitability', 'revision': 'Revision'}\nHEAD_FIELD = [('volume', 'Volume'), ('zone', 'Volume'), ('functional breakdown', 'Volume'), ('level', 'Level'),\n              ('location', 'Level'), ('spatial', 'Level'), ('document type', 'Type'), ('information type', 'Type'),\n              ('type code', 'Type'), ('form', 'Type'), ('type', 'Type'), ('role', 'Role'), ('discipline', 'Role'),\n              ('originator', 'Originator'), ('status', 'STATUS'), ('suitability', 'STATUS'), ('revision', 'REVISION'),\n              ('workset', 'WORKSETS'), ('level of information', 'LOIN'), ('loin', 'LOIN'), ('lod', 'LOIN')]\n\n\ndef head_field(text):\n    t = norm(text)\n    t = re.sub(r'^([a-z] )?\\d+( \\d+)* ', '', t)\n    if 'level of information' in t or t.startswith('loin') or 'level of development' in t or 'level of detail' in t             or re.match(r'^(lod|loi)\b', t):\n        return 'LOIN'\n    for w, f in HEAD_FIELD:\n        if re.search(r'\\b' + w + r's?\\b', t):\n            return f\n    return None\n\n\nCODE_RE = re.compile(r'^([A-Z0-9]{1,5})$')\n\n\ndef _field_name(cell):\n    t = norm(cell)\n    if t in FIELD_WORDS:\n        return FIELD_WORDS[t]\n    t2 = re.sub(r'\\b(code|codes|field)\\b', '', t).strip()\n    return FIELD_WORDS.get(t2) or FIELD_WORDS.get(t2.replace(' + ', ' ').replace('  ', ' '))\n\n\ndef _inline_codes(cell):\n    \"\"\"'XX General / whole project; MP Site; PD Podium' -> {code: description}\"\"\"\n    out = {}\n    for part in re.split(r'[;\\n]', cell or ''):\n        m = re.match(r'^\\s*([A-Z0-9]{1,5})\\s*[-=:]?\\s+(\\S.*)$', part.strip())\n        if m:\n            out[m.group(1)] = m.group(2).strip()\n    return out\n\n\ndef _len_range(cell):\n    m = re.match(r'^\\s*(\\d+)\\s*(?:-|to)\\s*(\\d+)\\s*$', _s(cell))\n    if m:\n        return int(m.group(1)), int(m.group(2))\n    m = re.match(r'^\\s*(\\d+)\\s*$', _s(cell))\n    if m:\n        return int(m.group(1)), int(m.group(1))\n    return None\n\n\ndef extract_naming(d):\n    res = {'fields': None, 'example': None, 'sep': '-', 'codes': {}, 'status': {}, 'status_names': [], 'worksets': [],\n           'workset_patterns': [], 'loin': [], 'revision': [], 'digits': None, 'material_rule': None, 'code_param': None,\n           'steps': [], 'lengths': {}, 'level_number': False, 'stages': []}\n    text = '\\n'.join(d['lines'])\n    # field order written as text \"Project-Originator-Volume-Level-Type-Role-Number\"\n    for m in re.finditer(r'([A-Za-z][A-Za-z /]{1,24}(?:\\s*[-_\u2013]\\s*[A-Za-z][A-Za-z /]{1,24}){3,10})', text):\n        parts = [norm(p_) for p_ in re.split(r'\\s*[-_\u2013]\\s*', m.group(1))]\n        mapped = [FIELD_WORDS.get(p_) or FIELD_WORDS.get(p_.split(' ')[-1] if p_ else '') for p_ in parts]\n        if len(parts) >= 4 and sum([1 for x_ in mapped if x_]) >= len(parts) - 1 and ('Number' in mapped or 'Project' in mapped):\n            res['fields'] = [x_ or parts[i_].title() for i_, x_ in enumerate(mapped)]\n            res['fields_from_text'] = True\n            break\n    # example container name\n    exs = []\n    for line in d['lines']:\n        for m in re.finditer(r'\\b[A-Z0-9]{2,8}(?:[-_][A-Z0-9]{1,8}){3,9}\\b', line):\n            exs.append((('example' in line.lower() or 'e.g' in line.lower()), m.group(0)))\n    exs.sort(key=lambda x: not x[0])\n    for flag, ex in exs:\n        n = len(re.split(r'[-_]', ex))\n        if res['fields'] is None or n == len(res['fields']):\n            if res['fields'] is not None or flag:\n                res['example'] = ex\n                res['sep'] = '_' if '_' in ex and '-' not in ex else '-'\n                break\n    m = re.search(r'(?i)number[^.\\n]{0,40}?\\b(two|three|four|five|six|\\d)\\s*(?:-\\s*)?digits?', text)\n    if m:\n        w = m.group(1).lower()\n        res['digits'] = {'two': 2, 'three': 3, 'four': 4, 'five': 5, 'six': 6}.get(w) or int(w)\n    for line in d['lines']:\n        if 'revision' in line.lower():\n            for r in re.findall(r'\\b([A-Z])(\\d{2})(?:\\.\\d+)?\\b', line):\n                if r[0] not in res['revision']:\n                    res['revision'].append(r[0])\n    m = re.search(r'(?i)materials?[^.\\n]{0,60}named\\s*[\"\u201c]?(<[^>]+>[^\"\u201d\\n]*)[\"\u201d]?', text)\n    if m:\n        res['material_rule'] = m.group(1).strip()\n    m = re.search(r'(?i)material code[^.]{0,80}?\\b(mark|keywords|description|comments)\\b\\s+parameter', text)\n    if m:\n        res['code_param'] = m.group(1).title()\n\n    def add_status(code, desc, state=''):\n        res['status'].setdefault(code, desc)\n        for n in (desc, state):\n            if n and norm(n) not in res['status_names']:\n                res['status_names'].append(norm(n))\n\n    head = ''\n    for b in d['blocks']:\n        if b[0] == 'h':\n            head = b[1]\n            continue\n        if b[0] == 'p':\n            line = b[1]\n            if d['ext'] in ('.pdf', '.txt', '.md'):\n                if d['type'] == 'WORKFLOW' and re.match(r'^\\d+[.)]\\s+\\S', line):\n                    res['steps'].append(line)\n                    continue\n                words = len(line.split())\n                numbered = (re.match(r'^\\d+(\\.\\d+)+\\.?\\s+[A-Za-z]', line) or re.match(r'^\\d+\\.\\s+[A-Za-z]', line) or\n                            re.match(r'^[A-L]\\.\\d+(\\.\\d+)*\\s+[A-Z]', line)) and words <= 9\n                keyed = words <= 8 and re.search(r'(?i)\\b(codes|worksets|level of information need|loin)\\b', line) and \\\n                    not re.match(r'^[A-Z0-9]{1,4}\\s', line)\n                if numbered or keyed:\n                    head = line\n                    continue\n                f = head_field(head)\n                if f in ('Volume', 'Level', 'Type', 'Role', 'Originator') or (f == 'STATUS' and re.search(r'(?i)status|suitab', head) and re.search(r'(?i)code', head)):\n                    m = re.match(r'^([A-Z0-9]{1,4})\\s+(\\S.*)$', line)\n                    if m and not line.lower().startswith(('code ', 'status ')):\n                        if f == 'STATUS':\n                            add_status(m.group(1), m.group(2).strip())\n                        else:\n                            res['codes'].setdefault(f, {}).setdefault(m.group(1), m.group(2).strip())\n                elif f == 'WORKSETS':\n                    m = re.match(r'^([A-Za-z0-9]+_[A-Za-z0-9_\\-]+)', line)\n                    if m:\n                        res['worksets'].append(m.group(1))\n                    elif line.lower().startswith('shared levels and grids'):\n                        res['worksets'].append('Shared Levels and Grids')\n                elif f == 'LOIN':\n                    res['loin'].append(line)\n            continue\n        rows = [r_ for r_ in b[1] if any(r_)]\n        if len(rows) < 2:\n            continue\n        hdr = [norm(c_) for c_ in rows[0]]\n        hdr0 = hdr[0] if hdr else ''\n        # naming table: Field | Characters | Codes\n        if hdr0 in ('field', 'fields', 'naming field', 'element') and len(rows) >= 4 and \\\n                any([h_ in ('characters', 'length', 'codes', 'chars', 'format', 'no of characters') for h_ in hdr[1:]]):\n            names = [_field_name(r_[0]) for r_ in rows[1:]]\n            if sum([1 for n_ in names if n_]) >= len(names) - 1 and (res['fields'] is None or res.get('fields_from_text')):\n                res['fields_from_text'] = False\n                res['fields'] = [n_ or rows[i_ + 1][0].title() for i_, n_ in enumerate(names)]\n                li = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('characters', 'length', 'chars', 'no of characters')])), None)\n                ki = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('codes', 'code', 'allowed codes', 'values')])), None)\n                for i, r in enumerate(rows[1:]):\n                    f = res['fields'][i]\n                    if 'level' in norm(r[0]) and f == 'Number':\n                        res['level_number'] = True\n                    if li is not None and li < len(r) and _len_range(r[li]):\n                        res['lengths'][f] = _len_range(r[li])\n                    if ki is not None and ki < len(r):\n                        cs = _inline_codes(r[ki])\n                        if cs:\n                            res['codes'].setdefault(f, {}).update(cs)\n                continue\n        # Field | Code | Meaning (container breakdown)\n        if hdr0 == 'field' and len(hdr) >= 2 and hdr[1] in ('code', 'codes'):\n            for r in rows[1:]:\n                f = _field_name(r[0])\n                if f and len(r) > 1 and CODE_RE.match(r[1].strip()):\n                    res['codes'].setdefault(f, {}).setdefault(r[1].strip(), r[2] if len(r) > 2 else '')\n            continue\n        # milestones / stages: Code | Stage | ... | Start | End\n        if any([h_ in ('stage', 'stage name') for h_ in hdr]) and any([h_ in ('start', 'end', 'date', 'from', 'to') for h_ in hdr]):\n            ci = 0 if hdr0 in ('code', 'stage code') else None\n            si = next(iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('stage', 'stage name')]))\n            st = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('start', 'from')])), None)\n            en = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('end', 'to', 'date')])), None)\n            for r in rows[1:]:\n                res['stages'].append({'code': r[ci].strip() if ci is not None else '', 'name': r[si] if si < len(r) else '',\n                                      'start': _date(r[st]) if st is not None and st < len(r) else None,\n                                      'end': _date(r[en]) if en is not None and en < len(r) else None})\n            continue\n        f = head_field(head)\n        if hdr0.startswith('workset'):\n            f = 'WORKSETS'\n        elif hdr0 in ('status', 'status code', 'suitability', 'suitability code') or \\\n                ('code' in hdr and any([h_ in ('cde state', 'state') for h_ in hdr])):\n            f = 'STATUS'\n        if f == 'WORKSETS':\n            for r in rows[1:]:\n                if r and r[0]:\n                    (res['workset_patterns'] if '<' in r[0] else res['worksets']).append(r[0].strip())\n        elif f == 'LOIN':\n            res['loin'].extend(['  '.join([c_ for c_ in r_ if c_]) for r_ in rows[1:]])\n        elif f in ('Volume', 'Level', 'Type', 'Role', 'Originator', 'STATUS'):\n            ci = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('code', 'status code', 'suitability code')])), None)\n            if ci is None:\n                ci = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('status', 'suitability')])), 0)\n            di = next((iter([i_ for i_, h_ in enumerate(hdr) if h_ in ('meaning', 'description', 'definition', 'use')])), ci + 1)\n            data = [r_ for r_ in rows[1:] if len(r_) > ci and r_[ci]]\n            if data and sum([1 for r_ in data if CODE_RE.match(r_[ci].strip())]) >= max(1, len(data) * 0.6):\n                for r in data:\n                    code = r[ci].strip()\n                    desc = r[di].strip() if di < len(r) else ''\n                    if f == 'STATUS':\n                        add_status(code, desc, r[0] if ci != 0 else '')\n                    else:\n                        res['codes'].setdefault(f, {}).setdefault(code, desc)\n    if d['ext'] == '.docx':\n        steps, inwf = [], False\n        for b in d['blocks']:\n            if b[0] == 'h':\n                inwf = 'workflow' in b[1].lower() or 'process' in b[1].lower()\n            elif b[0] == 'p' and inwf and len(b[1]) < 220:\n                steps.append(b[1])\n        res['steps'] = res['steps'] or steps[:15]\n    return res\n\n\ndef _date(v):\n    s = _s(v)\n    if not s:\n        return None\n    if re.match(r'^\\d{5}(\\.0+)?$', s):\n        try:\n            return datetime.date(1899, 12, 30) + datetime.timedelta(days=int(float(s)))\n        except Exception:\n            return None\n    for fmt in ('%d-%m-%Y', '%d/%m/%Y', '%Y-%m-%d', '%d.%m.%Y', '%d %b %Y', '%d %B %Y', '%Y-%m-%dT%H:%M:%S'):\n        try:\n            return datetime.datetime.strptime(s[:19], fmt).date()\n        except Exception:\n            pass\n    return None\n\n\n# ===================================================================== data types / stages / categories\ndef norm_dtype(s):\n    t = norm(s)\n    if not t:\n        return None\n    for keys, v in ((('yes no', 'yes/no', 'boolean', 'bool', 'y n', 'true false', 'yesno', 'checkbox'), 'YesNo'),\n                    (('integer', 'int', 'whole number', 'count'), 'Integer'),\n                    (('number', 'real', 'decimal', 'float', 'numeric', 'double'), 'Number'),\n                    (('length', 'distance'), 'Length'), (('area',), 'Area'),\n                    (('date', 'datetime', 'date time'), 'Date'), (('currency', 'cost', 'money'), 'Currency'),\n                    (('url', 'link', 'hyperlink'), 'URL'),\n                    (('text', 'string', 'alphanumeric', 'char', 'label', 'list', 'enumeration'), 'Text')):\n        for k in keys:\n            if t == k or t.startswith(k + ' ') or t.endswith(' ' + k):\n                return v\n    return 'Text'\n\n\nSTAGE_ORDER = []                                           # [(code, normalised name)] from the milestone table\n\n\ndef stage_num(s):\n    t = norm(s)\n    if not t:\n        return None\n    for i, (code, name) in enumerate(STAGE_ORDER):\n        if (code and re.search(r'\\b' + code.lower() + r'\\b', t)) or (name and name in t):\n            return i + 1\n    m = re.search(r'(\\d+)', t)\n    if m:\n        return int(m.group(1))\n    for words, n in ((('handover', 'completion', 'as built', 'operation'), 7), (('construction',), 5), (('tender',), 4),\n                     (('technical',), 4), (('developed', 'development'), 3), (('schematic',), 2), (('concept',), 1)):\n        if any([w_ in t for w_ in words]):\n            return n\n    return None\n\n\nCATEGORY_ALIASES = {\n    'door': 'Doors', 'doors': 'Doors', 'doorset': 'Doors', 'doorsets': 'Doors', 'window': 'Windows', 'windows': 'Windows',\n    'room': 'Rooms', 'rooms': 'Rooms', 'space': 'Rooms', 'spaces': 'Rooms', 'mep space': 'Spaces',\n    'mechanical equipment': 'Mechanical Equipment', 'mechanical': 'Mechanical Equipment', 'hvac equipment': 'Mechanical Equipment',\n    'electrical equipment': 'Electrical Equipment', 'electrical': 'Electrical Equipment', 'plumbing fixtures': 'Plumbing Fixtures',\n    'plumbing fixture': 'Plumbing Fixtures', 'sanitary': 'Plumbing Fixtures', 'sanitary ware': 'Plumbing Fixtures',\n    'sanitaryware': 'Plumbing Fixtures', 'lighting fixtures': 'Lighting Fixtures', 'lighting fixture': 'Lighting Fixtures',\n    'luminaires': 'Lighting Fixtures', 'luminaire': 'Lighting Fixtures', 'lights': 'Lighting Fixtures',\n    'furniture': 'Furniture', 'ffe': 'Furniture', 'ff e': 'Furniture', 'walls': 'Walls', 'wall': 'Walls',\n    'floors': 'Floors', 'floor': 'Floors', 'ceilings': 'Ceilings', 'ceiling': 'Ceilings', 'roofs': 'Roofs', 'roof': 'Roofs',\n    'stairs': 'Stairs', 'stair': 'Stairs', 'columns': 'Columns', 'structural columns': 'Structural Columns',\n    'structural framing': 'Structural Framing', 'beams': 'Structural Framing', 'generic models': 'Generic Models',\n    'casework': 'Casework', 'specialty equipment': 'Specialty Equipment', 'medical equipment': 'Medical Equipment',\n    'lifts': 'Generic Models', 'elevators': 'Generic Models', 'sprinklers': 'Sprinklers', 'air terminals': 'Air Terminals',\n    'ducts': 'Ducts', 'pipes': 'Pipes', 'cable trays': 'Cable Trays', 'electrical fixtures': 'Electrical Fixtures',\n    'fire alarm devices': 'Fire Alarm Devices', 'communication devices': 'Communication Devices',\n    'dampers': 'Duct Accessories', 'damper': 'Duct Accessories', 'fire dampers': 'Duct Accessories',\n    'valves': 'Pipe Accessories', 'curtain panels': 'Curtain Panels', 'railings': 'Railings', 'parking': 'Parking', 'site': 'Site',\n    'project information': 'Project Information', 'project': 'Project Information', 'sheets': 'Sheets', 'materials': 'Materials',\n}\nASSET_CATS = ['Mechanical Equipment', 'Electrical Equipment', 'Plumbing Fixtures', 'Lighting Fixtures', 'Specialty Equipment',\n              'Sprinklers', 'Fire Alarm Devices', 'Communication Devices', 'Electrical Fixtures', 'Air Terminals']\nELEMENT_CATS = ['Walls', 'Floors', 'Ceilings', 'Roofs', 'Doors', 'Windows', 'Stairs', 'Columns', 'Structural Columns',\n                'Structural Framing', 'Furniture', 'Casework', 'Generic Models', 'Curtain Panels', 'Railings'] + ASSET_CATS\n\n\ndef norm_categories(s):\n    \"\"\"category cell -> list of Revit categories ('All maintainable assets', 'Spaces, elements', 'Doors' ...)\"\"\"\n    t = norm(s)\n    if not t:\n        return []\n    out = []\n    if re.search(r'\\b(maintainable|asset|assets|equipment|plant)\\b', t) and not CATEGORY_ALIASES.get(t):\n        out += ASSET_CATS\n    if re.search(r'\\b(all elements|all model elements|elements|all objects)\\b', t):\n        out += ELEMENT_CATS\n    if re.search(r'\\b(space|spaces|room|rooms)\\b', t):\n        out.append('Rooms')\n    if out:\n        seen = []\n        for c in out:\n            if c not in seen:\n                seen.append(c)\n        return seen\n    parts = [p_ for p_ in re.split(r'\\s*(?:,|/|;| and )\\s*', _s(s)) if p_.strip()] or [_s(s)]\n    return [c_ for c_ in ([norm_category(p_) for p_ in parts]) if c_]\n\n\ndef norm_category(s):\n    t = norm(s)\n    if not t:\n        return None\n    if t in CATEGORY_ALIASES:\n        return CATEGORY_ALIASES[t]\n    if t.endswith('s') and t[:-1] in CATEGORY_ALIASES:\n        return CATEGORY_ALIASES[t[:-1]]\n    w = t.split()\n    for i in range(1, len(w)):                                  # 'fire rated walls' -> Walls\n        tail = ' '.join(w[i:])\n        if tail in CATEGORY_ALIASES:\n            return CATEGORY_ALIASES[tail]\n    return ' '.join([x_.capitalize() for x_ in w])\n\n\ndef norm_binding(s, category, cobie=''):\n    if category in ('Rooms', 'Spaces', 'Areas', 'Sheets', 'Project Information', 'Materials'):\n        return 'Instance'\n    t = norm(s)\n    if 'type' in t and 'instance' not in t:\n        return 'Type'\n    if 'instance' in t or 'occurrence' in t:\n        return 'Instance'\n    c = norm(cobie)\n    if c.startswith('type '):\n        return 'Type'\n    if c.startswith('component ') or c.startswith('space '):\n        return 'Instance'\n    return None\n\n\ndef clean_param_name(s):\n    s = _s(s).strip()\n    s = re.sub(r'\\s*/\\s*', ' ', s)\n    s = re.sub(r'[\\[\\]{}:;|<>?`~\\\\]', '', s)\n    s = re.sub(r'\\s+', ' ', s)\n    return s.strip()\n\n\nCOBIE_SKIP = {\n    'Type': ['name', 'createdby', 'createdon', 'category', 'description', 'externalsystem', 'externalobject',\n             'externalidentifier', 'extsystem', 'extobject', 'extidentifier'],\n    'Component': ['name', 'createdby', 'createdon', 'typename', 'space', 'description', 'externalsystem', 'externalobject',\n                  'externalidentifier', 'extsystem', 'extobject', 'extidentifier'],\n    'Space': ['name', 'createdby', 'createdon', 'category', 'floorname', 'description', 'grossarea', 'netarea',\n              'externalsystem', 'externalobject', 'externalidentifier', 'extsystem', 'extobject', 'extidentifier']}\nCOBIE_DTYPE = {'warrantydurationparts': 'Number', 'warrantydurationlabor': 'Number', 'replacementcost': 'Number',\n               'expectedlife': 'Number', 'nominallength': 'Number', 'nominalwidth': 'Number', 'nominalheight': 'Number',\n               'usableheight': 'Number', 'installationdate': 'Date', 'warrantystartdate': 'Date'}\n# attributes Revit already has (normalised name -> (Revit name, BuiltInParameter or '', categories or None))\nBUILTIN_MAP = {\n    'manufacturer': ('Manufacturer', 'ALL_MODEL_MANUFACTURER', None),\n    'model': ('Model', 'ALL_MODEL_MODEL', None), 'modelnumber': ('Model', 'ALL_MODEL_MODEL', None),\n    'description': ('Description', 'ALL_MODEL_DESCRIPTION', None),\n    'mark': ('Mark', 'ALL_MODEL_MARK', None), 'typemark': ('Type Mark', 'ALL_MODEL_TYPE_MARK', None),\n    'name': ('Mark', 'ALL_MODEL_MARK', None), 'assetname': ('Mark', 'ALL_MODEL_MARK', None),\n    'cost': ('Cost', 'ALL_MODEL_COST', None), 'url': ('URL', 'ALL_MODEL_URL', None),\n    'comments': ('Comments', 'ALL_MODEL_INSTANCE_COMMENTS', None), 'keynote': ('Keynote', 'KEYNOTE_PARAM', None),\n    'level': ('Level', '', None), 'assettype': ('Type', '', None), 'type': ('Type', '', None),\n    'modelelementguid': ('IfcGUID', '', None), 'guid': ('IfcGUID', '', None), 'ifcguid': ('IfcGUID', '', None),\n    'classificationcode': ('Assembly Code', '', None), 'classification': ('Assembly Code', '', None),\n    'site': ('Project Information', '', None), 'building': ('Project Information', '', None),\n    'spaceroom': ('Room', '', None), 'space': ('Room', '', None), 'room': ('Room', '', None),\n    'firerating': ('Fire Rating', 'DOOR_FIRE_RATING', ['Doors']),\n    'floorfinish': ('Floor Finish', 'ROOM_FINISH_FLOOR', ['Rooms']),\n    'ceilingfinish': ('Ceiling Finish', 'ROOM_FINISH_CEILING', ['Rooms']),\n    'wallfinish': ('Wall Finish', 'ROOM_FINISH_WALL', ['Rooms']), 'basefinish': ('Base Finish', 'ROOM_FINISH_BASE', ['Rooms']),\n}\n\n\ndef builtin_for(attr, category):\n    b = BUILTIN_MAP.get(key(attr))\n    if b and (b[2] is None or category in b[2]):\n        return b\n    return None\n\n\n# ===================================================================== analysis\ndef _has_any(d, keys):\n    \"\"\"plain loop: IronPython (pyRevit tracing) cannot compile a generator over a tuple literal\"\"\"\n    for k in keys:\n        if k in d:\n            return True\n    return False\n\n\ndef _issue(issues, sev, area, detail, action='', source=''):\n    issues.append({'severity': sev, 'area': area, 'detail': detail, 'action': action, 'source': source})\n\n\nIMPORT_SLOTS = ['BEP', 'MIDP', 'AIR', 'COBIE', 'FM', 'CHECKLIST', 'WORKFLOW', 'MATERIALS']\n\n\ndef _manual(req_manual, item, why, how, source=''):\n    for m in req_manual:\n        if m['item'] == item:\n            return\n    req_manual.append({'item': item, 'why': why, 'how': how, 'source': source})\n\n\ndef merge_manual(a, b):\n    out = list(a)\n    have = [m_['item'] for m_ in a]\n    for m in b:\n        if m['item'] not in have:\n            out.append(m)\n            have.append(m['item'])\n    return out\n\n\ndef _better_copy(p):\n    \"\"\"a PDF with a Word / Excel copy of the same name beside it -> read the copy (tables survive)\"\"\"\n    if not p.lower().endswith('.pdf'):\n        return p\n    stem = os.path.splitext(p)[0]\n    for ext in ('.docx', '.xlsx', '.xlsm'):\n        if os.path.isfile(stem + ext):\n            return stem + ext\n    return p\n\n\ndef sheet_wanted(s, req, roles):\n    \"\"\"-> (create?, reason).  roles '' = our originator, 'AR,ST' = these disciplines, 'ALL' = every sheet\"\"\"\n    if not s['is_sheet']:\n        return False, 'not a sheet (' + (s['type'] or '?') + ')'\n    rl = [r_.strip().upper() for r_ in (roles or '').split(',') if r_.strip()]\n    if 'ALL' not in rl:\n        if rl:\n            if s['role'] and s['role'] not in rl:\n                return False, 'other discipline ' + s['role']\n        else:\n            own = (req['project'].get('originator') or '').upper()\n            if own and s.get('originator') and s['originator'].upper() != own:\n                return False, 'other originator ' + s['originator']\n    cur = req.get('current_stage_code')\n    if cur and s.get('stage_code') and s['stage_code'] != cur:\n        return False, 'later / other stage ' + s['stage_code']\n    if not s['valid']:\n        return False, 'SKIPPED - fix number'\n    return True, ''\n\n\nSHEET_WORDS = r'drawing|plan|section|elevation|detail|sheet|layout|schedule|diagram|sketch|presentation|general arrangement'\nNOT_SHEET_WORDS = r'model|report|register|specification|calculation|schedule of|minutes|programme|data|cobie|ifc'\n\n\ndef analyse(inputs):\n    \"\"\"inputs = list of (document type, file path) - one import slot per client document.\n    Reads each file, cross-checks them and builds one coordinated requirements set + issues + manual inputs.\"\"\"\n    issues = []\n    manual = []\n    docs = []\n    for typ, p in inputs:\n        if not os.path.isfile(p):\n            _issue(issues, 'HIGH', 'Documents', '%s file not found: %s' % (TYPE_LABEL.get(typ, typ), p), 'Pick the file again', '')\n            continue\n        use = _better_copy(p)\n        d = load_document(use)\n        d['type'] = typ\n        if use != p:\n            d['method'] += ' (Word/Excel copy of the PDF)'\n        guess = classify(d) if not d['error'] else 'OTHER'\n        if guess not in ('OTHER', typ) and not (typ == 'BEP' and guess == 'EIR') and not (typ in ('AIR', 'FM') and guess in ('AIR', 'FM')):\n            _issue(issues, 'LOW', 'Documents', '%s was imported as %s but looks like %s' % (\n                d['name'], TYPE_LABEL[typ], TYPE_LABEL[guess]), 'Check the import slot', d['name'])\n        docs.append(d)\n        if d['error']:\n            _issue(issues, 'HIGH', 'Documents', d['name'] + ': ' + d['error'], 'Fix the file and run again', d['name'])\n        elif not d['lines'] and not d['tables']:\n            _issue(issues, 'HIGH', 'Documents', d['name'] + ': no text found (scanned PDF?)',\n                   'Ask the client for a text PDF / Excel version', d['name'])\n        elif 'basic reader' in d['method']:\n            _issue(issues, 'MEDIUM', 'Documents', d['name'] + ': PDF read with the basic reader',\n                   'Check the extracted values in the report', d['name'])\n    if not docs:\n        raise Exception('No document imported - pick at least one file (BEP, schedule, AIR, COBie, FM, checklist, '\n                        'workflow or material register).')\n    present = set([d_['type'] for d_ in docs])\n    folder = os.path.dirname(docs[0]['path'])\n    bep_name = ', '.join([d_['name'] for d_ in docs if d_['type'] == 'BEP']) or 'no BEP imported'\n\n    # ---------------- facts with precedence\n    facts_all = {}\n    orgs = {}\n    for d in docs:\n        for k, (v, how) in extract_facts(d).items():\n            facts_all.setdefault(k, []).append({'value': v, 'doc': d['name'], 'type': d['type']})\n        for c, o in extract_orgs(d).items():\n            orgs.setdefault(c, o)\n    project = {}\n    for k, vals in facts_all.items():\n        vals.sort(key=lambda x: PRECEDENCE_FACTS.get(x['type'], 10))\n        project[k] = vals[0]['value']\n        distinct = {}\n        for v in vals:\n            distinct.setdefault(norm_spell(v['value']) if k != 'units' else _unit_key(v['value']), []).append(v)\n        if len(distinct) > 1:\n            listing = '; '.join(['\"%s\" (%s)' % (v_['value'], v_['doc']) for v_ in vals])\n            _issue(issues, 'HIGH' if k in ('project_number', 'project_code', 'originator', 'project_name') else 'MEDIUM',\n                   'Consistency', FACT_TITLE.get(k, k) + ' differs between documents: ' + listing,\n                   'Using \"%s\" from %s - confirm with the client' % (vals[0]['value'], vals[0]['doc']), vals[0]['doc'])\n        elif len(set([norm(v_['value']) for v_ in vals])) > 1 and k != 'units':\n            listing = '; '.join(['\"%s\" (%s)' % (v_['value'], v_['doc']) for v_ in vals])\n            _issue(issues, 'LOW', 'Consistency', FACT_TITLE.get(k, k) + ' spelled differently: ' + listing,\n                   'Using \"%s\" - ask the client for one spelling' % vals[0]['value'], vals[0]['doc'])\n    if not project.get('project_number') and project.get('project_code'):\n        project['project_number'] = project['project_code']\n        _issue(issues, 'LOW', 'BEP content', 'No separate project number - project code %s used as Project Number'\n               % project['project_code'], 'Confirm with the client', bep_name)\n\n    # ---------------- naming + codes (BEP first)\n    order = sorted(docs, key=lambda d: PRECEDENCE_FACTS.get(d['type'], 10))\n    naming = {'fields': None, 'example': None, 'sep': '-', 'codes': {}, 'digits': None, 'source': '', 'lengths': {},\n              'level_number': False}\n    status_sets = []\n    status_names = []\n    worksets, ws_patterns, loin, revision, steps, stages = [], [], [], [], [], []\n    material_rule, code_param = None, None\n    for d in order:\n        n = extract_naming(d)\n        if n['fields'] and not naming['fields']:\n            naming['fields'], naming['source'] = n['fields'], d['name']\n            naming['lengths'], naming['level_number'] = n['lengths'], n['level_number']\n        if n['example'] and not naming['example']:\n            naming['example'], naming['sep'] = n['example'], n['sep']\n        if n['digits'] and not naming['digits']:\n            naming['digits'] = n['digits']\n        for f, codes in n['codes'].items():\n            if not codes:\n                continue\n            if f not in naming['codes']:\n                naming['codes'][f] = {'codes': dict(codes), 'source': d['name']}\n            elif naming['codes'][f]['source'] == d['name']:\n                naming['codes'][f]['codes'].update(codes)\n            else:\n                extra = set(codes) - set(naming['codes'][f]['codes'])\n                if extra:\n                    _issue(issues, 'MEDIUM', 'Consistency', '%s codes %s in %s are not in %s' % (\n                        f, ', '.join(sorted(extra)), d['name'], naming['codes'][f]['source']), 'Both accepted - confirm', d['name'])\n                    naming['codes'][f]['codes'].update(codes)\n        if n['status']:\n            status_sets.append((d['name'], n['status']))\n            status_names += [x_ for x_ in n['status_names'] if x_ not in status_names]\n        if n['worksets'] and not worksets:\n            worksets = [w_.strip() for w_ in n['worksets'] if w_.strip()]\n        ws_patterns += [p_ for p_ in n['workset_patterns'] if p_ not in ws_patterns]\n        if n['loin'] and not loin:\n            loin = n['loin']\n        for r in n['revision']:\n            if r not in revision:\n                revision.append(r)\n        if n['steps'] and d['type'] == 'WORKFLOW':\n            steps.extend(n['steps'])\n        if n['stages'] and not stages:\n            stages = n['stages']\n        material_rule = material_rule or n['material_rule']\n        code_param = code_param or n['code_param']\n    if orgs:                                                    # every stakeholder code is a valid originator\n        oc = naming['codes'].setdefault('Originator', {'codes': {}, 'source': 'stakeholder table'})\n        for c, (org, role) in orgs.items():\n            oc['codes'].setdefault(c, org)\n    if not naming['fields'] and naming['example']:\n        if len(re.split(r'[-_]', naming['example'])) == 7:\n            naming['fields'] = ['Project', 'Originator', 'Volume', 'Level', 'Type', 'Role', 'Number']\n            _issue(issues, 'MEDIUM', 'Naming', 'Naming field names not stated - assumed ISO 19650 order from the example '\n                   + naming['example'], 'Confirm the field order', naming['source'])\n    if naming['example'] and not naming['digits']:\n        last = re.split(r'[-_]', naming['example'])[-1]\n        if last.isdigit():\n            naming['digits'] = len(last)\n    status = {}\n    if status_sets:\n        base_name, base = status_sets[0]\n        status = dict(base)\n        for nm, st in status_sets[1:]:\n            a, b = set(base), set(st)\n            if a != b:\n                msg = []\n                if b - a:\n                    msg.append('%s has %s not in %s' % (nm, ', '.join(sorted(b - a)), base_name))\n                if a - b:\n                    msg.append('%s has %s not in %s' % (base_name, ', '.join(sorted(a - b)), nm))\n                _issue(issues, 'MEDIUM', 'Consistency', 'Status codes differ: ' + '; '.join(msg),\n                       'Both lists accepted for checking - confirm with the client', nm)\n            for c, v in st.items():\n                status.setdefault(c, v)\n    if not revision:\n        revision = ['P', 'C']\n    naming['regex'], naming['rules'] = build_naming_rules(naming, project)\n\n    # ---------------- stages: order + current stage (from milestone dates)\n    del STAGE_ORDER[:]\n    for s in stages:\n        STAGE_ORDER.append((s['code'], norm(s['name'])))\n    current_code, current_note = None, ''\n    today = datetime.date.today()\n    if stages:\n        cur = None\n        for s in stages:\n            if s['start'] and s['end'] and s['start'] <= today <= s['end']:\n                cur = s\n                break\n        if cur is None:\n            future = [s_ for s_ in stages if (s_['end'] or s_['start']) and (s_['end'] or s_['start']) >= today]\n            cur = future[0] if future else stages[-1]\n        current_code = cur['code'] or None\n        current_note = '%s %s' % (cur['code'], cur['name'])\n        if not project.get('stage'):\n            project['stage'] = current_note.strip() + ' (from the milestone dates)'\n    current_stage = stage_num(project.get('stage', ''))\n\n    # ---------------- BEP mandatory content (ISO 19650-2 5.3.2 / 5.4.1 / 5.1.4)\n    need = [('project_name', 'Project name'), ('project_number', 'Project number'), ('client', 'Client / appointing party'),\n            ('originator', 'Originator code'), ('units', 'Units'), ('coordinate_system', 'Shared coordinate system (5.1.4)'),\n            ('cde', 'CDE solution (5.1.7)'), ('software', 'Authoring software / version'), ('ifc', 'Open exchange format'),\n            ('stage', 'Current project stage')]\n    for k, title in need:\n        if not project.get(k):\n            _issue(issues, 'HIGH' if k in ('project_number', 'originator', 'coordinate_system') else 'MEDIUM', 'BEP content',\n                   title + ' not found in the imported documents', 'Ask the client / add it to the BEP', bep_name)\n            _manual(manual, title, 'Not stated in the imported documents (%s)' % bep_name,\n                    'Get it from the client; enter it in Revit (Manage > Project Information)' if k in (\n                        'project_name', 'project_number', 'client', 'stage') else 'Get it from the client', bep_name)\n    if project.get('coordinate_system'):\n        _manual(manual, 'Shared coordinates / survey point', 'Revit cannot set survey coordinates from a document: '\n                + project['coordinate_system'], 'Acquire coordinates from the survey / site model (Manage > Coordinates)',\n                bep_name)\n    if not naming['fields']:\n        _issue(issues, 'HIGH', 'BEP content', 'File / container naming convention not found',\n               'Ask the client for the naming convention (ISO 19650-2 5.1.4)', bep_name)\n        _manual(manual, 'Naming convention', 'Not found - sheet numbers and names cannot be checked', 'Ask the client', bep_name)\n    for f in ('Volume', 'Level', 'Type', 'Role'):\n        if naming['fields'] and f in naming['fields'] and f not in naming['codes']:\n            _issue(issues, 'MEDIUM', 'BEP content', '%s code list not found - %s field only checked for length' % (f, f),\n                   'Ask for the ' + f.lower() + ' code list', bep_name)\n    if not status:\n        _issue(issues, 'MEDIUM', 'BEP content', 'Status / suitability codes not found', 'Ask for the status code list', bep_name)\n    if not worksets and 'BEP' in present:\n        _issue(issues, 'LOW', 'BEP content', 'No workset list found', 'Office standard worksets can be used', bep_name)\n    if ws_patterns:\n        _manual(manual, 'Worksets by pattern ' + ', '.join(ws_patterns), 'The BEP gives a naming pattern, not names',\n                'Create them per discipline / zone (Collaborate > Worksets)', bep_name)\n    if not loin and 'BEP' in present:\n        _issue(issues, 'MEDIUM', 'BEP content', 'Level of information need (LOIN) not found', 'Ask for the LOIN table', bep_name)\n    if not material_rule and 'MATERIALS' in present:\n        _issue(issues, 'LOW', 'BEP content', 'No material naming rule found - using \"<Code> <Name>\"', '', bep_name)\n    if 'BEP' in present and not any(['responsib' in norm(' '.join(d_['lines'])) for d_ in docs if d_['type'] == 'BEP']):\n        _issue(issues, 'MEDIUM', 'BEP content', 'No responsibility matrix found (ISO 19650-2 5.3.3)', 'Ask for it', bep_name)\n        _manual(manual, 'Responsibility matrix', 'Not in the BEP (ISO 19650-2 5.3.3)', 'Ask the client', bep_name)\n\n    # ---------------- deliverables (execution schedule only)\n    type_desc = dict([(c_, norm(v_)) for c_, v_ in naming['codes'].get('Type', {}).get('codes', {}).items()])\n    allowed_status = set(status) | set(status_names)\n    sheets = []\n    seen = {}\n    for d in docs:\n        if d['type'] != 'MIDP':\n            continue\n        tables = d['tables']\n        master = [t_ for t_ in tables if re.search(r'\\b(midp|master)\\b', norm(t_['title']))]\n        for t in (master or tables):\n            cols, recs, hdr = find_table(t['rows'], 'deliverables')\n            if not cols or not _has_any(cols, ['type', 'scale', 'due', 'status', 'stage']):\n                continue\n            for r in recs:\n                num = _s(r.get('number')).replace(' ', '')\n                if not num or not re.search(r'[-_]', num):\n                    continue\n                fields = split_name(num, naming) or {}\n                s = {'number': num, 'name': _s(r.get('title')), 'type': (_s(r.get('type')) or fields.get('Type', '')).upper(),\n                     'role': (fields.get('Role') or _s(r.get('role'))).upper(),\n                     'originator': (_s(r.get('originator')) or fields.get('Originator', '')).upper(),\n                     'scale': _s(r.get('scale')), 'size': _s(r.get('size')),\n                     'stage': _s(r.get('stage')) or fields.get('Stage', ''), 'status': _s(r.get('status')).upper(),\n                     'revision': _s(r.get('revision')).upper(), 'due': _xl_date(r.get('due')),\n                     'responsible': _s(r.get('responsible')) or _s(r.get('originator')), 'source': d['name'], 'problems': []}\n                s['stage_code'] = (fields.get('Stage') or s['stage']).upper() if (fields.get('Stage') or s['stage']) else ''\n                if len(s['stage_code']) > 4:\n                    s['stage_code'] = ''\n                ok, probs = check_name(num, naming)\n                s['problems'].extend(probs)\n                if fields and r.get('type') and fields.get('Type') and fields.get('Type') != _s(r.get('type')).upper():\n                    s['problems'].append('Type column %s but number says %s' % (_s(r.get('type')).upper(), fields.get('Type')))\n                if s['status'] and allowed_status and s['status'] not in allowed_status and norm(s['status']) not in allowed_status:\n                    s['problems'].append('status %s not in the status code list' % s['status'])\n                if s['revision'] and not re.match(r'^(' + '|'.join(revision) + r')\\d{2}(\\.\\d+)?$', s['revision']):\n                    s['problems'].append('revision %s not in format %s' % (s['revision'], '/'.join([r_ + '01' for r_ in revision])))\n                base = s['name'].rsplit(' - ', 1)[0].strip().lower() if ' - ' in s['name'] else s['name'].strip().lower()\n                when = (_s(r.get('milestone')), s['due'])\n                if num in seen:\n                    first = seen[num]\n                    if first[1] != base or first[2] == when:\n                        s['problems'].append('duplicate number (also \"%s\")' % first[0])\n                        s['duplicate'] = True\n                    else:\n                        s['repeat'] = True                      # same container at a later milestone (new revision)\n                else:\n                    seen[num] = (s['name'], base, when)\n                if not s['name']:\n                    s['problems'].append('no title')\n                if 'due' in cols and not s['due']:\n                    s['problems'].append('no due date')\n                td = type_desc.get(s['type'], '')\n                s['is_sheet'] = bool((td and re.search(SHEET_WORDS, td) and not re.search(NOT_SHEET_WORDS, td)) or\n                                     (not td and s['type'] in ('DR', 'SH', 'DW', 'SK', 'GA', 'SE', 'EL', 'DT', 'PP')) or\n                                     (not s['type'] and bool(s['scale'])))\n                if s['is_sheet'] and 'scale' in cols and not s['scale']:\n                    s['problems'].append('no scale')\n                s['valid'] = ok and not s.get('duplicate')\n                sheets.append(s)\n                if s['problems']:\n                    _issue(issues, 'HIGH' if not s['valid'] else 'LOW', 'Deliverables',\n                           '%s \"%s\": %s' % (num, s['name'], '; '.join(s['problems'])),\n                           'Correct the schedule' if not s['valid'] else 'Complete the schedule row', d['name'])\n    if not sheets and 'MIDP' in present:\n        _issue(issues, 'HIGH', 'Deliverables', 'Execution schedule found but no deliverable table recognised',\n               'Columns needed: Document Number / Container ID + Title (+ Type / Due Date)', '')\n    bad = [s_ for s_ in sheets if not s_['valid']]\n    if bad:\n        _manual(manual, 'Deliverable numbers to correct (%d)' % len(bad),\n                'Not created as sheets - number breaks the naming convention or is a duplicate: ' +\n                ', '.join([s_['number'] for s_ in bad[:8]]), 'Ask for a corrected schedule, then import it again',\n                bad[0]['source'])\n    nodue = [s_ for s_ in sheets if 'no due date' in s_['problems']]\n    if nodue:\n        _manual(manual, 'Deliverables without due date (%d)' % len(nodue),\n                ', '.join([s_['number'] for s_ in nodue[:8]]), 'Complete the execution schedule', nodue[0]['source'])\n\n    # ---------------- parameters: AIR, FM, BEP / EIR tables + COBie columns\n    plist = {}                                        # (category, key(attr)) -> param record\n    no_dtype, no_cat = {}, {}\n\n    def add_param(attr, cat, dtype, unit, stage, binding, required, desc, src_doc, src_type, group, cobie):\n        k = (cat or '', key(attr))\n        rec = plist.get(k)\n        entry = {'doc': src_doc, 'type': src_type, 'datatype': dtype, 'binding': binding, 'stage': stage}\n        if rec is None:\n            plist[k] = {'name': attr, 'category': cat, 'datatype': dtype, 'unit': unit, 'stage': stage,\n                        'binding': binding, 'required': required, 'description': desc, 'group': group, 'sources': [entry],\n                        'builtin': None, 'cobie': cobie}\n            return\n        rec['sources'].append(entry)\n        pr_new = PRECEDENCE_PARAMS.get(src_type, 9)\n        pr_old = min([PRECEDENCE_PARAMS.get(s_['type'], 9) for s_ in rec['sources'][:-1]])\n        if dtype and rec['datatype'] and dtype != rec['datatype']:\n            win = rec['datatype'] if pr_old <= pr_new else dtype\n            _issue(issues, 'MEDIUM', 'Parameters', '%s (%s): data type %s in %s, but %s in %s' % (\n                rec['name'], cat or 'all', dtype, src_doc, rec['datatype'],\n                ', '.join(sorted(set([s_['doc'] for s_ in rec['sources'][:-1]])))),\n                'Using %s (precedence AIR > FM > BEP > COBie) - confirm with the client' % win, src_doc)\n            rec['datatype'] = win\n        elif dtype and not rec['datatype']:\n            rec['datatype'] = dtype\n        if binding and rec['binding'] and binding != rec['binding']:\n            _issue(issues, 'LOW', 'Parameters', '%s (%s): %s in one document, %s in another' % (\n                rec['name'], cat, rec['binding'], binding), 'Using ' + rec['binding'], src_doc)\n        rec['binding'] = rec['binding'] or binding\n        if stage is not None and (rec['stage'] is None or stage < rec['stage']):\n            rec['stage'] = stage\n        rec['unit'] = rec['unit'] or unit\n        rec['description'] = rec['description'] or desc\n        rec['cobie'] = rec['cobie'] or cobie\n\n    for d in sorted(docs, key=lambda d: PRECEDENCE_PARAMS.get(d['type'], 9)):\n        if d['type'] not in ('AIR', 'FM', 'BEP', 'EIR'):\n            continue\n        for t in d['tables']:\n            cols, recs, hdr = find_table(t['rows'], 'params')\n            if not cols or not _has_any(cols, ['datatype', 'category', 'cobie']):\n                continue\n            if d['type'] == 'BEP' and 'datatype' not in cols:\n                continue\n            for r in recs:\n                attr = clean_param_name(r.get('attribute'))\n                if not attr or len(attr) > 60 or '*' in attr or attr.lower().startswith(('pset_', 'qto_')):\n                    continue\n                req_flag = norm(r.get('required', ''))\n                if req_flag in ('no', 'n', 'optional', 'false'):\n                    continue\n                dt = norm_dtype(r.get('datatype', ''))\n                cobie = _s(r.get('cobie'))\n                cats = norm_categories(r.get('category', '')) if r.get('category') else []\n                if not cats:\n                    # a COBie Space.* field belongs to rooms; otherwise wait for another document to give the category\n                    cats = ['Rooms'] if norm(cobie).startswith('space ') else [None]\n                for cat in cats:\n                    add_param(attr, cat, dt, _s(r.get('unit')), stage_num(r.get('stage', '')),\n                              norm_binding(r.get('binding', ''), cat, cobie), req_flag or 'yes', _s(r.get('description')),\n                              d['name'], d['type'], {'AIR': 'AIR', 'FM': 'FM'}.get(d['type'], 'BEP'), cobie)\n    # attributes listed without category in one document but with categories in another -> drop the empty one\n    for k in list(plist.keys()):\n        if k[0] == '' and any([kk_[1] == k[1] and kk_[0] for kk_ in plist]):\n            rec = plist.pop(k)\n            for kk, other in plist.items():\n                if kk[1] == k[1]:\n                    other['sources'] += [s_ for s_ in rec['sources'] if s_ not in other['sources']]\n                    other['datatype'] = other['datatype'] or rec['datatype']\n                    other['cobie'] = other['cobie'] or rec['cobie']\n                    if rec['stage'] is not None and (other['stage'] is None or rec['stage'] < other['stage']):\n                        other['stage'] = rec['stage']\n    air_cats = sorted(set([p_['category'] for p_ in plist.values() if p_['category'] and p_['category'] not in\n                          ('Rooms', 'Spaces', 'Project Information', 'Sheets', 'Materials')]))\n    if 'AIR' in present:\n        seen_fm = set()\n        for p in plist.values():\n            types = set([s_['type'] for s_ in p['sources']])\n            if 'AIR' not in types and types & set(['FM', 'EIR', 'BEP']) and key(p['name']) not in seen_fm:\n                seen_fm.add(key(p['name']))\n                _issue(issues, 'LOW', 'Parameters', '%s is required by %s but not in the AIR' % (\n                    p['name'], p['sources'][0]['doc']), 'Added to the setup - ask the client to add it to the AIR',\n                    p['sources'][0]['doc'])\n    # COBie\n    cobie = {'sheets': [], 'params': [], 'source': ''}\n    for d in docs:\n        if d['type'] != 'COBIE':\n            continue\n        cobie['source'] = d['name']\n        for t in d['tables']:\n            title = t['title'].strip()\n            cobie['sheets'].append(title)\n            if title not in COBIE_SKIP or not t['rows']:\n                continue\n            hdr = [c_ for c_ in t['rows'][0] if c_]\n            for col in hdr:\n                kc = key(col)\n                if kc in COBIE_SKIP[title]:\n                    continue\n                if title == 'Space':\n                    cats, binding = ['Rooms'], 'Instance'\n                else:\n                    cats, binding = air_cats or ASSET_CATS, ('Type' if title == 'Type' else 'Instance')\n                dtype = COBIE_DTYPE.get(kc, 'Text')\n                ref = key(title + '.' + col)\n                same = [p_ for p_ in plist.values() if key(p_['name']) == kc or key(p_.get('cobie')) == ref]\n                for p in same:\n                    if p['datatype'] and p['datatype'] != dtype and not (p['datatype'] == 'Integer' and dtype == 'Number'):\n                        _issue(issues, 'MEDIUM', 'Parameters', 'COBie %s.%s is %s, but %s (%s) is %s in %s' % (\n                            title, col, dtype, p['name'], p['category'], p['datatype'], p['sources'][0]['doc']),\n                            'AIR/FM value kept - COBie export must convert', d['name'])\n                covered = set([p_['category'] for p_ in same])\n                rest = [c_ for c_ in cats if c_ not in covered]\n                names = []\n                for p in same:\n                    if p['name'] not in names:\n                        names.append(p['name'])\n                cobie['params'].append({'sheet': title, 'column': col, 'name': 'COBie.%s.%s' % (title, col),\n                                        'datatype': dtype, 'binding': binding, 'categories': rest,\n                                        'mapped_to': names, 'builtin': (BUILTIN_MAP.get(kc) or [None])[0]})\n        fac = [t_ for t_ in d['tables'] if t_['title'].strip().lower() == 'facility']\n        if fac and len([r_ for r_ in fac[0]['rows'] if any(r_)]) < 2:\n            _issue(issues, 'LOW', 'COBie', 'COBie Facility sheet is empty', 'Filled from the model at handover', d['name'])\n    params = []\n    for p in plist.values():\n        if not p['category']:\n            no_cat.setdefault(p['name'], p['sources'][0]['doc'])\n            continue\n        if not p['datatype']:\n            no_dtype.setdefault(p['name'], p['sources'][0]['doc'])\n            p['datatype'] = 'Text'\n        if not p['binding']:\n            p['binding'] = 'Instance' if p['category'] in ('Rooms', 'Spaces') else 'Type'\n        b = builtin_for(p['name'], p['category'])\n        if b:\n            p['builtin'] = b[0]\n            p['builtin_id'] = b[1]\n        p['required_now'] = bool(current_stage and p['stage'] and p['stage'] <= current_stage)\n        params.append(p)\n    params.sort(key=lambda p: (p['category'] or '', p['name']))\n    if no_dtype:\n        _issue(issues, 'MEDIUM', 'Parameters', 'No data type for %d attribute(s): %s' % (len(no_dtype), ', '.join(sorted(no_dtype))),\n               'Created as Text - ask the client', list(no_dtype.values())[0])\n        _manual(manual, 'Data type of %d attribute(s)' % len(no_dtype), ', '.join(sorted(no_dtype)) + ' - created as Text',\n                'Ask the client; change the parameter type if needed', list(no_dtype.values())[0])\n    if no_cat:\n        _issue(issues, 'MEDIUM', 'Parameters', 'No category for %d attribute(s): %s' % (len(no_cat), ', '.join(sorted(no_cat))),\n               'Not created - add the category / \"applies to\"', list(no_cat.values())[0])\n        _manual(manual, 'Category of %d attribute(s)' % len(no_cat), ', '.join(sorted(no_cat)) + ' - not created',\n                'Ask the client which Revit categories they apply to', list(no_cat.values())[0])\n\n    # ---------------- ISO 19650 checklist (checklist document only)\n    checklist = []\n    counts = {}\n    for d in docs:\n        if d['type'] != 'CHECKLIST':\n            continue\n        for t in d['tables']:\n            cols, recs, hdr = find_table(t['rows'], 'checklist')\n            if not cols or not _has_any(cols, ['status', 'closed', 'action']):\n                continue\n            open_list = bool(re.search(r'\\bopen\\b', norm(t['title'])))\n            for r in recs:\n                if not r.get('requirement'):\n                    continue\n                if norm(r.get('applicability', '')) in ('not applicable', 'n a', 'na'):\n                    continue\n                st = norm(r.get('status', ''))\n                if open_list:\n                    cls = 'closed' if _s(r.get('closed')) else 'open'\n                elif st in ('yes', 'y', 'complete', 'completed', 'compliant', 'done', 'closed', 'pass', 'met'):\n                    cls = 'compliant'\n                elif st in ('no', 'n', 'open', 'not started', 'pending', 'non compliant', 'not compliant', 'fail', 'false', 'x'):\n                    cls = 'open'\n                elif st in ('partial', 'partially', 'in progress', 'ongoing', 'partly compliant'):\n                    cls = 'partial'\n                elif st in ('n a', 'na', 'not applicable'):\n                    continue\n                else:\n                    cls = 'not assessed'\n                item = {'ref': _s(r.get('ref')), 'requirement': _s(r.get('requirement')), 'clause': _s(r.get('clause')),\n                        'status': _s(r.get('status')) or ('open item' if open_list else ''), 'comment': _s(r.get('comment') or r.get('action')),\n                        'class': cls, 'source': d['name'] + ' / ' + t['title']}\n                checklist.append(item)\n                counts[cls] = counts.get(cls, 0) + 1\n                if cls in ('open', 'partial'):\n                    _issue(issues, 'HIGH' if cls == 'open' else 'MEDIUM', 'ISO 19650 checklist', '%s %s - %s%s' % (\n                        item['ref'], item['requirement'], cls, (' (' + item['comment'][:120] + ')') if item['comment'] else ''),\n                        'Close before the next information exchange', d['name'])\n    if counts.get('not assessed'):\n        _issue(issues, 'MEDIUM', 'ISO 19650 checklist', '%d checklist items not assessed yet (%d compliant)' % (\n            counts['not assessed'], counts.get('compliant', 0)), 'Assess them with the BIM manager', '')\n    open_items = [c_ for c_ in checklist if c_['class'] in ('open', 'partial')]\n    if open_items:\n        _manual(manual, 'ISO 19650 checklist items open (%d)' % len(open_items),\n                '; '.join(['%s %s' % (c_['ref'], c_['requirement'][:60]) for c_ in open_items[:6]]),\n                'Close with the client / delivery team - cannot be done in Revit', open_items[0]['source'])\n\n    # ---------------- material register (material register document only)\n    register = []\n    for d in docs:\n        if d['type'] != 'MATERIALS':\n            continue\n        for t in d['tables']:\n            cols, recs, hdr = find_table(t['rows'], 'materials')\n            if not cols:\n                continue\n            for r in recs:\n                code, name = _s(r.get('code')), _s(r.get('name'))\n                if not code and not name:\n                    continue\n                appr = norm(r.get('approved', ''))\n                register.append({'code': code, 'name': name, 'category': _s(r.get('category')),\n                                 'description': _s(r.get('description')), 'manufacturer': _s(r.get('manufacturer')),\n                                 'product': _s(r.get('product')),\n                                 'approved': not (appr in ('n', 'no', 'rejected', 'not approved', 'false', 'pending', 'withdrawn')),\n                                 'source': d['name']})\n            if register:\n                break\n    codes = {}\n    names = {}\n    for m in register:\n        if not m['code']:\n            _issue(issues, 'HIGH', 'Material register', 'Material \"%s\" has no code' % m['name'], 'Ask the client', m['source'])\n        if not m['name']:\n            _issue(issues, 'HIGH', 'Material register', 'Code %s has no name' % m['code'], 'Ask the client', m['source'])\n        if m['code']:\n            codes.setdefault(m['code'].upper(), []).append(m)\n        if m['name']:\n            names.setdefault(norm(m['name']), []).append(m)\n        if not m['approved']:\n            _issue(issues, 'MEDIUM', 'Material register', '%s %s is NOT approved' % (m['code'], m['name']),\n                   'Must not be used in the model', m['source'])\n        miss = [f_ for f_ in ('description', 'manufacturer') if not m[f_]]\n        if miss and m['code']:\n            _issue(issues, 'LOW', 'Material register', '%s %s: no %s' % (m['code'], m['name'], ' / '.join(miss)),\n                   'Ask the client to complete the register', m['source'])\n    for c, ms in codes.items():\n        if len(ms) > 1:\n            _issue(issues, 'HIGH', 'Material register', 'Code %s used for %d materials: %s' % (\n                c, len(ms), '; '.join([m_['name'] for m_ in ms])), 'Ask the client for unique codes - only the first is used',\n                ms[0]['source'])\n            for m in ms[1:]:\n                m['duplicate'] = True\n    for n, ms in names.items():\n        if len(ms) > 1 and len(set([m_['code'] for m_ in ms])) > 1:\n            _issue(issues, 'MEDIUM', 'Material register', 'Material name \"%s\" has codes %s' % (\n                ms[0]['name'], ', '.join([m_['code'] for m_ in ms])), 'Ask the client', ms[0]['source'])\n    pats = {}\n    for m in register:\n        if m['code']:\n            pats.setdefault(_shape(m['code']), []).append(m['code'])\n    code_regex = None\n    if pats:\n        main = max(pats.items(), key=lambda kv: len(kv[1]))\n        code_regex = _shape_regex(main[1][0])\n        for sh, cs in pats.items():\n            if sh != main[0] and len(cs) < len(main[1]):\n                _issue(issues, 'LOW', 'Material register', 'Code format differs: %s (most codes look like %s)' % (\n                    ', '.join(cs), main[1][0]), 'Check with the client', '')\n    dup = [m_ for m_ in register if m_.get('duplicate')]\n    if dup:\n        _manual(manual, 'Duplicate material codes (%d)' % len(dup), ', '.join(['%s %s' % (m_['code'], m_['name']) for m_ in dup]),\n                'Ask the client for unique codes - these materials were not created', dup[0]['source'])\n\n    req = {\n        'tool': 'SD Tools A09', 'generated': datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), 'folder': folder,\n        'imported': sorted(present, key=lambda t: IMPORT_SLOTS.index(t) if t in IMPORT_SLOTS else 99),\n        'manual': manual,\n        'documents': [{'name': d_['name'], 'type': d_['type'], 'type_label': TYPE_LABEL[d_['type']], 'read_by': d_['method'],\n                       'error': d_['error'], 'lines': len(d_['lines']), 'tables': len(d_['tables'])} for d_ in docs],\n        'project': project, 'facts_all': facts_all, 'current_stage': current_stage, 'current_stage_code': current_code,\n        'stages': [{'code': s_['code'], 'name': s_['name'], 'start': _s(s_['start']), 'end': _s(s_['end'])} for s_ in stages],\n        'naming': naming, 'status_codes': status, 'status_names': status_names, 'revision_prefixes': revision,\n        'worksets': worksets, 'loin': loin, 'workflow_steps': steps[:20], 'sheets': sheets, 'parameters': params,\n        'cobie': cobie, 'checklist': checklist, 'checklist_counts': counts,\n        'materials': {'register': register, 'rule': material_rule or '<Code> <Name>', 'code_param': code_param or 'Mark',\n                      'code_regex': code_regex},\n        'issues': issues,\n    }\n    req['project_parameters'] = project_parameter_list(req)\n    req['sheet_parameters'] = [{'name': n_, 'datatype': 'Text'} for n_ in\n                               ('BEP_StatusCode', 'BEP_RevisionCode', 'BEP_DueDate', 'BEP_Responsible', 'BEP_Stage')]\n    return req, docs\n\n\ndef _unit_key(v):\n    t = norm_spell(v)\n    for u, k in (('millimeter', 'mm'), (' mm', 'mm'), ('mm', 'mm'), ('centimeter', 'cm'), ('meter', 'm'),\n                 ('feet', 'ft'), ('foot', 'ft'), ('inch', 'ft')):\n        if u in ' ' + t:\n            return k\n    return t\n\n\ndef _xl_date(v):\n    s = _s(v)\n    if re.match(r'^\\d{5}(\\.0+)?$', s):\n        try:\n            return (datetime.date(1899, 12, 30) + datetime.timedelta(days=int(float(s)))).isoformat()\n        except Exception:\n            return s\n    return s\n\n\ndef _shape(code):\n    return re.sub(r'[0-9]', '9', re.sub(r'[A-Za-z]', 'A', code))\n\n\ndef _shape_regex(code):\n    out = ''\n    for part in re.findall(r'[A-Za-z]+|[0-9]+|[^A-Za-z0-9]+', code):\n        if part[0].isalpha():\n            out += '[A-Z]{%d}' % len(part)\n        elif part[0].isdigit():\n            out += '[0-9]{%d}' % len(part)\n        else:\n            out += re.escape(part)\n    return out\n\n\ndef build_naming_rules(naming, project):\n    \"\"\"-> (regex string, per-field rules)\"\"\"\n    fields = naming.get('fields')\n    if not fields:\n        return None, []\n    ex = re.split(r'[-_]', naming['example']) if naming.get('example') else []\n    lengths = naming.get('lengths') or {}\n    rules = []\n    for i, f in enumerate(fields):\n        r = {'field': f, 'codes': None, 'fixed': None, 'length': None, 'minlen': None, 'maxlen': None, 'level_codes': None}\n        if f in naming['codes'] and f != 'Number':\n            r['codes'] = sorted(naming['codes'][f]['codes'].keys())\n        if f == 'Project' and project.get('project_code'):\n            r['fixed'] = project['project_code']\n        if f in lengths:\n            r['minlen'], r['maxlen'] = lengths[f]\n        if f == 'Number':\n            if naming.get('level_number') and 'Level' in naming['codes']:\n                r['level_codes'] = sorted(naming['codes']['Level']['codes'].keys())\n                r['digits'] = (lengths.get('Number', (4, 4))[1] - 2) if lengths.get('Number') else 2\n            else:\n                r['digits'] = naming.get('digits') or (len(ex[i]) if i < len(ex) and ex[i].isdigit() else None) or \\\n                    (lengths['Number'][1] if 'Number' in lengths and lengths['Number'][0] == lengths['Number'][1] else None)\n        if i < len(ex):\n            r['length'] = len(ex[i])\n        rules.append(r)\n    parts = []\n    for r in rules:\n        if r['field'] == 'Number' and r.get('level_codes'):\n            parts.append('(?:' + '|'.join([re.escape(c_) for c_ in r['level_codes']]) + ')[0-9]{%d}' % r['digits'])\n        elif r['field'] == 'Number' and r.get('digits'):\n            parts.append('[0-9]{%d}' % r['digits'])\n        elif r['codes']:\n            parts.append('(?:' + '|'.join([re.escape(c_) for c_ in r['codes']]) + ')')\n        elif r['fixed']:\n            parts.append(re.escape(r['fixed']))\n        elif r['minlen']:\n            parts.append('[A-Z0-9]{%d,%d}' % (r['minlen'], r['maxlen']))\n        else:\n            parts.append('[A-Z0-9]{1,8}')\n    return '^' + re.escape(naming.get('sep') or '-').join(parts) + '$', rules\n\n\ndef split_name(num, naming):\n    fields = naming.get('fields')\n    if not fields:\n        return None\n    parts = re.split(r'[-_]', num)\n    if len(parts) != len(fields):\n        return None\n    return dict(zip(fields, parts))\n\n\ndef check_name(num, naming):\n    \"\"\"-> (ok, [problems]) for a container name / sheet number\"\"\"\n    fields = naming.get('fields')\n    if not fields:\n        return True, []\n    sep = naming.get('sep') or '-'\n    parts = num.split(sep)\n    probs = []\n    if len(parts) != len(fields):\n        return False, ['%d fields, the BEP needs %d (%s)' % (len(parts), len(fields), sep.join(fields))]\n    for p, r in zip(parts, naming.get('rules') or []):\n        f = r['field']\n        if r.get('fixed') and p != r['fixed']:\n            probs.append('%s \"%s\" should be %s' % (f, p, r['fixed']))\n        elif r.get('codes') and p not in r['codes']:\n            probs.append('%s code \"%s\" not in the BEP list (%s)' % (f, p, ', '.join(r['codes'][:12])))\n        elif f == 'Number' and r.get('level_codes'):\n            dg = r['digits']\n            if not (p[-dg:].isdigit() and p[:-dg] in r['level_codes']):\n                probs.append('Number \"%s\" should be a level code + %d digits (e.g. %s01)' % (p, dg, r['level_codes'][0]))\n        elif f == 'Number' and r.get('digits') and not (p.isdigit() and len(p) == r['digits']):\n            probs.append('Number \"%s\" should be %d digits' % (p, r['digits']))\n        elif r.get('minlen') and not (r['minlen'] <= len(p) <= r['maxlen']):\n            probs.append('%s \"%s\" should be %d-%d characters' % (f, p, r['minlen'], r['maxlen']))\n        elif p != p.upper():\n            probs.append('%s \"%s\" should be upper case' % (f, p))\n    return (not probs), probs\n\n\ndef project_parameter_list(req):\n    p = req['project']\n    rows = []\n    for name, k in (('BEP_ProjectCode', 'project_code'), ('BEP_OriginatorCode', 'originator'),\n                    ('BEP_AppointingParty', 'appointing_party'), ('BEP_LeadAppointedParty', 'lead_appointed_party'),\n                    ('BEP_ProjectStage', 'stage'), ('BEP_CDEPlatform', 'cde'), ('BEP_ExchangeFormat', 'ifc'),\n                    ('BEP_AuthoringSoftware', 'software'), ('BEP_CoordinateSystem', 'coordinate_system'),\n                    ('BEP_ClashTolerance', 'clash_tolerance'), ('BEP_Units', 'units')):\n        rows.append({'name': name, 'datatype': 'Text', 'value': p.get(k, '')})\n    rows.append({'name': 'BEP_NamingConvention', 'datatype': 'Text',\n                 'value': (req['naming'].get('sep') or '-').join(req['naming']['fields']) if req['naming'].get('fields') else ''})\n    return rows\n\n\n# ===================================================================== report (xlsx, no libraries)\ndef _xml(s):\n    s = _s(s)\n    s = re.sub(u'[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]', '', s)\n    return s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('\"', '&quot;')\n\n\ndef _colname(i):\n    s = ''\n    i += 1\n    while i:\n        i, r = divmod(i - 1, 26)\n        s = chr(65 + r) + s\n    return s\n\n\ndef write_xlsx(path, sheets):\n    \"\"\"sheets = [(title, header list, rows list, widths list or None)].  Bold header row, frozen, auto filter.\"\"\"\n    def sheet_xml(header, rows, widths):\n        allrows = [header] + rows\n        out = ['<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>',\n               '<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">',\n               '<sheetViews><sheetView workbookViewId=\"0\"><pane ySplit=\"1\" topLeftCell=\"A2\" activePane=\"bottomLeft\" '\n               'state=\"frozen\"/></sheetView></sheetViews>']\n        if widths:\n            out.append('<cols>' + ''.join(['<col min=\"%d\" max=\"%d\" width=\"%s\" customWidth=\"1\"/>' % (i_ + 1, i_ + 1, w_)\n                                          for i_, w_ in enumerate(widths)]) + '</cols>')\n        out.append('<sheetData>')\n        for ri, r in enumerate(allrows):\n            cells = []\n            for ci, v in enumerate(r):\n                ref = _colname(ci) + str(ri + 1)\n                style = ' s=\"1\"' if ri == 0 else (' s=\"2\"' if _s(v) in ('HIGH', 'FAIL', 'MISMATCH') else\n                                                  (' s=\"3\"' if _s(v) in ('MEDIUM', 'WARN') else\n                                                   (' s=\"4\"' if _s(v) in ('OK', 'PASS', 'DONE', 'CREATED') else '')))\n                if isinstance(v, (int, float)) and not isinstance(v, bool):\n                    cells.append('<c r=\"%s\"%s><v>%s</v></c>' % (ref, style, v))\n                else:\n                    cells.append('<c r=\"%s\" t=\"inlineStr\"%s><is><t xml:space=\"preserve\">%s</t></is></c>' % (ref, style, _xml(v)))\n            out.append('<row r=\"%d\">%s</row>' % (ri + 1, ''.join(cells)))\n        out.append('</sheetData>')\n        if header:\n            out.append('<autoFilter ref=\"A1:%s%d\"/>' % (_colname(len(header) - 1), len(allrows)))\n        out.append('</worksheet>')\n        return '\\n'.join(out)\n\n    styles = ('<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>'\n              '<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">'\n              '<fonts count=\"2\"><font><sz val=\"10\"/><name val=\"Arial\"/></font><font><b/><sz val=\"10\"/><color rgb=\"FFFFFFFF\"/>'\n              '<name val=\"Arial\"/></font></fonts>'\n              '<fills count=\"6\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill>'\n              '<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FF1F4E79\"/></patternFill></fill>'\n              '<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FFF8CBAD\"/></patternFill></fill>'\n              '<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FFFFE699\"/></patternFill></fill>'\n              '<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FFC6EFCE\"/></patternFill></fill></fills>'\n              '<borders count=\"1\"><border/></borders><cellStyleXfs count=\"1\"><xf/></cellStyleXfs>'\n              '<cellXfs count=\"5\"><xf fontId=\"0\" fillId=\"0\"><alignment vertical=\"top\" wrapText=\"1\"/></xf>'\n              '<xf fontId=\"1\" fillId=\"2\" applyFont=\"1\" applyFill=\"1\"><alignment vertical=\"top\" wrapText=\"1\"/></xf>'\n              '<xf fontId=\"0\" fillId=\"3\" applyFill=\"1\"><alignment vertical=\"top\" wrapText=\"1\"/></xf>'\n              '<xf fontId=\"0\" fillId=\"4\" applyFill=\"1\"><alignment vertical=\"top\" wrapText=\"1\"/></xf>'\n              '<xf fontId=\"0\" fillId=\"5\" applyFill=\"1\"><alignment vertical=\"top\" wrapText=\"1\"/></xf></cellXfs>'\n              '<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles></styleSheet>')\n    tmp = path + '.tmp'\n    z = zipfile.ZipFile(tmp, 'w', zipfile.ZIP_DEFLATED)\n    n = len(sheets)\n    z.writestr('[Content_Types].xml',\n               '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">'\n               '<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>'\n               '<Default Extension=\"xml\" ContentType=\"application/xml\"/>'\n               '<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>'\n               '<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>'\n               + ''.join(['<Override PartName=\"/xl/worksheets/sheet%d.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>' % (i_ + 1) for i_ in range(n)])\n               + '</Types>')\n    z.writestr('_rels/.rels', '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">'\n               '<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>')\n    used = set()\n    titles = []\n    for t, _, _, _ in sheets:\n        tt = re.sub(r'[\\[\\]:*?/\\\\]', '', t)[:31] or 'Sheet'\n        while tt in used:\n            tt = tt[:28] + str(len(used))\n        used.add(tt)\n        titles.append(tt)\n    z.writestr('xl/workbook.xml', '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" '\n               'xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets>'\n               + ''.join(['<sheet name=\"%s\" sheetId=\"%d\" r:id=\"rId%d\"/>' % (_xml(t_), i_ + 1, i_ + 1) for i_, t_ in enumerate(titles)])\n               + '</sheets></workbook>')\n    z.writestr('xl/_rels/workbook.xml.rels', '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">'\n               + ''.join(['<Relationship Id=\"rId%d\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet%d.xml\"/>' % (i_ + 1, i_ + 1) for i_ in range(n)])\n               + '<Relationship Id=\"rId%d\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/></Relationships>' % (n + 1))\n    z.writestr('xl/styles.xml', styles)\n    for i, (t, header, rows, widths) in enumerate(sheets):\n        data = sheet_xml(header, rows, widths)\n        z.writestr('xl/worksheets/sheet%d.xml' % (i + 1), data.encode('utf-8') if not isinstance(data, bytes) else data)\n    z.close()\n    try:\n        if os.path.exists(path):\n            os.remove(path)\n        os.rename(tmp, path)\n        return path\n    except Exception:\n        alt = os.path.splitext(path)[0] + '_' + datetime.datetime.now().strftime('%H%M%S') + '.xlsx'\n        os.rename(tmp, alt)\n        log('report was open (locked) - saved as ' + alt)\n        return alt\n\n\nSEV_ORDER = {'HIGH': 0, 'MEDIUM': 1, 'LOW': 2, 'INFO': 3}\n\n\ndef report_sheets(req, revit=None):\n    \"\"\"Build the report sheets from the requirements (+ Revit results when given).\"\"\"\n    sh = []\n    iss = sorted(req['issues'] + (revit or {}).get('issues', []), key=lambda i: SEV_ORDER.get(i['severity'], 9))\n    cnt = {}\n    for i in iss:\n        cnt[i['severity']] = cnt.get(i['severity'], 0) + 1\n    p = req['project']\n    summary = [['Generated', req['generated']], ['Documents folder', req['folder']],\n               ['Documents read', len(req['documents'])],\n               ['Issues HIGH / MEDIUM / LOW', '%d / %d / %d' % (cnt.get('HIGH', 0), cnt.get('MEDIUM', 0), cnt.get('LOW', 0))],\n               ['Current stage', req.get('current_stage') or 'not found']]\n    for k in ('project_name', 'project_number', 'project_code', 'client', 'originator', 'stage', 'units'):\n        summary.append([FACT_TITLE[k], p.get(k, '- not found -')])\n    nm = req['naming']\n    summary.append(['Naming convention', (nm.get('sep') or '-').join(nm['fields']) if nm.get('fields') else '- not found -'])\n    summary.append(['Naming example', nm.get('example') or ''])\n    summary.append(['Deliverables (MIDP rows)', len(req['sheets'])])\n    summary.append(['Parameters (AIR/FM)', len(req['parameters'])])\n    summary.append(['COBie parameters', len(req['cobie']['params'])])\n    summary.append(['Material register items', len(req['materials']['register'])])\n    if revit:\n        for line in revit.get('summary', []):\n            summary.append(['Revit', line])\n    sh.append(('Summary', ['Item', 'Value'], summary, [34, 110]))\n    man = merge_manual(req.get('manual', []), (revit or {}).get('manual', []))\n    sh.append(('MANUAL INPUT REQUIRED', ['#', 'What is needed', 'Why', 'How / where', 'Source'],\n               [[i_ + 1, m_['item'], m_['why'], m_['how'], m_['source']] for i_, m_ in enumerate(man)], [5, 40, 70, 55, 36]))\n    sh.append(('Issues', ['Severity', 'Area', 'Issue', 'Action / decision', 'Source'],\n               [[i_['severity'], i_['area'], i_['detail'], i_['action'], i_['source']] for i_ in iss], [10, 18, 90, 55, 38]))\n    sh.append(('Documents', ['File', 'Recognised as', 'Read by', 'Lines', 'Tables', 'Problem'],\n               [[d_['name'], d_['type_label'], d_['read_by'], d_['lines'], d_['tables'], d_['error']] for d_ in req['documents']],\n               [52, 34, 26, 8, 8, 40]))\n    rows = []\n    for k, vals in sorted(req['facts_all'].items()):\n        for i, v in enumerate(vals):\n            rows.append([FACT_TITLE.get(k, k), v['value'], v['doc'], 'USED' if i == 0 else ''])\n    sh.append(('Project data', ['Item', 'Value', 'Document', 'Used'], rows, [26, 50, 50, 8]))\n    rows = []\n    for r in nm.get('rules') or []:\n        rows.append(['Field', r['field'], ', '.join(r['codes']) if r['codes'] else (r['fixed'] or ''),\n                     r.get('digits') or r.get('length') or ''])\n    for f, c in sorted(nm['codes'].items()):\n        for code, desc in sorted(c['codes'].items()):\n            rows.append([f + ' code', code, desc, c['source']])\n    for code, desc in sorted(req['status_codes'].items()):\n        rows.append(['Status code', code, desc, ''])\n    for w in req['worksets']:\n        rows.append(['Workset', w, '', ''])\n    for l in req['loin']:\n        rows.append(['LOIN', l, '', ''])\n    for l in req['workflow_steps']:\n        rows.append(['Workflow step', l, '', ''])\n    sh.append(('Standards', ['Kind', 'Value', 'Description / allowed', 'Source / digits'], rows, [16, 34, 70, 40]))\n    sh.append(('Deliverables', ['Number', 'Title', 'Type', 'Role', 'Scale', 'Size', 'Status', 'Rev', 'Due', 'Responsible',\n                                'Naming OK', 'Problems', 'In Revit'],\n               [[s_['number'], s_['name'], s_['type'], s_['role'], s_['scale'], s_['size'], s_['status'], s_['revision'], s_['due'],\n                 s_['responsible'], 'OK' if s_['valid'] else 'FAIL', '; '.join(s_['problems']), s_.get('revit', '')]\n                for s_ in req['sheets']], [30, 32, 6, 6, 8, 6, 7, 6, 11, 20, 9, 60, 18]))\n    sh.append(('Parameters', ['Name', 'Category', 'Data type', 'Unit', 'Stage', 'Instance/Type', 'Built-in used', 'Group',\n                              'Sources', 'Required now', 'In Revit'],\n               [[pp_['name'], pp_['category'] or '', pp_['datatype'], pp_['unit'], pp_['stage'] or '', pp_['binding'],\n                 pp_.get('builtin') or '', pp_['group'], ', '.join(sorted(set([s_['doc'] for s_ in pp_['sources']]))),\n                 'YES' if pp_.get('required_now') else '', pp_.get('revit', '')] for pp_ in req['parameters']]\n               + [[c_['name'], ', '.join(c_['categories']), c_['datatype'], '', '', c_['binding'], c_.get('builtin') or '',\n                   'COBie', req['cobie']['source'], '', c_.get('revit', '')] for c_ in req['cobie']['params']]\n               + [[pp_['name'], 'Project Information', 'Text', '', '', 'Instance', '', 'BEP', 'BEP', '', pp_.get('revit', '')]\n                  for pp_ in req['project_parameters']]\n               + [[pp_['name'], 'Sheets', 'Text', '', '', 'Instance', '', 'BEP', 'MIDP', '', pp_.get('revit', '')]\n                  for pp_ in req['sheet_parameters']],\n               [30, 24, 10, 8, 6, 12, 14, 8, 50, 10, 18]))\n    sh.append(('Material register', ['Code', 'Name', 'Category', 'Description', 'Manufacturer', 'Product', 'Approved',\n                                     'Source', 'In Revit'],\n               [[m_['code'], m_['name'], m_['category'], m_['description'], m_['manufacturer'], m_['product'],\n                 'YES' if m_['approved'] else 'NO', m_['source'], m_.get('revit', '')] for m_ in req['materials']['register']],\n               [14, 30, 14, 30, 18, 14, 9, 40, 22]))\n    if req['checklist']:\n        sh.append(('ISO 19650 checklist', ['Ref', 'Requirement', 'Clause', 'Status', 'Comment'],\n                   [[c_['ref'], c_['requirement'], c_['clause'], c_['status'], c_['comment']] for c_ in req['checklist']],\n                   [8, 60, 18, 10, 40]))\n    if revit:\n        for title, header, rows, widths in revit.get('sheets', []):\n            sh.append((title, header, rows, widths))\n    sh.append(('Log', ['Line'], [[l_] for l_ in LOG[-400:]], [140]))\n    return sh\n\n\n# =====================================================================\n#  A09  Part 2: apply the imported documents to the open Revit project + checks\n#  One step per import slot:\n#    BEP        project information, BEP parameters, units, worksets, view templates\n#    SCHEDULE   sheet parameters, sheets from the deliverables list, drawing register\n#    AIR / FM   shared parameters bound to their categories, asset data schedules\n#    COBIE      COBie parameters, COBie Type / Component / Space schedules\n#    CHECKLIST  ISO 19650 status + model checks (coordinates, worksharing)\n#    WORKFLOW   status codes -> sheet status check\n#    MATERIALS  approved materials created / codes + names fixed, material register schedule, material check\n# =====================================================================\nA09_PREFIX = 'A09 '\n\n\ndef _cats_by_name(doc):\n    out = {}\n    for c in doc.Settings.Categories:\n        try:\n            out[c.Name.lower()] = c\n        except Exception:\n            pass\n    return out\n\n\ndef _find_cat(doc, cats, name):\n    from Autodesk.Revit.DB import Category, BuiltInCategory\n    if not name:\n        return None\n    special = {'project information': BuiltInCategory.OST_ProjectInformation, 'sheets': BuiltInCategory.OST_Sheets,\n               'materials': BuiltInCategory.OST_Materials, 'rooms': BuiltInCategory.OST_Rooms}\n    if name.lower() in special:\n        try:\n            return Category.GetCategory(doc, special[name.lower()])\n        except Exception:\n            pass\n    for n in (name.lower(), name.lower() + 's', name.lower().rstrip('s')):\n        if n in cats:\n            return cats[n]\n    return None\n\n\ndef _spec(dt):\n    from Autodesk.Revit.DB import SpecTypeId\n    m = {'Number': SpecTypeId.Number, 'Integer': SpecTypeId.Int.Integer, 'Length': SpecTypeId.Length,\n         'Area': SpecTypeId.Area, 'YesNo': SpecTypeId.Boolean.YesNo, 'URL': SpecTypeId.String.Url,\n         'Currency': SpecTypeId.Currency}\n    return m.get(dt, SpecTypeId.String.Text)\n\n\ndef _pval(p):\n    \"\"\"parameter -> display string ('' when empty)\"\"\"\n    if p is None:\n        return ''\n    try:\n        if not p.HasValue:\n            return ''\n    except Exception:\n        pass\n    try:\n        from Autodesk.Revit.DB import StorageType\n        st = p.StorageType\n        if st == StorageType.String:\n            return p.AsString() or ''\n        v = p.AsValueString()\n        if v:\n            return v\n        if st == StorageType.Integer:\n            return str(p.AsInteger())\n        if st == StorageType.Double:\n            return str(p.AsDouble())\n    except Exception:\n        pass\n    return ''\n\n\ndef _pset(p, value):\n    if p is None or p.IsReadOnly:\n        return False\n    from Autodesk.Revit.DB import StorageType\n    try:\n        if p.StorageType == StorageType.String:\n            return p.Set(_s(value))\n        if p.StorageType == StorageType.Integer:\n            return p.Set(int(float(value)))\n        if p.StorageType == StorageType.Double:\n            return p.SetValueString(_s(value)) if not re.match(r'^-?[\\d.]+$', _s(value)) else p.Set(float(value))\n    except Exception:\n        return False\n    return False\n\n\nclass _Step(object):\n    \"\"\"one Transaction per step; errors are logged, the next step still runs\"\"\"\n    def __init__(self, doc, name, run):\n        self.doc, self.name, self.run, self.t = doc, name, run, None\n\n    def __enter__(self):\n        if self.run:\n            from Autodesk.Revit.DB import Transaction\n            self.t = Transaction(self.doc, 'A09 ' + self.name)\n            self.t.Start()\n        return self\n\n    def __exit__(self, et, ev, tb):\n        if self.t is not None:\n            if et is None:\n                self.t.Commit()\n            else:\n                try:\n                    self.t.RollBack()\n                except Exception:\n                    pass\n        if et is not None:\n            log('STEP %s FAILED: %s' % (self.name, ev))\n            log(''.join(traceback.format_exception(et, ev, tb))[-1500:])\n            RES['issues'].append({'severity': 'HIGH', 'area': 'Revit', 'detail': 'Step \"%s\" failed: %s' % (self.name, ev),\n                                  'action': 'See the Log sheet', 'source': 'Revit'})\n            RES['steps'].append('%s: FAILED - %s' % (self.name, ev))\n            return True\n        return False\n\n\nRES = {}\n\n\ndef _rissue(sev, area, detail, action=''):\n    RES['issues'].append({'severity': sev, 'area': area, 'detail': detail, 'action': action, 'source': 'Revit model'})\n\n\ndef _rmanual(item, why, how):\n    for m in RES['manual']:\n        if m['item'] == item:\n            return\n    RES['manual'].append({'item': item, 'why': why, 'how': how, 'source': 'Revit model'})\n\n\ndef _qc(check, result, detail):\n    RES['qc'].append([check, result, detail])\n    if result == 'FAIL':\n        _rissue('HIGH', 'Revit check', check + ': ' + detail)\n    elif result == 'WARN':\n        _rissue('MEDIUM', 'Revit check', check + ': ' + detail)\n\n\n# --------------------------------------------------------------------- shared parameters\nclass SharedParams(object):\n    def __init__(self, doc, path, run):\n        self.doc, self.app, self.path, self.run = doc, doc.Application, path, run\n        self.file = None\n        self.old = None\n        self.bound = {}\n        it = doc.ParameterBindings.ForwardIterator()\n        it.Reset()\n        while it.MoveNext():\n            try:\n                self.bound[it.Key.Name] = (it.Key, it.Current)\n            except Exception:\n                pass\n\n    def open(self):\n        if self.file is not None or not self.run:\n            return self.file\n        d = os.path.dirname(self.path)\n        if not os.path.isdir(d):\n            os.makedirs(d)\n        if not os.path.isfile(self.path):\n            open(self.path, 'w').close()                       # empty file: Revit writes the header itself\n        self.old = self.app.SharedParametersFilename\n        self.app.SharedParametersFilename = self.path\n        try:\n            self.file = self.app.OpenSharedParameterFile()\n        except Exception:\n            self.file = None\n        if self.file is None:                                  # unreadable A09 file -> start a new one\n            bad = self.path + '.unreadable'\n            if os.path.exists(bad):\n                os.remove(bad)\n            os.rename(self.path, bad)\n            open(self.path, 'w').close()\n            self.app.SharedParametersFilename = self.path\n            self.file = self.app.OpenSharedParameterFile()\n            log('shared parameter file was unreadable - new file started, old one kept as ' + bad)\n        return self.file\n\n    def close(self):\n        if self.old is not None:\n            try:\n                self.app.SharedParametersFilename = self.old\n            except Exception:\n                pass\n\n    def definition(self, group, name, dtype, desc=''):\n        from Autodesk.Revit.DB import ExternalDefinitionCreationOptions\n        f = self.open()\n        for g in f.Groups:\n            d = g.Definitions.get_Item(name)\n            if d is not None:\n                return d\n        g = f.Groups.get_Item(group) or f.Groups.Create(group)\n        opt = ExternalDefinitionCreationOptions(name, _spec(dtype))\n        try:\n            opt.Description = desc[:250] if desc else ''\n        except Exception:\n            pass\n        return g.Definitions.Create(opt)\n\n    def bind(self, group, name, dtype, categories, binding, desc=''):\n        \"\"\"-> status text.  Adds missing categories to an existing binding.\"\"\"\n        from Autodesk.Revit.DB import InstanceBinding, TypeBinding, GroupTypeId\n        cats = [c_ for c_ in categories if c_ is not None and c_.AllowsBoundParameters]\n        if not cats:\n            return 'NO CATEGORY'\n        if name in self.bound:\n            defn, b = self.bound[name]\n            have = set()\n            try:\n                for c in b.Categories:\n                    have.add(c.Id.IntegerValue if hasattr(c.Id, 'IntegerValue') else c.Id.Value)\n            except Exception:\n                pass\n            miss = [c_ for c_ in cats if (c_.Id.IntegerValue if hasattr(c_.Id, 'IntegerValue') else c_.Id.Value) not in have]\n            kind = 'Type' if b.GetType().Name == 'TypeBinding' else 'Instance'\n            if kind != binding:\n                _rissue('LOW', 'Parameters', '%s already in the project as %s parameter (document says %s)' % (name, kind, binding),\n                        'Kept as ' + kind)\n            if not miss:\n                return 'EXISTS'\n            if not self.run:\n                return 'ADD %d CAT' % len(miss)\n            cs = b.Categories\n            for c in miss:\n                cs.Insert(c)\n            b.Categories = cs\n            self.doc.ParameterBindings.ReInsert(defn, b, GroupTypeId.Data)\n            return 'CATEGORIES ADDED'\n        if not self.run:\n            return 'TO CREATE'\n        defn = self.definition(group, name, dtype, desc)\n        cs = self.app.Create.NewCategorySet()\n        for c in cats:\n            cs.Insert(c)\n        b = self.app.Create.NewTypeBinding(cs) if binding == 'Type' else self.app.Create.NewInstanceBinding(cs)\n        gid = GroupTypeId.IdentityData if group == 'BEP' else GroupTypeId.Data\n        if not self.doc.ParameterBindings.Insert(defn, b, gid):\n            self.doc.ParameterBindings.ReInsert(defn, b, gid)\n        self.bound[name] = (defn, b)\n        return 'CREATED'\n\n\n# --------------------------------------------------------------------- schedules\ndef _schedule(doc, name, kind, cat, fields, run):\n    \"\"\"kind = 'cat' (one category) / 'multi' / 'sheets' / 'material'.  Replaces an earlier A09 schedule of that name.\"\"\"\n    from Autodesk.Revit.DB import ViewSchedule, FilteredElementCollector, ElementId\n    old = [v_ for v_ in FilteredElementCollector(doc).OfClass(ViewSchedule) if v_.Name == name]\n    if not run:\n        return 'TO UPDATE' if old else 'TO CREATE', []\n    for v in old:\n        doc.Delete(v.Id)\n    if kind == 'sheets':\n        vs = ViewSchedule.CreateSheetList(doc)\n    elif kind == 'material':\n        vs = ViewSchedule.CreateMaterialTakeoff(doc, ElementId.InvalidElementId)\n    elif kind == 'multi':\n        vs = ViewSchedule.CreateSchedule(doc, ElementId.InvalidElementId)\n    else:\n        vs = ViewSchedule.CreateSchedule(doc, cat.Id)\n    vs.Name = name\n    sd = vs.Definition\n    avail = {}\n    for sf in sd.GetSchedulableFields():\n        try:\n            avail.setdefault(sf.GetName(doc).lower(), sf)\n        except Exception:\n            pass\n    missing = []\n    for f in fields:\n        sf = avail.get(f.lower())\n        if sf is None:\n            missing.append(f)\n            continue\n        try:\n            sd.AddField(sf)\n        except Exception:\n            missing.append(f)\n    return ('UPDATED' if old else 'CREATED'), missing\n\n\n# --------------------------------------------------------------------- material helpers\ndef _mat_name(rule, code, name):\n    out = re.sub(r'(?i)<[^>]*code[^>]*>', code, rule or '<Code> <Name>')\n    out = re.sub(r'<[^>]+>', name, out)\n    return re.sub(r'\\s+', ' ', out).strip()\n\n\ndef _used_material_ids(doc):\n    from Autodesk.Revit.DB import FilteredElementCollector, CategoryType\n    ids = set()\n    for e in FilteredElementCollector(doc).WhereElementIsNotElementType():\n        try:\n            c = e.Category\n            if c is None or c.CategoryType != CategoryType.Model:\n                continue\n            for flag in (False, True):\n                for i in e.GetMaterialIds(flag):\n                    ids.add(i.IntegerValue if hasattr(i, 'IntegerValue') else i.Value)\n        except Exception:\n            continue\n    return ids\n\n\ndef _eid(e):\n    i = e.Id\n    return i.IntegerValue if hasattr(i, 'IntegerValue') else i.Value\n\n\n# ===================================================================== main Revit step\ndef apply_revit(doc, req, opts, run):\n    \"\"\"opts: title_block, roles, mat_mode (FIX/CHECK), mat_scope (USED/ALL), sp_path\"\"\"\n    from Autodesk.Revit.DB import (FilteredElementCollector, ViewSheet, FamilySymbol, BuiltInCategory, BuiltInParameter,\n                                   Material, Workset, WorksetTable, WorksetKind, FilteredWorksetCollector, ViewPlan,\n                                   ViewFamilyType, ViewFamily, View3D, Level, View, ViewDetailLevel, ViewType,\n                                   FormatOptions, UnitTypeId, SpecTypeId, BasePoint, ElementId, TransactionGroup)\n    RES.clear()\n    RES.update({'issues': [], 'manual': [], 'qc': [], 'steps': [], 'summary': [], 'sheets': [], 'materials': []})\n    imp = set(req.get('imported', []))\n    cats = _cats_by_name(doc)\n    proj = req['project']\n    code = proj.get('project_code') or ''\n    sp = SharedParams(doc, opts['sp_path'], run)\n    tg = None\n    if run:\n        tg = TransactionGroup(doc, 'A09 Client BIM setup')\n        tg.Start()\n    try:\n        # ------------------------------------------------------------ BEP\n        if 'BEP' in imp:\n            with _Step(doc, 'BEP project information', run):\n                pi = doc.ProjectInformation\n                pairs = [('Project Name', 'project_name', BuiltInParameter.PROJECT_NAME),\n                         ('Project Number', 'project_number', BuiltInParameter.PROJECT_NUMBER),\n                         ('Client Name', 'client', BuiltInParameter.CLIENT_NAME),\n                         ('Project Address', 'address', BuiltInParameter.PROJECT_ADDRESS),\n                         ('Building Name', 'building_name', BuiltInParameter.PROJECT_BUILDING_NAME),\n                         ('Organization Name', 'lead_appointed_party', BuiltInParameter.PROJECT_ORGANIZATION_NAME),\n                         ('Project Status', 'stage', BuiltInParameter.PROJECT_STATUS)]\n                n = 0\n                for title, k, bip in pairs:\n                    v = proj.get(k)\n                    if not v:\n                        continue\n                    p = pi.get_Parameter(bip)\n                    if _pval(p) != v:\n                        n += 1\n                        if run:\n                            _pset(p, v)\n                RES['steps'].append('BEP: project information %d value(s) %s' % (n, 'set' if run else 'to set'))\n            with _Step(doc, 'BEP parameters', run):\n                pi = doc.ProjectInformation\n                pcat = [_find_cat(doc, cats, 'Project Information')]\n                made = 0\n                for pp in req['project_parameters']:\n                    st = sp.bind('BEP', pp['name'], 'Text', pcat, 'Instance', 'From the client BEP')\n                    pp['revit'] = st\n                    made += st in ('CREATED', 'TO CREATE')\n                if run:\n                    doc.Regenerate()\n                    for pp in req['project_parameters']:\n                        if pp['value']:\n                            _pset(pi.LookupParameter(pp['name']), pp['value'])\n                RES['steps'].append('BEP: %d BEP parameter(s) %s' % (made, 'created' if run else 'to create'))\n            with _Step(doc, 'BEP units', run):\n                uk = _unit_key(proj.get('units', '')) if proj.get('units') else None\n                target = {'mm': UnitTypeId.Millimeters, 'cm': UnitTypeId.Centimeters, 'm': UnitTypeId.Meters,\n                          'ft': UnitTypeId.FeetFractionalInches}.get(uk)\n                if target is not None:\n                    units = doc.GetUnits()\n                    cur = units.GetFormatOptions(SpecTypeId.Length).GetUnitTypeId()\n                    if cur.TypeId != target.TypeId:                # compare ids as text (CPython3 has no ForgeTypeId ==)\n                        if run:\n                            units.SetFormatOptions(SpecTypeId.Length, FormatOptions(target))\n                            if uk in ('mm', 'cm', 'm'):\n                                units.SetFormatOptions(SpecTypeId.Area, FormatOptions(UnitTypeId.SquareMeters))\n                            doc.SetUnits(units)\n                        RES['steps'].append('BEP: length units %s -> %s' % ('changed' if run else 'to change', uk))\n                    else:\n                        RES['steps'].append('BEP: units already ' + uk)\n            with _Step(doc, 'BEP worksets', run):\n                want = req.get('worksets') or []\n                if want and doc.IsWorkshared:\n                    have = set([w_.Name.lower() for w_ in FilteredWorksetCollector(doc).OfKind(WorksetKind.UserWorkset)])\n                    miss = [w_ for w_ in want if w_.lower() not in have]\n                    if run:\n                        for w in miss:\n                            if WorksetTable.IsWorksetNameUnique(doc, w):\n                                Workset.Create(doc, w)\n                    RES['steps'].append('BEP: %d workset(s) %s' % (len(miss), 'created' if run else 'to create'))\n                elif want:\n                    _rmanual('Enable worksharing', 'The BEP lists %d worksets but this model is not workshared' % len(want),\n                             'Collaborate > Worksharing (with the BIM lead), then run A09 again to create: ' + ', '.join(want))\n            with _Step(doc, 'BEP view templates', run):\n                views = list(FilteredElementCollector(doc).OfClass(View))\n                tnames = set([v_.Name for v_ in views if v_.IsTemplate])\n                rl = [r_.strip().upper() for r_ in (opts.get('roles') or '').split(',') if r_.strip() and r_.strip().upper() != 'ALL']\n                own = (proj.get('originator') or '').upper()\n                mine = [s_['role'] for s_ in req['sheets'] if s_['role'] and (not own or s_.get('originator', '').upper() == own)]\n                role = rl[0] if rl else (max(set(mine), key=mine.count) if mine else 'A')\n                pre = (code + '_' if code else '') + role + '_'\n                scales = sorted(set([int(s_['scale'].split(':')[-1]) for s_ in req['sheets']\n                                    if re.match(r'^1\\s*:\\s*\\d+$', s_.get('scale') or '')]) | set([100]), reverse=True)\n                plan_list = [('FloorPlan', ViewFamily.FloorPlan, sc_) for sc_ in scales] + [('CeilingPlan', ViewFamily.CeilingPlan, 100)]\n                vft = {}\n                for t in FilteredElementCollector(doc).OfClass(ViewFamilyType):\n                    vft.setdefault(int(t.ViewFamily), t)\n                level = next(iter(sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)), None)\n                made = []\n                for kind, fam, sc in plan_list:\n                    nm = '%s%s_1-%d' % (pre, kind, sc)\n                    if nm in tnames or int(fam) not in vft or level is None:\n                        continue\n                    made.append(nm)\n                    if run:\n                        v = ViewPlan.Create(doc, vft[int(fam)].Id, level.Id)\n                        t = v.CreateViewTemplate()\n                        t.Name = nm\n                        t.Scale = sc\n                        t.DetailLevel = ViewDetailLevel.Fine if sc <= 50 else ViewDetailLevel.Medium\n                        doc.Delete(v.Id)\n                for kind, vt, sc in (('Elevation', ViewType.Elevation, 100), ('Section', ViewType.Section, 50)):\n                    nm = '%s%s_1-%d' % (pre, kind, sc)\n                    src = [v_ for v_ in views if not v_.IsTemplate and int(v_.ViewType) == int(vt)]\n                    if nm in tnames or not src:\n                        continue\n                    made.append(nm)\n                    if run:\n                        t = src[0].CreateViewTemplate()\n                        t.Name = nm\n                        t.Scale = sc\n                        t.DetailLevel = ViewDetailLevel.Fine if sc <= 50 else ViewDetailLevel.Medium\n                nm = pre + '3D_Coordination'\n                if nm not in tnames and int(ViewFamily.ThreeDimensional) in vft:\n                    made.append(nm)\n                    if run:\n                        v = View3D.CreateIsometric(doc, vft[int(ViewFamily.ThreeDimensional)].Id)\n                        t = v.CreateViewTemplate()\n                        t.Name = nm\n                        t.DetailLevel = ViewDetailLevel.Medium\n                        doc.Delete(v.Id)\n                RES['steps'].append('BEP: %d view template(s) %s%s' % (len(made), 'created' if run else 'to create',\n                                                                       (': ' + ', '.join(made)) if made else ''))\n        # ------------------------------------------------------------ BIM execution schedule -> sheets\n        if 'MIDP' in imp:\n            with _Step(doc, 'Schedule sheets', run):\n                scat = [_find_cat(doc, cats, 'Sheets')]\n                for pp in req['sheet_parameters']:\n                    pp['revit'] = sp.bind('BEP', pp['name'], 'Text', scat, 'Instance', 'From the BIM execution schedule')\n                if run:\n                    doc.Regenerate()\n                tbs = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_TitleBlocks).OfClass(FamilySymbol))\n                want = (opts.get('title_block') or proj.get('title_block') or '').lower()\n                size = (proj.get('sheet_size') or '').lower()\n                tb = None\n                for t in tbs:\n                    full = (t.FamilyName + ' ' + Element_name(t)).lower()\n                    if want and want in full:\n                        tb = t\n                        break\n                if tb is None and size:\n                    tb = next((iter([t_ for t_ in tbs if re.search(r'\\b' + re.escape(size) + r'\\b', (t_.FamilyName + ' ' + Element_name(t_)).lower())])), None)\n                if tb is None and tbs:\n                    tb = tbs[0]\n                    if want:\n                        _rmanual('Title block \"%s\"' % (opts.get('title_block') or proj.get('title_block')),\n                                 'Named in the BEP but not loaded - sheets use \"%s\"' % tb.FamilyName,\n                                 'Load the client title block (Insert > Load Family), then change the sheets\\' title block')\n                if tb is None:\n                    _rmanual('Title block', 'No title block family is loaded - sheets were made without one',\n                             'Load the title block (Insert > Load Family)')\n                if tb is not None and run and not tb.IsActive:\n                    tb.Activate()\n                existing = dict([(s_.SheetNumber, s_) for s_ in FilteredElementCollector(doc).OfClass(ViewSheet)])\n                made, upd = 0, 0\n                done = set()\n                for s in req['sheets']:\n                    ok, why = sheet_wanted(s, req, opts.get('roles'))\n                    if not ok:\n                        s['revit'] = why\n                        continue\n                    if s['number'] in done:\n                        continue\n                    done.add(s['number'])\n                    sh = existing.get(s['number'])\n                    if sh is None:\n                        made += 1\n                        s['revit'] = 'CREATED' if run else 'TO CREATE'\n                        if not run:\n                            continue\n                        sh = ViewSheet.Create(doc, tb.Id if tb is not None else ElementId.InvalidElementId)\n                        sh.SheetNumber = s['number']\n                        sh.Name = s['name'] or s['number']\n                    else:\n                        s['revit'] = 'EXISTS'\n                        if s['name'] and sh.Name != s['name']:\n                            _rissue('MEDIUM', 'Sheets', 'Sheet %s is named \"%s\" - schedule says \"%s\"' % (s['number'], sh.Name, s['name']),\n                                    'Rename the sheet or correct the schedule')\n                        upd += 1\n                    if run:\n                        for pname, k in (('BEP_StatusCode', 'status'), ('BEP_RevisionCode', 'revision'), ('BEP_DueDate', 'due'),\n                                         ('BEP_Responsible', 'responsible'), ('BEP_Stage', 'stage')):\n                            if s.get(k):\n                                _pset(sh.LookupParameter(pname), s[k])\n                RES['steps'].append('SCHEDULE: %d sheet(s) %s, %d existing updated%s' % (\n                    made, 'created' if run else 'to create', upd,\n                    (' (title block ' + tb.FamilyName + ')') if tb is not None else ' (NO title block)'))\n            with _Step(doc, 'Drawing register', run):\n                st, miss = _schedule(doc, A09_PREFIX + 'Drawing Register', 'sheets', None,\n                                     ['Sheet Number', 'Sheet Name', 'BEP_StatusCode', 'BEP_RevisionCode', 'BEP_DueDate',\n                                      'BEP_Responsible', 'BEP_Stage'], run)\n                RES['steps'].append('SCHEDULE: drawing register schedule ' + st.lower())\n        # ------------------------------------------------------------ AIR + FM parameters\n        asset_params = [p_ for p_ in req['parameters'] if\n                        (('AIR' in imp and any([s_['type'] == 'AIR' for s_ in p_['sources']])) or\n                         ('FM' in imp and any([s_['type'] == 'FM' for s_ in p_['sources']])) or\n                         any([s_['type'] in ('BEP', 'EIR') for s_ in p_['sources']]))]\n        if asset_params:\n            with _Step(doc, 'AIR/FM parameters', run):\n                byname = {}\n                for p in asset_params:\n                    if not p['category']:\n                        p['revit'] = 'NO CATEGORY'\n                        continue\n                    if p.get('builtin'):\n                        p['revit'] = 'BUILT-IN ' + p['builtin']\n                        continue\n                    c = _find_cat(doc, cats, p['category'])\n                    if c is None:\n                        p['revit'] = 'CATEGORY NOT IN REVIT'\n                        _rmanual('Category \"%s\"' % p['category'], 'Not a Revit category - %s not created' % p['name'],\n                                 'Tell A09 which Revit category to use (edit the AIR)')\n                        continue\n                    byname.setdefault(p['name'], []).append((p, c))\n                counts = {}\n                for name, lst in byname.items():\n                    p0 = lst[0][0]\n                    st = sp.bind(p0['group'] if p0['group'] in ('AIR', 'FM') else 'AIR', name, p0['datatype'],\n                                 [c_ for _, c_ in lst], p0['binding'], p0.get('description', ''))\n                    for p, _ in lst:\n                        p['revit'] = st\n                    counts[st] = counts.get(st, 0) + 1\n                RES['steps'].append('AIR/FM: parameters ' + ', '.join(['%d %s' % (v_, k_.lower()) for k_, v_ in sorted(counts.items())]))\n            with _Step(doc, 'Asset data schedules', run):\n                bycat = {}\n                for p in asset_params:\n                    if p['category'] and p['category'] not in ('Project Information', 'Sheets', 'Materials'):\n                        if p.get('builtin') in ('Room', 'Project Information'):\n                            continue\n                        bycat.setdefault(p['category'], []).append(p.get('builtin') or p['name'])\n                made = []\n                others = [c_ for c_ in bycat if c_ not in ('Rooms', 'Spaces')]\n                groups = []                                     # (schedule name, category or None = multi-category, fields)\n                if len(others) > 8:                             # many categories -> one multi-category asset schedule\n                    allf = []\n                    for c_ in sorted(others):\n                        allf += bycat.pop(c_)\n                    groups.append(('All Assets', None, ['Category', 'Family and Type', 'Mark', 'Level'] + allf))\n                for catname, fields in sorted(bycat.items()):\n                    first = ['Number', 'Name', 'Level', 'Area'] if catname in ('Rooms', 'Spaces') else ['Family and Type', 'Mark', 'Level']\n                    groups.append((catname, catname, first + fields))\n                for title, catname, fields in groups:\n                    c = _find_cat(doc, cats, catname) if catname else None\n                    if catname and c is None:\n                        continue\n                    seen = []\n                    for f in fields:\n                        if f not in seen:\n                            seen.append(f)\n                    st, miss = _schedule(doc, A09_PREFIX + 'Asset Data - ' + title, 'cat' if c else 'multi', c, seen, run)\n                    made.append(title)\n                    if miss and run:\n                        log('schedule %s: fields not found %s' % (title, miss))\n                RES['steps'].append('AIR/FM: %d asset data schedule(s) %s' % (len(made), 'made' if run else 'to make'))\n        # ------------------------------------------------------------ COBie\n        if 'COBIE' in imp and req['cobie']['params']:\n            with _Step(doc, 'COBie parameters', run):\n                n = 0\n                for cp in req['cobie']['params']:\n                    if cp.get('builtin'):\n                        cp['revit'] = 'BUILT-IN ' + cp['builtin']\n                        continue\n                    cs = [_find_cat(doc, cats, c_) for c_ in cp['categories']]\n                    cs = [c_ for c_ in cs if c_ is not None]\n                    if not cs:\n                        cp['revit'] = 'MAPPED to ' + ', '.join(cp['mapped_to']) if cp['mapped_to'] else 'NO ASSET CATEGORY'\n                        continue\n                    cp['revit'] = sp.bind('COBie', cp['name'], cp['datatype'], cs, cp['binding'], 'COBie 2.4 ' + cp['sheet'])\n                    n += cp['revit'] in ('CREATED', 'TO CREATE')\n                RES['steps'].append('COBIE: %d COBie parameter(s) %s' % (n, 'created' if run else 'to create'))\n                if not any([p_['category'] for p_ in req['parameters']]):\n                    _rmanual('COBie asset categories', 'No AIR/FM imported - COBie Type/Component parameters have no category',\n                             'Import the AIR (or FM package) together with the COBie template')\n            with _Step(doc, 'COBie schedules', run):\n                tf = ['Category', 'Family and Type', 'Description', 'Manufacturer', 'Model'] + \\\n                     [c_['name'] for c_ in req['cobie']['params'] if c_['sheet'] == 'Type' and not c_.get('builtin')]\n                cf = ['Category', 'Family and Type', 'Mark', 'Level'] + \\\n                     [c_['name'] for c_ in req['cobie']['params'] if c_['sheet'] == 'Component']\n                _schedule(doc, A09_PREFIX + 'COBie - Type', 'multi', None, tf, run)\n                _schedule(doc, A09_PREFIX + 'COBie - Component', 'multi', None, cf, run)\n                rc = _find_cat(doc, cats, 'Rooms')\n                if rc is not None:\n                    _schedule(doc, A09_PREFIX + 'COBie - Space', 'cat', rc, ['Number', 'Name', 'Level', 'Area'] +\n                              [c_['name'] for c_ in req['cobie']['params'] if c_['sheet'] == 'Space'], run)\n                RES['steps'].append('COBIE: Type / Component / Space schedules ' + ('made' if run else 'to make'))\n        # ------------------------------------------------------------ materials\n        if 'MATERIALS' in imp and req['materials']['register']:\n            with _Step(doc, 'Materials', run):\n                material_step(doc, req, opts, run)\n            with _Step(doc, 'Material register schedule', run):\n                st, miss = _schedule(doc, A09_PREFIX + 'Material Register', 'material', None,\n                                     ['Material: Name', 'Material: Mark', 'Material: Description', 'Material: Manufacturer',\n                                      'Material: Model', 'Material: Area', 'Material: Volume'], run)\n                RES['steps'].append('MATERIALS: material register schedule ' + st.lower())\n        if tg is not None:\n            tg.Assimilate()\n            tg = None\n    finally:\n        if tg is not None:\n            try:\n                tg.RollBack()\n            except Exception:\n                pass\n        sp.close()\n    try:\n        checks(doc, req, opts, run)\n    except Exception as ex:\n        log('checks failed: ' + str(ex))\n        log(traceback.format_exc())\n    RES['summary'] = list(RES['steps'])\n    RES['sheets'].append(('Revit checks', ['Check', 'Result', 'Detail'], RES['qc'], [40, 10, 110]))\n    if RES['materials']:\n        RES['sheets'].append(('Model materials', ['Material', 'Code', 'Status', 'Register name', 'Action'],\n                              RES['materials'], [40, 14, 26, 34, 50]))\n    return RES\n\n\ndef Element_name(e):\n    try:\n        from Autodesk.Revit.DB import BuiltInParameter\n        p = e.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n        if p is not None and p.AsString():\n            return p.AsString()\n    except Exception:\n        pass\n    try:\n        return e.Name\n    except Exception:\n        return ''\n\n\ndef material_step(doc, req, opts, run):\n    from Autodesk.Revit.DB import FilteredElementCollector, Material, BuiltInParameter\n    reg = req['materials']['register']\n    rule = req['materials']['rule']\n    cparam = req['materials']['code_param'] or 'Mark'\n    cre = re.compile(req['materials']['code_regex']) if req['materials'].get('code_regex') else None\n    fix = (opts.get('mat_mode') or 'FIX').upper() == 'FIX'\n    bycode = {}\n    for m in reg:\n        if m['code'] and not m.get('duplicate'):\n            bycode.setdefault(m['code'].upper(), m)\n    mats = list(FilteredElementCollector(doc).OfClass(Material))\n    allnames = set([m_.Name for m_ in mats])\n    scope = (opts.get('mat_scope') or 'USED').upper()\n    if scope == 'USED':\n        used = _used_material_ids(doc)\n        check = [m_ for m_ in mats if _eid(m_) in used]\n    else:\n        check = mats\n\n    def cparam_of(m):\n        bip = {'Mark': BuiltInParameter.ALL_MODEL_MARK, 'Description': BuiltInParameter.ALL_MODEL_DESCRIPTION,\n               'Comments': BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS}.get(cparam)\n        p = m.get_Parameter(bip) if bip is not None else None\n        return p or m.LookupParameter(cparam)\n\n    in_model = {}\n    stats = {}\n    for m in check:\n        nm = m.Name\n        pc = cparam_of(m)\n        code = _pval(pc).strip().upper()\n        if code not in bycode:\n            code = ''\n            if cre is not None:\n                mm = cre.search(nm.upper())\n                if mm:\n                    code = mm.group(0)\n        status, action, rname = 'OK', '', ''\n        r = bycode.get(code) if code else None\n        if code and r is None:\n            status, action = 'CODE NOT IN REGISTER', 'Use an approved material'\n        elif r is not None:\n            rname = r['name']\n            in_model.setdefault(code, []).append(nm)\n            want = _mat_name(rule, r['code'], r['name'])\n            todo = []\n            if not r['approved']:\n                status, action = 'NOT APPROVED', 'Replace with an approved material'\n            else:\n                if nm != want:\n                    todo.append('rename to \"%s\"' % want)\n                if _pval(pc).strip().upper() != r['code'].upper():\n                    todo.append('%s = %s' % (cparam, r['code']))\n                for bip, k in ((BuiltInParameter.ALL_MODEL_DESCRIPTION, 'description'),\n                               (BuiltInParameter.ALL_MODEL_MANUFACTURER, 'manufacturer'),\n                               (BuiltInParameter.ALL_MODEL_MODEL, 'product')):\n                    if r[k] and _pval(m.get_Parameter(bip)) != r[k]:\n                        todo.append(k)\n                if todo:\n                    status = 'NAME MISMATCH' if todo[0].startswith('rename') else 'DATA MISSING'\n                    action = ('FIXED: ' if fix and run else ('FIX: ' if fix else 'needs: ')) + ', '.join(todo)\n                    if fix and run:\n                        if nm != want and want not in allnames:\n                            m.Name = want\n                            allnames.add(want)\n                        _pset(pc, r['code'])\n                        for bip, k in ((BuiltInParameter.ALL_MODEL_DESCRIPTION, 'description'),\n                                       (BuiltInParameter.ALL_MODEL_MANUFACTURER, 'manufacturer'),\n                                       (BuiltInParameter.ALL_MODEL_MODEL, 'product')):\n                            if r[k]:\n                                _pset(m.get_Parameter(bip), r[k])\n                        if r['category']:\n                            try:\n                                m.MaterialClass = r['category']\n                            except Exception:\n                                pass\n        else:\n            base = norm(nm)\n            best, score = None, 0.0\n            for rr in reg:\n                if not rr['approved'] or rr.get('duplicate'):\n                    continue\n                sc = difflib.SequenceMatcher(None, base, norm(rr['name'])).ratio()\n                if sc > score:\n                    best, score = rr, sc\n            if best is not None and score >= 0.82:\n                rname = best['name']\n                status = 'NO CODE'\n                want = _mat_name(rule, best['code'], best['name'])\n                action = ('FIXED: ' if fix and run else 'FIX: ') + 'is %s (%d%% match) -> \"%s\"' % (best['code'], score * 100, want) \\\n                    if fix else 'probably %s %s - add the code' % (best['code'], best['name'])\n                in_model.setdefault(best['code'].upper(), []).append(nm)\n                if fix and run:\n                    if want not in allnames:\n                        m.Name = want\n                        allnames.add(want)\n                    _pset(pc, best['code'])\n                    _pset(m.get_Parameter(BuiltInParameter.ALL_MODEL_DESCRIPTION), best['description'])\n                    _pset(m.get_Parameter(BuiltInParameter.ALL_MODEL_MANUFACTURER), best['manufacturer'])\n            else:\n                status = 'NOT IN REGISTER'\n                action = 'Replace with an approved material' + (\n                    (' (closest: %s %s)' % (best['code'], best['name'])) if best is not None and score > 0.5 else '')\n        stats[status] = stats.get(status, 0) + 1\n        RES['materials'].append([nm, code, status, rname, action])\n        if status in ('CODE NOT IN REGISTER', 'NOT APPROVED', 'NOT IN REGISTER'):\n            _rissue('HIGH', 'Materials', 'Material \"%s\": %s' % (nm, status.lower()), action)\n    for c, names in in_model.items():\n        if len(names) > 1:\n            _rissue('MEDIUM', 'Materials', 'Code %s is on %d materials: %s' % (c, len(names), ', '.join(names)), 'Merge them')\n    bad = [r_ for r_ in RES['materials'] if r_[2] in ('CODE NOT IN REGISTER', 'NOT APPROVED', 'NOT IN REGISTER')]\n    if bad:\n        _rmanual('Materials not in the approved register (%d)' % len(bad), ', '.join([r_[0] for r_ in bad[:10]]),\n                 'Swap them for approved materials in the element types (cannot be decided automatically)')\n    # approved register materials missing in the model -> create\n    allmats = dict([(_pval(cparam_of(m_)).strip().upper(), m_) for m_ in mats])\n    created = 0\n    for r in reg:\n        if not r['code'] or r.get('duplicate'):\n            continue\n        cu = r['code'].upper()\n        want = _mat_name(rule, r['code'], r['name'])\n        if cu in allmats or want in allnames or cu in in_model:\n            r['revit'] = 'IN MODEL'\n            continue\n        if not r['approved']:\n            r['revit'] = 'not approved - not created'\n            continue\n        if fix:\n            created += 1\n            r['revit'] = 'CREATED' if run else 'TO CREATE'\n            if run:\n                mid = Material.Create(doc, want)\n                m = doc.GetElement(mid)\n                allnames.add(want)\n                _pset(cparam_of(m), r['code'])\n                _pset(m.get_Parameter(BuiltInParameter.ALL_MODEL_DESCRIPTION), r['description'])\n                _pset(m.get_Parameter(BuiltInParameter.ALL_MODEL_MANUFACTURER), r['manufacturer'])\n                _pset(m.get_Parameter(BuiltInParameter.ALL_MODEL_MODEL), r['product'])\n                if r['category']:\n                    try:\n                        m.MaterialClass = r['category']\n                    except Exception:\n                        pass\n        else:\n            r['revit'] = 'MISSING'\n    RES['steps'].append('MATERIALS: %d checked (%s) - %s; %d approved material(s) %s' % (\n        len(check), scope.lower(), ', '.join(['%d %s' % (v_, k_.lower()) for k_, v_ in sorted(stats.items())]) or 'none used',\n        created, 'created' if run else ('to create' if fix else 'missing')))\n\n\ndef checks(doc, req, opts, run):\n    \"\"\"compliance checks of the model against the imported documents (read only)\"\"\"\n    from Autodesk.Revit.DB import (FilteredElementCollector, ViewSheet, BuiltInParameter, SpecTypeId, UnitTypeId, BasePoint,\n                                   WorksetKind, FilteredWorksetCollector)\n    imp = set(req.get('imported', []))\n    proj = req['project']\n    nm = req['naming']\n    if 'BEP' in imp:\n        pi = doc.ProjectInformation\n        for title, k, bip in (('Project name', 'project_name', BuiltInParameter.PROJECT_NAME),\n                              ('Project number', 'project_number', BuiltInParameter.PROJECT_NUMBER),\n                              ('Client', 'client', BuiltInParameter.CLIENT_NAME)):\n            have = _pval(pi.get_Parameter(bip))\n            want = proj.get(k, '')\n            if not want:\n                _qc('Project information: ' + title, 'WARN', 'not given in the BEP - model has \"%s\"' % have)\n            elif have == want:\n                _qc('Project information: ' + title, 'PASS', have)\n            else:\n                _qc('Project information: ' + title, 'FAIL' if run else 'WARN', 'model \"%s\", BEP \"%s\"%s' % (\n                    have, want, '' if run else ' (set by RUN)'))\n        if proj.get('units'):\n            uk = _unit_key(proj['units'])\n            cur = doc.GetUnits().GetFormatOptions(SpecTypeId.Length).GetUnitTypeId()\n            want_u = {'mm': UnitTypeId.Millimeters, 'cm': UnitTypeId.Centimeters, 'm': UnitTypeId.Meters}.get(uk)\n            ok = want_u is not None and want_u.TypeId == cur.TypeId\n            _qc('Length units', 'PASS' if ok else 'WARN', 'BEP: ' + proj['units'] + ('' if ok else ' - model differs'))\n        if nm.get('fields'):\n            title = doc.Title\n            okn, probs = check_name(re.sub(r'\\.rvt$', '', title, flags=re.I).split('_')[0], nm)\n            _qc('Model file name', 'PASS' if okn else 'WARN',\n                title + ('' if okn else ' - ' + '; '.join(probs) + ' (rename only by Save As of a new central, with the BIM lead)'))\n        if doc.IsWorkshared and req.get('worksets'):\n            have = set([w_.Name.lower() for w_ in FilteredWorksetCollector(doc).OfKind(WorksetKind.UserWorkset)])\n            miss = [w_ for w_ in req['worksets'] if w_.lower() not in have]\n            _qc('Worksets', 'PASS' if not miss else 'WARN', 'missing: ' + ', '.join(miss) if miss else 'all %d present' % len(req['worksets']))\n        elif req.get('worksets'):\n            _qc('Worksets', 'WARN', 'model not workshared - %d BEP worksets not created' % len(req['worksets']))\n    if 'CHECKLIST' in imp or 'BEP' in imp:\n        try:\n            sp = BasePoint.GetSurveyPoint(doc)\n            pos = sp.SharedPosition if hasattr(sp, 'SharedPosition') else sp.Position\n            at0 = abs(sp.Position.X) < 1e-6 and abs(sp.Position.Y) < 1e-6 and abs(sp.Position.Z) < 1e-6\n            pbp = BasePoint.GetProjectBasePoint(doc)\n            ang = pbp.get_Parameter(BuiltInParameter.BASEPOINT_ANGLETON_PARAM)\n            rot = ang.AsDouble() if ang is not None else 0.0\n            if at0 and abs(rot) < 1e-9:\n                _qc('Shared coordinates', 'WARN', 'survey point at the internal origin and no true north - coordinates not set')\n                _rmanual('Shared coordinates / survey point', 'The model has no survey coordinates yet (ISO 19650-2 5.1.4)',\n                         'Acquire coordinates from the survey / site model (Manage > Coordinates > Acquire)')\n            else:\n                _qc('Shared coordinates', 'PASS', 'survey point / true north set')\n        except Exception as ex:\n            log('coordinate check: ' + str(ex))\n    sheets = list(FilteredElementCollector(doc).OfClass(ViewSheet))\n    if nm.get('fields') and sheets:\n        bad = []\n        for s in sheets:\n            if s.IsPlaceholder:\n                continue\n            okn, probs = check_name(s.SheetNumber, nm)\n            if not okn:\n                bad.append('%s (%s)' % (s.SheetNumber, probs[0]))\n        _qc('Sheet numbers follow the naming convention', 'PASS' if not bad else 'FAIL',\n            '%d of %d sheets OK' % (len(sheets) - len(bad), len(sheets)) + ((' - wrong: ' + '; '.join(bad[:10])) if bad else ''))\n    if 'MIDP' in imp:\n        have = set([s_.SheetNumber for s_ in sheets])\n        want = [s_ for s_ in req['sheets'] if sheet_wanted(s_, req, opts.get('roles'))[0]]\n        miss = [s_['number'] for s_ in want if s_['number'] not in have]\n        extra = [n_ for n_ in have if n_ not in set([s_['number'] for s_ in req['sheets']])]\n        _qc('Deliverable sheets in the model', 'PASS' if not miss else ('WARN' if not run else 'FAIL'),\n            '%d of %d present%s' % (len(want) - len(miss), len(want), (' - missing: ' + ', '.join(miss[:10])) if miss else ''))\n        if extra:\n            _qc('Sheets not in the execution schedule', 'WARN', ', '.join(sorted(extra)[:15]))\n        empty = [s_.SheetNumber for s_ in sheets if not s_.IsPlaceholder and not list(s_.GetAllPlacedViews())]\n        if empty:\n            _qc('Sheets without views', 'INFO', '%d sheet(s) have no views yet - place the drawings' % len(empty))\n    if 'WORKFLOW' in imp or 'MIDP' in imp:\n        codes = set(req.get('status_codes') or {})\n        if codes:\n            bad = []\n            for s in sheets:\n                v = _pval(s.LookupParameter('BEP_StatusCode'))\n                if v and v not in codes:\n                    bad.append('%s=%s' % (s.SheetNumber, v))\n            _qc('Sheet status codes', 'PASS' if not bad else 'FAIL', 'allowed: ' + ', '.join(sorted(codes)) +\n                ((' - wrong: ' + ', '.join(bad[:10])) if bad else ''))\n    # required asset data filled in?\n    stage = req.get('current_stage')\n    cats = _cats_by_name(doc)\n    for p in req['parameters']:\n        if not p.get('required_now') or not p['category'] or p['category'] in ('Project Information', 'Sheets'):\n            continue\n        c = _find_cat(doc, cats, p['category'])\n        if c is None:\n            continue\n        els = list(FilteredElementCollector(doc).OfCategoryId(c.Id).WhereElementIsNotElementType())\n        if not els:\n            continue\n        if p.get('builtin') and not p.get('builtin_id'):\n            continue                                            # Level, Type, Room ... come from the model itself\n        pname = p.get('builtin') or p['name']\n        empty = 0\n        for e in els:\n            src = e\n            if p['binding'] == 'Type' and p['category'] not in ('Rooms', 'Spaces'):\n                t = doc.GetElement(e.GetTypeId())\n                src = t if t is not None else e\n            if not _pval(src.LookupParameter(pname)):\n                empty += 1\n        res = 'PASS' if empty == 0 else 'WARN'\n        _qc('Stage %s data: %s %s' % (stage, p['category'], pname), res, '%d of %d empty' % (empty, len(els)))\n        if empty:\n            _rmanual('Fill %s on %s (%d empty)' % (pname, p['category'], empty),\n                     'Required at stage %s by %s' % (p['stage'], p['sources'][0]['doc']),\n                     'Enter the values (A09 \"Asset Data - %s\" schedule)' % p['category'])\n\n\n# =====================================================================\n#  A09 - run: import -> analyse -> apply to Revit -> check -> report\n# =====================================================================\nSLOT_NAMES = [('BEP', 'BEP'), ('MIDP', 'BIM execution schedule'), ('AIR', 'AIR'), ('COBIE', 'COBie'),\n              ('FM', 'FM asset information'), ('CHECKLIST', 'ISO 19650 checklist'), ('WORKFLOW', 'Workflow package'),\n              ('MATERIALS', 'Material register')]\n\n\ndef out_folder(req, doc):\n    base = os.path.join(os.path.expanduser('~'), 'Documents', 'SD_Tools_A09')\n    nm = req['project'].get('project_code') or req['project'].get('project_number') or (doc.Title if doc is not None else 'project')\n    nm = re.sub(r'[^A-Za-z0-9 _.-]', '', nm).strip() or 'project'\n    d = os.path.join(base, nm)\n    if not os.path.isdir(d):\n        os.makedirs(d)\n    return d, nm\n\n\ndef a09_run(doc, files, opts, run):\n    del LOG[:]\n    inputs = [(typ_, f_) for typ_, f_ in files if f_]\n    req, docs = analyse(inputs)\n    folder, nm = out_folder(req, doc)\n    opts['sp_path'] = os.path.join(folder, nm + '_A09_SharedParameters.txt')\n    revit = None\n    if doc is not None:\n        revit = apply_revit(doc, req, opts, run)\n    rpt = write_xlsx(os.path.join(folder, nm + '_A09_Client_Requirements_Report.xlsx'), report_sheets(req, revit))\n    js = dict(req)\n    js['facts_all'] = req['facts_all']\n    io.open(os.path.join(folder, nm + '_A09_requirements.json'), 'w', encoding='utf-8').write(\n        unicode(json.dumps(js, indent=1, ensure_ascii=False, default=str)))\n    # ------------------------------------------------ result text\n    issues = req['issues'] + (revit or {}).get('issues', [])\n    manual = merge_manual(req.get('manual', []), (revit or {}).get('manual', []))\n    hi = len([i_ for i_ in issues if i_['severity'] == 'HIGH'])\n    me = len([i_ for i_ in issues if i_['severity'] == 'MEDIUM'])\n    out = []\n    out.append(('DONE - model set up' if run else 'PREVIEW - nothing changed (set RUN = True to apply)'))\n    out.append('Project: %s  %s' % (req['project'].get('project_number', '?'), req['project'].get('project_name', '?')))\n    out.append('')\n    out.append('IMPORTED')\n    names = dict(SLOT_NAMES)\n    for d in req['documents']:\n        out.append('  %-24s %s%s' % (names.get(d['type'], d['type']), d['name'], ('  !! ' + d['error']) if d['error'] else ''))\n    skipped = [names[t_] for t_, f_ in files if not f_]\n    if skipped:\n        out.append('  not imported: ' + ', '.join(skipped))\n    if revit:\n        out.append('')\n        out.append('REVIT')\n        for s in revit['steps']:\n            out.append('  ' + s)\n        fails = [q_ for q_ in revit['qc'] if q_[1] == 'FAIL']\n        out.append('  checks: %d pass, %d warn, %d fail' % (len([q_ for q_ in revit['qc'] if q_[1] == 'PASS']),\n                                                          len([q_ for q_ in revit['qc'] if q_[1] == 'WARN']), len(fails)))\n    out.append('')\n    out.append('ISSUES: %d high, %d medium, %d low' % (hi, me, len(issues) - hi - me))\n    out.append('')\n    out.append('MANUAL INPUT REQUIRED (%d)' % len(manual))\n    for i, m in enumerate(manual[:12]):\n        out.append('  %d. %s - %s' % (i + 1, m['item'], m['how']))\n    if len(manual) > 12:\n        out.append('  ... %d more in the report' % (len(manual) - 12))\n    out.append('')\n    out.append('Report: ' + rpt)\n    return out, rpt\n\n\n# =====================================================================\n#  DYNAMO / DYNAMO PLAYER INPUTS\n#    0  Import BEP                       (PDF / Word / Excel)\n#    1  Import BIM execution schedule    (MIDP / TIDP / drawing list)\n#    2  Import AIR                       (asset information requirements)\n#    3  Import COBie template\n#    4  Import FM asset information package\n#    5  Import ISO 19650 compliance checklist\n#    6  Import BIM workflow package\n#    7  Import material code register\n#    8  Title block      '' = the one named in the BEP (or sheet size), else the first loaded\n#    9  Sheets for       blank = our own originator (from the BEP),  AR or AR,ST = these disciplines,  ALL = every sheet\n#   10  Materials        FIX = create approved materials + fix codes / names,  CHECK = report only\n#   11  Check materials  USED = materials used in the model,  ALL = every material\n#   12  RUN              False = analyse + preview (nothing changes),  True = set up the model\n#  Leave an import empty to skip that document.  Run again any time: existing items are kept / updated.\n# =====================================================================\ntry:\n    IN                                                    # noqa - Dynamo\n    DYNAMO = True\nexcept NameError:\n    DYNAMO = False\ndoc = globals().get('doc')\nDOC_ERR = ''\nif DYNAMO:\n    try:\n        import clr                                        # Dynamo CPython3 does not import clr by itself\n        clr.AddReference('RevitAPI')\n        clr.AddReference('RevitAPIUI')\n        clr.AddReference('RevitServices')\n        from RevitServices.Persistence import DocumentManager\n        from RevitServices.Transactions import TransactionManager\n        doc = DocumentManager.Instance.CurrentDBDocument\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception as ex:\n        DOC_ERR = str(ex)\n    RAW = list(IN)\nelse:\n    RAW = list(globals().get('A09_INPUTS', []))\n\n\ndef _inp(i, default=''):\n    try:\n        v = RAW[i]\n    except Exception:\n        return default\n    if v is None:\n        return default\n    v = _s(v)\n    if not v or v.lower() in ('no file selected.', 'no file selected', 'none', 'null'):\n        return default\n    return v.strip().strip('\"')\n\n\ndef _flag(i, default=False):\n    try:\n        v = RAW[i]\n    except Exception:\n        return default\n    if isinstance(v, basestring):\n        return v.strip().upper() in ('TRUE', 'YES', '1', 'Y')\n    return bool(v) if v is not None else default\n\n\nout = []\nrpt = ''\ntry:\n    files = [(SLOT_NAMES[i_][0], _inp(i_)) for i_ in range(8)]\n    opts = {'title_block': _inp(8), 'roles': _inp(9, ''), 'mat_mode': _inp(10, 'FIX').upper(),\n            'mat_scope': _inp(11, 'USED').upper()}\n    if DYNAMO and doc is None:\n        raise Exception('No Revit model connected - nothing was changed. ' + (DOC_ERR or 'Open a project, then restart Dynamo from it.'))\n    out, rpt = a09_run(doc, files, opts, _flag(12, False))\nexcept Exception as ex:\n    out = ['FAILED: ' + str(ex)]\n    log(traceback.format_exc())\n    out.append(LOG[-1] if LOG else '')\nif DYNAMO and not globals().get('NO_DIALOG'):\n    try:\n        clr.AddReference('RevitAPIUI')\n        from Autodesk.Revit.UI import TaskDialog, TaskDialogCommonButtons, TaskDialogResult, TaskDialogCommandLinkId\n        td = TaskDialog('A09 Client BIM requirements')\n        td.MainInstruction = out[0] if out else 'A09'\n        td.MainContent = '\\n'.join(out[1:])[:1950]\n        td.CommonButtons = TaskDialogCommonButtons.Close\n        if rpt:\n            td.AddCommandLink(TaskDialogCommandLinkId.CommandLink1, 'Open the full report (Excel)')\n        r = td.Show()\n        if rpt and r == TaskDialogResult.CommandLink1:\n            os.startfile(rpt)\n    except Exception as ex:\n        out.append('(result dialog could not open: %s)' % ex)\nOUT = out\n",
      "Engine": "CPython3",
