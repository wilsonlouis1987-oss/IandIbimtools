    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - STAIRS FROM ROOMS / AREAS (professional)\n#  every Room or Area whose name contains STAIR gets a concrete dog-leg (or straight) stair that fits inside it:\n#  riser <= max riser, tread as set, riser height from the real floor-to-floor height, handrails + landing.\n#  Room too short for that? AUTO-FIT: the gentlest riser / tread that fits (limits AUTO_MAX_RISER / AUTO_MIN_TREAD).\n#  Room moved / resized / renamed -> Run again: only the changed stairs are rebuilt, deleted rooms lose their stair.\nimport os\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\ndef log(msg):\n    try:\n        with open(LOG, 'a') as fh:\n            fh.write(str(msg) + '\\n')\n    except Exception:\n        pass\nlog('--- stairs from rooms v2 (auto-fit) started')\nimport clr, math, traceback\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Architecture import *        # Stairs, StairsRun, StairsLanding, Railing ...\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\nMMF = 1.0 / 304.8\nCOL_PARAMS = [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')]\nout = []\n\n\ndef num(v, d=0.0):\n    try:\n        return float(v)\n    except Exception:\n        return d\n\n\ndef f(v):\n    return '{0:.0f}'.format(v)\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\n_CAT = {}\ndef catid(bic):\n    if bic not in _CAT:\n        _CAT[bic] = idv(Category.GetCategory(doc, bic).Id)\n    return _CAT[bic]\n\n\ndef cat_is(e, bic):\n    return e is not None and e.Category is not None and idv(e.Category.Id) == catid(bic)\n\n\ndef tname(t):\n    p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\n\ndef setp(e, bip, val):\n    p = e.get_Parameter(bip)\n    if p is not None and not p.IsReadOnly:\n        p.Set(val)\n        return True\n    return False\n\n\ndef getd(e, bip):\n    p = e.get_Parameter(bip)\n    return p.AsDouble() if p is not None else None\n\n\ndef getlvl(e, bip):\n    p = e.get_Parameter(bip)\n    if p is None:\n        return None\n    x = doc.GetElement(p.AsElementId())\n    return x if isinstance(x, Level) else None\n\n\ndef tagged(e):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    return (p.AsString() or '') if p is not None else ''\n\n\ndef mark(e, txt):\n    setp(e, BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS, txt)\n\n\ndef workset_for(keys):\n    if not doc.IsWorkshared:\n        return None\n    for ws in FilteredWorksetCollector(doc).OfKind(WorksetKind.UserWorkset):\n        if any(k in ws.Name.upper() for k in keys):\n            return ws.Id.IntegerValue\n    return None\n\n\ndef put_ws(e, wid):\n    if wid is not None:\n        try:\n            setp(e, BuiltInParameter.ELEM_PARTITION_PARAM, wid)\n        except Exception:\n            pass\n\n\ndef material(keys):\n    mats = list(FilteredElementCollector(doc).OfClass(Material))\n    for k in keys:\n        hit = [m for m in mats if k in m.Name.upper()]\n        if hit:\n            hit.sort(key=lambda m: len(m.Name))\n            return hit[0].Id\n    return ElementId.InvalidElementId\n\n\nLEVELS = sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.ProjectElevation)\nLIDX = dict((idv(l.Id), i) for i, l in enumerate(LEVELS))\n\n\ndef parse_levels(text, base=None):\n    \"\"\"'L2, L3' / 'L2..L5' / 'ALL' (= every level above base)\"\"\"\n    res = []\n    names = dict((l.Name.strip().upper(), l) for l in LEVELS)\n    for tok in [t.strip() for t in str(text or '').replace(';', ',').split(',') if t.strip()]:\n        T = tok.upper()\n        if T in ('ALL', '*', 'ALL ABOVE'):\n            b = LIDX[idv(base.Id)] if base is not None else -1\n            res += LEVELS[b + 1:]\n        elif '..' in T:\n            a, b = [names.get(x.strip()) for x in T.split('..', 1)]\n            if a is None or b is None:\n                raise Exception('Unknown level in \"{0}\". Levels: {1}'.format(tok, ', '.join(l.Name for l in LEVELS)))\n            i, j = sorted([LIDX[idv(a.Id)], LIDX[idv(b.Id)]])\n            res += LEVELS[i:j + 1]\n        else:\n            if T not in names:\n                raise Exception('Unknown level \"{0}\". Levels: {1}'.format(tok, ', '.join(l.Name for l in LEVELS)))\n            res.append(names[T])\n    seen, uniq = set(), []\n    for l in res:\n        if idv(l.Id) not in seen:\n            seen.add(idv(l.Id))\n            uniq.append(l)\n    return uniq\n\n\ndef col_size(c):\n    sym = c.Symbol\n    for a, b in COL_PARAMS:\n        if sym.LookupParameter(a) is not None and sym.LookupParameter(b) is not None:\n            return sym.LookupParameter(a).AsDouble() / MMF, sym.LookupParameter(b).AsDouble() / MMF\n    bb = c.get_BoundingBox(None)\n    return (bb.Max.X - bb.Min.X) / MMF, (bb.Max.Y - bb.Min.Y) / MMF\n\n\ndef angle_of(e):\n    bx = e.GetTransform().BasisX\n    return math.degrees(math.atan2(bx.Y, bx.X))\n\n\n\n\ndef _pt(f, s, lat=None):\n    lat = f['lat'] if lat is None else lat\n    return (f['u'][0] * s + f['v'][0] * lat, f['u'][1] * s + f['v'][1] * lat)\n\n\n\ndef stair_type(rh_max, tread, width):\n    types = list(FilteredElementCollector(doc).OfClass(StairsType))\n    if not types:\n        raise Exception('No stair type in the project')\n    name = 'CAD2BIM Concrete Stair'\n    st = [t for t in types if tname(t) == name]\n    if st:\n        st = st[0]\n    else:\n        pref = [t for t in types if any(k in tname(t).upper() for k in ('CAST', 'MONOLITHIC', 'CONCRETE'))]\n        st = (pref or types)[0].Duplicate(name)\n    try:\n        st.MaxRiserHeight = max(st.MaxRiserHeight, (rh_max + 1.0) * MMF)\n        st.MinTreadDepth = min(st.MinTreadDepth, (tread - 1.0) * MMF)\n        st.MinRunWidth = min(st.MinRunWidth, (width - 1.0) * MMF)\n    except Exception as ex:\n        log('stair type limits: ' + str(ex))\n    conc = material(['CONCRETE, CAST', 'CONCRETE'])\n    for tid in (getattr(st, 'RunType', None), getattr(st, 'LandingType', None)):\n        t = doc.GetElement(tid) if tid is not None else None\n        if t is None:\n            continue\n        for pn in ('Monolithic Material', 'Structural Material', 'Material'):\n            p = t.LookupParameter(pn)\n            if p is not None and not p.IsReadOnly and conc != ElementId.InvalidElementId:\n                try:\n                    p.Set(conc)\n                except Exception:\n                    pass\n    return st\n\n\ndef railing_type():\n    rts = list(FilteredElementCollector(doc).OfClass(RailingType))\n    for keys in (('HANDRAIL',), ('900',), ('1100',), ('GUARD',)):\n        for t in rts:\n            if any(k in tname(t).upper() for k in keys):\n                return t\n    return rts[0] if rts else None\n\n\nPRE = None\nRAIL_ERR = []\ntry:\n    import uuid as _uuid\n    _ns = 'CAD2BIM_' + _uuid.uuid4().hex[:10]\n\n    class _Quiet(IFailuresPreprocessor):\n        __namespace__ = _ns\n\n        def PreprocessFailures(self, fa):\n            err = False\n            try:\n                for m in fa.GetFailureMessages():\n                    if m.GetSeverity() == FailureSeverity.Warning:\n                        fa.DeleteWarning(m)\n                    else:\n                        err = True\n                        try:\n                            RAIL_ERR.append(m.GetDescriptionText())\n                        except Exception:\n                            RAIL_ERR.append('Revit error')\n            except Exception:\n                pass\n            if err:                     # an error that cannot be ignored: roll back ONLY this transaction (no error dialog)\n                return FailureProcessingResult.ProceedWithRollBack\n            return FailureProcessingResult.Continue\n    PRE = _Quiet()\nexcept Exception as ex:\n    log('failure handler not available: ' + str(ex))\n\n\ndef risers_per_flight(flights, H, maxr, from_cad):\n    \"\"\"number of risers of every flight for a storey of height H (mm)\"\"\"\n    if from_cad:\n        return [len(f['s']) for f in flights]\n    R = int(math.ceil(H / maxr - 1e-6))\n    base = [len(f['s']) for f in flights]\n    tot = float(sum(base))\n    rs = [max(2, int(round(R * b / tot))) for b in base]\n    while sum(rs) > R:\n        rs[rs.index(max(rs))] -= 1\n    while sum(rs) < R:\n        rs[rs.index(min(rs))] += 1\n    return rs\n\n\ndef build_stair(base, top, flights, rs, tread, width_ovr, stype, tag):\n    H = (top.ProjectElevation - base.ProjectElevation)\n    R = sum(rs)\n    rh = H / R\n    scope = StairsEditScope(doc, 'CAD2BIM stair')\n    sid = scope.Start(base.Id, top.Id)\n    t = Transaction(doc, 'CAD2BIM stair runs')\n    t.Start()\n    notes = []\n    try:\n        st = doc.GetElement(sid)\n        try:                                            # (new stairs already use it as default type)\n            tp = st.get_Parameter(BuiltInParameter.ELEM_TYPE_PARAM)\n            if tp is not None and not tp.IsReadOnly and idv(tp.AsElementId()) != idv(stype.Id):\n                tp.Set(stype.Id)\n        except Exception as ex:\n            notes.append('type: {0}'.format(ex))\n        st.DesiredRisersNumber = R\n        st.ActualTreadDepth = tread * MMF\n        runs, zrel = [], 0.0\n        for f, r in zip(flights, rs):\n            s0 = f['s'][0]\n            sgn = 1.0 if f['s'][-1] > f['s'][0] else -1.0\n            a = _pt(f, s0)\n            b = _pt(f, s0 + sgn * (r - 1) * tread)\n            ln = Line.CreateBound(XYZ(a[0] * MMF, a[1] * MMF, zrel), XYZ(b[0] * MMF, b[1] * MMF, zrel))\n            run = StairsRun.CreateStraightRun(doc, sid, ln, StairsRunJustification.Center)\n            run.ActualRunWidth = (width_ovr if width_ovr > 0 else f['w']) * MMF\n            try:\n                if abs(run.BaseElevation - zrel) > 1e-4:\n                    run.TopElevation = zrel + r * rh\n                    run.BaseElevation = zrel\n            except Exception as ex:\n                notes.append('run elevation: {0}'.format(ex))\n            runs.append(run)\n            zrel += r * rh\n        for i in range(len(runs) - 1):\n            try:\n                StairsLanding.CreateAutomaticLanding(doc, runs[i].Id, runs[i + 1].Id)\n            except Exception as ex:\n                notes.append('landing {0}-{1} not automatic - sketch it in Edit Stairs'.format(i + 1, i + 2))\n        mark(st, tag)\n        t.Commit()\n    except Exception:\n        if t.HasStarted() and not t.HasEnded():\n            t.RollBack()\n        scope.Cancel()\n        raise\n    scope.Commit(PRE)\n    return sid, rh / MMF, notes\n\n\n\n# ---------------------------------------------------------------- stair layout inside a room (pure python, mm)\ndef oriented_rect(pts):\n    \"\"\"smallest rectangle aligned with the room's longest wall -> (angle, u0, u1, v0, v1)  (u = long side)\"\"\"\n    best = None\n    n = len(pts)\n    edges = sorted(((math.hypot(pts[(i + 1) % n][0] - pts[i][0], pts[(i + 1) % n][1] - pts[i][1]), i)\n                    for i in range(n)), reverse=True)\n    for _, i in edges[:4]:\n        a = math.atan2(pts[(i + 1) % n][1] - pts[i][1], pts[(i + 1) % n][0] - pts[i][0])\n        c, s = math.cos(a), math.sin(a)\n        us = [p[0] * c + p[1] * s for p in pts]; vs = [-p[0] * s + p[1] * c for p in pts]\n        r = (max(us) - min(us)) * (max(vs) - min(vs))\n        if best is None or r < best[0]:\n            best = (r, a, min(us), max(us), min(vs), max(vs))\n    _, a, u0, u1, v0, v1 = best\n    if (v1 - v0) > (u1 - u0):                         # make u the long side\n        a += math.pi / 2\n        c, s = math.cos(a), math.sin(a)\n        us = [p[0] * c + p[1] * s for p in pts]; vs = [-p[0] * s + p[1] * c for p in pts]\n        u0, u1, v0, v1 = min(us), max(us), min(vs), max(vs)\n    return a, u0, u1, v0, v1\n\n\ndef plan_layout(rect, H, maxr, tread, gap, width_req, door=None, flip=False, wmax=2000.0):\n    \"\"\"dog-leg (2 flights + half landing) if it fits, else a straight flight.\n    returns (kind, flights, risers, info) - flights in the format of build_stair (u, v, s, lat, w)\"\"\"\n    a, u0, u1, v0, v1 = rect\n    L, W = u1 - u0, v1 - v0\n    c, s = math.cos(a), math.sin(a)\n    U = (c, s); Vv = (-s, c)\n    R = int(math.ceil(H / maxr - 1e-6))\n    r1 = int(math.ceil(R / 2.0)); r2 = R - r1\n    # which end is the entrance (bottom) and which side starts: from the door, else default / flip\n    du = dv = -1.0\n    if door is not None:\n        pu = door[0] * c + door[1] * s; pv = -door[0] * s + door[1] * c\n        du = -1.0 if (pu - u0) <= (u1 - pu) else 1.0\n        dv = -1.0 if (pv - v0) <= (v1 - pv) else 1.0\n    if flip:\n        dv = -dv\n    sgn_u = 1.0 if du < 0 else -1.0                   # walking direction of flight 1 (away from the entrance)\n    entry = u0 if du < 0 else u1\n    far = u1 if du < 0 else u0\n    # dog-leg\n    wf = (W - gap) / 2.0\n    if width_req > 0:\n        wf = min(wf, width_req)\n    wf = min(wf, wmax)\n    need = (r1 - 1) * tread + wf                      # flight + half landing\n    if wf >= 750 and r2 >= 2 and need <= L + 1:\n        s_top = far - sgn_u * wf                      # half landing touches the far wall\n        s_bot = s_top - sgn_u * (r1 - 1) * tread\n        side1 = (v0 + wf / 2.0) if dv < 0 else (v1 - wf / 2.0)\n        side2 = (v1 - wf / 2.0) if dv < 0 else (v0 + wf / 2.0)\n        f1 = {'u': U, 'v': Vv, 's': [s_bot, s_top], 'lat': side1, 'w': wf}\n        f2 = {'u': U, 'v': Vv, 's': [s_top, s_top - sgn_u * (r2 - 1) * tread], 'lat': side2, 'w': wf}\n        return 'dog-leg', [f1, f2], [r1, r2], {'R': R, 'rh': H / R, 'w': wf, 'need': need, 'L': L, 'W': W}\n    # straight\n    ws = min(W, width_req if width_req > 0 else W, wmax)\n    need_s = (R - 1) * tread\n    if ws >= 750 and need_s <= L + 1:\n        s_top = far\n        s_bot = s_top - sgn_u * need_s\n        f = {'u': U, 'v': Vv, 's': [s_bot, s_top], 'lat': (v0 + v1) / 2.0, 'w': ws}\n        return 'straight', [f], [R], {'R': R, 'rh': H / R, 'w': ws, 'need': need_s, 'L': L, 'W': W}\n    return None, [], [], {'R': R, 'rh': H / R, 'need': need, 'L': L, 'W': W, 'wf': wf}\n\n\nAUTO_MAX_RISER = 190.0     # auto-fit never makes the riser higher than this (mm) - set to your code limit\nAUTO_MIN_TREAD = 250.0     # auto-fit never makes the tread shorter than this (mm) - set to your code limit\n\n\ndef fit_layout(rect, H, maxr, tread, gap, width_req, door=None, flip=False):\n    \"\"\"plan_layout with the riser / tread as set; room too short -> the gentlest riser / tread that fits\n    (riser up to AUTO_MAX_RISER, tread down to AUTO_MIN_TREAD). info['tread'] = tread used, info['auto'] = changed\"\"\"\n    kind, fl, rs, info = plan_layout(rect, H, maxr, tread, gap, width_req, door, flip)\n    info['tread'] = tread\n    info['auto'] = False\n    info['rmax'] = max(maxr, AUTO_MAX_RISER)\n    info['tmin'] = min(tread, AUTO_MIN_TREAD)\n    if kind is not None:\n        return kind, fl, rs, info\n    R0 = info['R']\n    Rmin = max(2, int(math.ceil(H / info['rmax'] - 1e-6)))\n    best = None\n    for R in range(R0, Rmin - 1, -1):\n        t = tread\n        while t >= info['tmin'] - 1e-6:\n            # cost: riser rise and tread loss weighted alike (40 mm riser = 50 mm tread)\n            cost = (H / R - H / R0) / 40.0 + (tread - t) / 50.0\n            if best is not None and cost >= best[0] - 1e-9:\n                break                                   # shorter treads only cost more\n            k2, f2, r2, i2 = plan_layout(rect, H, H / R + 1e-6, t, gap, width_req, door, flip)\n            if k2 is not None:\n                best = (cost, k2, f2, r2, i2, t)\n                break\n            t -= 5.0\n    if best is None:\n        return kind, fl, rs, info\n    _, k2, f2, r2, i2, t = best\n    i2['tread'] = t\n    i2['auto'] = True\n    i2['rmax'] = info['rmax']\n    i2['tmin'] = info['tmin']\n    return k2, f2, r2, i2\n\n\nTAG = 'CAD2BIM-STAIRROOM'\n\n\ndef boundary_pts(sp):\n    \"\"\"outer boundary of a Room / Area as mm points\"\"\"\n    opt = SpatialElementBoundaryOptions()\n    loops = sp.GetBoundarySegments(opt)\n    best, best_a = None, -1.0\n    for loop in loops:\n        pts = []\n        for seg in loop:\n            for p in seg.GetCurve().Tessellate():\n                q = (p.X / MMF, p.Y / MMF)\n                if not pts or abs(pts[-1][0] - q[0]) + abs(pts[-1][1] - q[1]) > 1:\n                    pts.append(q)\n        if len(pts) >= 3:\n            a = abs(sum(pts[i - 1][0] * pts[i][1] - pts[i][0] * pts[i - 1][1] for i in range(len(pts)))) / 2.0\n            if a > best_a:\n                best, best_a = pts, a\n    return best\n\n\ndef name_of(sp):\n    p = sp.get_Parameter(BuiltInParameter.ROOM_NAME)\n    return (p.AsString() if p is not None else '') or ''\n\n\ndef door_point(sp, pts):\n    \"\"\"a door of this room (rooms: From/To room; areas: a door on the boundary)\"\"\"\n    xs = [p[0] for p in pts]; ys = [p[1] for p in pts]\n    for d in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Doors).WhereElementIsNotElementType():\n        try:\n            if isinstance(sp, Room):\n                fr, to = d.FromRoom, d.ToRoom\n                if not ((fr is not None and idv(fr.Id) == idv(sp.Id)) or (to is not None and idv(to.Id) == idv(sp.Id))):\n                    continue\n            lp = d.Location.Point\n            x, y = lp.X / MMF, lp.Y / MMF\n            if min(xs) - 400 <= x <= max(xs) + 400 and min(ys) - 400 <= y <= max(ys) + 400:\n                if idv(d.LevelId) == idv(sp.LevelId):\n                    return (x, y)\n        except Exception:\n            pass\n    return None\n\n\ntry:\n    KEYS = [k.strip().upper() for k in str(IN[0] or 'STAIR').split(',') if k.strip()] or ['STAIR']\n    USE_ROOMS = bool(IN[1]); USE_AREAS = bool(IN[2])\n    TOP_LV = str(IN[3] or '').strip()\n    MAXR = num(IN[4], 150); TREAD = num(IN[5], 300); WIDTH = num(IN[6], 0); GAP = num(IN[7], 150)\n    FLIP = bool(IN[8]); RAILS = bool(IN[9]); DO = bool(IN[10])\n    log('inputs: keys {0} rooms {1} areas {2} top \"{3}\" maxr {4} tread {5} width {6} gap {7} flip {8} rails {9} run {10}'.format(\n        KEYS, USE_ROOMS, USE_AREAS, TOP_LV, MAXR, TREAD, WIDTH, GAP, FLIP, RAILS, DO))\n    if not DO:\n        raise Exception('Switch on PLACE / UPDATE STAIRS, then Run')\n\n    # ---------------- stair rooms / areas\n    spaces = []\n    cats = ([BuiltInCategory.OST_Rooms] if USE_ROOMS else []) + ([BuiltInCategory.OST_Areas] if USE_AREAS else [])\n    for bic in cats:\n        for sp in FilteredElementCollector(doc).OfCategory(bic).WhereElementIsNotElementType():\n            try:\n                if sp.Area <= 0 or not any(k in name_of(sp).upper() for k in KEYS):\n                    continue\n                lv = doc.GetElement(sp.LevelId)\n                pts = boundary_pts(sp)\n                if lv is None or not pts:\n                    continue\n                cx = sum(p[0] for p in pts) / len(pts); cy = sum(p[1] for p in pts) / len(pts)\n                # an Area on the same footprint as a Room = the same stair\n                if any(idv(o['lv'].Id) == idv(lv.Id) and abs(o['c'][0] - cx) < 500 and abs(o['c'][1] - cy) < 500 for o in spaces):\n                    continue\n                spaces.append({'sp': sp, 'lv': lv, 'pts': pts, 'c': (cx, cy), 'name': name_of(sp)})\n            except Exception as ex:\n                log('skip space: ' + str(ex))\n    if not spaces:\n        raise Exception('No Room / Area named {0} - name the stair rooms (e.g. STAIR 1) and Run'.format(' / '.join(KEYS)))\n\n    top_limit = parse_levels(TOP_LV)[0] if TOP_LV else None\n\n    # ---------------- storeys for every stair room\n    jobs = []                                   # (space, base level, top level)\n    for o in spaces:\n        i = LIDX[idv(o['lv'].Id)]\n        if i + 1 >= len(LEVELS):\n            continue                            # room on the top level: nothing to climb to\n        jobs.append((o, LEVELS[i], LEVELS[i + 1]))\n        if top_limit is not None:               # repeat up to the chosen level (unless that floor has its own stair room)\n            j = i + 1\n            while j + 1 < len(LEVELS) and LEVELS[j].ProjectElevation < top_limit.ProjectElevation - 0.01:\n                own = any(idv(p['lv'].Id) == idv(LEVELS[j].Id) and abs(p['c'][0] - o['c'][0]) < 1500\n                          and abs(p['c'][1] - o['c'][1]) < 1500 for p in spaces)\n                if not own:\n                    jobs.append((o, LEVELS[j], LEVELS[j + 1]))\n                j += 1\n\n    # ---------------- what already exists\n    existing = {}\n    for e in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Stairs).WhereElementIsNotElementType():\n        t = tagged(e)\n        if t.startswith(TAG + '|'):\n            parts = t.split('|')\n            existing[parts[1] + '|' + (parts[2] if len(parts) > 2 else '')] = (e, parts[3] if len(parts) > 3 else '')\n    plans, keep_keys = [], set()\n    for o, b, t_ in jobs:\n        H = (t_.ProjectElevation - b.ProjectElevation) / MMF\n        rect = oriented_rect(o['pts'])\n        door = door_point(o['sp'], o['pts'])\n        kind, fl, rs, info = fit_layout(rect, H, MAXR, TREAD, GAP, WIDTH, door, FLIP)\n        key = o['sp'].UniqueId + '|' + b.Name\n        sig = '{0:.0f},{1:.0f},{2:.0f},{3:.0f},{4:.4f},{5:.0f},{6},{7:.0f},{8:.0f},{9:.0f},{10},{11}'.format(\n            rect[1], rect[2], rect[3], rect[4], rect[0], H, t_.Name, MAXR, TREAD, WIDTH, FLIP, door is not None)\n        plans.append((o, b, t_, H, kind, fl, rs, info, key, sig))\n        keep_keys.add(key)\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    removed = 0\n    for k, (e, sig) in list(existing.items()):\n        if k not in keep_keys:                  # room deleted / renamed -> its stair goes\n            doc.Delete(e.Id)\n            removed += 1\n            del existing[k]\n    todo = []\n    for p in plans:\n        key, sig = p[8], p[9]\n        if key in existing and existing[key][1] == sig:\n            continue                            # unchanged\n        if key in existing:\n            doc.Delete(existing[key][0].Id)     # room moved / resized -> rebuild\n        todo.append(p)\n    TransactionManager.Instance.ForceCloseTransaction()\n\n    rows, warn, made, rails = [], [], 0, 0\n    if todo:\n        widths = [p[7].get('w', 1000) for p in todo if p[4]]\n        rhs = [p[7]['rh'] for p in todo if p[4]]\n        tt = Transaction(doc, 'CAD2BIM stair type')\n        tt.Start()\n        stype = stair_type(max(rhs or [MAXR]), min([p[7]['tread'] for p in todo if p[4]] or [TREAD]), min(widths or [1000]))\n        try:\n            doc.SetDefaultElementTypeId(ElementTypeGroup.StairsType, stype.Id)\n        except Exception:\n            pass\n        rtype = railing_type() if RAILS else None\n        tt.Commit()\n        for o, b, t_, H, kind, fl, rs, info, key, sig in todo:\n            label = '{0} ({1})'.format(o['name'], b.Name)\n            if kind is None:\n                warn.append('{0}: NOT BUILT - room {1:.0f} x {2:.0f} too small: needs {3:.0f} mm length for {4} risers, '\n                            'and no fit even with riser up to {5:.0f} / tread down to {6:.0f} - make the room longer'.format(\n                    label, info['L'], info['W'], info['need'] + 0, info['R'], info['rmax'], info['tmin']))\n                continue\n            try:\n                sid, rh, notes = build_stair(b, t_, fl, rs, info['tread'], 0, stype, '{0}|{1}|{2}'.format(TAG, key, sig))\n                made += 1\n                rows.append('  {0:<22} {1} -> {2}  H {3:.0f}  {4:<8} {5} risers {6:.1f} x {7:.0f}  width {8:.0f}'.format(\n                    label[:22], b.Name, t_.Name, H, kind, '+'.join(str(r) for r in rs), rh, info['tread'], fl[0]['w']))\n                if info['auto']:\n                    warn.append('{0}: AUTO-FIT - room {1:.0f} mm long is too short for riser <= {2:.0f} / tread {3:.0f}, '\n                                'built with riser {4:.1f} x tread {5:.0f} - check against your code'.format(\n                        label, info['L'], MAXR, TREAD, rh, info['tread']))\n                warn.extend('{0}: {1}'.format(label, n) for n in notes)\n                if rtype is not None:\n                    RAIL_ERR[:] = []\n                    tr = Transaction(doc, 'CAD2BIM handrails')\n                    try:\n                        if PRE is not None:\n                            _fo = tr.GetFailureHandlingOptions()\n                            _fo.SetFailuresPreprocessor(PRE)\n                            tr.SetFailureHandlingOptions(_fo)\n                    except Exception:\n                        pass\n                    tr.Start()\n                    try:\n                        Railing.Create(doc, sid, rtype.Id, RailingPlacementPosition.Treads)\n                        _st = tr.Commit()\n                        if str(_st) == 'Committed':\n                            rails += 2\n                        else:\n                            warn.append('{0}: railing skipped: {1}'.format(label, RAIL_ERR[-1] if RAIL_ERR else 'Revit could not build the rail'))\n                    except Exception as ex:\n                        tr.RollBack()\n                        if 'already has associated railings' in str(ex):\n                            rails += 2\n            except Exception as ex:\n                log(traceback.format_exc())\n                warn.append('{0}: FAILED {1}'.format(label, str(ex).split(chr(10))[0]))\n\n    out.append('CAD2BIM STAIRS FROM ROOMS  -  DONE')\n    out.append('Stair rooms/areas: {0}  |  storeys: {1}  |  built {2}, unchanged {3}, removed {4}'.format(\n        len(spaces), len(plans), made, len(plans) - len(todo), removed))\n    out.append('Rule: riser <= {0:.0f} mm (exact = floor height / risers), tread {1:.0f} mm, handrails {2}'.format(\n        MAXR, TREAD, rails))\n    out.extend(rows)\n    if warn:\n        out.append('Check:')\n        out.extend('  - ' + w for w in warn[:15])\n    out.append('Moved / resized a stair room? just Run again - only changed stairs are rebuilt.')\nexcept Exception as ex:\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n    out.insert(0, 'FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\ntry:                                                    # show the result in Revit, not only in the REPORT node\n    clr.AddReference('RevitAPIUI')\n    from Autodesk.Revit.UI import TaskDialog as _TD\n    _TD.Show('B10 Stairs in stair rooms', '\\n'.join(out))\nexcept Exception as ex:\n    log('result dialog: ' + str(ex))\nOUT = out\n",
      "Engine": "CPython3",
