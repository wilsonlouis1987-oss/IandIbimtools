{
  "Uuid": "fb9d714b-a185-4330-bbf3-c56670441109",
  "IsCustomNode": false,
  "Description": "ELEVATION / SECTION SHEET: open the sheet with the elevations or sections (or one elevation) - SD view template (material colour + hatch, grey poche, elements behind fade to grey), crop to the building, level heads, grid bubbles, level / height / grid / width dimensions, spot levels on roof + parapet tops, door / window tags and material notes on what you can see, then ONE scale for the sheet (largest that fits) and the viewports packed inside the title block. Run again = replaced, no doubles. Works in any project.",
  "Name": "D15_DRAWINGS_Elevation_Section_Sheet_Template_Colour_Depth_Levels_Grids_Dims_Spots_Tags_Fit_Scale",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "2b2b1f645f1f4785854d56332881fdeb",
      "Name": "SD VIEW TEMPLATE  SD_ELEVATION / SD_SECTION",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
