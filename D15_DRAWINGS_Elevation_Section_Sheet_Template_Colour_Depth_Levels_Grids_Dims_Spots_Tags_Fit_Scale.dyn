      "Description": "Enables selection between True and False"
    },
    {
      "Id": "3fadb678bf2748f09f27f64a26e53654",
      "Name": "LEVELS + GRIDS  trimmed, heads both ends, bubbles on top",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "006b0ac495a24df8af35b4e8e41e3bbe",
      "Name": "LEVEL DIMS  level chain + overall height (left)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "7f433ce6b41946fa8f6341e91e924a9a",
      "Name": "GRID DIMS  grid chain + overall width (below)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "827445a79e1f4e77bb91b61fd0e503e6",
      "Name": "SPOT LEVELS on roof / parapet tops",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "e98ba5c963564355bb5242ab0aabdfc8",
      "Name": "DOOR + WINDOW TAGS  (only the ones you can see)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "ca7bc5a5526242f2a36609003c038360",
      "Name": "MATERIAL NOTES  (one per wall material you can see)",
      "Type": "boolean",
      "Type2": "boolean",
      "Value": "true",
      "Description": "Enables selection between True and False"
    },
    {
      "Id": "ddd78458b1fd4a468b9042065bd8a61a",
      "Name": "AUTO SCALE + FIT the viewports on the sheet",
      "Type": "boolean",
