    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - COLUMN CONTROL for the columns SELECTED in Revit (sliders -> Run)\nimport os\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\ndef log(msg):\n    try:\n        with open(LOG, 'a') as f:\n            f.write(str(msg) + '\\n')\n    except Exception:\n        pass\nlog('--- column control started')\nimport clr, math, re, traceback\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nMMF = 1.0 / 304.8\nSIZE_PARAMS = [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')]\nout = []\n\n\ndef num(v, d=0.0):\n    try:\n        return float(v)\n    except Exception:\n        return d\n\n\ndef tname(t):\n    p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\n\ntry:\n    ANGLE = num(IN[0]); DO_ROT = bool(IN[1])\n    B = num(IN[2]); H = num(IN[3]); DO_SIZE = bool(IN[4])\n    TOP_OFF = num(IN[5]); BASE_OFF = num(IN[6]); DO_HEIGHT = bool(IN[7])\n    TOP_LEVEL = str(IN[8] or '').strip()\n    log('inputs: angle {0} ({1}), size {2}x{3} ({4}), top {5} base {6} ({7}), top level \"{8}\"'.format(\n        ANGLE, DO_ROT, B, H, DO_SIZE, TOP_OFF, BASE_OFF, DO_HEIGHT, TOP_LEVEL))\n    uidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n    cols = []\n    for eid in uidoc.Selection.GetElementIds():\n        e = doc.GetElement(eid)\n        if isinstance(e, FamilyInstance) and e.Category is not None and \\\n                e.Category.Id.ToString() in (Category.GetCategory(doc, BuiltInCategory.OST_StructuralColumns).Id.ToString(),\n                                             Category.GetCategory(doc, BuiltInCategory.OST_Columns).Id.ToString()):\n            cols.append(e)\n    if not cols:\n        raise Exception('Select one or more columns in Revit, then press Run')\n    top_lv = None\n    if DO_HEIGHT and TOP_LEVEL:\n        m = [l for l in FilteredElementCollector(doc).OfClass(Level) if l.Name.lower() == TOP_LEVEL.lower()]\n        if not m:\n            raise Exception('No level named \"{0}\"'.format(TOP_LEVEL))\n        top_lv = m[0]\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    made = set()\n    for c in cols:\n        if DO_SIZE and B > 0 and H > 0:\n            sym = c.Symbol\n            sp = None\n            for a, b in SIZE_PARAMS:\n                if sym.LookupParameter(a) is not None and sym.LookupParameter(b) is not None:\n                    sp = (a, b)\n                    break\n            if sp is None:\n                out.append('size skipped: type \"{0}\" has no b/h or Width/Depth'.format(tname(sym)))\n            else:\n                old = tname(sym)\n                new = re.sub(r'\\d+(\\.\\d+)?\\s*[xX]\\s*\\d+(\\.\\d+)?', '{0:.0f}x{1:.0f}'.format(B, H), old)\n                if new == old:\n                    new = '{0} {1:.0f}x{2:.0f}'.format(sym.Family.Name, B, H)\n                target = None\n                for sid in sym.Family.GetFamilySymbolIds():\n                    s = doc.GetElement(sid)\n                    if tname(s) == new:\n                        target = s\n                if target is None:\n                    target = sym.Duplicate(new)\n                    target.LookupParameter(sp[0]).Set(B * MMF)\n                    target.LookupParameter(sp[1]).Set(H * MMF)\n                    made.add(new)\n                if not target.IsActive:\n                    target.Activate()\n                if c.Symbol.Id.ToString() != target.Id.ToString():\n                    c.Symbol = target\n        if DO_HEIGHT:\n            if top_lv is not None:\n                c.get_Parameter(BuiltInParameter.FAMILY_TOP_LEVEL_PARAM).Set(top_lv.Id)\n            c.get_Parameter(BuiltInParameter.FAMILY_TOP_LEVEL_OFFSET_PARAM).Set(TOP_OFF * MMF)\n            c.get_Parameter(BuiltInParameter.FAMILY_BASE_LEVEL_OFFSET_PARAM).Set(BASE_OFF * MMF)\n        if DO_ROT:\n            pt = c.Location.Point\n            bx = c.GetTransform().BasisX\n            cur = math.degrees(math.atan2(bx.Y, bx.X))\n            delta = (ANGLE - cur + 180.0) % 360.0 - 180.0\n            if abs(delta) > 0.01:\n                ElementTransformUtils.RotateElement(doc, c.Id, Line.CreateBound(pt, pt.Add(XYZ.BasisZ)), math.radians(delta))\n    TransactionManager.Instance.TransactionTaskDone()\n    out.insert(0, 'DONE on {0} selected column(s): {1}{2}{3}'.format(\n        len(cols),\n        'angle {0:.0f} deg; '.format(ANGLE) if DO_ROT else '',\n        'size {0:.0f}x{1:.0f}; '.format(B, H) if DO_SIZE else '',\n        'top {0}{1:+.0f} / base {2:+.0f}'.format(TOP_LEVEL + ' ' if top_lv else '', TOP_OFF, BASE_OFF) if DO_HEIGHT else ''))\n    if made:\n        out.append('new type(s): ' + ', '.join(sorted(made)))\nexcept Exception as ex:\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n    out.append('FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nOUT = out\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
