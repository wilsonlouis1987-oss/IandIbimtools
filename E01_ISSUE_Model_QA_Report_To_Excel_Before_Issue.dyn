{
  "Uuid": "b3cbdc09-6bc6-494f-8626-f58e553844f5",
  "IsCustomNode": false,
  "Description": "Model health check before every issue: warnings, rooms, views not on sheets, sheet numbers, CAD imports, links, in-place families, groups, purgeable, levels - QA report Excel (model not changed)",
  "Name": "CAD2BIM_Model_QA_Check",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.Filename, CoreNodeModels",
