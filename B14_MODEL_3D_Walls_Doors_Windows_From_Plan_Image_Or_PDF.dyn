    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =====================================================================\n#  PLAN2BIM - B14 3D WALLS FROM A PLAN PICTURE OR PDF   (Revit 2026)   v3 (2026-11-24)\n#  JPG / PNG / PDF of a floor plan  ->\n#    1. the plan goes into your plan view as an underlay at TRUE SCALE\n#    2. scale from:  LINE  = a dimension or scale bar you mark on the picture + its real length (most exact)\n#                    SCALE = PDF drawn at 1:100 / 1:50 ...      WALL = outer wall thickness (e.g. 230)\n#                    WIDTH = overall building width\n#    3. walls found in the picture (filled, hatched or double-line walls), wall thickness per wall,\n#       gaps -> doors, gaps with glass lines -> windows, then a 3D view\n#  v2: grey / coloured floor fills -> read again with dark lines only (INK_THR, plan_walls_best);\n#      thin inner walls kept (tmin 30 mm); hollow outlines (door leaves, cupboards, porch edges) are not walls (solid_only)\n#  v3: DIMENSIONS written on the plan are read first (dimension lines + Windows OCR): they give the scale, and walls\n#      standing on a dimension point are set exactly at the written distance; DIM 8850 = you type what the marked\n#      dimension D1 says (small text); \"... ONLY\" behind the scale = do not use the dimensions\n#  v4: the whole picture is read first and reported (walls, doors with their SWING, COLUMNS with size, ROOM NAMES,\n#      STAIRS, grids, dimensions), then built: doors hung and opening as drawn, concrete structural columns, Revit\n#      rooms named from the picture + room tags, real stairs (tread 300, riser 150, B18 engine); no furniture\n#  Not found: curved walls, slanted walls shorter than 3 m, walls hidden by furniture -> draw them on the underlay.\n#  Runs in pyRevit (IronPython 2.7) and Dynamo CPython3.\n# =====================================================================\nimport bisect, math, os, re, subprocess\n\ntry:\n    import clr\n    clr.AddReference('RevitAPI')\n    clr.AddReference('System.Drawing')\n    from Autodesk.Revit.DB import *                       # noqa\n    from Autodesk.Revit.DB.Structure import StructuralType\n    import System\n    import System.Drawing as SD\n    import System.Drawing.Imaging as SDI\n    import System.Drawing.Drawing2D as SD2\n    from System.Collections.Generic import List\n    REVIT = True\nexcept Exception:                                         # plain Python: tests of the detection\n    REVIT = False\n\nMMF = 1.0 / 304.8\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'PLAN2BIM_log.txt')\nTAG = 'B14 PLAN|'\n\n\ndef log(msg):\n    try:\n        with open(LOG, 'a') as f:\n            f.write(str(msg) + '\\n')\n    except Exception:\n        pass\n\n# ------------------------------------------------------------------ plan picture -> wall centre lines (pure Python)\n\nRUN = re.compile('1+')\nNET_MM = 2500.0\nSLANT_MM = 3000.0                                         # slanted walls shorter than this are ignored\nMIN_WALL_MM = 25.0\nMIN_WALL_RATIO = 0.28\nSTD_THK = [100.0, 115.0, 150.0, 200.0, 230.0, 250.0, 300.0, 350.0, 400.0]\n\n\ndef ink_row(r, g, b, thr=150, sat=70):\n    \"\"\"one row of channel byte values -> '1' ink (dark, not coloured) / '0' paper\"\"\"\n    out = []\n    for i in range(len(r)):\n        R, G, B = r[i], g[i], b[i]\n        mx = R if R > G else G\n        mx = mx if mx > B else B\n        mn = R if R < G else G\n        mn = mn if mn < B else B\n        out.append('1' if (R * 299 + G * 587 + B * 114) < thr * 1000 and mx - mn < sat else '0')\n    return ''.join(out)\n\n\ndef transpose(rows):\n    if not rows:\n        return []\n    return [''.join(c) for c in zip(*rows)]\n\n\ndef closed_runs(s, gmax):\n    out = []\n    for m in RUN.finditer(s):\n        a, b = m.start(), m.end() - 1\n        if out and a - out[-1][1] - 1 <= gmax:\n            out[-1][1] = b\n        else:\n            out.append([a, b])\n    return out\n\n\ndef track(lines, gmax, tmin, tmax, tol=1, cmax=0):\n    \"\"\"runs of ink (gaps <= gmax closed) with stable edges along the lines -> wall tracks.\n    A track also carries on (up to cmax lines) where its band is covered by a wider run: furniture against\n    the wall, or the wall it runs into at a corner / T.\"\"\"\n    opened = {}                                           # x0 -> list of tracks\n    done = []\n    for y, s in enumerate(lines):\n        nxt = {}\n        used = set()\n        runs = closed_runs(s, gmax)\n        for a, b in runs:\n            L = b - a + 1\n            if L < tmin or L > tmax:\n                continue\n            hit = None\n            for k in range(a - tol, a + tol + 1):\n                for t in opened.get(k, ()):\n                    if id(t) not in used and abs(t['x1'] - b) <= tol:\n                        hit = t\n                        break\n                if hit:\n                    break\n            if hit is None:\n                hit = {'y0': y, 'c0': (a + b + 1) / 2.0, 'sL': 0.0, 'n': 0, 'pts': [], 'ink': 0}\n            used.add(id(hit))\n            hit['x0'], hit['x1'], hit['yl'], hit['ylr'] = a, b, y, y\n            hit['sL'] += L\n            hit['ink'] += s.count('1', a, b + 1)          # solid wall ~1.0, outline of a door leaf ~0.5\n            hit['n'] += 1\n            hit['pts'].append((y, (a + b + 1) / 2.0))\n            nxt.setdefault(a, []).append(hit)\n        starts = [r[0] for r in runs]\n        for lst in opened.values():\n            for t in lst:\n                if id(t) in used:\n                    continue\n                if cmax and y - t['ylr'] <= cmax:        # band covered by a wider run: carry on\n                    i = bisect.bisect_right(starts, t['x0'] + tol) - 1\n                    if i >= 0 and runs[i][0] <= t['x0'] + tol and runs[i][1] >= t['x1'] - tol:\n                        t['yl'] = y\n                        nxt.setdefault(t['x0'], []).append(t)\n                        continue\n                if y - t['yl'] <= 2:                      # allow a 1-2 px break (JPEG noise)\n                    nxt.setdefault(t['x0'], []).append(t)\n                else:\n                    done.append(t)\n        opened = nxt\n    for lst in opened.values():\n        done.extend(lst)\n    for t in done:                                        # do not run on past the wall it met\n        t['yl'] = min(t['yl'], t['ylr'] + tmax)\n    return done\n\n\ndef _fit(pts):\n    \"\"\"least squares x = m*y + c over the track centres\"\"\"\n    n = float(len(pts))\n    sy = sum(p[0] for p in pts)\n    sx = sum(p[1] for p in pts)\n    syy = sum(p[0] * p[0] for p in pts)\n    sxy = sum(p[0] * p[1] for p in pts)\n    den = n * syy - sy * sy\n    m = (n * sxy - sy * sx) / den if abs(den) > 1e-9 else 0.0\n    return m, (sx - m * sy) / n\n\n\ndef pieces_from(tracks, vertical, min_len, slant_min=0):\n    out = []\n    for t in tracks:\n        if t['n'] < 2:\n            continue\n        L = t['sL'] / t['n']                              # run width across the lines\n        span = t['yl'] - t['y0'] + 1\n        if t['n'] < max(min_len, 2.0 * L) or t['n'] < 0.5 * span:\n            continue\n        m, c = _fit(t['pts'])\n        if abs(m) < 0.06:                                 # straight: snap to exactly vertical / horizontal\n            m, c = 0.0, sum(p[1] for p in t['pts']) / len(t['pts'])\n        elif span < slant_min:                            # short slanted bits are furniture / hatch\n            continue\n        thk = L / math.sqrt(1.0 + m * m)                  # true thickness of a slanted wall\n        y0, y1 = t['y0'], t['yl'] + 1\n        a, b = (m * y0 + c, y0), (m * y1 + c, y1)\n        if not vertical:\n            a, b = (a[1], a[0]), (b[1], b[0])\n        out.append({'p': a, 'q': b, 't': thk, 'len': span * math.sqrt(1.0 + m * m), 'v': vertical,\n                    'fill': t['ink'] / t['sL'] if t['sL'] else 1.0})\n    return out\n\n\ndef _dedupe(pcs):\n    \"\"\"45 deg walls show in both scans: keep the longer copy\"\"\"\n    pcs = sorted(pcs, key=lambda p: -p['len'])\n    keep = []\n    for p in pcs:\n        dx, dy = p['q'][0] - p['p'][0], p['q'][1] - p['p'][1]\n        if abs(dx) > 1e-6 and abs(dy) > 1e-6:             # slanted only\n            mid = ((p['p'][0] + p['q'][0]) / 2.0, (p['p'][1] + p['q'][1]) / 2.0)\n            dup = False\n            for k in keep:\n                kx, ky = k['q'][0] - k['p'][0], k['q'][1] - k['p'][1]\n                kl = math.hypot(kx, ky) or 1.0\n                cross = abs((mid[0] - k['p'][0]) * ky - (mid[1] - k['p'][1]) * kx) / kl\n                u = ((mid[0] - k['p'][0]) * kx + (mid[1] - k['p'][1]) * ky) / kl\n                ang = abs(dx * ky - dy * kx) / ((math.hypot(dx, dy) or 1.0) * kl)\n                if cross < max(p['t'], k['t']) and -2 <= u <= kl + 2 and ang < 0.2:\n                    dup = True\n                    break\n            if dup:\n                continue\n        keep.append(p)\n    return keep\n\n\ndef _axis(p):\n    \"\"\"vertical / horizontal piece -> (orientation, offset, t0, t1); None for slanted\"\"\"\n    (x0, y0), (x1, y1) = p['p'], p['q']\n    if abs(x1 - x0) < 1e-6:\n        return 'V', x0, min(y0, y1), max(y0, y1)\n    if abs(y1 - y0) < 1e-6:\n        return 'H', y0, min(x0, x1), max(x0, x1)\n    return None\n\n\ndef _contained(pcs):\n    \"\"\"a thin piece lying inside a thicker wall (e.g. the double face line of an outer wall) is dropped\"\"\"\n    ax = [_axis(p) for p in pcs]\n    order = sorted(range(len(pcs)), key=lambda i: -pcs[i]['t'])\n    keep = []\n    for i in order:\n        a = ax[i]\n        p = pcs[i]\n        inside = False\n        if a is not None:\n            for j in keep:\n                b = ax[j]\n                q = pcs[j]\n                if b is None or b[0] != a[0] or q['t'] < p['t'] * 1.15:\n                    continue\n                if abs(a[1] - b[1]) + p['t'] / 2.0 > q['t'] / 2.0 + 1.5:\n                    continue\n                ov = min(a[3], b[3]) - max(a[2], b[2])\n                if ov > 0.6 * (a[3] - a[2]):\n                    inside = True\n                    break\n        if not inside:\n            keep.append(i)\n    return [pcs[i] for i in sorted(keep)]\n\n\ndef _same(pcs):\n    \"\"\"the same wall found by two passes: keep one copy per overlap\"\"\"\n    ax = [_axis(p) for p in pcs]\n    order = sorted(range(len(pcs)), key=lambda i: -pcs[i]['len'])\n    keep = []\n    for i in order:\n        a = ax[i]\n        dup = False\n        if a is not None:\n            for j in keep:\n                b = ax[j]\n                if b is None or b[0] != a[0] or abs(a[1] - b[1]) > 1.5 or abs(pcs[i]['t'] - pcs[j]['t']) > 1.6:\n                    continue\n                ov = min(a[3], b[3]) - max(a[2], b[2])\n                if ov > 0.6 * (a[3] - a[2]):\n                    dup = True\n                    break\n        if not dup:\n            keep.append(i)\n    return [pcs[i] for i in sorted(keep)]\n\n\ndef thickness_classes(pcs, ratio=1.3):\n    \"\"\"[(px thickness, total length)] biggest first: groups of similar thickness\"\"\"\n    items = sorted((p['t'], p['len']) for p in pcs)\n    cls = []\n    for t, L in items:\n        if cls and t <= cls[-1]['lo'] * ratio:\n            c = cls[-1]\n            c['w'] += L\n            c['s'] += t * L\n        else:\n            cls.append({'lo': t, 'w': L, 's': t * L})\n    res = [(c['s'] / c['w'], c['w']) for c in cls]\n    return sorted(res, key=lambda c: -c[0])\n\n\ndef line_width(rows):\n    \"\"\"most common width of thin ink runs = the pen width of the drawing\"\"\"\n    h = {}\n    for s in rows[::3]:\n        for m in RUN.finditer(s):\n            L = m.end() - m.start()\n            if L <= 6:\n                h[L] = h.get(L, 0) + 1\n    return float(max(h, key=h.get)) if h else 1.0\n\n\ndef detect_plan(rows, mm_px=None, tmin_mm=30.0, tmax_mm=500.0):\n    \"\"\"rows = ink strings ('1'/'0').  mm_px known -> wall range from mm, else from the picture size.\n    returns pieces (px, y down), classes\"\"\"\n    H = len(rows)\n    W = len(rows[0]) if rows else 0\n    if mm_px:\n        tmin = max(3, int(round(tmin_mm / mm_px)))\n        tmax = max(tmin + 2, int(math.ceil(tmax_mm / mm_px)))\n    else:\n        tmin = 3\n        tmax = max(8, int(min(W, H) / 22.0))\n    cols = transpose(rows)\n    min_len = max(4, int((300.0 / mm_px) if mm_px else tmax * 0.6))\n    pcs = []\n    cmax = int(1200.0 / mm_px) if mm_px else tmax * 3\n    slant_min = (SLANT_MM / mm_px) if mm_px else tmax * 10\n    gaps = sorted(set([2, max(2, tmax // 3), tmax - 2]))\n    for gmax in gaps:                                     # small gaps: thin double-line walls near doors / text;\n        pcs += pieces_from(track(rows, gmax, tmin, tmax, 1, cmax), True, min_len, slant_min)     # big gaps: thick hollow / hatched walls\n        pcs += pieces_from(track(cols, gmax, tmin, tmax, 1, cmax), False, min_len, slant_min)\n    pcs = _dedupe(_contained(_same(pcs)))\n    lw = line_width(rows)\n    for p in pcs:                                         # faces are drawn lines: thickness = line centre to centre\n        p['t'] = max(1.0, p['t'] - lw)\n    return {'lw': lw, 'pieces': pcs, 'classes': thickness_classes(pcs), 'W': W, 'H': H, 'tmin': tmin, 'tmax': tmax, 'gmax': gaps}\n\n\n# ------------------------------------------------------------------ keep the wall network, drop furniture / text / cars\ndef _seg_dist(a, b, p):\n    dx, dy = b[0] - a[0], b[1] - a[1]\n    L2 = dx * dx + dy * dy\n    u = 0.0 if L2 < 1e-9 else max(0.0, min(1.0, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / L2))\n    return math.hypot(a[0] + dx * u - p[0], a[1] + dy * u - p[1])\n\n\ndef _pdist(P, Q):\n    return min(_seg_dist(P['p'], P['q'], Q['p']), _seg_dist(P['p'], P['q'], Q['q']),\n               _seg_dist(Q['p'], Q['q'], P['p']), _seg_dist(Q['p'], Q['q'], P['q']))\n\n\ndef network(pcs, min_total, near=2.5, gap=0.0):\n    \"\"\"pieces touching (corner / T, within near px) or in line across a door gap (<= gap px) form one network;\n    small separate networks (furniture, cars, text) are dropped\"\"\"\n    n = len(pcs)\n    ax = [_axis(p) for p in pcs]\n    par = list(range(n))\n\n    def f(a):\n        while par[a] != a:\n            par[a] = par[par[a]]\n            a = par[a]\n        return a\n    for i in range(n):\n        for j in range(i + 1, n):\n            lim = (pcs[i]['t'] + pcs[j]['t']) / 2.0 + near\n            a, b = ax[i], ax[j]\n            if a and b and a[0] == b[0] and abs(a[1] - b[1]) <= max(pcs[i]['t'], pcs[j]['t']) / 2.0:\n                lim = max(lim, gap)                       # same line: across a door gap\n            if _pdist(pcs[i], pcs[j]) <= lim:\n                par[f(i)] = f(j)\n    tot = {}\n    for i in range(n):\n        tot[f(i)] = tot.get(f(i), 0.0) + pcs[i]['len']\n    big = max(tot.values()) if tot else 0.0\n    keep = [pcs[i] for i in range(n) if tot[f(i)] >= max(min_total, 0.2 * big)]\n    return keep, n - len(keep)\n\n\ndef solid_only(pcs):\n    \"\"\"walls drawn solid (most of the length): a hollow piece (two lines with paper between: porch / garage edge,\n    cupboard, door leaf) only counts when it is as thick as a solid wall kind (an outer wall with window lines)\"\"\"\n    tl = sum(p['len'] for p in pcs) or 1.0\n    sol = [p for p in pcs if p.get('fill', 1.0) >= 0.6]\n    if sum(p['len'] for p in sol) < 0.5 * tl:\n        return pcs                                        # hatched / double-line walls: keep everything\n    scls = strong_classes(thickness_classes(sol))\n    return [p for p in pcs if p.get('fill', 1.0) >= 0.6 or snap_class(p['t'], scls) is not None]\n\n\ndef strong_classes(classes, share=0.06):\n    tot = sum(w for t, w in classes) or 1.0\n    return [c for c in classes if c[1] >= share * tot] or classes[:1]\n\n\ndef snap_class(t, strong):\n    if not strong:\n        return t\n    best = min(strong, key=lambda c: abs(math.log(c[0] / t)))\n    return best[0] if abs(math.log(best[0] / t)) < math.log(1.7) else None\n\n\n# ------------------------------------------------------------------ walls through door / window gaps (from B12, in px)\ndef _canon(p, q):\n    a = math.degrees(math.atan2(q[1] - p[1], q[0] - p[0])) % 180.0\n    if a > 179.5:\n        a -= 180.0\n    t = math.radians(a)\n    return a, (math.cos(t), math.sin(t))\n\n\ndef _lines_along(rows, d, n, off, t, u0, u1):\n    \"\"\"count straight ink lines running along the gap inside the wall band (window glass / sill lines)\"\"\"\n    H = len(rows)\n    W = len(rows[0]) if rows else 0\n    hits = []\n    v = -t / 2.0 + 0.5\n    while v <= t / 2.0:\n        k = tot = 0\n        u = u0 + 1.0\n        while u < u1 - 1.0:\n            x = int(d[0] * u + n[0] * (off + v))\n            y = int(d[1] * u + n[1] * (off + v))\n            if 0 <= x < W and 0 <= y < H:\n                tot += 1\n                if rows[y][x] == '1':\n                    k += 1\n            u += 1.0\n        hits.append(tot > 2 and k >= 0.7 * tot)\n        v += 1.0\n    groups, prev = 0, False\n    for h in hits:\n        if h and not prev:\n            groups += 1\n        prev = h\n    return groups\n\n\ndef _swing(orows, d, n, off, t, u0, u1):\n    \"\"\"door leaf: a straight line standing out from one end of the gap, about as long as the gap -> True\"\"\"\n    if not orows:\n        return False\n    H = len(orows)\n    W = len(orows[0])\n    gap = u1 - u0\n    for side in (1.0, -1.0):\n        for ue in (u0, u1):\n            for du in (-2.0, -1.0, 0.0, 1.0, 2.0):\n                u = ue + du\n                run = best = 0\n                v = t / 2.0 + 1.0\n                while v <= t / 2.0 + 1.2 * gap:\n                    x = int(d[0] * u + n[0] * (off + side * v))\n                    y = int(d[1] * u + n[1] * (off + side * v))\n                    if 0 <= x < W and 0 <= y < H and orows[y][x] == '1':\n                        run += 1\n                        best = max(best, run)\n                    else:\n                        run = 0\n                    v += 1.0\n                if best >= 0.6 * gap:\n                    return True\n    return False\n\n\ndef build_walls(pcs, rows, door_min, door_max, win_max, orows=None, outer_t=None):\n    \"\"\"pieces (px, class thickness) -> walls running through door / window gaps, with the openings\"\"\"\n    groups = []\n    for pc in sorted(pcs, key=lambda p: -p['t']):\n        a, d = _canon(pc['p'], pc['q'])\n        n = (-d[1], d[0])\n        off = pc['p'][0] * n[0] + pc['p'][1] * n[1]\n        t0 = pc['p'][0] * d[0] + pc['p'][1] * d[1]\n        t1 = pc['q'][0] * d[0] + pc['q'][1] * d[1]\n        iv = (min(t0, t1), max(t0, t1))\n        for g in groups:\n            da = abs(g['a'] - a)\n            if min(da, 180.0 - da) <= 1.0 and abs(g['t'] - pc['t']) < 0.01 and abs(off - g['off']) <= max(1.5, 0.3 * pc['t']):\n                g['iv'].append(iv)\n                break\n        else:\n            groups.append({'a': a, 'd': d, 'n': n, 'off': off, 't': pc['t'], 'iv': [iv], 'fill': []})\n    for g in groups:                                      # thinner bits inside a gap of a thicker wall = window\n        iv = sorted(g['iv'])\n        g['holes'] = [(iv[k][1], iv[k + 1][0]) for k in range(len(iv) - 1) if iv[k + 1][0] - iv[k][1] <= win_max]\n    for g in sorted(groups, key=lambda g: g['t']):\n        if not g['iv']:\n            continue\n        for o in groups:\n            da = abs(g['a'] - o['a'])\n            if o['t'] <= g['t'] or min(da, 180.0 - da) > 1.0 or abs(g['off'] - o['off']) + g['t'] / 2.0 > o['t'] / 2.0 + 1.5:\n                continue\n            rest = []\n            for a0, a1 in g['iv']:\n                if any(min(a1, h1) - max(a0, h0) >= 0.6 * (a1 - a0) for h0, h1 in o['holes']):\n                    o['fill'].append((a0, a1))\n                else:\n                    rest.append((a0, a1))\n            g['iv'] = rest\n    groups = [g for g in groups if g['iv']]\n    walls = []\n    for g in groups:\n        d, n, off = g['d'], g['n'], g['off']\n\n        def P(t):\n            return (d[0] * t + n[0] * off, d[1] * t + n[1] * off)\n        iv = sorted(g['iv'])\n        cur = list(iv[0])\n        ops = []\n        for a, b in iv[1:]:\n            gap = a - cur[1]\n            if gap <= door_min:                           # tiny break: close it\n                cur[1] = max(cur[1], b)\n                continue\n            filled = sum(max(0.0, min(a, f1) - max(cur[1], f0)) for f0, f1 in g['fill'])\n            lines = _lines_along(rows, d, n, off, g['t'], cur[1], a)\n            outer = outer_t is not None and g['t'] >= 0.8 * outer_t\n            if ((filled >= 0.4 * gap or lines >= 1) or (outer and not _swing(orows, d, n, off, g['t'], cur[1], a))) \\\n                    and gap <= win_max:\n                ops.append({'c': P((cur[1] + a) / 2.0), 'w': gap, 'kind': 'window'})\n                cur[1] = max(cur[1], b)\n            elif gap <= door_max:\n                ops.append({'c': P((cur[1] + a) / 2.0), 'w': gap, 'kind': 'door'})\n                cur[1] = max(cur[1], b)\n            else:\n                walls.append({'p': P(cur[0]), 'q': P(cur[1]), 't': g['t'], 'ops': ops})\n                cur, ops = [a, b], []\n        walls.append({'p': P(cur[0]), 'q': P(cur[1]), 't': g['t'], 'ops': ops})\n    return walls\n\n\ndef _inter(p1, d1, p2, d2):\n    den = d1[0] * d2[1] - d1[1] * d2[0]\n    if abs(den) < 1e-9:\n        return None\n    return ((p2[0] - p1[0]) * d2[1] - (p2[1] - p1[1]) * d2[0]) / den\n\n\ndef _dir(w):\n    L = math.hypot(w['q'][0] - w['p'][0], w['q'][1] - w['p'][1]) or 1.0\n    return ((w['q'][0] - w['p'][0]) / L, (w['q'][1] - w['p'][1]) / L), L\n\n\ndef _runs_along(walls, w, E, dv, s):\n    \"\"\"would extending w from E by s run over another wall lying in the same line?\"\"\"\n    for o in walls:\n        if o is w or abs(w['d'][0] * o['d'][1] - w['d'][1] * o['d'][0]) > 0.05:\n            continue\n        n = (-w['d'][1], w['d'][0])\n        if abs((o['p'][0] - E[0]) * n[0] + (o['p'][1] - E[1]) * n[1]) > max(w['t'], o['t']) / 2.0:\n            continue\n        u0 = (o['p'][0] - E[0]) * dv[0] + (o['p'][1] - E[1]) * dv[1]\n        u1 = (o['q'][0] - E[0]) * dv[0] + (o['q'][1] - E[1]) * dv[1]\n        if min(max(u0, u1), s) - max(min(u0, u1), 0.0) > 0.25 * s:\n            return True\n    return False\n\n\ndef join_walls(walls, door_min, door_max, slack):\n    \"\"\"L / T corners: ends run onto the wall they meet; an end stopping a door width short gets a door\"\"\"\n    for w in walls:\n        w['d'], w['L'] = _dir(w)\n    for w in walls:\n        for end in ('p', 'q'):\n            E = w[end]\n            dv = w['d'] if end == 'q' else (-w['d'][0], -w['d'][1])\n            best = None\n            for o in walls:\n                if o is w or abs(w['d'][0] * o['d'][1] - w['d'][1] * o['d'][0]) < 0.17:\n                    continue\n                s = _inter(E, dv, o['p'], o['d'])\n                if s is None:\n                    continue\n                X = (E[0] + dv[0] * s, E[1] + dv[1] * s)\n                u = (X[0] - o['p'][0]) * o['d'][0] + (X[1] - o['p'][1]) * o['d'][1]\n                if u < -o['t'] or u > o['L'] + o['t']:\n                    continue\n                face = s - o['t'] / 2.0\n                lim = max(w['t'], o['t']) / 2.0 + slack\n                if -lim <= s <= lim or (0 < face < door_min):\n                    kind = 'join'\n                elif door_min <= face <= door_max and not _runs_along(walls, w, E, dv, s):\n                    kind = 'door'\n                else:\n                    continue\n                if best is None or abs(s) < abs(best[0]):\n                    best = (s, X, kind, face)\n            if best is not None:\n                s, X, kind, face = best\n                if kind == 'door':\n                    c = (E[0] + dv[0] * face / 2.0, E[1] + dv[1] * face / 2.0)\n                    w['ops'].append({'c': c, 'w': face, 'kind': 'door'})\n                w[end] = X\n        w['d'], w['L'] = _dir(w)\n    return walls\n\n\ndef walls_from_plan(rows, mm_px, door_min_mm=600.0, door_max_mm=2400.0, win_max_mm=6000.0, orows=None):\n    \"\"\"everything in px; mm only for limits\"\"\"\n    res = detect_plan(rows, mm_px)\n    pcs, dropped = network(solid_only(res[\"pieces\"]), NET_MM / mm_px, 300.0 / mm_px, door_max_mm / mm_px) if NET_MM > 0 else (res[\"pieces\"], 0)\n    strong = strong_classes(thickness_classes(pcs))\n    top = max(c[0] for c in strong) if strong else 0.0\n    # thinner than ~1/4 of the outer walls = furniture / window lines (relative, so a wrong scale guess keeps the walls)\n    strong = [c for c in strong if c[0] >= MIN_WALL_RATIO * top and c[0] * mm_px >= MIN_WALL_MM]\n    use = []\n    for p in pcs:\n        t = snap_class(p['t'], strong)\n        if t is not None:\n            q = dict(p)\n            q['t'] = t\n            use.append(q)\n    tot_w = sum(c[1] for c in strong) or 1.0\n    big = [c for c in strong if c[1] >= 0.15 * tot_w] or strong\n    outer_t = max(c[0] for c in big) if big else None        # the outer walls: thickest kind with a real share\n    thin = [p for p in use if outer_t and p['t'] < 0.6 * outer_t]\n    tl = sum(p['len'] for p in thin) or 1.0\n    if thin and sum(p['len'] for p in thin if p.get('fill', 1.0) >= 0.85) >= 0.6 * tl:\n        # inner walls drawn solid: thin hollow outlines are door leaves / cupboards (hatched plans keep them)\n        use = [p for p in use if p.get('fill', 1.0) >= 0.7 or p['t'] >= 0.6 * outer_t]\n    walls = build_walls(use, rows, door_min_mm / mm_px, door_max_mm / mm_px, win_max_mm / mm_px, orows, outer_t)\n    walls = join_walls(walls, door_min_mm / mm_px, door_max_mm / mm_px, 60.0 / mm_px)\n    walls = [w for w in walls if w['L'] * mm_px >= 150.0]\n    res.update({'walls': walls, 'strong': strong, 'dropped': dropped, 'used': use})\n    return res\n\n\n# ------------------------------------------------------------------ furniture / sanitary / steps (pure Python)\ndef obj_row(r, g, b, lum_max=172, col_sat=60, col_lum=235):\n    \"\"\"'1' = something drawn on the floor: dark or mid grey, or coloured (furniture renders, sanitary)\"\"\"\n    out = []\n    for i in range(len(r)):\n        R, G, B = r[i], g[i], b[i]\n        mx = max(R, G, B)\n        mn = min(R, G, B)\n        lum = (R * 299 + G * 587 + B * 114) / 1000.0\n        out.append('1' if lum < lum_max or (mx - mn >= col_sat and lum < col_lum) else '0')\n    return ''.join(out)\n\n\ndef _bits(rows):\n    return [int(s, 2) if '1' in s else 0 for s in rows]\n\n\ndef _dilate(v, W, r):\n    full = (1 << W) - 1\n    for _ in range(r):\n        h = [(x | (x << 1) | (x >> 1)) & full for x in v]\n        v = [h[y] | (h[y - 1] if y else 0) | (h[y + 1] if y + 1 < len(h) else 0) for y in range(len(h))]\n    return v\n\n\ndef _wall_mask(walls, W, H, grow):\n    m = [0] * H\n    for w in walls:\n        xs = [w['p'][0], w['q'][0]]\n        ys = [w['p'][1], w['q'][1]]\n        h = w['t'] / 2.0 + grow\n        x0, x1 = int(max(0, min(xs) - h)), int(min(W - 1, max(xs) + h))\n        y0, y1 = int(max(0, min(ys) - h)), int(min(H - 1, max(ys) + h))\n        if x1 < x0:\n            continue\n        rm = ((1 << (x1 - x0 + 1)) - 1) << (W - 1 - x1)\n        for y in range(y0, y1 + 1):\n            m[y] |= rm\n    return m\n\n\ndef _to_rows(v, W):\n    return [bin(x)[2:].rstrip('L').zfill(W) if x else '0' * W for x in v]\n\n\ndef components(rows):\n    \"\"\"8-connected blobs from run lengths -> [{'x0','y0','x1','y1','n'}]\"\"\"\n    par = {}\n\n    def f(a):\n        while par[a] != a:\n            par[a] = par[par[a]]\n            a = par[a]\n        return a\n    prev = []\n    runs = []\n    k = 0\n    for y, s in enumerate(rows):\n        cur = []\n        j = 0\n        for m in RUN.finditer(s):\n            a, b = m.start(), m.end() - 1\n            par[k] = k\n            while j < len(prev) and prev[j][1] < a - 1:\n                j += 1\n            jj = j\n            while jj < len(prev) and prev[jj][0] <= b + 1:\n                ra, rb = f(prev[jj][2]), f(k)\n                if ra != rb:\n                    par[ra] = rb\n                jj += 1\n            cur.append((a, b, k))\n            runs.append((y, a, b, k))\n            k += 1\n        prev = cur\n    comp = {}\n    for y, a, b, i in runs:\n        c = comp.setdefault(f(i), {'x0': a, 'x1': b, 'y0': y, 'y1': y, 'n': 0})\n        c['x0'] = min(c['x0'], a)\n        c['x1'] = max(c['x1'], b)\n        c['y1'] = y\n        c['n'] += b - a + 1\n    return list(comp.values())\n\n\ndef _filled(rows, c):\n    \"\"\"share of the blob's box that is the blob or closed in by it (outline of a bed = full, a door swing = low)\"\"\"\n    x0, x1, y0, y1 = c['x0'], c['x1'], c['y0'], c['y1']\n    w, h = x1 - x0 + 3, y1 - y0 + 3\n    seen = bytearray(w * h)\n    for yy in range(h):\n        y = y0 - 1 + yy\n        if 0 <= y < len(rows):\n            s = rows[y]\n            for xx in range(w):\n                x = x0 - 1 + xx\n                if 0 <= x < len(s) and s[x] == '1':\n                    seen[yy * w + xx] = 2                 # blob\n    stack = [0]\n    seen[0] = 1\n    out = 0\n    while stack:\n        i = stack.pop()\n        out += 1\n        yy, xx = divmod(i, w)\n        for j in ((i - 1) if xx else -1, (i + 1) if xx + 1 < w else -1, i - w, i + w):\n            if 0 <= j < w * h and not seen[j]:\n                seen[j] = 1\n                stack.append(j)\n    return 1.0 - float(out - (2 * w + 2 * h - 4)) / max(1.0, float((w - 2) * (h - 2)))\n\n\ndef _tread_lines(ink, c, along_x):\n    \"\"\"evenly spaced straight lines across the blob = stair treads -> count, spacing px\"\"\"\n    x0, x1, y0, y1 = c['x0'], c['x1'], c['y0'], c['y1']\n    lines = []\n    if along_x:                                           # treads run left-right: look at rows\n        for y in range(y0, y1 + 1):\n            seg = ink[y][x0:x1 + 1]\n            if seg.count('1') >= 0.75 * len(seg):\n                lines.append(y)\n    else:\n        for x in range(x0, x1 + 1):\n            col = ''.join(ink[y][x] for y in range(y0, y1 + 1))\n            if col.count('1') >= 0.75 * len(col):\n                lines.append(x)\n    grp = []\n    for v in lines:\n        if grp and v - grp[-1][-1] <= 1:\n            grp[-1].append(v)\n        else:\n            grp.append([v])\n    cs = [sum(g) / float(len(g)) for g in grp]\n    if len(cs) < 5:\n        return 0, 0.0\n    gaps = [b - a for a, b in zip(cs, cs[1:])]\n    m = sum(gaps) / len(gaps)\n    if m <= 0 or max(abs(g - m) for g in gaps) > 0.3 * m:\n        return 0, 0.0\n    return len(cs), m\n\n\n# name, category, height mm, test(L, W) with L >= W in mm\nKINDS_3D = [\n    ('Car', 'generic', 1500, lambda L, W: 3500 <= L <= 5500 and 1500 <= W <= 2300),\n    ('Bed', 'furniture', 550, lambda L, W: 1800 <= L <= 2400 and 850 <= W <= 2200),\n    ('Bathtub', 'plumbing', 550, lambda L, W: 1350 <= L <= 1900 and 650 <= W <= 900),\n    ('Shower', 'plumbing', 60, lambda L, W: 700 <= W and L <= 1300 and L / W < 1.4),\n    ('WC', 'plumbing', 400, lambda L, W: 500 <= L <= 800 and 330 <= W <= 520),\n    ('Basin', 'plumbing', 850, lambda L, W: 380 <= L <= 700 and 280 <= W < 560),\n    ('Chair', 'furniture', 450, lambda L, W: 350 <= W and L <= 650),\n    ('Counter / wardrobe', 'furniture', 900, lambda L, W: 450 <= W <= 750 and L >= 1000),\n    ('Sofa', 'furniture', 800, lambda L, W: 1400 <= L <= 3200 and 700 <= W <= 1100),\n    ('Table', 'furniture', 750, lambda L, W: 700 <= W <= 1300 and 700 <= L <= 2800),\n]\n\n\ndef _is_text(orows, c, mm_px):\n    \"\"\"room names / sizes: letters side by side on a line - similar heights, not nested, line much wider than tall\"\"\"\n    sub = [r[c['x0']:c['x1'] + 1] for r in orows[c['y0']:c['y1'] + 1]]\n    parts = [p for p in components(sub) if p['n'] > 2]\n    if len(parts) < 3:\n        return False\n    hs = sorted(p['y1'] - p['y0'] + 1 for p in parts)\n    hmed = hs[len(hs) // 2]\n    big = max(max(p['x1'] - p['x0'] + 1, p['y1'] - p['y0'] + 1) for p in parts)\n    if big > 3.5 * hmed:                                  # a long line or a big shape: not lettering\n        return False\n    letters = [p for p in parts if 0.5 * hmed <= p['y1'] - p['y0'] + 1 <= 1.6 * hmed]\n    if len(letters) < 0.7 * len(parts):\n        return False\n    letters.sort(key=lambda p: p['x0'])\n    nested = 0\n    for i, p in enumerate(letters):\n        for q in letters[i + 1:]:\n            if q['x0'] > p['x1']:\n                break\n            ov_y = min(p['y1'], q['y1']) - max(p['y0'], q['y0'])\n            if ov_y > 0.5 * hmed and min(p['x1'], q['x1']) - q['x0'] > 2:\n                nested += 1\n    return nested <= len(letters) // 4\n\n\ndef _is_shaft(orows, x0, y0, x1, y1):\n    \"\"\"a box with both diagonals drawn (the plan symbol for a shaft / duct)\"\"\"\n    W, H = len(orows[0]), len(orows)\n    w, h = x1 - x0, y1 - y0\n    if min(w, h) < 8:\n        return False\n\n    def hit(x, y):\n        for dx in (-1, 0, 1):\n            for dy in (-1, 0, 1):\n                xx, yy = int(round(x)) + dx, int(round(y)) + dy\n                if 0 <= xx < W and 0 <= yy < H and orows[yy][xx] == '1':\n                    return True\n        return False\n\n    def frac(pts):\n        pts = list(pts)\n        return sum(1 for p in pts if hit(*p)) / float(max(1, len(pts)))\n    n = int(max(w, h))\n    t = [0.1 + 0.8 * i / float(n) for i in range(n + 1)]   # leave the corners out (any box has those)\n    d1 = frac((x0 + w * k, y0 + h * k) for k in t)\n    d2 = frac((x1 - w * k, y0 + h * k) for k in t)\n    mid = frac([(x0 + w * k, y0 + h * 0.5) for k in t[::3]] + [(x0 + w * 0.5, y0 + h * k) for k in t[::3]])\n    return d1 >= 0.75 and d2 >= 0.75 and mid < 0.6     # both diagonals, not a filled / hatched block\n\n\ndef find_objects(orows, ink, walls, mm_px, W, H, min_mm=300.0, max_m2=14.0):\n    \"\"\"furniture / sanitary / steps drawn in the plan -> [{'x0','y0','x1','y1','kind','cat','h', 'steps'}] (px)\"\"\"\n    v = _bits(orows)\n    wm = _wall_mask(walls, W, H, 2.0)\n    full = (1 << W) - 1\n    v = [x & ~m & full for x, m in zip(v, wm)]\n    grow = max(1, int(round(60.0 / mm_px)))               # join an object's own parts (outline + pattern)\n    d = _dilate(v, W, grow)\n    d = [x & ~m & full for x, m in zip(d, wm)]\n    drow = _to_rows(d, W)\n    res = []\n    for c in components(drow):\n        wpx, hpx = c['x1'] - c['x0'] + 1, c['y1'] - c['y0'] + 1\n        Lmm, Wmm = max(wpx, hpx) * mm_px, min(wpx, hpx) * mm_px\n        if Wmm < min_mm or Lmm * Wmm / 1e6 > max_m2 or Lmm / max(Wmm, 1.0) > 8.0 or max(wpx, hpx) < 14:\n            continue                                      # text, dimension lines, whole rooms\n        g0 = grow\n        if Wmm >= 400.0 and _is_shaft(ink, c['x0'] + g0, c['y0'] + g0, c['x1'] - g0, c['y1'] - g0):   # black X only\n            res.append(dict(c, x0=c['x0'] + g0, y0=c['y0'] + g0, x1=c['x1'] - g0, y1=c['y1'] - g0,\n                            kind='Shaft', cat='generic', h=None, steps=0))\n            continue\n        st_x = _tread_lines(ink, c, True)\n        st_y = _tread_lines(ink, c, False)\n        st = st_x if st_x[0] >= st_y[0] else st_y\n        if st[0] >= 5 and 180.0 <= st[1] * mm_px <= 380.0:\n            res.append(dict(c, kind='Stair', cat='generic', h=None, steps=st[0] + 1, along_y=(st is st_x)))\n            continue\n        if _filled(drow, c) < 0.55:\n            continue                                      # door swings, loose lines\n        if _is_text(orows, c, mm_px) or (min(wpx, hpx) <= 15 and max(wpx, hpx) >= 2.5 * min(wpx, hpx) and Wmm < 450):\n            continue                                      # room names, areas, a line of text\n        kind = ('Object', 'furniture', 750)\n        for name, cat, hmm, test in KINDS_3D:\n            if test(Lmm, Wmm):\n                kind = (name, cat, hmm)\n                break\n        res.append(dict(c, kind=kind[0], cat=kind[1], h=float(kind[2]), steps=0))\n    keep = []\n    for o in res:                                         # a box around other objects is a room outline, not furniture\n        inside = [p for p in res if p is not o and o['x0'] <= (p['x0'] + p['x1']) / 2.0 <= o['x1']\n                  and o['y0'] <= (p['y0'] + p['y1']) / 2.0 <= o['y1'] and (p['x1'] - p['x0']) < (o['x1'] - o['x0'])]\n        if not inside:\n            keep.append(o)\n    return keep\n\n\n# ------------------------------------------------------------------ scale\nSTD_MM = [75.0, 100.0, 115.0, 125.0, 150.0, 200.0, 230.0, 250.0, 300.0, 350.0, 400.0, 450.0]\n\n\ndef snap_mm(t):\n    best = min(STD_MM, key=lambda s: abs(s - t))\n    return float(best) if abs(best - t) <= 0.08 * best else float(int(round(t / 5.0)) * 5)\n\n\ndef parse_scale(text, default=('WALL', 230.0)):\n    \"\"\"'LINE 2000' / 'WALL 230' / 'WIDTH 12000' / '1:100' / 'SCALE 1:50' / 'MMPX 25' / '230' -> (mode, number)\"\"\"\n    t = str(text or '').strip().upper().replace(',', '.')\n    if not t:\n        return default\n    t = t.replace('ONLY', '').strip()\n    if t.startswith('DIM'):                               # what the marked dimension D1 says: 8850, 8.85 m, 27'10\"\n        raw = re.sub('(?i)only', '', str(text).strip()[3:]).strip(' =:')\n        vs = dim_values(raw)\n        if vs:\n            v, kind = vs[0]\n            return 'DIM', v * (1000.0 if kind.startswith('dec') and v < 100 else 1.0)\n    if not t or t.startswith('AUTO'):\n        return default\n    m = re.search(r'1\\s*:\\s*([\\d.]+)', t)\n    if m:\n        return 'SCALE', float(m.group(1))\n    m = re.search(r'([\\d.]+)', t)\n    if not m:\n        return default\n    v = float(m.group(1))\n    for key in ('LINE', 'LEN', 'BAR'):\n        if t.startswith(key):\n            return 'LINE', v\n    if t.startswith('WID') or t.startswith('OVER'):\n        return 'WIDTH', v\n    if t.startswith('MMPX') or t.startswith('PX'):\n        return 'MMPX', v\n    if t.startswith('SCALE'):\n        return 'SCALE', v\n    return 'WALL', v\n\n\ndef _unscaled(rows):\n    res = detect_plan(rows, None)\n    keep, _ = network(solid_only(res['pieces']), 0.0, 3.0, res['tmax'] * 4.0) if res['pieces'] else ([], 0)\n    return keep, res\n\n\ndef ref_wall_px(rows):\n    \"\"\"thickness (px) of the outer walls: the thickest wall kind that makes up a good part of the walls\"\"\"\n    keep, res = _unscaled(rows)\n    cls = strong_classes(thickness_classes(keep))\n    if not cls:\n        return None\n    tot = sum(w for t, w in cls) or 1.0\n    big = [c for c in cls if c[1] >= 0.15 * tot] or cls\n    return max(big)[0]\n\n\ndef width_px(rows):\n    keep, res = _unscaled(rows)\n    if not keep:\n        return None\n    xs = []\n    for p in keep:\n        for e in (p['p'], p['q']):\n            xs.extend([e[0] - p['t'] / 2.0, e[0] + p['t'] / 2.0])\n    return max(xs) - min(xs)\n\n\ndef plan_walls(rows, mode, value, line_px=None, paper_mm_px=None, orows=None, dim_s=None):\n    \"\"\"-> dict(s = mm per px, walls (px) each with 'mm' thickness, msgs).  dim_s = scale from the written dimensions\"\"\"\n    msgs = []\n    s = None\n    if dim_s:\n        s, mode = dim_s, 'DIMS'\n    elif mode == 'MMPX':\n        s = value\n    elif mode == 'SCALE':\n        if paper_mm_px:\n            s = paper_mm_px * value\n            msgs.append('Scale 1:{0:g} from the PDF page size'.format(value))\n        else:\n            msgs.append('CHECK 1:{0:g} works for PDFs only (a picture has no paper size) - used the wall thickness 230 instead'.format(value))\n            mode, value = 'WALL', 230.0\n    elif mode == 'LINE':\n        if line_px:\n            s = value / line_px\n            msgs.append('Scale from your {0:g} mm line ({1:.0f} px on the picture)'.format(value, line_px))\n        else:\n            msgs.append('CHECK no line to scale from - used the wall thickness 230 instead')\n            mode, value = 'WALL', 230.0\n    if mode == 'WIDTH':\n        w = width_px(rows)\n        if w:\n            s = value / w\n            msgs.append('Scale from the overall width {0:g} mm ({1:.0f} px)'.format(value, w))\n        else:\n            mode, value = 'WALL', 230.0\n    if s is None:                                         # WALL\n        r = ref_wall_px(rows)\n        if not r:\n            raise Exception('no walls found in the picture to scale from - use LINE (a dimension) or SCALE 1:100')\n        s = value / r\n        msgs.append('Scale from the outer walls = {0:g} mm ({1:.1f} px thick)'.format(value, r))\n    res = walls_from_plan(rows, s, orows=orows)\n    strong = res['strong']\n    cmap = {}\n    for i, (t, w) in enumerate(strong):\n        cmap[t] = float(value) if (mode == 'WALL' and i == 0) else snap_mm(t * s)\n    for w in res['walls']:\n        w['mm'] = cmap.get(w['t']) or snap_mm(w['t'] * s)\n    res['s'] = s\n    res['msgs'] = msgs\n    res['mode'] = mode\n    return res\n\n\nINK_THR = (150, 100, 70)                                  # ink = darker than this; 100 / 70 skip grey floor fills\nLAST_INK = {}                                             # load_ink keeps the darker ink maps here: thr -> rows\n\n\ndef plan_walls_best(cands, mode, value, line_px=None, paper_mm_px=None, orows=None, dim_s=None):\n    \"\"\"cands = [(thr, rows)] lightest first.  Plans with grey / coloured floor fills melt the rooms into the walls at\n    the normal ink level: read with each level and keep the one that finds clearly more wall -> (res, thr, rows)\"\"\"\n    got = []\n    err = None\n    for thr, rows in cands:\n        try:\n            res = plan_walls(rows, mode, value, line_px, paper_mm_px, orows, dim_s)\n        except Exception as ex:\n            err = ex\n            continue\n        got.append((sum(w['L'] for w in res['walls']), res, thr, rows))    # wall length in px (same picture)\n    if not got:\n        raise err or Exception('no walls found in the picture')\n    base = got[0] if got[0][2] == cands[0][0] else (0.0, None, None, None)\n    best = max(got, key=lambda g: g[0])\n    if base[1] is not None and best[0] <= 2.0 * base[0]:   # only when clearly better: a darker level can lose walls\n        best = base\n    score, res, thr, rows = best\n    if thr != cands[0][0]:\n        res['msgs'].append('Walls read from the dark lines only (darker than {0}): grey / coloured floor fills ignored'.format(thr))\n    return res, thr, rows\n\ndef summary(res):\n    ws = res['walls']\n    nd = sum(1 for w in ws for o in w['ops'] if o['kind'] == 'door')\n    nw = sum(1 for w in ws for o in w['ops'] if o['kind'] == 'window')\n    by = {}\n    for w in ws:\n        by[w['mm']] = by.get(w['mm'], 0.0) + w['L'] * res['s'] / 1000.0\n    kinds = ', '.join('{0:.0f} mm: {1:.1f} m'.format(k, v) for k, v in sorted(by.items(), reverse=True))\n    ob = res.get('objects') or []\n    kinds_o = {}\n    for o in ob:\n        kinds_o[o['kind']] = kinds_o.get(o['kind'], 0) + 1\n    extra = ('; objects: ' + ', '.join('{0} {1}'.format(v, k) for k, v in sorted(kinds_o.items()))) if ob else ''\n    return '{0} walls ({1}), {2} doors, {3} windows{7}; 1 px = {4:.1f} mm, picture {5:.1f} x {6:.1f} m'.format(\n        len(ws), kinds, nd, nw, res['s'], res['W'] * res['s'] / 1000.0, res['H'] * res['s'] / 1000.0, extra)\n\n\n# ------------------------------------------------------------------ dimensions written on the plan (pure Python + Windows OCR)\n#  1. thin straight lines with cross marks (extension lines, ticks, arrows) and a small text next to the middle of each\n#     span = dimension lines;  2. every text is cut out, enlarged and read by Windows OCR;  3. number / pixel length of\n#     the dimensions that agree = the scale;  4. the dimension points become fixed coordinates the walls are set on.\nDIM_TOL = 0.03                                            # written and measured more apart than this: reported, not used\nDIM_MIN_TEXT = 9.0                                        # text lower than this (picture px) is not trusted without a check\nLAST_MARK = []                                            # load_ink keeps every drawn mark here (light lines too)\n\nPS_DIMS = r'''param([string]$path, [string]$boxes, [string]$heights = '44,64', [string]$prefix = '')\n$ErrorActionPreference = 'Stop'\nAdd-Type -AssemblyName System.Drawing\nAdd-Type -AssemblyName System.Runtime.WindowsRuntime\n$null = [Windows.Storage.StorageFile, Windows.Storage, ContentType = WindowsRuntime]\n$null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]\n$null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Graphics, ContentType = WindowsRuntime]\n$asTask = ([System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' })[0]\nfunction Await($op, [Type]$t) { $task = $asTask.MakeGenericMethod($t).Invoke($null, @($op)); $task.Wait() | Out-Null; $task.Result }\n$eng = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages()\nif ($eng -eq $null) { 'NOENGINE'; exit }\n$src = New-Object System.Drawing.Bitmap $path\n$items = @()\nforeach ($l in [IO.File]::ReadAllLines($boxes)) { $p = $l.Split('|'); if ($p.Length -ge 6) { $items += ,@([int]$p[0], [int]$p[1], [int]$p[2], [int]$p[3], [int]$p[4], [int]$p[5]) } }\n$sheetNo = 0\nfunction ReadSheet($sheet, $cells, $v) {\n  $script:sheetNo++\n  $tmp = [IO.Path]::Combine($env:TEMP, ('PLAN2BIM_dims{0}.png' -f $script:sheetNo))\n  $sheet.Save($tmp, [System.Drawing.Imaging.ImageFormat]::Png)\n  $file = Await ([Windows.Storage.StorageFile]::GetFileFromPathAsync($tmp)) ([Windows.Storage.StorageFile])\n  $stream = Await ($file.OpenAsync([Windows.Storage.FileAccessMode]::Read)) ([Windows.Storage.Streams.IRandomAccessStream])\n  $dec = Await ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])\n  $bmp = Await ($dec.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])\n  $res = Await ($eng.RecognizeAsync($bmp)) ([Windows.Media.Ocr.OcrResult])\n  $stream.Dispose()\n  foreach ($l in $res.Lines) { foreach ($w in $l.Words) { $r = $w.BoundingRect\n    $cx = $r.X + $r.Width / 2; $cy = $r.Y + $r.Height / 2\n    if ($prefix -and $w.Text -eq $prefix) { continue }\n    foreach ($c in $cells) { if (($prefix -or ($cx -ge $c[1] -and $cx -le $c[1] + $c[3])) -and $cy -ge $c[2] -and $cy -le $c[2] + $c[4]) {\n      \"T|{0}|{1}|{2}|{3}\" -f $c[0], $v, [int]$r.X, $w.Text; break } } } }\n}\n$v = 0\nforeach ($hs in $heights.Split(',')) {\n  $th = [int]$hs\n  $SW = 3400; $SH = 8000; $gap = 70\n  $sheet = New-Object System.Drawing.Bitmap $SW, $SH\n  $g = [System.Drawing.Graphics]::FromImage($sheet); $g.Clear([System.Drawing.Color]::White)\n  $g.InterpolationMode = 'HighQualityBicubic'; $g.PixelOffsetMode = 'Half'\n  $cells = @(); $x = $gap; $y = $gap\n  foreach ($it in $items) {\n    $rx = [Math]::Max(0, $it[1]); $ry = [Math]::Max(0, $it[2])\n    $rw = [Math]::Min($src.Width - $rx, $it[3]); $rh = [Math]::Min($src.Height - $ry, $it[4])\n    if ($rw -lt 2 -or $rh -lt 2) { continue }\n    $crop = $src.Clone((New-Object System.Drawing.Rectangle $rx, $ry, $rw, $rh), [System.Drawing.Imaging.PixelFormat]::Format24bppRgb)\n    if ($it[5] -eq 90) { $crop.RotateFlip([System.Drawing.RotateFlipType]::Rotate90FlipNone) }\n    if ($it[5] -eq 270) { $crop.RotateFlip([System.Drawing.RotateFlipType]::Rotate270FlipNone) }\n    $z = [Math]::Min(14.0, $th / $crop.Height)\n    $tw = [int]($crop.Width * $z); $thh = [int]($crop.Height * $z)\n    if ($tw -gt $SW - 2 * $gap) { $crop.Dispose(); continue }\n    if ($y + $th + $gap -gt $SH) {\n      $g.Dispose(); ReadSheet $sheet $cells $v\n      $sheet.Dispose(); $sheet = New-Object System.Drawing.Bitmap $SW, $SH\n      $g = [System.Drawing.Graphics]::FromImage($sheet); $g.Clear([System.Drawing.Color]::White)\n      $g.InterpolationMode = 'HighQualityBicubic'; $g.PixelOffsetMode = 'Half'\n      $cells = @(); $x = $gap; $y = $gap }\n    if ($prefix) {\n      # single letters are only read when they stand in a line of text: a printed word goes in front of each cut-out\n      $font = New-Object System.Drawing.Font 'Arial', ([single]($th * 0.8)), ([System.Drawing.FontStyle]::Regular), ([System.Drawing.GraphicsUnit]::Pixel)\n      $g.DrawString($prefix, $font, [System.Drawing.Brushes]::Black, [single]$gap, [single]($y + $th * 0.05))\n      $x = $gap + [int]$g.MeasureString($prefix, $font).Width + [int]($th * 0.3); $font.Dispose()\n    } elseif ($x + $tw + $gap -gt $SW) { $x = $gap; $y += $th + $gap }\n    $g.DrawImage($crop, $x, $y, $tw, $thh); $crop.Dispose()\n    $cells += ,@($it[0], ($x - 20), ($y - 20), ($tw + 40), ($thh + 40))\n    if ($prefix) { $x = $gap; $y += $th + $gap } else { $x += $tw + $gap }\n  }\n  $g.Dispose()\n  if ($cells.Count -gt 0) { ReadSheet $sheet $cells $v }\n  $sheet.Dispose()\n  $v++\n}\n$src.Dispose()\n'DONE'\n'''\n\n\ndef ocr_tiles(path, boxes, heights='44,64', prefix=''):\n    \"\"\"boxes [(x, y, w, h, rot)] in picture px -> {index: [text read at each size]} (Windows OCR, one text per cut-out)\"\"\"\n    res = {}\n    if not boxes:\n        return res\n    try:\n        tmp = _tmpdir()\n        ps = os.path.join(tmp, 'dims.ps1')\n        with open(ps, 'w') as f:\n            f.write(PS_DIMS)\n        lst = os.path.join(tmp, 'dims_boxes.txt')\n        with open(lst, 'w') as f:\n            for i, b in enumerate(boxes):\n                f.write('{0}|{1}|{2}|{3}|{4}|{5}\\n'.format(i, int(b[0]), int(b[1]), int(b[2]), int(b[3]), int(b[4])))\n        o, e = _ps(['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ps, path, lst, heights] + ([prefix] if prefix else []))\n        if 'DONE' not in o:\n            log('dims ocr: ' + (e.strip().splitlines() or [o.strip()[:200]])[-1][:300])\n        nv = len(heights.split(','))\n        got = {}\n        for l in o.splitlines():\n            p = l.strip().split('|', 4)\n            if len(p) == 5 and p[0] == 'T':\n                got.setdefault((int(p[1]), int(p[2])), []).append((int(p[3]), p[4]))\n        for (i, v), ws in got.items():\n            res.setdefault(i, [''] * nv)[v] = ''.join(t for x, t in sorted(ws))\n    except Exception as ex:\n        log('dims ocr: ' + str(ex))\n    return res\n\n\n_DIGITISH = {'O': '0', 'o': '0', 'D': '0', 'S': '5', 's': '5', 'l': '1', 'I': '1', '|': '1', 'B': '8', 'Z': '2', 'z': '2'}\n\n\ndef dim_values(text):\n    \"\"\"text of a dimension -> [(number, kind)], best first.  kind 'mm' = length known (feet-inches or a unit written),\n    'int' / 'dec' = plain number (unit worked out later from all dimensions), a '?' behind = OCR had to be mended\"\"\"\n    t = (text or '').strip()\n    for a, b in ((u'\u2019', \"'\"), (u'\u2018', \"'\"), (u'\u2032', \"'\"), (u'\u00b4', \"'\"), ('`', \"'\"), (u'\u201d', '\"'),\n                 (u'\u201c', '\"'), (u'\u2033', '\"'), (\"''\", '\"'), (' ', ''), (u'\u2212', '-'), (u'\u2013', '-')):\n        t = t.replace(a, b)\n    t = t.strip('-_~.,:;')\n    if not t or len(t) > 12:\n        return []\n    out = []\n    mend = ''\n    if not re.match(r'^[\\d\\'\".,/\\-]+(MM|CM|M|mm|cm|m)?$', t):\n        t2 = ''.join(_DIGITISH.get(c, c) for c in t)\n        if t2 == t or not re.match(r'^[\\d\\'\".,/\\-]+$', t2) or sum(1 for c in t if c.isdigit()) * 2 < len(t):\n            return []\n        t, mend = t2, '?'\n    u = t.upper()\n    m = re.match(r'^(\\d+)\\'-?(\\d+(?:\\.\\d+)?)?(?:-?(\\d+)/(\\d+))?\"?$', u)\n    if m:\n        inch = float(m.group(2) or 0)\n        if m.group(3) and float(m.group(4)):\n            inch += float(m.group(3)) / float(m.group(4))\n        return [((float(m.group(1)) * 12.0 + inch) * 25.4, 'mm' + mend)]\n    m = re.match(r'^(\\d+(?:[.,]\\d+)?)(MM|CM|M)$', u)\n    if m:\n        v = float(m.group(1).replace(',', '.'))\n        return [(v * {'MM': 1.0, 'CM': 10.0, 'M': 1000.0}[m.group(2)], 'mm' + mend)]\n    m = re.match(r'^(\\d+)\"$', u)\n    if m:\n        d = m.group(1)\n        out.append((float(d) * 25.4, 'mm' + mend))\n        for i in range(1, len(d) - 1):                    # 12'6\" read as 1216\": the 1 is the feet mark\n            if d[i] == '1' and float(d[i + 1:]) < 12:\n                out.append(((float(d[:i]) * 12.0 + float(d[i + 1:])) * 25.4, 'mm?'))\n        return out\n    m = re.match(r'^(\\d+)[.,](\\d+)$', u)\n    if m:\n        v = float(m.group(1) + '.' + m.group(2))\n        if len(m.group(2)) == 3:                          # 8,850 = 8850 mm = 8.850 m\n            return [(v * 1000.0, 'mm' + mend)]\n        return [(v, 'dec' + mend)]\n    if re.match(r'^[1-9]\\d{1,5}$', u):                   # a leading 0 is an OCR slip\n        return [(float(u), 'int' + mend)]\n    return []\n\n\ndef _dim_lines(rows, lmin, gapmax, seg_min, tmax=3, solid=0.5, pmin=6):\n    \"\"\"thin straight lines along the rows (a text may break them) -> [{'y0', 'y1', 'a', 'b', 'segs': [(a, b)]}]\"\"\"\n    live, done = [], []\n    for y, s in enumerate(rows):\n        cur = []\n        if '1' in s:\n            grp = []\n            for a, b in closed_runs(s, 1):\n                if b - a + 1 < pmin:\n                    continue\n                if grp and a - grp[-1][-1][1] <= gapmax:\n                    grp[-1].append((a, b))\n                else:\n                    grp.append([(a, b)])\n            for g in grp:\n                ink = sum(b - a + 1 for a, b in g)\n                if ink >= lmin and ink >= len(g) * seg_min and ink >= solid * (g[-1][1] - g[0][0] + 1):\n                    cur.append({'y0': y, 'y1': y, 'segs': g, 'a': g[0][0], 'b': g[-1][1]})\n        nxt = []\n        for c in cur:\n            for l in live:\n                if l['y1'] == y - 1 and min(c['b'], l['b']) - max(c['a'], l['a']) >= 0.9 * max(c['b'] - c['a'], l['b'] - l['a']):\n                    l['y1'] = y                           # the same line, more than 1 px thick\n                    c = l\n                    break\n            nxt.append(c)\n        keep = set(id(l) for l in nxt)\n        done.extend(l for l in live if id(l) not in keep)\n        live = nxt\n    done.extend(live)\n    return [l for l in done if l['y1'] - l['y0'] < tmax]\n\n\ndef _dim_marks(rows, l, k):\n    \"\"\"points where something crosses the line (extension line, tick, arrow) + its ends -> sorted [(x, strong)]\"\"\"\n    H, W = len(rows), len(rows[0])\n    yt, yb = l['y0'], l['y1']\n\n    def reach(x, step, y):\n        n = 0\n        for j in range(k):\n            r = y + step * (j + 1)\n            if r < 0 or r >= H or rows[r].find('1', max(0, x - j - 1), min(W, x + j + 2)) < 0:\n                break\n            n += 1\n        return n\n\n    def strict(x, step, y):\n        n = 0\n        for j in range(1, 3 * k + 1):\n            r = y + step * j\n            if r < 0 or r >= H or not 0 <= x < W or rows[r][x] != '1':\n                break\n            n += 1\n        return n\n    groups = []\n    for a, b in l['segs']:\n        for x in range(a, b + 1):\n            u, d = reach(x, -1, yt), reach(x, 1, yb)\n            if (u >= k and d >= 2) or (d >= k and u >= 2):\n                if groups and x - groups[-1][-1] <= 1:\n                    groups[-1].append(x)\n                else:\n                    groups.append([x])\n    alen = max(14, int(0.012 * max(W, H)))                # longest arrow head\n    found = []                                            # [pos, kind x = line across / a = arrow / t = tick, lo, hi, tip side]\n    for g in groups:\n        if g[-1] - g[0] > 12 * k:                         # a hatch / a wall along the line, not a mark\n            continue\n        us = [strict(x, -1, yt) for x in g]\n        ds = [strict(x, 1, yb) for x in g]\n        vs = [u + d for u, d in zip(us, ds)]\n        m = max(vs)\n        both = sum(1 for u, d in zip(us, ds) if u and d)\n        if m >= k + 2 and any(u >= k or d >= k for u, d in zip(us, ds)) and both < 0.6 * len(g) + 2:\n            best = [x for x, v in zip(g, vs) if v == m]   # extension line straight across\n            found.append([(best[0] + best[-1]) / 2.0 + 0.5, 'x', g[0], g[-1], 0])\n        elif len(g) >= 3 and both >= 0.6 * len(g):        # arrow head: the dimension ends at its tip\n            ink = [x for x, v in zip(g, vs) if v]\n            lo_out = strict(ink[0] - 1, -1, yt) + strict(ink[0] - 1, 1, yb)\n            hi_out = strict(ink[-1] + 1, -1, yt) + strict(ink[-1] + 1, 1, yb)\n            if bool(lo_out) != bool(hi_out):              # the head thins out towards its tip, its back ends at once\n                step = -1 if lo_out else 1\n            else:\n                cen = sum(i * v for i, v in enumerate(vs)) / float(sum(vs))\n                step = 1 if cen < (len(g) - 1) / 2.0 else -1\n            x = ink[0] if step < 0 else ink[-1]\n            for j in range(alen):\n                if not (strict(x + step, -1, yt) or strict(x + step, 1, yb)):\n                    break\n                x += step\n            found.append([x + 0.5 + step, 'a', min(g[0], x), max(g[-1], x), step])\n        else:                                             # tick\n            found.append([(g[0] + g[-1]) / 2.0 + 0.5, 't', g[0], g[-1], 0])\n    marks = []\n    for i, m in enumerate(found):\n        if m[1] == 'a':\n            j = i + m[4]\n            edge = m[2] if m[4] < 0 else m[3]\n            if 0 <= j < len(found) and found[j][1] != 'a' and abs(found[j][0] - edge) <= alen:\n                found[j][2], found[j][3] = min(found[j][2], m[2]), max(found[j][3], m[3])\n                continue                                  # the arrow points at this extension line\n            end = l['a'] if m[4] < 0 else l['b'] + 1\n            if abs(end - edge) <= alen:\n                m[0] = float(end)\n    for m in found:\n        if m[1] == 'a' and any(o is not m and o[1] != 'a' and o[2] <= m[2] and m[3] <= o[3] for o in found):\n            continue\n        marks.append((m[0], True, m[2], m[3], m[1] == 'x'))\n    if not marks or marks[0][0] > l['a'] + 3:\n        marks.insert(0, (float(l['a']), False, l['a'], l['a'], False))\n    if marks[-1][0] < l['b'] - 2:\n        marks.append((l['b'] + 1.0, False, l['b'], l['b'], False))\n    return marks\n\n\ndef _text_cluster(rows, xa, xb, r0, r1, cx):\n    \"\"\"ink between rows r0..r1, columns xa..xb -> the group of letters nearest cx: (x0, y0, x1, y1) or None\"\"\"\n    hb = r1 - r0 + 1\n    iv = []\n    for r in range(r0, r1 + 1):\n        for m in RUN.finditer(rows[r][xa:xb]):\n            iv.append((xa + m.start(), xa + m.end() - 1))\n    if not iv:\n        return None\n    iv.sort()\n    gap = max(2.0, 0.8 * hb)\n    cl = [list(iv[0])]\n    for a, b in iv[1:]:\n        if a - cl[-1][1] - 1 <= gap:\n            cl[-1][1] = max(cl[-1][1], b)\n        else:\n            cl.append([a, b])\n    x0, x1 = min(cl, key=lambda c: abs((c[0] + c[1]) / 2.0 - cx))\n    w = x1 - x0 + 1\n    if w < 0.4 * hb or w > 14 * hb:\n        return None\n    y0 = y1 = None\n    for r in range(r0, r1 + 1):\n        seg = rows[r][x0:x1 + 1]\n        if '1' in seg:\n            if y0 is None:\n                y0 = r\n            y1 = r\n            if w > 3 * hb and max(len(q) for q in RUN.findall(seg)) >= 0.8 * w:\n                return None                               # a line, not lettering\n    if y0 is None or y1 - y0 + 1 < 5:\n        return None\n    return (x0, y0, x1, y1)\n\n\ndef _span_text(rows, l, m0, m1, k, hmax, x_lo=None, x_hi=None):\n    \"\"\"the text of one dimension span: in a break of the line, or just above / below its middle\"\"\"\n    H = len(rows)\n    L = m1 - m0\n    cx = (m0 + m1) / 2.0\n    for i in range(len(l['segs']) - 1):                   # text sitting in the line\n        g0, g1 = l['segs'][i][1] + 1, l['segs'][i + 1][0] - 1\n        if g0 < m0 or g1 > m1 or g1 - g0 < 4:\n            continue\n        r0 = l['y0']\n        while r0 > 0 and l['y0'] - r0 < hmax and '1' in rows[r0 - 1][g0 + 1:g1]:\n            r0 -= 1\n        r1 = l['y1']\n        while r1 + 1 < H and r1 - l['y1'] < hmax and '1' in rows[r1 + 1][g0 + 1:g1]:\n            r1 += 1\n        if l['y0'] - r0 >= hmax or r1 - l['y1'] >= hmax:\n            continue\n        box = _text_cluster(rows, g0 + 1, g1, r0, r1, (g0 + g1) / 2.0)\n        if box is not None and abs((box[0] + box[2]) / 2.0 - cx) <= max(0.3 * L, 4.0):\n            return box\n    inset = int(min(k + 2, L / 5.0))\n    xa, xb = int(m0) + inset + 1, int(m1) - inset\n    if x_lo is not None:                                  # clear of the ticks / arrows at both ends\n        xa, xb = max(xa, x_lo), min(xb, x_hi)\n    if xb - xa < 4:\n        return None\n    ca, cb = max(xa, int(cx - 0.3 * L)), min(xb, int(cx + 0.3 * L) + 1)    # the text sits over the middle of the span\n    best = None\n    for step, ys in ((-1, l['y0'] - 1), (1, l['y1'] + 1)):\n        r = ys\n        skipped = 0\n        while 0 <= r < H and '1' not in rows[r][ca:cb]:\n            skipped += 1\n            r += step\n            if skipped > max(6, hmax // 2):\n                break\n        if skipped < 1 or skipped > max(6, hmax // 2) or not 0 <= r < H:\n            continue\n        ra = r\n        n = 0\n        while 0 <= r < H and '1' in rows[r][ca:cb] and n <= hmax:\n            n += 1\n            r += step\n        if n > hmax or n < 5 or skipped > 1.2 * n + 3:\n            continue\n        box = _text_cluster(rows, xa, xb, min(ra, r - step), max(ra, r - step), cx)\n        if box is None or abs((box[0] + box[2]) / 2.0 - cx) > max(0.3 * L, 4.0):\n            continue\n        if best is None or skipped < best[0]:\n            best = (skipped, box)\n    return best[1] if best else None\n\n\ndef dim_candidates(rows, vertical=False, limit=160):\n    \"\"\"dimension spans along the rows -> [{'o', 'a', 'b' (points, px), 'c' (line), 'box' (text), 'strong'}]\"\"\"\n    H = len(rows)\n    W = len(rows[0]) if rows else 0\n    big = max(W, H)\n    hmax = max(12, int(0.035 * big))\n    out = []\n    for n, l in enumerate(_dim_lines(rows, max(24, int(0.02 * big)), max(30, int(0.09 * big)), max(10, int(0.012 * big)))):\n        marks = _dim_marks(rows, l, 3)\n        if len(marks) > 60:\n            continue\n        for (m0, s0, lo0, hi0, e0), (m1, s1, lo1, hi1, e1) in zip(marks, marks[1:]):\n            if m1 - m0 < 10 or (not (s0 and s1) and m1 - m0 < max(24, 0.02 * big)):\n                continue                                  # too short / the bit of line past the last tick\n            xa, xb = int(hi0) + 3, int(lo1) - 2\n            if xb - xa >= 6 and any(0 <= r < H and rows[r].count('1', xa, xb) > 0.25 * (xb - xa)\n                                    for r in (l['y0'] - 2, l['y1'] + 2)):\n                continue                                  # the face of a wall / a hatch, not a line on its own\n            box = _span_text(rows, l, m0, m1, 3, hmax, hi0 + 3, lo1 - 2)\n            if box is None:\n                continue\n            out.append({'o': 'V' if vertical else 'H', 'a': m0, 'b': m1, 'c': (l['y0'] + l['y1'] + 1) / 2.0,\n                        'box': box, 'strong': bool(s0 and s1), 'chain': ('V' if vertical else 'H', n)})\n    out.sort(key=lambda d: (not d['strong'], -(d['b'] - d['a'])))\n    keep = []\n    for d in out:                                         # a thick line gives the same dimension on 2 rows\n        bx = d['box']\n        if not any(abs(bx[0] - k['box'][0]) <= 3 and abs(bx[2] - k['box'][2]) <= 3 and abs(bx[1] - k['box'][1]) <= 3\n                   and abs(d['a'] - k['a']) <= 3 and abs(d['b'] - k['b']) <= 3 for k in keep):\n            keep.append(d)\n    return keep[:limit]\n\n\ndef read_dims(path, mark_rows, f=1.0, wall_px=None, ocr=None):\n    \"\"\"every dimension found on the picture, read -> list of dims: + 'txt' (as read), 'vals' [(number, kind)], 'sure',\n    'th' (text height, picture px).  f = working px per picture px.  ocr = reader for tests\"\"\"\n    if not mark_rows:\n        return []\n    dims = dim_candidates(mark_rows, False)\n    cols = transpose(mark_rows)\n    for d in dim_candidates(cols, True):\n        x0, y0, x1, y1 = d['box']\n        d['box'] = (y0, x0, y1, x1)                       # back to picture directions\n        dims.append(d)\n    boxes = []\n    for d in dims:\n        x0, y0, x1, y1 = d['box']\n        pad = 2\n        bx = ((x0 - pad) / f, (y0 - pad) / f, (x1 - x0 + 1 + 2 * pad) / f, (y1 - y0 + 1 + 2 * pad) / f)\n        d['th'] = ((x1 - x0 + 1) if d['o'] == 'V' else (y1 - y0 + 1)) / f\n        boxes.append((bx[0], bx[1], bx[2] + 1, bx[3] + 1, 90 if d['o'] == 'V' else 0))\n    texts = (ocr or ocr_tiles)(path, boxes)\n    out = []\n    for i, d in enumerate(dims):\n        tx = [t for t in (texts.get(i) or []) if t]\n        vs = [dim_values(t) for t in tx]\n        vs = [v for v in vs if v]\n        if not vs:\n            if tx:\n                d['txt'] = tx[0]\n            d['vals'], d['sure'] = [], False\n            out.append(d)\n            continue\n        d['txt'] = [t for t in tx if dim_values(t)][0]\n        same = len(vs) >= 2 and all(abs(v[0][0] - vs[0][0][0]) < 1e-6 and v[0][1] == vs[0][0][1] for v in vs)\n        vals = []\n        for v in vs:\n            for q in v:\n                if not any(abs(q[0] - p[0]) < 1e-6 and q[1].rstrip('?') == p[1].rstrip('?') for p in vals):\n                    vals.append(q)\n        d['vals'] = vals\n        d['sure'] = bool(same and d['th'] >= DIM_MIN_TEXT and not vals[0][1].endswith('?'))\n        out.append(d)\n    return out\n\n\nDIM_UNITS = [('mm', {'int': 1.0}), ('m', {'dec': 1000.0, 'int': 1000.0}), ('cm', {'int': 10.0, 'dec': 10.0}),\n             ('feet', {'dec': 304.8, 'int': 304.8}), ('inch', {'int': 25.4, 'dec': 25.4})]\n\n\ndef _dim_mm(q, mult):\n    kind = q[1].rstrip('?')\n    if kind == 'mm':\n        return q[0]\n    return q[0] * mult[kind] if kind in mult else None\n\n\ndef dim_scale(dims, wall_px=None, fixed_s=None):\n    \"\"\"-> {'s' mm per working px, 'unit', 'used': dims with 'mm', 'off': dims that disagree, 'sure'} or None\"\"\"\n    best = None\n    for rank, (unit, mult) in enumerate(DIM_UNITS):\n        items = []\n        for d in dims:\n            L = d['b'] - d['a']\n            for q in d.get('vals') or []:\n                mm = _dim_mm(q, mult)\n                if mm and mm > 0:\n                    items.append((d, mm, mm / L, bool(d.get('sure')) and q is d['vals'][0], q))\n        if not items:\n            continue\n        cands = [fixed_s] if fixed_s else sorted(set(it[2] for it in items if it[3]) or set(it[2] for it in items))\n        top = None\n        for sc in cands:\n            inl = {}\n            for d, mm, si, ok, q in items:\n                L = d['b'] - d['a']\n                if abs(mm - L * sc) <= max(DIM_TOL * mm, 2.0 * sc):\n                    if id(d) not in inl or abs(mm - L * sc) < abs(inl[id(d)][1] - L * sc):\n                        inl[id(d)] = (d, mm, ok, q)\n            key = (sum(1 for v in inl.values() if v[2]), len(inl), sum(v[0]['b'] - v[0]['a'] for v in inl.values()))\n            if top is None or key > top[0]:\n                top = (key, sc, inl)\n        key, sc, inl = top\n        if not inl:\n            continue\n        used = list(inl.values())\n        s = fixed_s or sum(v[1] for v in used) / sum(v[0]['b'] - v[0]['a'] for v in used)\n        ok_wall = wall_px is None or 45.0 <= wall_px * s <= 900.0\n        score = (ok_wall, key[0], key[1], -rank)\n        if best is None or score > best[0]:\n            best = (score, s, unit, mult, used)\n    if best is None:\n        return None\n    score, s, unit, mult, used = best\n    if not score[0] and not fixed_s:\n        return None\n    ids = set(id(v[0]) for v in used)\n    res_used = []\n    for d, mm, ok, q in used:\n        d['mm'] = mm\n        d['ok'] = ok                                      # read clearly: may fix wall positions\n        d['mended'] = q[1].endswith('?')\n        res_used.append(d)\n    off = []\n    for d in dims:\n        if id(d) in ids or not d.get('vals'):\n            continue\n        mm = _dim_mm(d['vals'][0], mult)\n        if mm:\n            d['mm'] = mm\n            off.append(d)\n    n_sure = sum(1 for d in res_used if d.get('ok'))\n    sure = n_sure >= 2 or (n_sure == 1 and wall_px is not None and (len(res_used) >= 2 or res_used[0].get('strong')))\n    return {'s': s, 'unit': unit, 'used': res_used, 'off': off, 'sure': bool(sure or fixed_s)}\n\n\ndef dim_first(dims, sc=None):\n    \"\"\"the dimension the user is asked about (D1): the longest one used; nothing read for sure -> the first span of the\n    dimension line with the most numbers on it (None when no text next to a line reads as a number)\"\"\"\n    if sc and sc.get('sure') and sc.get('used'):\n        return max(sc['used'], key=lambda d: d['b'] - d['a'])\n    ch = {}\n    for d in dims:\n        if d.get('vals') and d.get('strong'):\n            c = ch.setdefault(d['chain'], [0, 0.0])\n            c[0] += 1\n            c[1] = max(c[1], d['b'] - d['a'])\n    if not ch:\n        return None\n    best = max(ch, key=lambda k: tuple(ch[k]))\n    return min((d for d in dims if d['chain'] == best and d.get('strong')), key=lambda d: d['a'])\n\n\ndef dim_text(mm, unit='mm'):\n    if unit in ('feet', 'inch'):\n        tot = int(round(mm / 25.4))\n        return '{0}\\'{1}\"'.format(tot // 12, tot % 12)\n    return '{0:.0f}'.format(mm)\n\n\ndef dim_report(dims, sc, unit=None):\n    \"\"\"lines for the result\"\"\"\n    out = []\n    if sc:\n        cnt = {}\n        for d in sc['used']:\n            if d.get('typed'):\n                k = '{0:g}'.format(d['mm'])\n            elif d.get('mended'):                         # OCR slip mended (12'6\" read as 1216\"): show what was used\n                k = dim_text(d['mm'], 'feet' if '\"' in str(d.get('txt')) else 'mm')\n            else:\n                k = str(d.get('txt') or dim_text(d['mm']))\n            cnt[k] = cnt.get(k, 0) + 1\n        txt = ', '.join(k + (' (x{0})'.format(n) if n > 1 else '') for k, n in sorted(cnt.items(), key=lambda c: -c[1])[:12])\n        plain = any(q[1].rstrip('?') in ('int', 'dec') for d in sc['used'] for q in d.get('vals') or [])\n        out.append('Dimensions read on the plan ({0} used{1}): {2}'.format(\n            len(sc['used']), ', numbers taken as ' + sc['unit'] if plain else '', txt))\n        for d in sc['off'][:5]:\n            out.append('CHECK dimension \"{0}\" = {1:.0f} mm but it measures {2:.0f} mm on the picture - not used'.format(\n                d.get('txt', '?'), d['mm'], (d['b'] - d['a']) * sc['s']))\n        if len(sc['off']) > 5:\n            out.append('CHECK {0} more dimensions do not fit the picture - not used'.format(len(sc['off']) - 5))\n    return out\n\n\ndef _dim_axis(used, o, s):\n    \"\"\"dimension points of one direction -> sorted [(px, mm)] fixed coordinates, messages\"\"\"\n    tol = 1.6\n    pts = []\n    for d in used:\n        if d['o'] == o:\n            pts.extend([d['a'], d['b']])\n    pts.sort()\n    nodes = []\n    for p in pts:\n        if nodes and p - nodes[-1][-1] <= tol:\n            nodes[-1].append(p)\n        else:\n            nodes.append([p])\n    px = [sum(n) / len(n) for n in nodes]\n\n    def node(p):\n        return min(range(len(px)), key=lambda i: abs(px[i] - p))\n    par = list(range(len(px)))\n    pos = [p * s for p in px]\n    members = dict((i, [i]) for i in range(len(px)))\n\n    def find(a):\n        while par[a] != a:\n            a = par[a]\n        return a\n    msgs = []\n    for d in sorted((d for d in used if d['o'] == o), key=lambda d: d['b'] - d['a']):\n        i, j = node(d['a']), node(d['b'])\n        if i == j:\n            continue\n        ri, rj = find(i), find(j)\n        if ri == rj:\n            gap = pos[j] - pos[i] - d['mm']\n            if abs(gap) > max(30.0, 0.003 * d['mm']):\n                msgs.append('CHECK dimension {0:.0f} is {1:.0f} mm {2} than the dimensions inside it add up to'.format(\n                    d['mm'], abs(gap), 'smaller' if gap > 0 else 'bigger'))\n            continue\n        shift = pos[i] + d['mm'] - pos[j]\n        for m in members[rj]:\n            pos[m] += shift\n        members[ri].extend(members[rj])\n        par[rj] = ri\n    for r in set(find(i) for i in range(len(px))):        # each chain stays where it is on the picture\n        ms = members[r]\n        off = sum(pos[m] - px[m] * s for m in ms) / len(ms)\n        for m in ms:\n            pos[m] -= off\n    anchors = []\n    for p, q in sorted(zip(px, pos)):\n        if anchors and q <= anchors[-1][1]:\n            continue\n        anchors.append((p, q))\n    return anchors, msgs\n\n\ndef _dim_map(anchors, s):\n    \"\"\"px -> mm along one direction: exact on the dimension points, the plan scale elsewhere\"\"\"\n    xs = [a[0] for a in anchors]\n\n    def fn(p):\n        if not anchors:\n            return p * s\n        if p <= xs[0]:\n            return anchors[0][1] + (p - xs[0]) * s\n        if p >= xs[-1]:\n            return anchors[-1][1] + (p - xs[-1]) * s\n        i = bisect.bisect_right(xs, p)\n        (p0, q0), (p1, q1) = anchors[i - 1], anchors[i]\n        return q0 + (q1 - q0) * (p - p0) / (p1 - p0)\n    return fn\n\n\ndef dim_fit(res, sc):\n    \"\"\"walls set on the dimension points: res['mx'], res['my'] (px -> mm), each wall 'pm', 'qm' (mm; y down) -> messages\"\"\"\n    s = res['s']\n    used = [d for d in (sc['used'] if sc else []) if d.get('ok') or d.get('typed')]\n    ax, msgs = _dim_axis(used, 'H', s)\n    ay, m2 = _dim_axis(used, 'V', s)\n    msgs += m2\n    mx, my = _dim_map(ax, s), _dim_map(ay, s)\n    res['mx'], res['my'] = mx, my\n    res['ax'], res['ay'] = ax, ay\n    snapped = [0]\n\n    def line_mm(c, t_px, t_mm, anchors, fn):\n        \"\"\"centre line coordinate of a wall: a face or the centre on a dimension point -> exactly there\"\"\"\n        best = None\n        for p, q in anchors:\n            for dp, dq in ((0.0, 0.0), (-t_px / 2.0, -t_mm / 2.0), (t_px / 2.0, t_mm / 2.0)):\n                e = abs(c + dp - p)\n                if e <= max(2.0, 0.2 * t_px) and (best is None or e < best[0]):\n                    best = (e, q - dq)\n        if best is None:\n            return fn(c)\n        snapped[0] += 1\n        return best[1]\n    vs, hs = [], []\n    for w in res['walls']:\n        (x0, y0), (x1, y1) = w['p'], w['q']\n        w['ax'] = 'V' if abs(x1 - x0) < 1e-6 else ('H' if abs(y1 - y0) < 1e-6 else None)\n        if w['ax'] == 'V':\n            w['cm'] = line_mm(x0, w['t'], w['mm'], ax, mx)\n            vs.append(w)\n        elif w['ax'] == 'H':\n            w['cm'] = line_mm(y0, w['t'], w['mm'], ay, my)\n            hs.append(w)\n\n    def end_mm(v, lo, hi, others, k, fn):\n        \"\"\"end of a wall: on the centre line of the wall it meets, else by the map\"\"\"\n        best = None\n        for o in others:\n            c = o['p'][k]\n            a, b = sorted((o['p'][1 - k], o['q'][1 - k]))\n            if abs(c - v) <= 1.0 and a - o['t'] <= lo and hi <= b + o['t'] and (best is None or abs(c - v) < best[0]):\n                best = (abs(c - v), o['cm'])\n        return best[1] if best else fn(v)\n    for w in res['walls']:\n        (x0, y0), (x1, y1) = w['p'], w['q']\n        if w['ax'] == 'V':\n            w['pm'] = (w['cm'], end_mm(y0, x0, x0, hs, 1, my))\n            w['qm'] = (w['cm'], end_mm(y1, x0, x0, hs, 1, my))\n        elif w['ax'] == 'H':\n            w['pm'] = (end_mm(x0, y0, y0, vs, 0, mx), w['cm'])\n            w['qm'] = (end_mm(x1, y0, y0, vs, 0, mx), w['cm'])\n        else:\n            w['pm'], w['qm'] = (mx(x0), my(y0)), (mx(x1), my(y1))\n    if ax or ay:\n        msgs.insert(0, 'Walls set on the dimension points: {0} wall lines sit exactly on a written dimension '\n                       '({1} points across, {2} up-down)'.format(snapped[0], len(ax), len(ay)))\n    return msgs\n\n\n# ------------------------------------------------------------------ grid lines with bubbles drawn on the plan (pure Python)\ndef _ink_near(rows, x, y):\n    H, W = len(rows), len(rows[0])\n    for yy in (y - 1, y, y + 1):\n        if 0 <= yy < H and rows[yy].find('1', max(0, x - 1), min(W, x + 2)) >= 0:\n            return True\n    return False\n\n\ndef _ring(rows, cx, yc, r):\n    \"\"\"a circle of radius r drawn around (cx, yc), on its own (clear just inside and outside) -> hits of 24, 0 = no\"\"\"\n    H, W = len(rows), len(rows[0])\n    hits = inner = outer = core = 0\n    for i in range(24):\n        ca, sa = math.cos(math.pi * i / 12.0), math.sin(math.pi * i / 12.0)\n        if _ink_near(rows, int(round(cx + r * ca)), int(round(yc + r * sa))):\n            hits += 1\n        for rr, which in ((r - 3.0, 0), (r + 3.5, 1)):\n            px_, py_ = int(round(cx + rr * ca)), int(round(yc + rr * sa))\n            if 0 <= py_ < H and 0 <= px_ < W and rows[py_][px_] == '1':\n                if which:\n                    outer += 1\n                else:\n                    inner += 1\n        if _ink_near(rows, int(round(cx + 0.45 * r * ca)), int(round(yc + 0.45 * r * sa))):\n            core += 1\n    # a ring on its own: clear just outside; inside only a label (a filled blob or a busy corner of the plan is no bubble)\n    return hits if (hits >= 20 and outer <= 6 and (inner <= 8 or r < 10) and core <= 17) else 0\n\n\ndef _bubble(rows, yc, e, step, rmin, rmax):\n    \"\"\"circle standing on the end e of a line along row yc (step = which way is out) -> (centre x, radius) or None\"\"\"\n    H, W = len(rows), len(rows[0])\n    best = None\n    tried = set()\n    x = e + step * int(2 * rmin)\n    lim = e + step * int(2 * rmax + 3)\n    while 0 <= x < W and (x - lim) * step <= 0:\n        if any(0 <= yy < H and rows[yy][x] == '1' for yy in (yc - 1, yc, yc + 1)):      # far side of the ring?\n            for e0 in (e, e + step, e + 2 * step, e - step):\n                r = abs(x - e0) / 2.0\n                key = int(r * 2)\n                if r < rmin or r > rmax or key in tried:\n                    continue\n                tried.add(key)\n                cx = (x + e0) / 2.0\n                hits = _ring(rows, cx, yc, r)\n                if hits and (best is None or hits > best[0] or (hits == best[0] and r > best[2])):\n                    best = (hits, cx, r)\n        x += step\n    return (best[1], best[2]) if best else None\n\n\ndef grid_candidates(rows, vertical=False):\n    \"\"\"long thin lines (dash-dot or solid) with a bubble on an end -> [{'o', 'c', 'a', 'b', 'bub': [(centre, r)]}]\n    rows = the picture's rows for lines running left-right; pass the transposed picture for up-down lines\"\"\"\n    H = len(rows)\n    W = len(rows[0]) if rows else 0\n    big = max(W, H)\n    rmin, rmax = max(5.0, 0.005 * big), max(12.0, 0.045 * big)\n    out = []\n    for l in _dim_lines(rows, int(0.35 * W), max(8, int(0.02 * big)), 3, 3, 0.35, 3):\n        yc = (l['y0'] + l['y1']) // 2\n        bubs = []\n        ends = [(sg[0], -1) for sg in l['segs'][:4]] + [(sg[1], 1) for sg in l['segs'][-4:][::-1]]\n        for step in (-1, 1):                              # the label inside a bubble can look like a bit of the line\n            for e in [e_ for e_, s_ in ends if s_ == step]:\n                b = _bubble(rows, yc, e, step, rmin, rmax)\n                if b is not None:\n                    bubs.append(b)\n                    break\n        if bubs:\n            out.append({'o': 'V' if vertical else 'H', 'c': (l['y0'] + l['y1'] + 1) / 2.0, 'a': float(l['a']),\n                        'b': l['b'] + 1.0, 'bub': bubs})\n    # the bubbles of one direction stand in a row: keep that row, look along it for bubbles whose line was missed\n    rails = {}\n    for g in out:\n        for cx, r in g['bub']:\n            k = [k for k in rails if abs(k[0] - cx) <= 3 and abs(k[1] - r) <= 2]\n            rails.setdefault(k[0] if k else (cx, r), []).append(g)\n    rails = dict((k, v) for k, v in rails.items() if len(v) >= 3)        # 3 bubbles in a row: a real grid\n    if not rails:\n        return []\n    out = [g for g in out if any(any(g is x for x in v) for v in rails.values())]\n    for g in out:\n        g['bub'] = [b_ for b_ in g['bub'] if any(abs(k[0] - b_[0]) <= 3 and abs(k[1] - b_[1]) <= 2 for k in rails)]\n    a_med = sorted(g['a'] for g in out)[len(out) // 2]\n    b_med = sorted(g['b'] for g in out)[len(out) // 2]\n    for (cx, r), v in sorted(rails.items(), key=lambda kv: -len(kv[1]))[:1]:\n        run = []\n        for y in range(H):\n            ok = _ring(rows, cx, y, r) or _ring(rows, cx + 1, y, r)\n            if ok:\n                run.append(y)\n            if (not ok or y == H - 1) and run:\n                yc = (run[0] + run[-1]) / 2.0 + 0.5\n                if not any(abs(g['c'] - yc) <= 3.0 for g in out):\n                    out.append({'o': 'V' if vertical else 'H', 'c': yc, 'a': a_med, 'b': b_med, 'bub': [(cx, r)], 'rail': True})\n                run = []\n    out.sort(key=lambda g: g['c'])\n    keep = []\n    for g in out:                                         # a line 2 px thick shows twice\n        if keep and g['c'] - keep[-1]['c'] <= 3.0:\n            if g['b'] - g['a'] > keep[-1]['b'] - keep[-1]['a']:\n                keep[-1] = g\n            continue\n        keep.append(g)\n    rad = max(r for g in keep for c_, r in g['bub'])\n    if any(b['c'] - a['c'] < 4.0 * rad for a, b in zip(keep, keep[1:])):\n        return []                                         # bubbles would sit on top of each other: not a grid\n    return keep\n\n\n_LETTERS = [c for c in 'ABCDEFGHJKLMNPQRSTUVWXYZ']         # I and O are not used for grids\n\n\ndef _grid_seq(kind, n, start=0):\n    if kind == 'num':\n        return [str(start + i + 1) for i in range(n)]\n    out = []\n    for i in range(start, start + n):\n        out.append(_LETTERS[i] if i < len(_LETTERS) else _LETTERS[i // len(_LETTERS) - 1] + _LETTERS[i % len(_LETTERS)])\n    return out\n\n\ndef _grid_label(t):\n    t = re.sub(r'[^A-Za-z0-9]', '', t or '').upper()\n    if re.match(r'^\\d{1,3}$', t) or re.match(r'^[A-Z]{1,2}$', t):\n        return t\n    return ''\n\n\ndef name_grids(lines, default_kind):\n    \"\"\"lines of one direction in order, each with 'read' (OCR of its bubble, may be '') -> 'name', 'guessed' set;\n    names follow one run (1, 2, 3 ... or A, B, C ...) fitted to the labels that could be read -> kind used\"\"\"\n    reads = [_grid_label(g.get('read')) for g in lines]\n    nums = sum(1 for r in reads if r.isdigit())\n    lets = sum(1 for r in reads if r and not r.isdigit())\n    kind = 'num' if nums > lets else ('let' if lets > nums else default_kind)\n    n = len(lines)\n    best = (0, 0, False)\n    for rev in (False, True):\n        for start in range(0, 40):\n            seq = _grid_seq(kind, n, start)\n            if rev:\n                seq = seq[::-1]\n            hit = sum(1 for r, s in zip(reads, seq) if r == s)\n            if hit > best[0]:\n                best = (hit, start, rev)\n    seq = _grid_seq(kind, n, best[1])\n    if best[2]:\n        seq = seq[::-1]\n    for g, r, s in zip(lines, reads, seq):\n        g['name'] = s\n        g['guessed'] = r != s\n    return kind\n\n\ndef find_grids(path, mark_rows, f=1.0, ocr=None):\n    \"\"\"grid lines of the picture with names -> {'v': up-down lines left to right, 'h': left-right lines top to bottom}\"\"\"\n    res = {'v': [], 'h': []}\n    if not mark_rows:\n        return res\n    try:\n        h = grid_candidates(mark_rows, False)\n        v = grid_candidates(transpose(mark_rows), True)\n    except Exception as ex:\n        log('grids: ' + str(ex))\n        return res\n    if len(h) + len(v) < 2:\n        return res\n    boxes = []\n    for g in v + h:\n        cx, r = g['bub'][0]\n        k = 0.58 * r\n        if g['o'] == 'V':                                 # line runs up-down: 'c' is x, the bubble centre is a y\n            boxes.append(((g['c'] - k) / f, (cx - k) / f, 2 * k / f + 1, 2 * k / f + 1, 0))\n        else:\n            boxes.append(((cx - k) / f, (g['c'] - k) / f, 2 * k / f + 1, 2 * k / f + 1, 0))\n    texts = (ocr or ocr_tiles)(path, boxes, '48,72', 'Grid') if boxes else {}\n    for i, g in enumerate(v + h):\n        tx = [_grid_label(re.sub('(?i)^grid', '', t.strip())) for t in (texts.get(i) or [])]\n        tx = sorted(set(t for t in tx if t))\n        g['read'] = tx[0] if len(tx) == 1 else ''              # the run of names (1, 2, 3 ...) then has to agree with it\n    kv = name_grids(v, 'num') if v else None\n    kh = name_grids(h, 'let' if kv != 'let' else 'num') if h else None\n    if v and h and kv == kh:                              # both directions must not share names\n        name_grids(h, 'let' if kv == 'num' else 'num')\n        for g in h:\n            g['guessed'] = True\n    res['v'], res['h'] = v, h\n    return res\n\n\ndef _mask_updown(rows, lines, lw):\n    H, W = len(rows), len(rows[0])\n    rows = list(rows)\n    for g in lines:\n        x = int(g['c'])\n        if not 0 <= x < W:\n            continue\n        for y in range(max(0, int(g['a'])), min(H, int(g['b']))):\n            s = rows[y]\n            if '1' not in s[max(0, x - 1):x + 2]:\n                continue\n            k = x if s[x] == '1' else (x - 1 if x > 0 and s[x - 1] == '1' else x + 1)\n            a = b = k\n            while a > 0 and s[a - 1] == '1':\n                a -= 1\n            while b + 1 < W and s[b + 1] == '1':\n                b += 1\n            if b - a + 1 <= lw:                           # thin here: the grid line alone, not a wall on it\n                rows[y] = s[:a] + '0' * (b - a + 1) + s[b + 1:]\n        for cy, r in g['bub']:\n            x0, x1 = max(0, int(g['c'] - r - 2)), min(W, int(g['c'] + r + 3))\n            for yy in range(max(0, int(cy - r - 2)), min(H, int(cy + r + 3))):\n                rows[yy] = rows[yy][:x0] + '0' * (x1 - x0) + rows[yy][x1:]\n    return rows\n\n\ndef mask_grids(rows, gr, lw=3):\n    \"\"\"grid lines and bubbles rubbed out, so they are not read as walls / furniture (a wall on a grid line stays)\"\"\"\n    if not rows or not gr or not (gr['v'] or gr['h']):\n        return rows\n    if gr['v']:\n        rows = _mask_updown(rows, gr['v'], lw)\n    if gr['h']:\n        rows = transpose(_mask_updown(transpose(rows), gr['h'], lw))\n    return rows\n\n\ndef grid_report(gr):\n    out = []\n    n = len(gr['v']) + len(gr['h'])\n    if not n:\n        return out\n    for key, word in (('v', 'up-down'), ('h', 'left-right')):\n        ls = gr[key]\n        if ls:\n            rd = [g['name'] for g in ls if not g['guessed']]\n            out.append('Grid lines {0}: {1} ({2} .. {3}); names read from the bubbles: {4}; the others follow in order'.format(\n                word, len(ls), ls[0]['name'], ls[-1]['name'], ', '.join(rd) if rd else 'none (text too small) - named in order'))\n    return out\n\n\ndef find_dims(path, rows, f=1.0):\n    \"\"\"dimensions of the picture -> {'dims', 'sc' (scale from them or None), 'd1' (the one the user is asked about),\n    'wall_px'}.  Needs load_ink(path) run just before (LAST_MARK)\"\"\"\n    try:\n        wall_px = ref_wall_px(rows)\n    except Exception:\n        wall_px = None\n    try:\n        dl = read_dims(path, LAST_MARK, f, wall_px)\n        sc = dim_scale(dl, wall_px)\n    except Exception as ex:\n        log('dims: ' + str(ex))\n        dl, sc = [], None\n    return {'dims': dl, 'sc': sc, 'd1': dim_first(dl, sc), 'wall_px': wall_px}\n\n\ndef dim_typed(dm, value):\n    \"\"\"the user says dimension D1 = value mm -> scale (equal spans on the same line counted in), message\"\"\"\n    d1 = dm['d1']\n    L1 = d1['b'] - d1['a']\n    same = [d for d in dm['dims'] if d is d1 or (abs(d['b'] - d['a'] - L1) <= 1.0 and d.get('strong') and not d.get('sure'))]\n    s = value * len(same) / sum(d['b'] - d['a'] for d in same)\n    sc = dim_scale(dm['dims'], None, s) or {'s': s, 'unit': 'mm', 'used': [], 'off': [], 'sure': True}\n    for d in same:                                        # spans as long as D1 whose text is too small: the same number\n        d['typed'], d['mm'] = True, float(value)\n    sc['used'] = [d for d in sc['used'] if d.get('ok') and not d.get('typed')] + same\n    sc['off'] = [d for d in sc['off'] if d is not d1 and d.get('sure')]\n    dm['sc'] = sc\n    return s, 'SCALE 1 px = {3:.2f} mm - from dimension D1 = {0:g} mm as you typed ({1:.0f} px on the picture{2})'.format(\n        value, L1, '; {0} dimension spans of the same length are taken as {1:g} too'.format(len(same) - 1, value) if len(same) > 1 else '', s)\n\n\n# ------------------------------------------------------------------ the scale is decided and checked before anything is placed\nclass NotPlaced(Exception):\n    \"\"\"the picture cannot be placed at a scale that can be trusted; .lines = what was read and why\"\"\"\n    def __init__(self, lines):\n        Exception.__init__(self, lines[0] if lines else 'not placed')\n        self.lines = list(lines)\n\n\ndef plan_facts(res):\n    \"\"\"-> dict of what the building would be at this scale: walls, total m, size m, thickest wall mm, doors\"\"\"\n    s = res['s']\n    ws = res['walls']\n    xs = [p[0] for w in ws for p in (w['p'], w['q'])]\n    ys = [p[1] for w in ws for p in (w['p'], w['q'])]\n    doors = sorted(o['w'] * s for w in ws for o in w['ops'] if o['kind'] == 'door')\n    strong = res.get('strong') or []\n    return {'n': len(ws), 'tot': sum(w['L'] for w in ws) * s / 1000.0,\n            'bw': (max(xs) - min(xs)) * s / 1000.0 if xs else 0.0, 'bh': (max(ys) - min(ys)) * s / 1000.0 if ys else 0.0,\n            'top': max(c[0] for c in strong) * s if strong else 0.0, 'top_px': max(c[0] for c in strong) if strong else 0.0,\n            'doors': doors, 'door': doors[len(doors) // 2] if doors else None}\n\n\ndef plan_check(res):\n    \"\"\"is this a believable building? -> (reason it is not, or '', one line of facts)\"\"\"\n    k = plan_facts(res)\n    facts = '{0} walls, the thickest {1:.0f} mm; {2}; building {3:.1f} x {4:.1f} m'.format(\n        k['n'], k['top'], 'doors about {0:.0f} mm wide'.format(k['door']) if k['door'] else 'no door openings found', k['bw'], k['bh'])\n    if k['n'] < 3 or k['tot'] < 6.0:\n        return 'only {0} wall(s), {1:.1f} m in all, could be read - this does not look like a floor plan the tool can use'.format(\n            k['n'], k['tot']), facts\n    big = max(k['bw'], k['bh'])\n    if big < 2.5 or big > 500.0:\n        return 'the building would be {0:.1f} x {1:.1f} m'.format(k['bw'], k['bh']), facts\n    hi = 450.0 if k['top_px'] >= 5.0 else 650.0           # a wall only 3-4 px thick cannot be measured well\n    if not 55.0 <= k['top'] <= hi:\n        return 'the walls would be {0:.0f} mm thick'.format(k['top']), facts\n    if len(k['doors']) >= 3 and not 550.0 <= k['door'] <= 1600.0:\n        return 'the doors would be about {0:.0f} mm wide'.format(k['door']), facts\n    return '', facts\n\n\ndef _door_score(res):\n    \"\"\"how far the usual door opening is from a normal door (850 mm); openings over 1.6 m are not doors -> mm, less is better\"\"\"\n    d = [w for w in plan_facts(res)['doors'] if w < 1600.0]\n    return abs(d[len(d) // 2] - 850.0) if d else 400.0\n\n\ndef decide(cands, dm, scale_text, line_px=None, paper=None, orows=None):\n    \"\"\"scale first, then the walls, then the checks -> (res, ink level, rows); res['how'] = lines saying what was decided.\n    Raises NotPlaced when no scale can be trusted (nothing may be put into Revit then).\n    Order: what the user typed for D1 / an exact scale the user gave  >  dimensions read on the picture  >\n    no dimension: standard wall thickness 200 or 150 mm.  A scale the user typed is kept even when a check fails.\"\"\"\n    txt = str(scale_text or '').strip()\n    up = txt.upper()\n    only = 'ONLY' in up\n    auto = not up or up.startswith('AUTO')\n    mode, value = parse_scale(txt)\n    sc, d1, dims = dm.get('sc'), dm.get('d1'), dm.get('dims') or []\n    how = []\n    dim_s = None\n    source = 'input'\n    n_sure = sum(1 for d in dims if d.get('sure'))\n    exact_input = mode == 'MMPX' or (mode == 'LINE' and line_px) or (mode == 'SCALE' and paper)\n    if mode == 'DIM':\n        if d1 is None:\n            raise NotPlaced(['DIM {0:g} was given but no dimension line was found on this picture - give the scale another way '\n                             '(WALL 200, WIDTH 12000, 1:100 for a PDF, or LINE)'.format(value)])\n        dim_s, m_ = dim_typed(dm, value)\n        sc = dm['sc']\n        how.append(m_)\n        source = 'typed'\n    elif only or exact_input:\n        if sc and sc['sure']:\n            how.append('(the dimensions on the picture would give 1 px = {0:.2f} mm - your own scale was used)'.format(sc['s']))\n    elif sc and sc['sure']:\n        dim_s, source = sc['s'], 'dims'\n        how.append('SCALE 1 px = {0:.2f} mm - from the dimensions written on the plan'.format(dim_s))\n        how.extend(dim_report(dims, sc))\n    elif sc and len(sc['used']) >= 3:\n        dim_s, source = sc['s'], 'approx'\n        th = min(d['th'] for d in sc['used'])\n        how.append('SCALE 1 px = {0:.1f} mm - from {1} dimensions on the plan read with difficulty (text only {2:.0f} px high)'.format(\n            dim_s, len(sc['used']), th))\n        how.append('CHECK the scale can be off by about 1 % because single digits may be misread. For the exact size type what '\n                   'the dimension marked D1 says as the scale: DIM 3500 (or DIM 11\\'6\")')\n    elif auto and n_sure >= 2:\n        raise NotPlaced(['The dimensions read on the picture do not agree with each other, so no scale can be trusted: ' +\n                         ', '.join('\"{0}\" over {1:.0f} px'.format(d.get('txt'), d['b'] - d['a']) for d in dims if d.get('sure'))[:400],\n                         'Give the scale yourself: DIM <what the dimension marked D1 says>, WALL 200, WIDTH 12000 or LINE'])\n    elif auto and d1 is not None:\n        raise NotPlaced(['Dimension lines were found on the picture but their text could not be read'\n                         '{0}'.format(' (text only {0:.0f} px high)'.format(d1['th']) if d1.get('th') else ''),\n                         'Type what the dimension marked D1 (thick green line on the marked picture) says as the scale: '\n                         'DIM 3500 (or DIM 11\\'6\") - or use a sharper picture / the PDF'])\n    try:\n        if dim_s or not auto:\n            res, thr, rows = plan_walls_best(cands, mode, value, line_px, paper, orows, dim_s)\n            if not dim_s:\n                how.extend(res['msgs'])\n        else:                                             # no dimension on the picture: standard wall thickness\n            source = 'wall'\n            tries = []\n            for t in (200.0, 150.0):\n                r3 = plan_walls_best(cands, 'WALL', t, None, None, orows, None)\n                bad, facts = plan_check(r3[0])\n                tries.append((not bad, _door_score(r3[0]), t, r3, facts, bad))\n            tries.sort(key=lambda q: (q[0], -q[1], q[2]), reverse=True)\n            ok, score, t, (res, thr, rows), facts, bad = tries[0]\n            o = tries[1]\n            how.append('SCALE 1 px = {0:.1f} mm - no dimension on the picture, so the thickest walls ({1:.1f} px) are taken as '\n                       'standard {2:.0f} mm walls'.format(res['s'], t / res['s'], t))\n            how.append('({0:.0f} mm fits better than {1:.0f} mm: {2})'.format(\n                t, o[2], 'with {0:.0f} mm {1}'.format(o[2], o[5]) if o[5] else\n                'the door openings then come within {0:.0f} mm of a normal 850 mm door, against {1:.0f} mm'.format(score, o[1])\n                if score != o[1] else 'no door openings to judge by, the thicker standard wall is used'))\n    except NotPlaced:\n        raise\n    except Exception as ex:\n        raise NotPlaced(['No walls could be read in this picture ({0}) - it does not look like a floor plan the tool can use'.format(\n            (str(ex).splitlines() or ['?'])[0][:160])] + how)\n    res['msgs'] = [m for m in res['msgs'] if m.startswith('Walls read from')]\n    bad, facts = plan_check(res)\n    if bad and source != 'input' and source != 'typed':\n        raise NotPlaced(['With this scale {0} - that cannot be right, so nothing is placed'.format(bad)] + how +\n                        ['Give the scale yourself: DIM <what the dimension marked D1 says>, WALL 200, WIDTH 12000 or LINE'])\n    how.append(('CHECK with your scale {0} - placed because you gave the scale; '.format(bad) if bad else 'Checks passed: ') + facts)\n    how.extend(res['msgs'])\n    res['how'] = how\n    res['source'] = source\n    res['dim_s'] = dim_s\n    return res, thr, rows\n\n\ndef picture_check(rows):\n    \"\"\"a photo, a rendering or a dark / empty picture is not a line drawing -> the reason, or ''\"\"\"\n    n = float(len(rows) * len(rows[0])) if rows else 0.0\n    if not n:\n        return 'The picture is empty'\n    share = sum(r.count('1') for r in rows) / n\n    if share > 0.30:\n        return ('{0:.0f} % of the picture is dark - it looks like a photo, a rendering or a drawing on a dark background, '\n                'not a floor plan drawn with lines on light paper'.format(100 * share))\n    if share < 0.002:\n        return 'Almost nothing is drawn on the picture (no dark lines found)'\n    return ''\n\n\ndef grid_fit(gr, res):\n    \"\"\"grid lines -> ends in mm (x right, y down from the picture's top left): each line gets 'p0', 'p1'.\n    A grid standing on a dimension point sits exactly on it\"\"\"\n    mx, my = res['mx'], res['my']\n\n    def snap(c, anchors, fn):\n        best = None\n        for p, q in anchors:\n            if abs(p - c) <= 2.0 and (best is None or abs(p - c) < best[0]):\n                best = (abs(p - c), q)\n        return best[1] if best else fn(c)\n    n = 0\n    for g in gr['v'] + gr['h']:\n        a, b = g['a'], g['b']\n        for c_, r in g['bub']:                            # the Revit grid runs to the far side of the drawn bubbles\n            a, b = min(a, c_ - r), max(b, c_ + r)\n        if g['o'] == 'V':\n            x = snap(g['c'], res.get('ax') or [], mx)\n            g['p0'], g['p1'] = (x, my(a)), (x, my(b))\n        else:\n            y = snap(g['c'], res.get('ay') or [], my)\n            g['p0'], g['p1'] = (mx(a), y), (mx(b), y)\n        n += 1\n    for key, k in (('v', 0), ('h', 1)):                   # grids closer than 0.6 m are no grids: leave that direction out\n        ls = gr[key]\n        if any(abs(b['p0'][k] - a['p0'][k]) < 600.0 for a, b in zip(ls, ls[1:])):\n            n -= len(ls)\n            gr[key] = []\n    return n\n\n\nGRID_FILE = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'PLAN2BIM_grids.txt')\n\n\ndef _grid_store(key, uids=None):\n    \"\"\"the grids this tool made, per project + picture (so a second run replaces them and makes no doubles)\"\"\"\n    lines = []\n    try:\n        with open(GRID_FILE) as f:\n            lines = [l.rstrip('\\n') for l in f if l.strip()]\n    except Exception:\n        pass\n    old, rest = [], []\n    for l in lines:\n        if l.startswith(key + '|'):\n            old = [u for u in l[len(key) + 1:].split(';') if u]\n        else:\n            rest.append(l)\n    if uids is not None:\n        try:\n            with open(GRID_FILE, 'w') as f:\n                f.write('\\n'.join(rest + [key + '|' + ';'.join(uids)]) + '\\n')\n        except Exception as ex:\n            log('grid list: ' + str(ex))\n    return old\n\n\ndef grid_name(g):\n    try:\n        p = g.get_Parameter(BuiltInParameter.DATUM_TEXT)\n        return str(p.AsString() or '') if p is not None else ''\n    except Exception:\n        return ''\n\n\ndef make_grids(doc, gr, MM, tag):\n    \"\"\"Revit grids from the picture's grid lines -> (names made, names kept because the project has them, failures).\n    Grids made by an earlier run for the same picture are replaced; a grid of the same name made by somebody else stays\"\"\"\n    key = str(doc.Title) + '|' + tag\n    made, kept, fail = [], [], []\n    for uid in _grid_store(key):\n        try:\n            e = doc.GetElement(uid)\n            if e is not None:\n                doc.Delete(e.Id)\n        except Exception:\n            pass\n    names = set(grid_name(g) for g in FilteredElementCollector(doc).OfClass(Grid))\n    uids = []\n    for g in gr['v'] + gr['h']:\n        if g['name'] in names:\n            kept.append(g['name'])\n            continue\n        try:\n            e = Grid.Create(doc, Line.CreateBound(MM(g['p0']), MM(g['p1'])))\n            try:\n                e.get_Parameter(BuiltInParameter.DATUM_TEXT).Set(g['name'])\n            except Exception:\n                e.Name = g['name']\n            uids.append(str(e.UniqueId))\n            made.append(g['name'])\n            names.add(g['name'])\n        except Exception as ex:\n            fail.append('grid {0}: {1}'.format(g['name'], (str(ex).splitlines() or ['?'])[0][:90]))\n    _grid_store(key, uids)\n    return made, kept, fail\n\n\n# ------------------------------------------------------------------ door swings, columns, room names, stair lines (pure Python)\ndef _leaf_run(orows, x0, y0, dx, dy, n):\n    \"\"\"longest unbroken run of ink along a ray (1 px breaks and 1 px sideways slack allowed) -> px\"\"\"\n    H, W = len(orows), len(orows[0])\n    best = run = miss = 0\n    for i in range(int(n)):\n        x, y = int(round(x0 + dx * i)), int(round(y0 + dy * i))\n        hit = False\n        for ax, ay in ((0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)):\n            xx, yy = x + ax, y + ay\n            if 0 <= xx < W and 0 <= yy < H and orows[yy][xx] == '1':\n                hit = True\n                break\n        if hit:\n            run += 1 + miss if run else 1\n            miss = 0\n            best = max(best, run)\n        else:\n            miss += 1\n            if miss > 1:\n                run = miss = 0\n    return best\n\n\ndef read_swings(walls, orows):\n    \"\"\"every door: where its leaf is drawn in the picture -> op['hinge'] (px point: the jamb the leaf hangs on),\n    op['side'] (px point on the side it opens to), op['swing'] = 'read' / 'guess' (only more ink on one side) / ''\n    -> (read, guessed, doors)\"\"\"\n    if not orows:\n        return 0, 0, 0\n    H, W = len(orows), len(orows[0])\n    n_read = n_guess = n_all = 0\n    for w in walls:\n        d = w['d']\n        n = (-d[1], d[0])\n        for o in w['ops']:\n            if o['kind'] != 'door':\n                continue\n            n_all += 1\n            g = o['w']\n            c = o['c']\n            ends = [(c[0] - d[0] * g / 2.0, c[1] - d[1] * g / 2.0), (c[0] + d[0] * g / 2.0, c[1] + d[1] * g / 2.0)]\n            best = None\n            for ei, e in enumerate(ends):\n                inward = (d[0], d[1]) if ei == 0 else (-d[0], -d[1])        # from this jamb towards the other one\n                for side in (1.0, -1.0):\n                    for ang in (90.0, 75.0, 60.0, 45.0, 30.0):\n                        ca, sa = math.cos(math.radians(ang)), math.sin(math.radians(ang))\n                        dx = inward[0] * ca + n[0] * side * sa\n                        dy = inward[1] * ca + n[1] * side * sa\n                        for du in (-2.0, -1.0, 0.0, 1.0, 2.0):\n                            st = w['t'] / 2.0 + 1.0\n                            x0 = e[0] - inward[0] * du + n[0] * side * st\n                            y0 = e[1] - inward[1] * du + n[1] * side * st\n                            r = _leaf_run(orows, x0, y0, dx, dy, 1.25 * g)\n                            if best is None or r > best[0]:\n                                best = (r, ei, side)\n            o['swing'] = ''\n            if best is not None and best[0] >= 0.6 * g:\n                o['swing'] = 'read'\n                ei, side = best[1], best[2]\n                n_read += 1\n            else:                                         # no clear leaf line: the side with the arc has more ink\n                ink = {}\n                for side in (1.0, -1.0):\n                    for ei in (0, 1):\n                        k = 0\n                        for iu in range(int(g / 2.0)):\n                            u = (iu if ei == 0 else g - 1 - iu)\n                            for iv in range(int(g)):\n                                x = int(ends[0][0] + d[0] * u + n[0] * side * (w['t'] / 2.0 + 1.0 + iv))\n                                y = int(ends[0][1] + d[1] * u + n[1] * side * (w['t'] / 2.0 + 1.0 + iv))\n                                if 0 <= x < W and 0 <= y < H and orows[y][x] == '1':\n                                    k += 1\n                        ink[(side, ei)] = k\n                tot = {1.0: ink[(1.0, 0)] + ink[(1.0, 1)], -1.0: ink[(-1.0, 0)] + ink[(-1.0, 1)]}\n                side = 1.0 if tot[1.0] >= tot[-1.0] else -1.0\n                if tot[side] < 0.5 * g or tot[side] < 2.0 * tot[-side] + 2:\n                    continue                              # nothing to go by: Revit's own placing stays\n                ei = 0 if ink[(side, 0)] >= ink[(side, 1)] else 1\n                o['swing'] = 'guess'\n                n_guess += 1\n            o['hinge'] = ends[ei]\n            o['side'] = (c[0] + n[0] * side * g, c[1] + n[1] * side * g)\n    return n_read, n_guess, n_all\n\n\ndef swing_flips(act_hinge, act_side, want_hinge, want_side):\n    \"\"\"signs (+1 / -1) of where the placed door's hinge is along the wall and which side it opens to, and where the\n    picture has them -> (flip hand, flip facing)\"\"\"\n    return (act_hinge * want_hinge < 0), (act_side * want_side < 0)\n\n\ndef _erode(v, W, r):\n    full = (1 << W) - 1\n    for _ in range(r):\n        h = [x & (x << 1) & (x >> 1) & full for x in v]\n        v = [h[y] & (h[y - 1] if y else 0) & (h[y + 1] if y + 1 < len(h) else 0) for y in range(len(h))]\n    return v\n\n\ndef _col_mm(v):\n    \"\"\"column sizes come in 50 mm steps (and 230, the brick size)\"\"\"\n    if abs(v - 230.0) <= 12.0:\n        return 230.0\n    return max(150.0, round(v / 50.0) * 50.0)\n\n\ndef find_columns(rows, wall_px, mm_px, walls=None, gr=None):\n    \"\"\"solid dark blocks thicker than the walls (square, rectangular or round) -> columns\n    [{'cx', 'cy' (px), 'w', 'd' (mm across / up-down), 'round'}].  rows = dark ink of the picture.\n    A solid block counts as a column when the same size is drawn at least twice, or it stands in a wall line or on a\n    grid crossing - one odd dark block on its own is furniture\"\"\"\n    if not rows:\n        return []\n    H, W = len(rows), len(rows[0])\n    r = max(2, int(wall_px / 2.0) + 1)                    # only what is thicker than a wall survives\n    core = _to_rows(_erode(_bits(rows), W, r), W)\n    out = []\n    for c in components(core):\n        x0, x1, y0, y1 = c['x0'], c['x1'], c['y0'], c['y1']   # the core; now its real edges\n        ym, xm = (y0 + y1) // 2, (x0 + x1) // 2\n        cap = 2 * r + 2\n\n        def walk(x, y, dx, dy, lo, hi, across):\n            \"\"\"steps of ink from the core edge outwards: along the middle line (true size of a free or round column);\n            if that runs on without end the column stands in a wall - then while most of the core's width is ink\"\"\"\n            n = 0\n            while n < cap and 0 <= x + dx * (n + 1) < W and 0 <= y + dy * (n + 1) < H and rows[y + dy * (n + 1)][x + dx * (n + 1)] == '1':\n                n += 1\n            if n < cap:\n                return n\n            n = 0\n            while n < r + 1:\n                xx, yy = x + dx * (n + 1), y + dy * (n + 1)\n                if not (0 <= xx < W and 0 <= yy < H):\n                    break\n                k = sum(rows[v][xx] == '1' for v in range(lo, hi + 1)) if across == 'y' else rows[yy].count('1', lo, hi + 1)\n                if k * 2 <= hi - lo + 1:\n                    break\n                n += 1\n            return n\n        gx0 = walk(x0, ym, -1, 0, y0, y1, 'y')\n        gx1 = walk(x1, ym, 1, 0, y0, y1, 'y')\n        gy0 = walk(xm, y0, 0, -1, x0, x1, 'x')\n        gy1 = walk(xm, y1, 0, 1, x0, x1, 'x')\n        x0, x1, y0, y1 = x0 - gx0, x1 + gx1, y0 - gy0, y1 + gy1\n        wpx, hpx = x1 - x0 + 1, y1 - y0 + 1\n        wmm, dmm = (wpx - 0.5) * mm_px, (hpx - 0.5) * mm_px   # a drawn edge covers its pixel: half a pixel too wide\n        if not (150.0 <= wmm <= 1250.0 and 150.0 <= dmm <= 1250.0) or max(wmm, dmm) > 2.5 * min(wmm, dmm):\n            continue\n        ink = sum(rows[y][max(0, x0):x1 + 1].count('1') for y in range(max(0, y0), min(H, y1 + 1)))\n        fill = ink / float(wpx * hpx)\n        if fill < 0.66:\n            continue\n        # a column stands on its own or in a wall: around it there must be paper or thin walls, not more solid black\n        ring = tot = 0\n        for y in range(max(0, y0 - r - 1), min(H, y1 + r + 2)):\n            for x in (x0 - r - 1, x1 + r + 1):\n                if 0 <= x < W:\n                    tot += 1\n                    ring += rows[y][x] == '1'\n        for x in range(max(0, x0 - r - 1), min(W, x1 + r + 2)):\n            for y in (y0 - r - 1, y1 + r + 1):\n                if 0 <= y < H:\n                    tot += 1\n                    ring += rows[y][x] == '1'\n        if tot and ring > 0.6 * tot:\n            continue\n        rnd = fill < 0.86 and abs(wpx - hpx) <= max(2, 0.15 * wpx) and wpx >= 8\n        out.append({'cx': (x0 + x1 + 1) / 2.0, 'cy': (y0 + y1 + 1) / 2.0, 'px': (x0, y0, x1, y1),\n                    'w': _col_mm(wmm), 'd': _col_mm(dmm), 'round': bool(rnd)})\n    # sizes drawn the same within a pixel are the same column size\n    sizes = {}\n    for c in out:\n        k = [k for k in sizes if abs(k[0] - c['w']) <= 1.2 * mm_px and abs(k[1] - c['d']) <= 1.2 * mm_px and k[2] == c['round']]\n        sizes.setdefault(k[0] if k else (c['w'], c['d'], c['round']), []).append(c)\n    for k, cs in sizes.items():\n        w_ = _col_mm(sum(c['w'] for c in cs) / len(cs))\n        d_ = _col_mm(sum(c['d'] for c in cs) / len(cs))\n        for c in cs:\n            c['w'], c['d'] = w_, (w_ if c['round'] else d_)\n    cnt = {}\n    for c in out:\n        cnt[(c['w'], c['d'], c['round'])] = cnt.get((c['w'], c['d'], c['round']), 0) + 1\n\n    def placed(c):\n        for w in walls or []:                             # its middle lies in a wall line\n            if _seg_dist(w['p'], w['q'], (c['cx'], c['cy'])) <= w['t'] / 2.0 + 1.0:\n                return True\n        if gr and any(abs(g['c'] - c['cx']) <= 3.0 for g in gr['v']) and any(abs(g['c'] - c['cy']) <= 3.0 for g in gr['h']):\n            return True\n        return False\n    return [c for c in out if cnt[(c['w'], c['d'], c['round'])] >= 2 or placed(c)]\n\n\ndef column_report(cols):\n    if not cols:\n        return []\n    cnt = {}\n    for c in cols:\n        k = ('{0:.0f} round'.format(c['w']) if c['round'] else '{0:.0f} x {1:.0f}'.format(c['w'], c['d']))\n        cnt[k] = cnt.get(k, 0) + 1\n    return ['Columns in the picture: {0} ({1}) - concrete columns'.format(\n        len(cols), ', '.join('{0} of {1}'.format(n, k) for k, n in sorted(cnt.items(), key=lambda q: -q[1])[:8]))]\n\n\n_NOT_NAME = set(['X', 'FT', 'SQ', 'SQFT', 'SQM', 'M2', 'MM', 'CM', 'M', 'UP', 'DN', 'DOWN', 'NORTH', 'N'])\n\n\ndef room_labels(words):\n    \"\"\"OCR words (x, y, w, h, text) -> room names as written: words on one line joined, a line right below joined too\n    -> [(centre x, centre y, text)] in picture px.  Sizes, areas and dimensions are left out\"\"\"\n    toks = []\n    for x, y, w, h, t in words:\n        t = (t or '').strip().strip('.,;:()[]')\n        if not t or h < 9:                                # smaller text is not read reliably (same rule as the dimensions)\n            continue\n        up = t.upper()\n        letters = sum(1 for ch in t if ch.isalpha())\n        digits = sum(1 for ch in t if ch.isdigit())\n        if up in _NOT_NAME or re.search(r'[\\'\"=]', t):\n            continue\n        if letters >= 2 and digits <= 1 and letters >= 0.6 * len(t):\n            toks.append([x, y, w, h, t, 'name'])\n        elif digits and letters == 0 and len(t) <= 2:\n            toks.append([x, y, w, h, t, 'no'])            # BEDROOM 2\n    toks.sort(key=lambda k: (k[1], k[0]))\n    lines = []\n    for k in sorted(toks, key=lambda k: k[0]):\n        hit = None\n        for ln in lines:\n            last = ln[-1]\n            if abs((last[1] + last[3] / 2.0) - (k[1] + k[3] / 2.0)) <= 0.5 * max(last[3], k[3]) and \\\n                    0 <= k[0] - (last[0] + last[2]) <= 1.3 * max(last[3], k[3]):\n                hit = ln\n                break\n        if hit is not None:\n            hit.append(k)\n        elif k[5] == 'name':\n            lines.append([k])\n    boxes = []\n    for ln in lines:\n        x0, y0 = min(k[0] for k in ln), min(k[1] for k in ln)\n        x1, y1 = max(k[0] + k[2] for k in ln), max(k[1] + k[3] for k in ln)\n        boxes.append([x0, y0, x1, y1, ' '.join(k[4] for k in ln)])\n    boxes.sort(key=lambda b: b[1])\n    out = []\n    used = set()\n    for i, b in enumerate(boxes):\n        if i in used:\n            continue\n        cur = list(b)\n        for j in range(i + 1, len(boxes)):\n            o = boxes[j]\n            hh = cur[3] - cur[1]\n            if j not in used and 0 <= o[1] - cur[3] <= 0.9 * (o[3] - o[1]) and min(cur[2], o[2]) - max(cur[0], o[0]) > 0 \\\n                    and 0.6 <= (o[3] - o[1]) / float(max(1, min(hh, b[3] - b[1]))) <= 1.7:\n                cur = [min(cur[0], o[0]), cur[1], max(cur[2], o[2]), o[3], cur[4] + ' ' + o[4]]\n                used.add(j)\n        out.append(((cur[0] + cur[2]) / 2.0, (cur[1] + cur[3]) / 2.0, cur[4]))\n    return out\n\n\ndef stair_segments(rows, box, mm_px, pad_mm=250.0):\n    \"\"\"straight thin lines inside a stair's box -> [((x0, y0), (x1, y1))] in px, for the stair engine (B18)\"\"\"\n    H, W = len(rows), len(rows[0])\n    pad = int(pad_mm / mm_px)\n    x0, y0 = max(0, int(box[0]) - pad), max(0, int(box[1]) - pad)\n    x1, y1 = min(W, int(box[2]) + pad + 1), min(H, int(box[3]) + pad + 1)\n    sub = [r[x0:x1] for r in rows[y0:y1]]\n    lmin = max(8, int(500.0 / mm_px))\n    segs = []\n    for l in _dim_lines(sub, lmin, 2, 4, 4, 0.8, 4):\n        c = y0 + (l['y0'] + l['y1'] + 1) / 2.0\n        segs.append(((x0 + l['a'], c), (x0 + l['b'] + 1.0, c)))\n    for l in _dim_lines(transpose(sub), lmin, 2, 4, 4, 0.8, 4):\n        c = x0 + (l['y0'] + l['y1'] + 1) / 2.0\n        segs.append(((c, y0 + l['a']), (c, y0 + l['b'] + 1.0)))\n    return segs\n\n\n# ------------------------------------------------------------------ picture / PDF -> ink strings (.NET)\nPS_PDF = r'''param([string]$pdf, [string]$png, [int]$page = 1, [int]$width = 2400)\n$ErrorActionPreference = 'Stop'\nAdd-Type -AssemblyName System.Runtime.WindowsRuntime\n$null = [Windows.Storage.StorageFile, Windows.Storage, ContentType = WindowsRuntime]\n$null = [Windows.Data.Pdf.PdfDocument, Windows.Data.Pdf, ContentType = WindowsRuntime]\n$null = [Windows.Storage.Streams.InMemoryRandomAccessStream, Windows.Storage.Streams, ContentType = WindowsRuntime]\n$m = [System.WindowsRuntimeSystemExtensions].GetMethods()\n$asTask = ($m | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' })[0]\n$asTaskA = ($m | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncAction' })[0]\nfunction Await($op, [Type]$t) { $task = $asTask.MakeGenericMethod($t).Invoke($null, @($op)); $task.Wait(-1) | Out-Null; $task.Result }\n$file = Await ([Windows.Storage.StorageFile]::GetFileFromPathAsync($pdf)) ([Windows.Storage.StorageFile])\n$doc = Await ([Windows.Data.Pdf.PdfDocument]::LoadFromFileAsync($file)) ([Windows.Data.Pdf.PdfDocument])\n$n = $doc.PageCount\nif ($page -lt 1 -or $page -gt $n) { $page = 1 }\n$p = $doc.GetPage($page - 1)\n$opt = New-Object Windows.Data.Pdf.PdfPageRenderOptions\n$opt.DestinationWidth = [uint32]$width\n$opt.DestinationHeight = [uint32]([Math]::Round($width * $p.Size.Height / $p.Size.Width))\n$opt.BackgroundColor = [Windows.UI.Color]::FromArgb(255,255,255,255)\n$ms = New-Object Windows.Storage.Streams.InMemoryRandomAccessStream\n$t = $asTaskA.Invoke($null, @($p.RenderToStreamAsync($ms, $opt))); $t.Wait(-1) | Out-Null\n$s = [System.IO.WindowsRuntimeStreamExtensions]::AsStreamForRead($ms.GetInputStreamAt(0))\n$fs = [IO.File]::Create($png); $s.CopyTo($fs); $fs.Close()\n\"OK|$n|$page|$($p.Size.Width)|$($p.Size.Height)\"\n'''\n\n\ndef _q(a):\n    return '\"' + a.replace('\"', '') + '\"' if (' ' in a or not a) else a\n\n\ndef _ps(args):\n    \"\"\"run powershell hidden -> (stdout, stderr)\"\"\"\n    if REVIT:\n        psi = System.Diagnostics.ProcessStartInfo('powershell.exe', ' '.join(_q(a) for a in args))\n        psi.UseShellExecute = False\n        psi.CreateNoWindow = True\n        psi.RedirectStandardOutput = True\n        psi.RedirectStandardError = True\n        pr = System.Diagnostics.Process.Start(psi)\n        o = pr.StandardOutput.ReadToEnd()\n        e = pr.StandardError.ReadToEnd()\n        pr.WaitForExit(120000)\n        return str(o), str(e)\n    p = subprocess.Popen(['powershell.exe'] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n    o, e = p.communicate()\n    return o.decode('utf-8', 'ignore'), e.decode('utf-8', 'ignore')\n\n\nPS_IMG = r'''param([string]$src, [string]$png)\n$ErrorActionPreference = 'Stop'\nAdd-Type -AssemblyName PresentationCore\n$fs = [IO.File]::OpenRead($src)\n$dec = [System.Windows.Media.Imaging.BitmapDecoder]::Create($fs, [System.Windows.Media.Imaging.BitmapCreateOptions]::PreservePixelFormat, [System.Windows.Media.Imaging.BitmapCacheOption]::OnLoad)\n$enc = New-Object System.Windows.Media.Imaging.PngBitmapEncoder\n$enc.Frames.Add([System.Windows.Media.Imaging.BitmapFrame]::Create($dec.Frames[0]))\n$fs.Close()\n$out = [IO.File]::Create($png); $enc.Save($out); $out.Close()\n\"OK|$($dec.Frames[0].PixelWidth)|$($dec.Frames[0].PixelHeight)\"\n'''\nPS_OCR = r'''param([string]$path, [double]$zoom = 3)\n$ErrorActionPreference = 'Stop'\nAdd-Type -AssemblyName System.Drawing\n$src = New-Object System.Drawing.Bitmap $path\n$z = [Math]::Max(1.0, [Math]::Min($zoom, 4000.0 / [Math]::Max($src.Width, $src.Height)))\n$big = New-Object System.Drawing.Bitmap ([int]($src.Width * $z)), ([int]($src.Height * $z))\n$g = [System.Drawing.Graphics]::FromImage($big); $g.Clear([System.Drawing.Color]::White)\n$g.InterpolationMode = 'HighQualityBicubic'; $g.DrawImage($src, 0, 0, $big.Width, $big.Height); $g.Dispose(); $src.Dispose()\n$tmp = [IO.Path]::Combine($env:TEMP, 'PLAN2BIM_ocr.png'); $big.Save($tmp, [System.Drawing.Imaging.ImageFormat]::Png); $big.Dispose()\n$path = $tmp\nAdd-Type -AssemblyName System.Runtime.WindowsRuntime\n$null = [Windows.Storage.StorageFile, Windows.Storage, ContentType = WindowsRuntime]\n$null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]\n$null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Graphics, ContentType = WindowsRuntime]\n$asTask = ([System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object { $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' })[0]\nfunction Await($op, [Type]$t) { $task = $asTask.MakeGenericMethod($t).Invoke($null, @($op)); $task.Wait() | Out-Null; $task.Result }\n$file = Await ([Windows.Storage.StorageFile]::GetFileFromPathAsync($path)) ([Windows.Storage.StorageFile])\n$stream = Await ($file.OpenAsync([Windows.Storage.FileAccessMode]::Read)) ([Windows.Storage.Streams.IRandomAccessStream])\n$dec = Await ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($stream)) ([Windows.Graphics.Imaging.BitmapDecoder])\n$bmp = Await ($dec.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap])\n$eng = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages()\nif ($eng -eq $null) { 'NOENGINE'; exit }\n$res = Await ($eng.RecognizeAsync($bmp)) ([Windows.Media.Ocr.OcrResult])\nforeach ($l in $res.Lines) { foreach ($w in $l.Words) { $r = $w.BoundingRect\n  \"W|{0}|{1}|{2}|{3}|{4}\" -f [int]($r.X / $z), [int]($r.Y / $z), [int][Math]::Ceiling($r.Width / $z), [int][Math]::Ceiling($r.Height / $z), $w.Text } }\n'''\n\n\ndef _tmpdir():\n    tmp = os.path.join(os.environ.get('TEMP', os.path.expanduser('~')), 'PLAN2BIM')\n    if not os.path.isdir(tmp):\n        os.makedirs(tmp)\n    return tmp\n\n\ndef ocr_words(path):\n    \"\"\"Windows' own text reader -> word boxes [(x, y, w, h, text)] in picture px ([] if it is not available)\"\"\"\n    try:\n        ps = os.path.join(_tmpdir(), 'ocr.ps1')\n        with open(ps, 'w') as f:\n            f.write(PS_OCR)\n        o, e = _ps(['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ps, path, '3'])\n        res = []\n        for l in o.splitlines():\n            p = l.strip().split('|', 5)\n            if len(p) == 6 and p[0] == 'W':\n                res.append((int(p[1]), int(p[2]), int(p[3]), int(p[4]), p[5]))\n        return res\n    except Exception as ex:\n        log('ocr: ' + str(ex))\n        return []\n\n\ndef text_zone(words):\n    \"\"\"room labels: the line of each word read, widened, plus a line above and below (sizes OCR could not read)\"\"\"\n    z = []\n    for x, y, w, h, t in words:\n        z.append((x - 2 * h, y - int(1.4 * h), w + 4 * h, int(3.8 * h), t))\n    return z\n\n\ndef mask_words(rows, words, f=1.0, pad=1):\n    \"\"\"blank the text so letters are not read as walls / furniture\"\"\"\n    if not rows:\n        return rows\n    W, H = len(rows[0]), len(rows)\n    rows = list(rows)\n    for x, y, w, h, t in words:\n        x0, y0 = max(0, int(x * f) - pad), max(0, int(y * f) - pad)\n        x1, y1 = min(W - 1, int((x + w) * f) + pad), min(H - 1, int((y + h) * f) + pad)\n        for yy in range(y0, y1 + 1):\n            r = rows[yy]\n            rows[yy] = r[:x0] + '0' * (x1 - x0 + 1) + r[x1 + 1:]\n    return rows\n\n\ndef raster(path, page=1, width=2400):\n    \"\"\"PDF -> PNG of one page (Windows' own PDF reader); WebP / other formats -> PNG.\n    -> (picture path, paper mm per px or None, report)\"\"\"\n    ext = os.path.splitext(path)[1].lower()\n    if ext in ('.jpg', '.jpeg', '.png', '.bmp', '.gif', '.tif', '.tiff'):\n        return path, None, ''\n    if ext != '.pdf':\n        ps = os.path.join(_tmpdir(), 'img2png.ps1')\n        with open(ps, 'w') as f:\n            f.write(PS_IMG)\n        png = os.path.join(_tmpdir(), re.sub(r'[^\\w\\-]+', '_', os.path.splitext(os.path.basename(path))[0])[:60] + '.png')\n        o, e = _ps(['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ps, path, png])\n        if 'OK|' not in o or not os.path.isfile(png):\n            raise Exception('could not read this picture type ({0}): {1}'.format(ext, (e.strip().splitlines() or ['?'])[-1][:200]))\n        return png, None, 'Picture {0} converted to PNG'.format(ext)\n    tmp = os.path.join(os.environ.get('TEMP', os.path.expanduser('~')), 'PLAN2BIM')\n    if not os.path.isdir(tmp):\n        os.makedirs(tmp)\n    ps = os.path.join(tmp, 'pdf2png.ps1')\n    with open(ps, 'w') as f:\n        f.write(PS_PDF)\n    base = re.sub(r'[^\\w\\-]+', '_', os.path.splitext(os.path.basename(path))[0])[:60]\n    png = os.path.join(tmp, '{0}_p{1}.png'.format(base, int(page)))\n    o, e = _ps(['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ps, path, png, str(int(page)), str(int(width))])\n    line = [l for l in o.splitlines() if l.startswith('OK|')]\n    if not line or not os.path.isfile(png):\n        raise Exception('could not open the PDF: ' + (e.strip().splitlines() or ['?'])[-1][:200])\n    _, n, pg, wd, ht = line[0].split('|')\n    paper_w_mm = float(wd.replace(',', '.')) * 25.4 / 96.0\n    return png, paper_w_mm / float(width), 'PDF page {0} of {1} ({2:.0f} x {3:.0f} mm paper)'.format(\n        pg, n, paper_w_mm, float(ht.replace(',', '.')) * 25.4 / 96.0)\n\n\ndef _table(fn):\n    return dict((i, '1' if fn(i) else '0') for i in range(256))\n\n\ndef load_ink(path, max_px=2600, thr=150, sat=70):\n    \"\"\"-> ink rows ('1' dark grey/black, '0' paper or colour), W, H, object rows (dark / mid grey / coloured),\n    picture-to-working scale factor.  Native speed: ColorMatrix + translate\"\"\"\n    from System.Runtime.InteropServices import Marshal\n    src = SD.Bitmap(path)\n    try:\n        W0, H0 = src.Width, src.Height\n        f = min(1.0, float(max_px) / max(W0, H0))\n        W, H = max(1, int(round(W0 * f))), max(1, int(round(H0 * f)))\n        bmp = SD.Bitmap(W, H, SDI.PixelFormat.Format24bppRgb)\n        g = SD.Graphics.FromImage(bmp)\n        try:\n            g.Clear(SD.Color.White)\n            g.InterpolationMode = SD2.InterpolationMode.HighQualityBicubic if f < 1.0 else SD2.InterpolationMode.NearestNeighbor\n            g.PixelOffsetMode = SD2.PixelOffsetMode.Half\n            cm = SDI.ColorMatrix()                        # memory B,G,R  =  grey, (R-G)/2+.5, (G-B)/2+.5\n            cm.Matrix00, cm.Matrix10, cm.Matrix20 = 0.0, 0.5, -0.5\n            cm.Matrix40 = 0.5\n            cm.Matrix01, cm.Matrix11, cm.Matrix21 = 0.5, -0.5, 0.0\n            cm.Matrix41 = 0.5\n            cm.Matrix02, cm.Matrix12, cm.Matrix22 = 0.299, 0.587, 0.114\n            cm.Matrix33 = 1.0\n            ia = SDI.ImageAttributes()\n            ia.SetColorMatrix(cm)\n            g.DrawImage(src, SD.Rectangle(0, 0, W, H), 0, 0, W0, H0, SD.GraphicsUnit.Pixel, ia)\n        finally:\n            g.Dispose()\n    finally:\n        src.Dispose()\n    data = bmp.LockBits(SD.Rectangle(0, 0, W, H), SDI.ImageLockMode.ReadOnly, SDI.PixelFormat.Format24bppRgb)\n    try:\n        stride = abs(data.Stride)\n        arr = System.Array.CreateInstance(System.Byte, stride * H)\n        Marshal.Copy(data.Scan0, arr, 0, stride * H)\n    finally:\n        bmp.UnlockBits(data)\n        bmp.Dispose()\n    s = System.Text.Encoding.GetEncoding(28591).GetString(arr)\n    s = str(s)\n    dark = _table(lambda v: v < thr)\n    darker = [(t, _table(lambda v, t=t: v < t), []) for t in INK_THR if t < thr]\n    grey = _table(lambda v: abs(v - 128) < sat / 2.0)\n    mid = _table(lambda v: v < 172)\n    light = _table(lambda v: v < 235)\n    neutral = _table(lambda v: abs(v - 128) < 30)\n    anym = _table(lambda v: v < 215)\n    full = (1 << W) - 1\n    rows, orows = [], []\n    del LAST_MARK[:]\n    for y in range(H):\n        r = s[y * stride: y * stride + 3 * W]\n        b0, b1, b2 = r[0::3], r[1::3], r[2::3]\n        a = int(b0.translate(dark), 2) & int(b1.translate(grey), 2) & int(b2.translate(grey), 2)\n        rows.append(bin(a)[2:].rstrip('L').zfill(W) if a else '0' * W)\n        gg = int(b1.translate(grey), 2) & int(b2.translate(grey), 2)\n        for t_, tab, lst in darker:\n            a = int(b0.translate(tab), 2) & gg\n            lst.append(bin(a)[2:].rstrip('L').zfill(W) if a else '0' * W)\n        col = full & ~(int(b1.translate(neutral), 2) & int(b2.translate(neutral), 2))\n        o = int(b0.translate(mid), 2) | (col & int(b0.translate(light), 2))\n        orows.append(bin(o)[2:].rstrip('L').zfill(W) if o else '0' * W)\n        LAST_MARK.append(str(b0.translate(anym)))         # every drawn mark, light lines too: dimension lines\n    LAST_INK.clear()\n    for t_, tab, lst in darker:\n        LAST_INK[t_] = lst\n    return rows, W, H, orows, f\n\n\ndef _draw_dims(g, dm, H):\n    \"\"\"dimensions on the marked plan: green = used, orange = does not fit the picture, thick + 'D1' = the one asked about\"\"\"\n    if not dm:\n        return\n    sc = dm.get('sc')\n    if sc and not sc.get('sure'):\n        sc = None                                         # nothing read for sure: only D1 is shown\n    used = set(id(d) for d in (sc['used'] if sc else []))\n    off = set(id(d) for d in (sc['off'] if sc else []))\n    f = SD.Font('Arial', max(8.0, H / 90.0), SD.FontStyle.Bold)\n    for d in dm['dims']:\n        first = d is dm.get('d1')\n        if id(d) in used or first:\n            col = SD.Color.FromArgb(255, 0, 150, 0)\n        elif id(d) in off:\n            col = SD.Color.FromArgb(255, 235, 120, 0)\n        else:\n            continue\n        pen = SD.Pen(col, 5.0 if first else 2.0)\n        a, b, c = float(d['a']), float(d['b']), float(d['c'])\n        if d['o'] == 'H':\n            g.DrawLine(pen, a, c, b, c)\n            tx, ty = (a + b) / 2.0, c + 3.0\n        else:\n            g.DrawLine(pen, c, a, c, b)\n            tx, ty = c + 4.0, (a + b) / 2.0\n        if d.get('typed'):\n            label = '{0:g}'.format(d['mm'])\n        elif d.get('mended') and id(d) in used:\n            label = dim_text(d['mm'], 'feet' if '\"' in str(d.get('txt')) else 'mm')\n        elif id(d) in used or id(d) in off:\n            label = str(d.get('txt', ''))\n        else:\n            label = '?'\n        g.DrawString(('D1 ' if first else '') + label, f, SD.SolidBrush(col), float(tx), float(ty))\n\n\ndef _draw_grids(g, gr, H):\n    \"\"\"grid lines found on the picture, with the names they get\"\"\"\n    if not gr:\n        return\n    col = SD.Color.FromArgb(255, 150, 0, 200)\n    pen = SD.Pen(col, 1.5)\n    f = SD.Font('Arial', max(8.0, H / 90.0), SD.FontStyle.Bold)\n    for ln in gr['v'] + gr['h']:\n        a, b, c = float(ln['a']), float(ln['b']), float(ln['c'])\n        if ln['o'] == 'V':\n            g.DrawLine(pen, c, a, c, b)\n            g.DrawString(str(ln.get('name', '')), f, SD.SolidBrush(col), c + 3.0, a + 16.0)\n        else:\n            g.DrawLine(pen, a, c, b, c)\n            g.DrawString(str(ln.get('name', '')), f, SD.SolidBrush(col), a + 16.0, c + 2.0)\n\n\ndef dims_preview(path, dm, out_path, W, H):\n    \"\"\"the plan with the dimensions found (shown before the walls are read)\"\"\"\n    src = SD.Bitmap(path)\n    bmp = SD.Bitmap(W, H, SDI.PixelFormat.Format24bppRgb)\n    g = SD.Graphics.FromImage(bmp)\n    try:\n        g.Clear(SD.Color.White)\n        g.DrawImage(src, SD.Rectangle(0, 0, W, H))\n        g.FillRectangle(SD.SolidBrush(SD.Color.FromArgb(110, 255, 255, 255)), 0, 0, W, H)\n        _draw_dims(g, dm, H)\n    finally:\n        g.Dispose()\n        src.Dispose()\n    bmp.Save(out_path, SDI.ImageFormat.Png)\n    bmp.Dispose()\n    return out_path\n\n\ndef preview(path, res, out_path, W, H):\n    \"\"\"the walls found, drawn over the plan (red walls, black doors, blue windows)\"\"\"\n    src = SD.Bitmap(path)\n    bmp = SD.Bitmap(W, H, SDI.PixelFormat.Format24bppRgb)\n    g = SD.Graphics.FromImage(bmp)\n    try:\n        g.Clear(SD.Color.White)\n        g.DrawImage(src, SD.Rectangle(0, 0, W, H))\n        g.FillRectangle(SD.SolidBrush(SD.Color.FromArgb(150, 255, 255, 255)), 0, 0, W, H)\n        g.SmoothingMode = SD2.SmoothingMode.AntiAlias\n        cols = [SD.Color.FromArgb(200, 220, 0, 0), SD.Color.FromArgb(200, 0, 90, 230), SD.Color.FromArgb(200, 0, 150, 0),\n                SD.Color.FromArgb(200, 200, 0, 200), SD.Color.FromArgb(200, 230, 140, 0)]\n        kinds = sorted(set(w['mm'] for w in res['walls']), reverse=True)\n        for w in res['walls']:\n            pen = SD.Pen(cols[kinds.index(w['mm']) % len(cols)], max(2.0, float(w['t'])))\n            pen.StartCap = pen.EndCap = SD2.LineCap.Square\n            g.DrawLine(pen, float(w['p'][0]), float(w['p'][1]), float(w['q'][0]), float(w['q'][1]))\n            for o in w['ops']:\n                c = SD.Color.Black if o['kind'] == 'door' else SD.Color.FromArgb(255, 0, 190, 230)\n                op = SD.Pen(c, max(2.0, float(w['t']) + 2.0))\n                dx, dy = w['d'][0] * o['w'] / 2.0, w['d'][1] * o['w'] / 2.0\n                g.DrawLine(op, float(o['c'][0] - dx), float(o['c'][1] - dy), float(o['c'][0] + dx), float(o['c'][1] + dy))\n        for o in res.get('objects') or []:\n            c = SD.Color.FromArgb(220, 150, 0, 160) if o['kind'] == 'Stair' else SD.Color.FromArgb(220, 0, 140, 60)\n            g.DrawRectangle(SD.Pen(c, 2.0), float(o['x0']), float(o['y0']), float(o['x1'] - o['x0'] + 1), float(o['y1'] - o['y0'] + 1))\n            g.DrawString(o['kind'], SD.Font('Arial', 7.0), SD.SolidBrush(c), float(o['x0']) + 1.0, float(o['y0']) + 1.0)\n        _draw_grids(g, res.get('gr'), H)\n        for c_ in res.get('columns') or []:               # columns: filled orange; door leaves: thin black line from the hinge\n            x0_, y0_, x1_, y1_ = c_['px']\n            g.FillRectangle(SD.SolidBrush(SD.Color.FromArgb(230, 255, 140, 0)), float(x0_), float(y0_), float(x1_ - x0_ + 1), float(y1_ - y0_ + 1))\n        for w_ in res['walls']:\n            for o_ in w_['ops']:\n                if o_.get('swing'):\n                    hx, hy = o_['hinge']\n                    sx, sy = o_['side']\n                    cx_, cy_ = o_['c']\n                    g.DrawLine(SD.Pen(SD.Color.Black, 2.0), float(hx), float(hy), float(hx + sx - cx_), float(hy + sy - cy_))\n        _draw_dims(g, res.get('dm'), H)\n        f = SD.Font('Arial', max(9.0, H / 70.0), SD.FontStyle.Bold)\n        y = 4.0\n        for k in kinds:\n            g.DrawString('{0:.0f} mm walls'.format(k), f, SD.SolidBrush(cols[kinds.index(k) % len(cols)]), 4.0, y)\n            y += f.Height\n        g.DrawString('black = door (line = leaf), blue = window, orange = column, green = dimension used, purple = stair / grid', f, SD.Brushes.Black, 4.0, y)\n    finally:\n        g.Dispose()\n        src.Dispose()\n    bmp.Save(out_path, SDI.ImageFormat.Png)\n    bmp.Dispose()\n    return out_path\n\n\n# ------------------------------------------------------------------ Revit helpers\ndef ename(e):\n    for bip in (BuiltInParameter.SYMBOL_NAME_PARAM, BuiltInParameter.ALL_MODEL_TYPE_NAME):\n        try:\n            p = e.get_Parameter(bip)\n            if p is not None and p.AsString():\n                return p.AsString()\n        except Exception:\n            pass\n    try:\n        return Element.Name.GetValue(e)\n    except Exception:\n        return ''\n\n\ndef tname_of(o):\n    try:\n        return o.GetType().Name\n    except Exception:\n        return type(o).__name__\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\ndef plan_view(doc, uidoc):\n    \"\"\"the open floor plan (active view first)\"\"\"\n    try:\n        v = uidoc.ActiveView if uidoc is not None else doc.ActiveView\n    except Exception:\n        v = doc.ActiveView\n    if v is not None and tname_of(v) == 'ViewPlan' and not v.IsTemplate:\n        return v\n    try:\n        for uv in uidoc.GetOpenUIViews():\n            ov = doc.GetElement(uv.ViewId)\n            if ov is not None and tname_of(ov) == 'ViewPlan' and not ov.IsTemplate:\n                return ov\n    except Exception:\n        pass\n    plans = [p for p in FilteredElementCollector(doc).OfClass(ViewPlan) if not p.IsTemplate and p.ViewType == ViewType.FloorPlan]\n    return plans[0] if plans else None\n\n\ndef pick_level(doc, view, name=''):\n    levels = sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)\n    if not levels:\n        raise Exception('No levels in this project.')\n    if name:\n        for l in levels:\n            if l.Name.strip().upper() == str(name).strip().upper():\n                return l\n        for l in levels:\n            if str(name).strip().upper() in l.Name.upper():\n                return l\n    try:\n        if view is not None and view.GenLevel is not None:\n            return view.GenLevel\n    except Exception:\n        pass\n    return levels[0]\n\n\ndef _same_path(a, b):\n    try:\n        return os.path.normcase(os.path.abspath(a)) == os.path.normcase(os.path.abspath(b))\n    except Exception:\n        return False\n\n\ndef find_underlay(doc, view, path):\n    if view is None:\n        return None\n    for inst in FilteredElementCollector(doc, view.Id).OfClass(ImageInstance):\n        try:\n            if _same_path(doc.GetElement(inst.GetTypeId()).Path, path):\n                return inst\n        except Exception:\n            pass\n    return None\n\n\ndef underlay_geom(inst):\n    \"\"\"-> (bottom-left XYZ, width mm)\"\"\"\n    return inst.GetLocation(BoxPlacement.BottomLeft), inst.Width / MMF\n\n\ndef place_underlay(doc, view, path, width_mm, origin, inst=None):\n    if inst is None:\n        it = None\n        for t in FilteredElementCollector(doc).OfClass(ImageType):\n            try:\n                if _same_path(t.Path, path):\n                    it = t\n                    break\n            except Exception:\n                pass\n        if it is None:\n            it = ImageType.Create(doc, ImageTypeOptions(path, False, ImageTypeSource.Import))\n        inst = ImageInstance.Create(doc, view, it.Id, ImagePlacementOptions(origin, BoxPlacement.BottomLeft))\n    try:\n        inst.LockProportions = True\n    except Exception:\n        pass\n    inst.Width = width_mm * MMF\n    inst.SetLocation(origin, BoxPlacement.BottomLeft)\n    try:\n        inst.DrawLayer = DrawLayer.Background\n    except Exception:\n        pass\n    return inst\n\n\ntry:\n    class _Cap(IFailuresPreprocessor):\n        __namespace__ = 'PLAN2BIM_B14'\n\n        def PreprocessFailures(self, fa):\n            for f in fa.GetFailureMessages():\n                try:\n                    if f.GetSeverity() == FailureSeverity.Warning:\n                        fa.DeleteWarning(f)\n                except Exception:\n                    pass\n            return FailureProcessingResult.Continue\nexcept Exception:\n    _Cap = None\n\n\ndef in_tx(doc, name, fn):\n    t = Transaction(doc, name)\n    if _Cap is not None:\n        try:\n            o = t.GetFailureHandlingOptions()\n            o.SetFailuresPreprocessor(_Cap())\n            t.SetFailureHandlingOptions(o)\n        except Exception:\n            pass\n    t.Start()\n    try:\n        r = fn()\n    except Exception:\n        if t.HasStarted() and not t.HasEnded():\n            t.RollBack()\n        raise\n    t.Commit()\n    return r\n\n\n# ------------------------------------------------------------------ types (same names as B12: A_WAL_BRK_230 ...)\ndef mat_code(m):\n    u = m.upper()\n    for k, c in (('BRICK', 'BRK'), ('AAC', 'AAC'), ('BLOCK', 'BLK'), ('CONCRETE', 'RC'), ('RCC', 'RC'), ('STONE', 'STN'),\n                 ('GYPSUM', 'GYP'), ('GLASS', 'GL')):\n        if k in u:\n            return c\n    return re.sub(r'[^A-Z]', '', u)[:3] or 'GEN'\n\n\ndef material_id(doc, name):\n    mats = list(FilteredElementCollector(doc).OfClass(Material))\n    for m in mats:\n        if m.Name.upper() == name.upper():\n            return m.Id\n    for m in mats:\n        if name.upper() in m.Name.upper():\n            return m.Id\n    return Material.Create(doc, name)\n\n\ndef wall_type(doc, t_mm, material, cache):\n    key = int(round(t_mm))\n    if key in cache:\n        return cache[key]\n    name = 'A_WAL_{0}_{1}'.format(mat_code(material), key)\n    wt = next((t for t in FilteredElementCollector(doc).OfClass(WallType) if ename(t) == name), None)\n    if wt is None:\n        base = [t for t in FilteredElementCollector(doc).OfClass(WallType) if t.Kind == WallKind.Basic and t.GetCompoundStructure() is not None]\n        if not base:\n            raise Exception('no basic wall type in this project to copy')\n        wt = base[0].Duplicate(name)\n        cs = wt.GetCompoundStructure()\n        lay = List[CompoundStructureLayer]()\n        lay.Add(CompoundStructureLayer(key * MMF, MaterialFunctionAssignment.Structure, material_id(doc, material)))\n        cs.SetLayers(lay)\n        for side in (ShellLayerType.Exterior, ShellLayerType.Interior):\n            try:\n                cs.SetNumberOfShellLayers(side, 0)\n            except Exception:\n                pass\n        try:\n            cs.StructuralMaterialIndex = 0\n        except Exception:\n            pass\n        wt.SetCompoundStructure(cs)\n    cache[key] = wt\n    return wt\n\n\ndef _symbols(doc, bic):\n    return list(FilteredElementCollector(doc).OfCategory(bic).OfClass(FamilySymbol))\n\n\ndef _lib_family(doc, words):\n    root = os.path.join(os.environ.get('ProgramData', r'C:\\ProgramData'), 'Autodesk', 'RVT ' + doc.Application.VersionNumber, 'Libraries')\n    for lg in ('English', 'English-Imperial', 'English_I'):\n        base = os.path.join(root, lg)\n        if not os.path.isdir(base):\n            continue\n        for w in words:\n            for dp, dn, fn in os.walk(base):\n                for f_ in fn:\n                    if f_.lower().endswith('.rfa') and w.lower() in f_.lower():\n                        try:\n                            if doc.LoadFamily(os.path.join(dp, f_)):\n                                return os.path.splitext(f_)[0]\n                        except Exception as ex:\n                            log('load {0}: {1}'.format(f_, ex))\n    return None\n\n\ndef _set_len(s, names, mm):\n    for n in names:\n        bip = getattr(BuiltInParameter, n, None)\n        p = s.get_Parameter(bip) if bip is not None else None\n        if p is None:\n            p = s.LookupParameter(n)\n        if p is not None and not p.IsReadOnly:\n            try:\n                p.Set(mm * MMF)\n                return True\n            except Exception:\n                pass\n    return False\n\n\ndef _is_double(s):\n    n = (s.Family.Name + ' ' + ename(s)).upper()\n    return 'DOUBLE' in n or 'DBL' in n or 'PAIR' in n\n\n\ndef _base_symbol(doc, bic, prefer, lib_words, double=None):\n    def ok(s):\n        return double is None or _is_double(s) == double\n    cand = [s for s in _symbols(doc, bic) if ok(s)]\n    pref = [s for s in cand if any(p in s.Family.Name.upper() for p in prefer)]\n    if pref or cand:\n        return (pref or cand)[0]\n    fam = _lib_family(doc, lib_words)\n    if fam:\n        cand = [s for s in _symbols(doc, bic) if s.Family.Name == fam]\n        if cand:\n            return cand[0]\n    if double:\n        return _base_symbol(doc, bic, prefer, lib_words, False)\n    return None\n\n\ndef opening_type(doc, kind, w_mm, h_mm, cache, double_from=1300.0):\n    \"\"\"door / window type of this size (copy of a family type in the project, or loaded from the Revit library)\"\"\"\n    dbl = kind == 'door' and w_mm > double_from\n    key = (kind, dbl, int(round(w_mm / 10.0) * 10), int(round(h_mm)))\n    if key in cache:\n        return cache[key]\n    if kind == 'door':\n        base = _base_symbol(doc, BuiltInCategory.OST_Doors, ['FLUSH'],\n                            ['Double-Flush', 'Double-Glass'] if dbl else ['Single-Flush', 'Single-Panel'], dbl)\n        name = 'A_DR_{0}_{1:04d}x{2:04d}'.format('DBL' if base is not None and _is_double(base) else 'SGL', key[2], key[3])\n        wn, hn = ['DOOR_WIDTH', 'FAMILY_WIDTH_PARAM', 'Width', 'Rough Width'], ['DOOR_HEIGHT', 'FAMILY_HEIGHT_PARAM', 'Height', 'Rough Height']\n    else:\n        base = _base_symbol(doc, BuiltInCategory.OST_Windows, ['FIXED', 'CASEMENT', 'SLIDING'], ['Window-Fixed', 'Fixed', 'Casement', 'Sliding'])\n        name = 'A_WIN_{0:04d}x{1:04d}'.format(key[2], key[3])\n        wn, hn = ['WINDOW_WIDTH', 'FAMILY_WIDTH_PARAM', 'Width', 'Rough Width'], ['WINDOW_HEIGHT', 'FAMILY_HEIGHT_PARAM', 'Height', 'Rough Height']\n    if base is None:\n        raise Exception('no {0} family in the project or the Revit library - load one (Insert > Load Family)'.format(kind))\n    s = None\n    for sid in base.Family.GetFamilySymbolIds():\n        e = doc.GetElement(sid)\n        if ename(e) == name:\n            s = e\n            break\n    if s is None:\n        s = base.Duplicate(name)\n    _set_len(s, wn, key[2])\n    _set_len(s, hn, key[3])\n    if not s.IsActive:\n        s.Activate()\n    cache[key] = s\n    return s\n\n\ndef tagged(doc, bic, tag):\n    res = []\n    for e in FilteredElementCollector(doc).OfCategory(bic).WhereElementIsNotElementType():\n        try:\n            c = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n            if c is not None and (c.AsString() or '') == tag:\n                res.append(e.Id)\n        except Exception:\n            pass\n    return res\n\n\ndef view_3d(doc, name):\n    for v in FilteredElementCollector(doc).OfClass(View3D):\n        if not v.IsTemplate and v.Name == name:\n            return v\n    vft = next(t for t in FilteredElementCollector(doc).OfClass(ViewFamilyType) if t.ViewFamily == ViewFamily.ThreeDimensional)\n    v = View3D.CreateIsometric(doc, vft.Id)\n    try:\n        v.Name = name\n    except Exception:\n        pass\n    try:\n        v.DetailLevel = ViewDetailLevel.Medium\n        v.DisplayStyle = DisplayStyle.ShadingWithEdges\n    except Exception:\n        pass\n    return v\n\n\ndef selected_line_mm(doc, uidoc):\n    \"\"\"length (mm) of the line selected in Revit - the dimension / scale bar the user traced on the picture\"\"\"\n    try:\n        for i in uidoc.Selection.GetElementIds():\n            e = doc.GetElement(i)\n            c = getattr(e, 'GeometryCurve', None)\n            if c is not None and c.IsBound:\n                return c.Length / MMF\n    except Exception:\n        pass\n    return None\n\n\ndef room_floors(doc, level, tag, min_m2=1.0):\n    \"\"\"a floor slab in every closed room on the level (temporary Revit rooms find the closed spaces) -> (floors, rooms)\"\"\"\n    try:\n        phase = list(doc.Phases)[-1]\n        rids = list(doc.Create.NewRooms2(level, phase))\n    except Exception as ex:\n        log('rooms: ' + str(ex))\n        return 0, 0\n    doc.Regenerate()\n    ft = doc.GetDefaultElementTypeId(ElementTypeGroup.FloorType)\n    if ft is None or ft == ElementId.InvalidElementId:\n        fts = list(FilteredElementCollector(doc).OfClass(FloorType))\n        ft = fts[0].Id if fts else None\n    opt = SpatialElementBoundaryOptions()\n    opt.SpatialElementBoundaryLocation = SpatialElementBoundaryLocation.Center     # slab runs under the walls\n    n = 0\n    for rid in rids:\n        r = doc.GetElement(rid)\n        if r is None or ft is None:\n            continue\n        try:\n            loops = List[CurveLoop]()\n            for seg_loop in r.GetBoundarySegments(opt):\n                cl = CurveLoop()\n                for sg in seg_loop:\n                    cl.Append(sg.GetCurve())\n                loops.Add(cl)\n            if loops.Count == 0:\n                continue\n            area = 0.0\n            for cl in loops:                              # shoelace over the boundary points (sq ft)\n                P = [c.GetEndPoint(0) for c in cl]\n                a = sum(P[i].X * P[(i + 1) % len(P)].Y - P[(i + 1) % len(P)].X * P[i].Y for i in range(len(P))) / 2.0\n                area = max(area, abs(a))\n            if area * 0.092903 < min_m2:\n                continue\n            f = Floor.Create(doc, loops, ft, level.Id)\n            f.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n            n += 1\n        except Exception as ex:\n            log('floor: ' + str(ex))\n    for rid in rids:                                      # the temporary rooms go again\n        try:\n            if doc.GetElement(rid) is not None:\n                doc.Delete(rid)\n        except Exception:\n            pass\n    return n, len(rids)\n\n\nCAT_3D = {'furniture': 'OST_Furniture', 'plumbing': 'OST_PlumbingFixtures', 'generic': 'OST_GenericModel'}\n\n\ndef _box(x0, y0, x1, y1, z0, h):\n    pts = [XYZ(x0, y0, z0), XYZ(x1, y0, z0), XYZ(x1, y1, z0), XYZ(x0, y1, z0)]\n    cl = CurveLoop()\n    for i in range(4):\n        cl.Append(Line.CreateBound(pts[i], pts[(i + 1) % 4]))\n    loops = List[CurveLoop]()\n    loops.Add(cl)\n    return GeometryCreationUtilities.CreateExtrusionGeometry(loops, XYZ.BasisZ, h)\n\n\ndef shape_3d(doc, cat, solids, name, tag):\n    \"\"\"one DirectShape (Furniture / Plumbing Fixtures / Generic Model) made of boxes\"\"\"\n    bic = getattr(BuiltInCategory, CAT_3D.get(cat, 'OST_GenericModel'))\n    cid = ElementId(bic)\n    if not DirectShape.IsValidCategoryId(cid, doc):\n        cid = ElementId(BuiltInCategory.OST_GenericModel)\n    ds = DirectShape.CreateElement(doc, cid)\n    geo = List[GeometryObject]()\n    for so in solids:\n        geo.Add(so)\n    ds.SetShape(geo)\n    try:\n        ds.Name = name\n    except Exception:\n        pass\n    for bip, val in ((BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS, tag), (BuiltInParameter.ALL_MODEL_MARK, name)):\n        try:\n            ds.get_Parameter(bip).Set(val)\n        except Exception:\n            pass\n    return ds\n\n\ndef tagged_shapes(doc, tag):\n    res = []\n    for e in FilteredElementCollector(doc).OfClass(DirectShape):\n        try:\n            c = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n            if c is not None and (c.AsString() or '') == tag:\n                res.append(e.Id)\n        except Exception:\n            pass\n    return res\n\n\ndef build_objects(doc, objs, M, s, H, z0, height_mm, tag):\n    \"\"\"objects (px boxes) -> 3D blocks at their size; stairs -> steps up to the wall height. -> counts by kind\"\"\"\n    made = {}\n    for o in objs:\n        a, b = M((o['x0'], o['y1'] + 1)), M((o['x1'] + 1, o['y0']))\n        x0, x1, y0, y1 = min(a.X, b.X), max(a.X, b.X), min(a.Y, b.Y), max(a.Y, b.Y)\n        try:\n            if o['kind'] == 'Stair':\n                n = max(2, int(o['steps']))\n                rise = height_mm * MMF / n\n                solids = []\n                for i in range(n):                        # treads across the run, each one riser higher\n                    if o.get('along_y'):\n                        t0 = y0 + (y1 - y0) * i / float(n)\n                        t1 = y0 + (y1 - y0) * (i + 1) / float(n)\n                        solids.append(_box(x0, t0, x1, t1, z0, rise * (i + 1)))\n                    else:\n                        t0 = x0 + (x1 - x0) * i / float(n)\n                        t1 = x0 + (x1 - x0) * (i + 1) / float(n)\n                        solids.append(_box(t0, y0, t1, y1, z0, rise * (i + 1)))\n                shape_3d(doc, 'generic', solids, 'Stair {0} steps'.format(n), tag)\n            else:\n                shape_3d(doc, o['cat'], [_box(x0, y0, x1, y1, z0, o['h'] * MMF)], o['kind'], tag)\n            made[o['kind']] = made.get(o['kind'], 0) + 1\n        except Exception as ex:\n            log('object {0}: {1}'.format(o['kind'], ex))\n    return made\n\n\n# ------------------------------------------------------------------ Revit: door swing as drawn, concrete columns, rooms, stairs\ndef _swing_arcs(e, view):\n    \"\"\"the swing arcs of a placed door as the plan view draws it -> [(centre XYZ = hinge, a point half way along the arc)]\"\"\"\n    out = []\n    try:\n        opt = Options()\n        opt.View = view\n        todo = [e.get_Geometry(opt)]\n        while todo:\n            geo = todo.pop()\n            if geo is None:\n                continue\n            for g in geo:\n                tn = g.GetType().Name\n                if tn == 'GeometryInstance':\n                    todo.append(g.GetInstanceGeometry())\n                elif tn == 'Arc':\n                    try:\n                        out.append((g.Center, g.Evaluate(0.5, True)))\n                    except Exception:\n                        pass\n    except Exception as ex:\n        log('swing: ' + str(ex))\n    return out\n\n\ndef fix_swing(doc, e, view, hinge, side):\n    \"\"\"turn the placed door so that it hangs and opens as in the picture (hinge, side = model points) ->\n    'ok' = matches the picture, 'facing' = opens to the right side (hinge side could not be checked), '' = not checked\"\"\"\n    try:\n        loc = e.Location.Point\n        hd = e.HandOrientation                            # along the wall\n        fd = e.FacingOrientation                          # across the wall\n\n        def sg(v):\n            return 1.0 if v >= 0 else -1.0\n        want_h = sg((hinge.X - loc.X) * hd.X + (hinge.Y - loc.Y) * hd.Y)\n        want_s = sg((side.X - loc.X) * fd.X + (side.Y - loc.Y) * fd.Y)\n        for attempt in range(2):\n            arcs = _swing_arcs(e, view)\n            if not arcs:\n                return ''\n            act_s = sg(sum((m.X - loc.X) * fd.X + (m.Y - loc.Y) * fd.Y for c, m in arcs))\n            single = len(arcs) == 1\n            act_h = sg((arcs[0][0].X - loc.X) * hd.X + (arcs[0][0].Y - loc.Y) * hd.Y) if single else want_h\n            fh, ff = swing_flips(act_h, act_s, want_h, want_s)\n            if not fh and not ff:\n                return 'ok' if single else 'facing'\n            if attempt:\n                return ''\n            if ff and e.CanFlipFacing:\n                e.flipFacing()\n            if fh and e.CanFlipHand:\n                e.flipHand()\n            doc.Regenerate()\n    except Exception as ex:\n        log('swing: ' + str(ex))\n    return ''\n\n\ndef column_type(doc, w, d, rnd, cache):\n    \"\"\"concrete structural column type C_<w>x<d>_CONC (round: C_D<w>_CONC) -> FamilySymbol or None\"\"\"\n    key = (int(w), int(d), bool(rnd))\n    if key in cache:\n        return cache[key]\n    name = 'C_D{0}_CONC'.format(key[0]) if rnd else 'C_{0}x{1}_CONC'.format(key[0], key[1])\n    words = ['ROUND'] if rnd else ['RECT', 'SQUARE']\n\n    def pick():\n        syms = _symbols(doc, BuiltInCategory.OST_StructuralColumns)\n        conc = [s for s in syms if 'CONC' in s.Family.Name.upper()]\n        good = [s for s in conc if any(k in s.Family.Name.upper() for k in words)]\n        return (good or ([] if rnd else conc) or [None])[0]\n    base = pick()\n    if base is None:\n        _lib_family(doc, ['Concrete-Round-Column'] if rnd else ['Concrete-Rectangular-Column', 'Concrete-Square-Column'])\n        base = pick()\n    if base is None and rnd:                              # no round family: a square one of the same size\n        s = column_type(doc, w, w, False, cache)\n        cache[key] = s\n        return s\n    if base is None:\n        cache[key] = None\n        return None\n    s = None\n    for sid in base.Family.GetFamilySymbolIds():\n        e = doc.GetElement(sid)\n        if ename(e) == name:\n            s = e\n            break\n    if s is None:\n        s = base.Duplicate(name)\n    if rnd:\n        _set_len(s, ['b', 'Diameter', 'd', 'D'], key[0])\n    else:\n        _set_len(s, ['b', 'Width', 'B'], key[0])\n        _set_len(s, ['h', 'Depth', 'H', 'd'], key[1])\n    try:\n        mp = s.get_Parameter(BuiltInParameter.STRUCTURAL_MATERIAL_PARAM)\n        if mp is not None and not mp.IsReadOnly:\n            mp.Set(material_id(doc, 'Concrete'))\n    except Exception:\n        pass\n    if not s.IsActive:\n        s.Activate()\n    cache[key] = s\n    return s\n\n\ndef make_columns(doc, cols, M, level, top, height_mm, tag):\n    \"\"\"concrete structural columns at the places and sizes read from the picture -> (made, as plain blocks, failures)\"\"\"\n    cache = {}\n    made = blocks = 0\n    fail = []\n    for c in cols:\n        pt = M((c['cx'], c['cy']))\n        try:\n            sym = column_type(doc, c['w'], c['d'], c['round'], cache)\n            if sym is None:                               # no concrete column family to be had: a plain concrete block\n                hw, hd = c['w'] * MMF / 2.0, c['d'] * MMF / 2.0\n                ds = DirectShape.CreateElement(doc, ElementId(BuiltInCategory.OST_StructuralColumns))\n                geo = List[GeometryObject]()\n                geo.Add(_box(pt.X - hw, pt.Y - hd, pt.X + hw, pt.Y + hd, level.Elevation, height_mm * MMF))\n                ds.SetShape(geo)\n                ds.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n                blocks += 1\n                continue\n            e = doc.Create.NewFamilyInstance(pt, sym, level, StructuralType.Column)\n            for bip, val in ((BuiltInParameter.FAMILY_BASE_LEVEL_PARAM, level.Id), (BuiltInParameter.FAMILY_BASE_LEVEL_OFFSET_PARAM, 0.0),\n                             (BuiltInParameter.FAMILY_TOP_LEVEL_PARAM, (top or level).Id),\n                             (BuiltInParameter.FAMILY_TOP_LEVEL_OFFSET_PARAM, 0.0 if top is not None else height_mm * MMF)):\n                try:\n                    p = e.get_Parameter(bip)\n                    if p is not None and not p.IsReadOnly:\n                        p.Set(val)\n                except Exception:\n                    pass\n            try:\n                mp = e.get_Parameter(BuiltInParameter.STRUCTURAL_MATERIAL_PARAM)\n                if mp is not None and not mp.IsReadOnly:\n                    mp.Set(material_id(doc, 'Concrete'))\n            except Exception:\n                pass\n            e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n            made += 1\n        except Exception as ex:\n            fail.append('column {0:.0f} x {1:.0f}: {2}'.format(c['w'], c['d'], (str(ex).splitlines() or ['?'])[0][:90]))\n    return made, blocks, fail[:4]\n\n\ndef level_above(doc, level):\n    ls = sorted((l for l in FilteredElementCollector(doc).OfClass(Level) if l.Elevation > level.Elevation + 1e-6),\n                key=lambda l: l.Elevation)\n    return ls[0] if ls else None\n\n\ndef rooms_floors(doc, level, tag, view, floors=True, keep=True, labels=None, min_m2=1.0):\n    \"\"\"Revit rooms in every closed space of the level; floors under them; rooms named from the names written in the\n    picture (labels = [(XYZ, text)]) and tagged -> dict(floors, rooms, named, unnamed [numbers], tags, note)\"\"\"\n    res = {'floors': 0, 'rooms': 0, 'named': [], 'unnamed': [], 'tags': 0, 'note': ''}\n    try:\n        phase = list(doc.Phases)[-1]\n        rids = list(doc.Create.NewRooms2(level, phase))\n    except Exception as ex:\n        log('rooms: ' + str(ex))\n        res['note'] = 'rooms could not be made: ' + (str(ex).splitlines() or ['?'])[0][:90]\n        return res\n    doc.Regenerate()\n    ft = None\n    if floors:\n        ft = doc.GetDefaultElementTypeId(ElementTypeGroup.FloorType)\n        if ft is None or ft == ElementId.InvalidElementId:\n            fts = list(FilteredElementCollector(doc).OfClass(FloorType))\n            ft = fts[0].Id if fts else None\n    opt = SpatialElementBoundaryOptions()\n    opt.SpatialElementBoundaryLocation = SpatialElementBoundaryLocation.Center     # slab runs under the walls\n    good = []\n    for rid in rids:\n        r = doc.GetElement(rid)\n        if r is None:\n            continue\n        try:\n            loops = List[CurveLoop]()\n            for seg_loop in r.GetBoundarySegments(opt):\n                cl = CurveLoop()\n                for sg in seg_loop:\n                    cl.Append(sg.GetCurve())\n                loops.Add(cl)\n            if loops.Count == 0:\n                continue\n            area = 0.0\n            for cl in loops:                              # shoelace over the boundary points (sq ft)\n                P = [c.GetEndPoint(0) for c in cl]\n                a = sum(P[i].X * P[(i + 1) % len(P)].Y - P[(i + 1) % len(P)].X * P[i].Y for i in range(len(P))) / 2.0\n                area = max(area, abs(a))\n            if area * 0.092903 < min_m2:\n                continue\n            good.append(r)\n            if ft is not None:\n                f = Floor.Create(doc, loops, ft, level.Id)\n                f.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n                res['floors'] += 1\n        except Exception as ex:\n            log('floor: ' + str(ex))\n    res['rooms'] = len(good)\n    keep_ids = set()\n    if keep:\n        z = level.Elevation + 1.0\n        for r in good:\n            names = []\n            spot = None\n            for pt, text in labels or []:\n                try:\n                    if r.IsPointInRoom(XYZ(pt.X, pt.Y, z)):\n                        names.append((round(-pt.Y, 1), pt.X, text))\n                        spot = spot or pt\n                except Exception:\n                    pass\n            try:\n                r.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n                if names:\n                    nm = ' '.join(t for y_, x_, t in sorted(names))[:120]\n                    r.get_Parameter(BuiltInParameter.ROOM_NAME).Set(nm)\n                    res['named'].append(nm)\n                else:\n                    res['unnamed'].append(str(r.get_Parameter(BuiltInParameter.ROOM_NUMBER).AsString() or '?'))\n                keep_ids.add(idv(r.Id))\n            except Exception as ex:\n                log('room name: ' + str(ex))\n                continue\n            try:\n                p = spot if spot is not None else r.Location.Point\n                doc.Create.NewRoomTag(LinkElementId(r.Id), UV(p.X, p.Y), view.Id)\n                res['tags'] += 1\n            except Exception as ex:\n                if not res['note']:\n                    res['note'] = 'room tags: ' + (str(ex).splitlines() or ['?'])[0][:90]\n    for rid in rids:                                      # rooms that are not kept (tiny spaces, or rooms not wanted) go again\n        try:\n            if idv(rid) not in keep_ids and doc.GetElement(rid) is not None:\n                doc.Delete(rid)\n        except Exception:\n            pass\n    return res\n\n\nB18_NS = {}\n\n\ndef stair_engine():\n    \"\"\"the B18 stair engine (b18_core.py: flights from tread lines, landings, railings) -> its namespace, or None\"\"\"\n    if B18_NS:\n        return B18_NS\n    src = globals().get('B18_SRC')\n    path = ''\n    if not src:\n        here = os.path.dirname(globals().get('__file__', '') or '')\n        for p in (os.path.join(here, 'b18_core.py'), os.path.join(os.path.dirname(here), 'B18 Stairs.pushbutton', 'b18_core.py')):\n            if os.path.isfile(p):\n                path = p\n                with open(p) as f:\n                    src = f.read()\n                break\n    if not src:\n        return None\n    ns = {'__name__': 'b18_core', '__file__': path}\n    exec(compile(src, path or 'b18_core', 'exec'), ns)\n    B18_NS.update(ns)\n    return B18_NS\n\n\ndef make_stairs(doc, level, top, height_mm, seg_sets, tread=300.0, riser=150.0, rails=True):\n    \"\"\"real Revit stairs where the picture shows them: seg_sets = per stair its straight lines in model mm.\n    Tread 300, riser <= 150: the number of risers comes from the floor-to-floor height. Uses its own transactions\n    (call it outside any open transaction) -> report lines\"\"\"\n    B = stair_engine()\n    if B is None:\n        return ['CHECK stairs not made: the stair engine b18_core.py was not found next to this tool']\n    out = []\n    H_mm = (top.Elevation - level.Elevation) / MMF if top is not None else float(height_mm)\n    plans = []\n    for segs in seg_sets:\n        try:\n            for order, how_dir in B['find_stairs'](segs):\n                rs = B['risers_fit'](order, H_mm, riser)\n                plans.append((order, rs, how_dir))\n        except Exception as ex:\n            log('stair lines: ' + str(ex))\n    if not plans:\n        return ['CHECK stairs: the tread lines in the picture could not be made into a flight (3 or more equal, evenly spaced lines needed)']\n    made = old_n = 0\n    tg = TransactionGroup(doc, 'B14 stairs')\n    tg.Start()\n    try:\n        old = B['old_stairs'](doc, level, [B['footprint'](p[0]) for p in plans])\n        if old:\n            def kill():\n                for i in old:\n                    try:\n                        doc.Delete(i)\n                    except Exception:\n                        pass\n            B['in_tx'](doc, 'B14 remove old stairs', kill)\n            old_n = len(old)\n        stype = B['in_tx'](doc, 'B14 stair type', lambda: B['stair_type'](doc, riser, tread, min(min(f['w'] for f in p[0]) for p in plans)))\n        rtype = B['railing_type'](doc) if rails else None\n        for k, (order, rs, how_dir) in enumerate(plans):\n            try:\n                del B['REVIT_ERRORS'][:]\n                sid, rh, notes = B['build_stair'](doc, level, top, H_mm * MMF, order, rs, tread, 0.0, stype,\n                                                  '{0}|B14|{1}|{2}'.format(B['TAG'], level.Name, k + 1))\n                made += 1\n                run_mm = sum((r - 1) * tread for r in rs)\n                drawn = sum(abs(f['s'][-1] - f['s'][0]) for f in order)\n                out.append('Stair {0}: {1} flight(s), {2} risers of {3:.0f} mm, tread {4:.0f} mm, width {5:.0f} mm, up by {6}{7}'.format(\n                    k + 1, len(order), sum(rs), H_mm / sum(rs), float(tread), min(f['w'] for f in order), how_dir,\n                    '; CHECK the flights are {0:.1f} m long, in the picture {1:.1f} m (the picture has fewer / other treads)'.format(\n                        run_mm / 1000.0, drawn / 1000.0) if abs(run_mm - drawn) > 2.0 * tread else ''))\n                if rtype is not None:\n                    try:\n                        if not list(doc.GetElement(sid).GetAssociatedRailings()):\n                            B['in_tx'](doc, 'B14 stair railings', lambda: B['Railing'].Create(\n                                doc, sid, rtype.Id, B['RailingPlacementPosition'].Treads))\n                    except Exception as ex:\n                        log('railing: ' + str(ex))\n            except Exception as ex:\n                why = B['REVIT_ERRORS'][-1] if B['REVIT_ERRORS'] else (str(ex).splitlines() or ['?'])[0]\n                out.append('CHECK stair {0}: Revit could not make it - {1}'.format(k + 1, str(why)[:140]))\n        tg.Assimilate()\n    except Exception as ex:\n        tg.RollBack()\n        return ['CHECK stairs not made: ' + (str(ex).splitlines() or ['?'])[0][:140]]\n    out.insert(0, 'Stairs: {0} real Revit stair(s) made (tread {1:.0f}, riser not over {2:.0f}, floor to floor {3:.0f} mm){4}'.format(\n        made, float(tread), float(riser), H_mm, ', {0} old one(s) replaced'.format(old_n) if old_n else ''))\n    return out\n\n\nSHAFT_TAG = 'B14 SHAFT|'\n\n\ndef line_xs(doc, view, tol_mm=30.0):\n    \"\"\"two straight lines crossing corner to corner (an X: equal length, same middle) in the plan view\n       -> [[4 corner XYZ]]  - symbolic / detail / model lines\"\"\"\n    segs = []\n    if view is None:\n        return []\n    for e in FilteredElementCollector(doc, view.Id).OfClass(CurveElement):\n        try:\n            c = e.GeometryCurve\n            if c is None or not c.IsBound or tname_of(c) != 'Line':\n                continue\n            p, q = c.GetEndPoint(0), c.GetEndPoint(1)\n            L = p.DistanceTo(q)\n            if L * 304.8 >= 300.0:\n                segs.append((p, q, L, XYZ((p.X + q.X) / 2.0, (p.Y + q.Y) / 2.0, 0.0)))\n        except Exception:\n            pass\n        if len(segs) > 4000:\n            break\n    tol = tol_mm * MMF\n    out, used = [], set()\n    for i in range(len(segs)):\n        if i in used:\n            continue\n        p1, q1, L1, m1 = segs[i]\n        for j in range(i + 1, len(segs)):\n            if j in used:\n                continue\n            p2, q2, L2, m2 = segs[j]\n            if abs(L1 - L2) > tol or m1.DistanceTo(m2) > tol:\n                continue\n            d1 = (q1 - p1).Normalize()\n            d2 = (q2 - p2).Normalize()\n            if abs(d1.X * d2.Y - d1.Y * d2.X) < 0.2:          # parallel: not an X\n                continue\n            used.add(i)\n            used.add(j)\n            out.append([p1, p2, q1, q2])                     # corners in turn around the box\n            break\n    return out\n\n\ndef make_shaft(doc, level, corners, height_mm, tag, below_mm=500.0):\n    \"\"\"Revit shaft opening through the floors: from below this level's slab up to the next level (or the height)\"\"\"\n    xs_, ys_ = [p.X for p in corners], [p.Y for p in corners]\n    tol = 30.0 * MMF\n    for o in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_ShaftOpening).WhereElementIsNotElementType():\n        try:                                              # same place already has a shaft: keep it (run again = no doubles)\n            bb = o.get_BoundingBox(None)\n            if abs(bb.Min.X - min(xs_)) < tol and abs(bb.Max.X - max(xs_)) < tol and                     abs(bb.Min.Y - min(ys_)) < tol and abs(bb.Max.Y - max(ys_)) < tol:\n                return o\n        except Exception:\n            pass\n    levels = sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)\n    up = next((l for l in levels if l.Elevation > level.Elevation + 1e-6), None)\n    z = level.Elevation\n    pts = [XYZ(p.X, p.Y, z) for p in corners]\n    ca = CurveArray()\n    for i in range(len(pts)):\n        ca.Append(Line.CreateBound(pts[i], pts[(i + 1) % len(pts)]))\n    op = doc.Create.NewOpening(level, up if up is not None else level, ca)\n    for bip, val in ((BuiltInParameter.WALL_BASE_OFFSET, -below_mm * MMF),):\n        try:\n            op.get_Parameter(bip).Set(val)\n        except Exception:\n            pass\n    if up is None:\n        try:\n            op.get_Parameter(BuiltInParameter.WALL_HEIGHT_TYPE).Set(ElementId.InvalidElementId)\n            op.get_Parameter(BuiltInParameter.WALL_USER_HEIGHT_PARAM).Set((height_mm + below_mm) * MMF)\n        except Exception:\n            pass\n    try:\n        op.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n    except Exception:\n        pass\n    return op\n\n\ndef shafts_from_lines(doc, uidoc, level_name='', height_mm=3000.0):\n    \"\"\"no picture needed: every X drawn with lines in the open plan -> shaft opening.  Run again = replaced.\"\"\"\n    view = plan_view(doc, uidoc)\n    if view is None:\n        raise Exception('Open a floor plan first.')\n    level = pick_level(doc, view, level_name)\n    xs = line_xs(doc, view)\n    tag = SHAFT_TAG + 'lines|' + view.Name\n    st = {'n': 0, 'fail': []}\n\n    def work():\n        for i in tagged(doc, BuiltInCategory.OST_ShaftOpening, tag):\n            try:\n                doc.Delete(i)\n            except Exception:\n                pass\n        for cs in xs:\n            try:\n                make_shaft(doc, level, cs, height_mm, tag)\n                st['n'] += 1\n            except Exception as ex:\n                st['fail'].append((str(ex).splitlines() or ['?'])[0][:90])\n    in_tx(doc, 'B14 shaft openings from lines', work)\n    out = ['{0} shaft opening(s) from X lines in \"{1}\" (level {2}) - a shaft already in the same place is kept, not doubled'.format(st['n'], view.Name, level.Name)]\n    if not xs:\n        out.append('CHECK no X found: draw the shaft box with two lines corner to corner (symbolic / detail / model lines)')\n    for f_ in st['fail'][:5]:\n        out.append('CHECK shaft: ' + f_)\n    log('\\n'.join(out))\n    return out\n\n\n# ------------------------------------------------------------------ the whole job\ndef run(doc, uidoc, path, scale_text='WALL 230', page=1, height=3000.0, level_name='', material='Brick',\n        openings=True, door_h=2100.0, win_h=1200.0, sill=900.0, underlay=True, make=True, line_px=None,\n        before_build=None, open_3d=True, floors=True, objects=False, shafts=True, dims=None, grids=True, columns=True, rooms=True, stairs=True):\n    \"\"\"-> (report lines, info).  line_px = length in picture px of the user's LINE (pyRevit picks it);\n       otherwise LINE uses the line selected in Revit over the picture already placed by a first run.\"\"\"\n    out = []\n    info = {}\n    img, paper, how = raster(path, page)\n    if how:\n        out.append(how)\n    rows, W, H, orows, f = load_ink(img)\n    cands = [(INK_THR[0], rows)] + sorted(LAST_INK.items(), reverse=True)\n    words = ocr_words(img)\n    name_words = list(words)                              # for the room names\n    only = 'ONLY' in str(scale_text).upper()\n    bad_pic = picture_check(rows)\n    gr = find_grids(img, LAST_MARK, f) if (grids and not bad_pic) else {'v': [], 'h': []}\n    dm = dims if dims is not None else ({'dims': [], 'sc': None, 'd1': None} if (only or bad_pic) else find_dims(img, rows, f))\n    words = words + [(int(d['box'][0] / f), int(d['box'][1] / f), int((d['box'][2] - d['box'][0] + 1) / f) + 1,\n                      int((d['box'][3] - d['box'][1] + 1) / f) + 1, d.get('txt', '')) for d in dm['dims'] if d.get('vals')]\n    if gr['v'] or gr['h']:                                # grid lines and bubbles are not walls / furniture\n        cands = [(t_, mask_grids(r_, gr)) for t_, r_ in cands]\n        rows = cands[0][1]\n        orows = mask_grids(orows, gr)\n    raw_ink = dict(cands)                                 # before the text is rubbed out (OCR also \"reads\" round columns)\n    if words:                                             # letters are not walls / furniture\n        cands = [(t_, mask_words(r_, words, f)) for t_, r_ in cands]\n        rows = cands[0][1]\n        orows_walls = mask_words(orows, words, f)\n        orows = mask_words(orows, text_zone(words), f)\n        out.append('Text read and left out: ' + ' '.join(w[4] for w in words[:14]) + (' ...' if len(words) > 14 else ''))\n    info.update({'image': img, 'W': W, 'H': H, 'words': words, 'dims': dm, 'grids': gr})\n    view = plan_view(doc, uidoc)\n    if view is None:\n        raise Exception('Open a floor plan first.')\n    level = pick_level(doc, view, level_name)\n    inst = find_underlay(doc, view, img)\n    mode, value = parse_scale(scale_text)\n    if mode == 'LINE' and not line_px:\n        L = selected_line_mm(doc, uidoc)\n        if L and inst is not None:\n            line_px = L / (underlay_geom(inst)[1] / W)\n        elif inst is None:\n            out.append('CHECK LINE: run once to place the picture, draw a detail line over a dimension on it, select the line, run again')\n        else:\n            out.append('CHECK LINE: select the line you drew over the dimension / scale bar, then run again')\n    try:\n        if bad_pic:\n            raise NotPlaced([bad_pic])\n        res, thr, rows = decide(cands, dm, scale_text, line_px, paper, orows_walls if words else orows)\n    except NotPlaced as ex:                               # no scale that can be trusted: nothing goes into Revit\n        out = ['NOT PLACED - nothing was put into Revit'] + ex.lines + out\n        info['not_placed'] = True\n        try:\n            if dm.get('d1') is not None:\n                info['preview'] = dims_preview(img, dm, os.path.join(_tmpdir(), 'B14_dims_' + os.path.splitext(os.path.basename(img))[0] + '.png'), W, H)\n                out.append('Picture with dimension D1 marked: ' + info['preview'])\n        except Exception as ex2:\n            log('dims preview: ' + str(ex2))\n        log('\\n'.join(out))\n        return out, info\n    out = res['how'] + out\n    s = res['s']\n    out.extend(dim_fit(res, dm.get('sc') if res.get('dim_s') else None))\n    res['dm'] = dm\n    res['gr'] = gr\n    mx, my = res['mx'], res['my']\n    my_h = my(H)\n    if gr['v'] or gr['h']:\n        grid_fit(gr, res)\n        out.extend(grid_report(gr))\n    res['objects'] = []\n    if objects or stairs or shafts:                       # objects = furniture blocks (off: the user does not want them)\n        try:\n            res['objects'] = [o for o in find_objects(orows, rows, res['walls'], s, W, H)\n                              if (o['kind'] == 'Stair' and stairs) or (o['kind'] == 'Shaft' and shafts) or\n                              (o['kind'] not in ('Stair', 'Shaft') and objects)]\n        except Exception as ex:\n            out.append('CHECK stairs / shafts not read: ' + str(ex))\n    # ---- the rest of the picture is read before anything is built\n    found = []\n    res['columns'] = []\n    if columns:\n        try:\n            res['columns'] = find_columns(raw_ink.get(thr, rows), plan_facts(res)['top_px'], s, res['walls'], gr)\n            found.extend(column_report(res['columns']))\n        except Exception as ex:\n            out.append('CHECK columns not read: ' + str(ex))\n    if openings:\n        try:\n            n_read, n_guess, n_doors = read_swings(res['walls'], orows_walls if words else orows)\n            if n_doors:\n                found.append('Door swings: {0} of {1} doors have their leaf read from the picture{2}{3}'.format(\n                    n_read, n_doors, ', {0} more from the side the arc is on'.format(n_guess) if n_guess else '',\n                    '; the other {0} are left as Revit places them'.format(n_doors - n_read - n_guess)\n                    if n_doors - n_read - n_guess else ''))\n        except Exception as ex:\n            out.append('CHECK door swings not read: ' + str(ex))\n    res['labels'] = []\n    if rooms:\n        try:\n            res['labels'] = [(x * f, y * f, t) for x, y, t in room_labels(name_words)]\n            found.append('Room names read in the picture: ' + (', '.join(t for x, y, t in res['labels'][:30]) or\n                                                               'none (no names, or text under 9 px high)'))\n        except Exception as ex:\n            out.append('CHECK room names not read: ' + str(ex))\n    res['stair_segs'] = []\n    if stairs:\n        for o in res['objects']:\n            if o['kind'] == 'Stair':\n                try:\n                    res['stair_segs'].append(stair_segments(rows, (o['x0'], o['y0'], o['x1'], o['y1']), s))\n                except Exception as ex:\n                    log('stair lines: ' + str(ex))\n        if res['stair_segs']:\n            found.append('Stairs in the picture: {0} (real stairs, tread 300, riser 150)'.format(len(res['stair_segs'])))\n    out.extend(found)\n    info['res'] = res\n    try:\n        tmp = os.path.join(os.environ.get('TEMP', ''), 'PLAN2BIM')\n        if not os.path.isdir(tmp):\n            os.makedirs(tmp)\n        info['preview'] = preview(img, res, os.path.join(tmp, 'B14_preview_' + os.path.splitext(os.path.basename(img))[0] + '.png'), W, H)\n        out.append('Walls marked on the plan: ' + info['preview'])\n    except Exception as ex:\n        log('preview: ' + str(ex))\n    out.insert(0, summary(res))\n    if not make:\n        out.insert(0, 'ONLY READ (Make it = False): nothing built')\n        return out, info\n    if before_build is not None and not before_build(out, info):\n        out.insert(0, 'Cancelled: nothing built')\n        return out, info\n    tag = TAG + os.path.basename(path)\n    origin = underlay_geom(inst)[0] if inst is not None else XYZ(0, 0, level.Elevation)\n    ox, oy = origin.X / MMF, origin.Y / MMF\n\n    def M(p):                                             # picture px -> model (exact on the dimension points)\n        return XYZ((ox + mx(p[0])) * MMF, (oy + my_h - my(p[1])) * MMF, level.Elevation)\n\n    def MM(p):                                            # mm from the picture's top left corner -> model\n        return XYZ((ox + p[0]) * MMF, (oy + my_h - p[1]) * MMF, level.Elevation)\n    st = {'walls': [], 'skip': [], 'ops': 0, 'fail': [], 'nops': 0, 'sw': [], 'swres': {}}\n    top_level = level_above(doc, level)\n    ltag = SHAFT_TAG + 'lines|' + view.Name\n    xs_lines = line_xs(doc, view) if shafts else []\n    wt_cache, op_cache = {}, {}\n\n    def work():\n        if underlay:\n            try:\n                place_underlay(doc, view, img, W * s, origin, inst)\n            except Exception as ex:\n                out.append('CHECK picture not placed: ' + (str(ex).splitlines() or ['?'])[0])\n        for i in tagged(doc, BuiltInCategory.OST_Rooms, tag) + tagged(doc, BuiltInCategory.OST_StructuralColumns, tag) + \\\n                tagged(doc, BuiltInCategory.OST_Doors, tag) + tagged(doc, BuiltInCategory.OST_Windows, tag) + \\\n                tagged(doc, BuiltInCategory.OST_Floors, tag) + tagged_shapes(doc, tag) + tagged(doc, BuiltInCategory.OST_Walls, tag) + \\\n                tagged(doc, BuiltInCategory.OST_ShaftOpening, tag) + tagged(doc, BuiltInCategory.OST_ShaftOpening, ltag):\n            try:\n                doc.Delete(i)\n            except Exception:\n                pass\n        if gr['v'] or gr['h']:\n            st['grids'] = make_grids(doc, gr, MM, tag)\n        if res['columns']:\n            st['cols'] = make_columns(doc, res['columns'], M, level, top_level, height, tag)\n        for w in res['walls']:\n            try:\n                wl = Wall.Create(doc, Line.CreateBound(MM(w['pm']), MM(w['qm'])), wall_type(doc, w['mm'], material, wt_cache).Id,\n                                 level.Id, height * MMF, 0.0, False, False)\n            except Exception as ex:\n                st['skip'].append((str(ex).splitlines() or ['?'])[0][:80])\n                continue\n            try:\n                wl.get_Parameter(BuiltInParameter.WALL_KEY_REF_PARAM).Set(0)\n            except Exception:\n                pass\n            wl.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n            st['walls'].append((wl, w))\n        doc.Regenerate()\n        if openings:\n            put_openings()\n            if st['sw']:                                  # doors hung and opening as drawn in the picture\n                doc.Regenerate()\n                for e_, o_ in st['sw']:\n                    r_ = fix_swing(doc, e_, view, M(o_['hinge']), M(o_['side']))\n                    st['swres'][r_] = st['swres'].get(r_, 0) + 1\n        if floors or rooms:\n            doc.Regenerate()\n            st['rr'] = rooms_floors(doc, level, tag, view, floors, rooms, [(M((x, y)), t) for x, y, t in res['labels']])\n            st['floors'], st['rooms'] = st['rr']['floors'], st['rr']['rooms']\n        objs = [o for o in res['objects'] if o['kind'] not in ('Shaft', 'Stair')]\n        if objs:\n            st['objs'] = build_objects(doc, objs, M, s, H, level.Elevation, height, tag)\n        if shafts:\n            st['sh_img'] = st['sh_lin'] = 0\n            for o in res['objects']:\n                if o['kind'] != 'Shaft':\n                    continue\n                try:\n                    make_shaft(doc, level, [M((o['x0'], o['y1'] + 1)), M((o['x1'] + 1, o['y1'] + 1)),\n                                            M((o['x1'] + 1, o['y0'])), M((o['x0'], o['y0']))], height, tag)\n                    st['sh_img'] += 1\n                except Exception as ex:\n                    st['fail'].append('shaft: ' + (str(ex).splitlines() or ['?'])[0][:90])\n            for cs in xs_lines:\n                try:\n                    make_shaft(doc, level, cs, height, ltag)\n                    st['sh_lin'] += 1\n                except Exception as ex:\n                    st['fail'].append('shaft (lines): ' + (str(ex).splitlines() or ['?'])[0][:90])\n\n    def put_openings():\n        for wl, w in st['walls']:\n            for o in w['ops']:\n                st['nops'] += 1\n                wmm = max(600.0, round(o['w'] * s / 10.0) * 10.0)\n                try:\n                    sym = opening_type(doc, o['kind'], wmm, door_h if o['kind'] == 'door' else win_h, op_cache)\n                    e = doc.Create.NewFamilyInstance(M(o['c']), sym, wl, level, StructuralType.NonStructural)\n                    if o['kind'] == 'window':\n                        p = e.get_Parameter(BuiltInParameter.INSTANCE_SILL_HEIGHT_PARAM)\n                        if p is not None and not p.IsReadOnly:\n                            p.Set(sill * MMF)\n                    e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n                    st['ops'] += 1\n                    if o['kind'] == 'door' and o.get('swing'):\n                        st['sw'].append((e, o))\n                except Exception as ex:\n                    st['fail'].append('{0} {1:.0f}: {2}'.format(o['kind'], wmm, (str(ex).splitlines() or ['?'])[0][:90]))\n\n    in_tx(doc, 'B14 3D walls from plan', work)\n    stair_lines = []\n    if stairs and res['stair_segs']:                      # real stairs: the stair engine works in its own transactions\n        try:\n            sets = [[((ox + mx(a[0]), oy + my_h - my(a[1])), (ox + mx(b[0]), oy + my_h - my(b[1]))) for a, b in sg]\n                    for sg in res['stair_segs']]\n            stair_lines = make_stairs(doc, level, top_level, height, sets)\n        except Exception as ex:\n            stair_lines = ['CHECK stairs not made: ' + (str(ex).splitlines() or ['?'])[0][:140]]\n    out.append('Built on level \"{0}\", height {1:.0f} mm: {2} walls{3}{4}'.format(\n        level.Name, float(height), len(st['walls']), ', {0} of {1} doors / windows'.format(st['ops'], st['nops']) if openings else '',\n        ', floors in {0} of {1} closed rooms'.format(st.get('floors', 0), st.get('rooms', 0)) if floors else ''))\n    if st.get('cols'):\n        cm, cb, cf = st['cols']\n        out.append('Columns: {0} concrete structural columns made{1} (level \"{2}\" to {3})'.format(\n            cm, ', {0} as plain concrete blocks because no concrete column family could be loaded'.format(cb) if cb else '',\n            level.Name, '\"{0}\"'.format(top_level.Name) if top_level is not None else '{0:.0f} mm high'.format(float(height))))\n        st['fail'].extend(cf)\n    if st['sw']:\n        sw = st['swres']\n        out.append('Door swings: {0} doors checked against the picture - {1} hang and open as drawn{2}{3}'.format(\n            len(st['sw']), sw.get('ok', 0),\n            ', {0} double doors open to the drawn side'.format(sw.get('facing', 0)) if sw.get('facing') else '',\n            '; CHECK {0} could not be checked (no swing arc in the door family as this view shows it)'.format(sw.get('', 0))\n            if sw.get('') else ''))\n    if rooms and st.get('rr'):\n        rr = st['rr']\n        out.append('Rooms: {0} made, {1} named from the picture ({2}), {3} room tags{4}{5}'.format(\n            len(rr['named']) + len(rr['unnamed']), len(rr['named']), ', '.join(rr['named'][:20]) or '-', rr['tags'],\n            '; no name could be read for room number(s) {0}'.format(', '.join(rr['unnamed'][:20])) if rr['unnamed'] else '',\n            '; CHECK ' + rr['note'] if rr['note'] else ''))\n    out.extend(stair_lines)\n    if shafts and (st.get('sh_img') or st.get('sh_lin')):\n        out.append('Shaft openings: {0} from X boxes in the picture, {1} from X lines in the plan'.format(\n            st.get('sh_img', 0), st.get('sh_lin', 0)))\n    if st.get('grids'):\n        made, kept, gfail = st['grids']\n        out.append('Grids: {0} made{1}{2}'.format(\n            len(made), ' (' + ', '.join(made[:40]) + ')' if made else '',\n            '; {0} not made because the project already has a grid of that name: {1}'.format(len(kept), ', '.join(kept[:40])) if kept else ''))\n        st['fail'].extend(gfail)\n    if st.get('objs'):\n        out.append('3D blocks from the picture: ' + ', '.join('{0} {1}'.format(v, k) for k, v in sorted(st['objs'].items())) +\n                   ' (sizes from the picture; Furniture / Plumbing Fixtures / Generic Model, Mark = what it looks like)')\n    if underlay:\n        out.append('Plan picture under the walls in \"{0}\" at true scale ({1:.1f} x {2:.1f} m) - check it lines up'.format(\n            view.Name, W * s / 1000.0, H * s / 1000.0))\n    if st['skip']:\n        out.append('CHECK {0} wall(s) Revit refused: {1}'.format(len(st['skip']), '; '.join(st['skip'][:3])))\n    for f_ in st['fail'][:6]:\n        out.append('CHECK ' + f_)\n    out.append('Wall types: ' + ', '.join(sorted(set(ename(t) for t in wt_cache.values()))))\n    out.append('Run again = walls / doors / windows from this plan are replaced (Comments = \"{0}\")'.format(tag))\n    if open_3d:\n        try:\n            v3 = in_tx(doc, 'B14 3D view', lambda: view_3d(doc, 'B14 3D - ' + os.path.splitext(os.path.basename(path))[0][:60]))\n            info['view3d'] = v3\n            out.append('3D view: \"{0}\"'.format(v3.Name))\n        except Exception as ex:\n            out.append('CHECK 3D view: ' + (str(ex).splitlines() or ['?'])[0])\n    log('\\n'.join(out))\n    return out, info\n\n\nB18_SRC = '# -*- coding: utf-8 -*-\\n# =====================================================================\\n#  B18 STAIRS FROM REVIT LINES OR CAD LINES   (Revit 2026)   v1\\n#  The stair drawn in the open floor plan -> real Revit stairs (runs + landings + railings)\\n#    - REVIT: model / detail lines in the plan (selected lines only, if lines are selected)\\n#    - CAD:   lines / polylines of a DWG linked or imported in the plan (optional layer filter)\\n#  A flight = 3+ parallel, equally long, evenly spaced tread (riser) lines.  Every line = one riser,\\n#  a longer landing / floor edge line just after the last tread line is the last riser.\\n#  Flights close to each other = one stair, joined by landings.  Walk line arrow -> the UP end.\\n#  Base = level of the plan, top = next level (or the top level / height you give).\\n#  Riser count + width + tread from the lines, riser height = level-to-level height / risers (checked).\\n#  Run again = the B18 stairs in the same place are replaced (no doubles).  One undo (Ctrl+Z).\\n#  PREVIEW (make = False) builds everything, reports, then rolls it back.\\n#  Runs in pyRevit (IronPython 2.7) and Dynamo CPython3.\\n# =====================================================================\\nimport math, os\\n\\nimport clr\\nclr.AddReference(\\'RevitAPI\\')\\nfrom Autodesk.Revit.DB import *                           # noqa\\nfrom Autodesk.Revit.DB.Architecture import Stairs, StairsRun, StairsLanding, StairsType, StairsRunJustification, \\\\\\n    Railing, RailingType, RailingPlacementPosition       # noqa\\n\\nMMF = 1.0 / 304.8\\nLOG = os.path.join(os.environ.get(\\'APPDATA\\', \\'\\'), \\'pyRevit\\', \\'B18_stairs_log.txt\\')\\nTAG = \\'B18 STAIR\\'\\nTYPE_NAME = \\'B18 Stair\\'\\n\\n\\ndef log(msg):\\n    try:\\n        with open(LOG, \\'a\\') as f:\\n            f.write(str(msg) + \\'\\\\n\\')\\n    except Exception:\\n        pass\\n\\n\\ndef tname_of(o):\\n    try:\\n        return o.GetType().Name\\n    except Exception:\\n        return type(o).__name__\\n\\n\\ndef idv(eid):\\n    try:\\n        return eid.Value\\n    except Exception:\\n        return eid.IntegerValue\\n\\n\\ndef type_name(t):\\n    try:\\n        p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\\n        if p is not None and p.AsString():\\n            return p.AsString()\\n    except Exception:\\n        pass\\n    try:\\n        return Element.Name.__get__(t)\\n    except Exception:\\n        try:\\n            return t.Name\\n        except Exception:\\n            return \\'\\'\\n\\n\\ndef plan_view(doc, uidoc):\\n    try:\\n        v = uidoc.ActiveView if uidoc is not None else doc.ActiveView\\n    except Exception:\\n        v = doc.ActiveView\\n    if v is not None and tname_of(v) == \\'ViewPlan\\' and not v.IsTemplate:\\n        return v\\n    try:\\n        for uv in uidoc.GetOpenUIViews():\\n            ov = doc.GetElement(uv.ViewId)\\n            if ov is not None and tname_of(ov) == \\'ViewPlan\\' and not ov.IsTemplate:\\n                return ov\\n    except Exception:\\n        pass\\n    return None\\n\\n\\ndef levels_of(doc):\\n    return sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)\\n\\n\\ndef find_level(doc, name):\\n    if not name:\\n        return None\\n    lv = levels_of(doc)\\n    for l in lv:\\n        if l.Name.strip().upper() == str(name).strip().upper():\\n            return l\\n    for l in lv:\\n        if str(name).strip().upper() in l.Name.upper():\\n            return l\\n    raise Exception(\\'No level \"{0}\". Levels: {1}\\'.format(name, \\', \\'.join(l.Name for l in lv)))\\n\\n\\n# ------------------------------------------------------------------ lines in the plan (Revit + CAD) -> 2D segments in mm\\ndef _seg(p, q):\\n    return ((p.X / MMF, p.Y / MMF), (q.X / MMF, q.Y / MMF))\\n\\n\\nLINE_KINDS = (\\'ModelLine\\', \\'DetailLine\\', \\'SymbolicCurve\\', \\'ModelCurve\\', \\'DetailCurve\\')\\n\\n\\ndef selected_ids(uidoc):\\n    try:\\n        return [i for i in uidoc.Selection.GetElementIds()]\\n    except Exception:\\n        return []\\n\\n\\ndef revit_segments(doc, view, style=\\'\\', only=None):\\n    out = []\\n    src = [doc.GetElement(i) for i in only] if only else FilteredElementCollector(doc, view.Id).OfClass(CurveElement)\\n    for e in src:\\n        try:\\n            if e is None or tname_of(e) not in LINE_KINDS:\\n                continue\\n            if style and style.upper() not in (e.LineStyle.Name if e.LineStyle is not None else \\'\\').upper():\\n                continue\\n            c = e.GeometryCurve\\n            if c is not None and c.IsBound and tname_of(c) == \\'Line\\':\\n                out.append(_seg(c.GetEndPoint(0), c.GetEndPoint(1)))\\n        except Exception:\\n            pass\\n    return out\\n\\n\\ndef _walk(geo, tf, out, layer_word, doc):\\n    for g in geo:\\n        n = tname_of(g)\\n        if n == \\'GeometryInstance\\':\\n            _walk(g.GetSymbolGeometry(), tf.Multiply(g.Transform), out, layer_word, doc)\\n            continue\\n        if layer_word:\\n            try:\\n                gs = doc.GetElement(g.GraphicsStyleId)\\n                nm = gs.GraphicsStyleCategory.Name if gs is not None else \\'\\'\\n                if layer_word.upper() not in nm.upper():\\n                    continue\\n            except Exception:\\n                continue\\n        if n == \\'Line\\':\\n            out.append(_seg(tf.OfPoint(g.GetEndPoint(0)), tf.OfPoint(g.GetEndPoint(1))))\\n        elif n == \\'PolyLine\\':\\n            pts = [tf.OfPoint(p) for p in g.GetCoordinates()]\\n            for a, b in zip(pts, pts[1:]):\\n                out.append(_seg(a, b))\\n\\n\\ndef cad_segments(doc, view, layer=\\'\\', only=None):\\n    out = []\\n    opt = Options()\\n    opt.View = view\\n    src = [doc.GetElement(i) for i in only] if only else FilteredElementCollector(doc, view.Id).OfClass(ImportInstance)\\n    for ii in src:\\n        if ii is None or tname_of(ii) != \\'ImportInstance\\':\\n            continue\\n        try:\\n            _walk(ii.get_Geometry(opt), Transform.Identity, out, layer, doc)\\n        except Exception as ex:\\n            log(\\'cad: \\' + str(ex))\\n    return out\\n\\n\\n# ------------------------------------------------------------------ stair finding (all in mm)\\ndef _len(s):\\n    return math.hypot(s[1][0] - s[0][0], s[1][1] - s[0][1])\\n\\n\\ndef _ang(s):\\n    (x0, y0), (x1, y1) = s\\n    return math.degrees(math.atan2(y1 - y0, x1 - x0)) % 180.0\\n\\n\\ndef _adiff(a, b):\\n    return abs(((a - b + 90.0) % 180.0) - 90.0)\\n\\n\\ndef _merge_collinear(segs, ang_tol=1.0, off_tol=15.0, gap=100.0):\\n    \"\"\"join pieces of one tread line that a walk line / arrow / CAD export split; drop exact copies\"\"\"\\n    groups = {}\\n    for s in segs:\\n        if _len(s) < 1.0:\\n            continue\\n        a = round(_ang(s) / ang_tol) * ang_tol % 180.0\\n        t = math.radians(a)\\n        d = (math.cos(t), math.sin(t))\\n        n = (-d[1], d[0])\\n        off = s[0][0] * n[0] + s[0][1] * n[1]\\n        key = (a, int(round(off / off_tol)))\\n        t0 = s[0][0] * d[0] + s[0][1] * d[1]\\n        t1 = s[1][0] * d[0] + s[1][1] * d[1]\\n        groups.setdefault(key, []).append((min(t0, t1), max(t0, t1), off, d, n))\\n    out = []\\n    for key, iv in groups.items():\\n        iv.sort(key=lambda x: (x[0], x[1]))\\n        cur = list(iv[0])\\n        offs = [cur[2]]\\n        for a, b, off, d, n in iv[1:]:\\n            # pieces split by a walk line join; two full-width flights side by side (dog-leg) stay apart\\n            if a <= cur[1] + 1.0 or (a <= cur[1] + gap and max(cur[1] - cur[0], b - a) < 750.0):\\n                cur[1] = max(cur[1], b)\\n                offs.append(off)\\n            else:\\n                out.append((cur, sum(offs) / len(offs)))\\n                cur = [a, b, off, d, n]\\n                offs = [off]\\n        out.append((cur, sum(offs) / len(offs)))\\n    res = []\\n    for (a, b, _, d, n), off in out:\\n        res.append(((d[0] * a + n[0] * off, d[1] * a + n[1] * off), (d[0] * b + n[0] * off, d[1] * b + n[1] * off)))\\n    return res\\n\\n\\ndef find_flights(segs, tmin=100.0, tmax=450.0, wmin=600.0, wmax=3500.0, min_lines=3, max_lines=25):\\n    \"\"\"flights = >= min_lines parallel, equally long, evenly spaced, overlapping lines (the risers)\\n    that are NOT crossed by many perpendicular lines (that would be a tile grid / hatch)\"\"\"\\n    merged = _merge_collinear(segs)\\n    lines = [s for s in merged if wmin <= _len(s) <= wmax]\\n    by_ang = {}\\n    for s in lines:\\n        by_ang.setdefault(int(round(_ang(s))) % 180, []).append(s)\\n    flights, used = [], set()\\n    for a, ss in by_ang.items():\\n        t = math.radians(a)\\n        v = (math.cos(t), math.sin(t))\\n        u = (-v[1], v[0])                                 # v along the tread, u = walking direction\\n        info = []\\n        for s in ss:\\n            s0 = s[0][0] * u[0] + s[0][1] * u[1]\\n            l0 = s[0][0] * v[0] + s[0][1] * v[1]\\n            l1 = s[1][0] * v[0] + s[1][1] * v[1]\\n            info.append((s0, min(l0, l1), max(l0, l1), s))\\n        info.sort(key=lambda i: i[0])\\n        perp = None\\n        for i0 in range(len(info)):\\n            if id(info[i0][3]) in used:\\n                continue\\n            chain = [info[i0]]\\n            for j in range(i0 + 1, len(info)):\\n                cand = info[j]\\n                if id(cand[3]) in used:\\n                    continue\\n                last = chain[-1]\\n                gap = cand[0] - last[0]\\n                if gap < tmin:\\n                    continue\\n                if gap > tmax:\\n                    break\\n                L1, L2 = last[2] - last[1], cand[2] - cand[1]\\n                ov = min(last[2], cand[2]) - max(last[1], cand[1])\\n                if abs(L1 - L2) > 0.1 * max(L1, L2) or ov < 0.85 * min(L1, L2):\\n                    continue\\n                if len(chain) >= 2:\\n                    sp = chain[1][0] - chain[0][0]\\n                    if abs(gap - sp) > max(10.0, 0.06 * sp):\\n                        continue\\n                chain.append(cand)\\n            if len(chain) > max_lines:                    # far too many = a hatch, not a stair\\n                for c in chain:\\n                    used.add(id(c[3]))\\n                continue\\n            if len(chain) < min_lines:\\n                continue\\n            pos = [c[0] for c in chain]\\n            lo = sorted(c[1] for c in chain)[len(chain) // 2]\\n            hi = sorted(c[2] for c in chain)[len(chain) // 2]\\n            if perp is None:                              # tile grid / hatch test\\n                perp = []\\n                for q in merged:\\n                    if _adiff(_ang(q), a) > 88.0:\\n                        q0 = q[0][0] * u[0] + q[0][1] * u[1]\\n                        q1 = q[1][0] * u[0] + q[1][1] * u[1]\\n                        lat = q[0][0] * v[0] + q[0][1] * v[1]\\n                        perp.append((min(q0, q1), max(q0, q1), lat))\\n            span = pos[-1] - pos[0]\\n            cross = sum(1 for q0, q1, lat in perp\\n                        if lo + 50 < lat < hi - 50 and min(q1, pos[-1]) - max(q0, pos[0]) > 0.5 * span)\\n            if cross > 2:\\n                continue\\n            for c in chain:\\n                used.add(id(c[3]))\\n            if any(abs(g[\\'s\\'][0] - pos[0]) < 20 and abs(g[\\'s\\'][-1] - pos[-1]) < 20 and\\n                   abs(g[\\'lat\\'] - (lo + hi) / 2.0) < 20 and g[\\'u\\'] == u for g in flights):\\n                continue\\n            flights.append({\\'u\\': u, \\'v\\': v, \\'a\\': a, \\'s\\': pos, \\'lat\\': (lo + hi) / 2.0, \\'w\\': hi - lo,\\n                            \\'spacing\\': span / (len(pos) - 1), \\'ext\\': []})\\n    for f in flights:\\n        _extend_edges(f, merged)\\n    return flights\\n\\n\\ndef _extend_edges(f, merged):\\n    \"\"\"a longer landing / floor edge line one tread after the last (or before the first) line = also a riser\"\"\"\\n    u, v, sp = f[\\'u\\'], f[\\'v\\'], f[\\'spacing\\']\\n    lo, hi = f[\\'lat\\'] - f[\\'w\\'] / 2.0, f[\\'lat\\'] + f[\\'w\\'] / 2.0\\n    for end in (0, -1):\\n        s_end = f[\\'s\\'][end]\\n        sgn = -1.0 if end == 0 else 1.0\\n        want = s_end + sgn * sp\\n        for q in merged:\\n            if _adiff(_ang(q), f[\\'a\\']) > 1.5 or _len(q) < f[\\'w\\'] * 1.15:\\n                continue\\n            q0 = q[0][0] * u[0] + q[0][1] * u[1]\\n            if abs(q0 - want) > max(10.0, 0.06 * sp):\\n                continue\\n            l0 = q[0][0] * v[0] + q[0][1] * v[1]\\n            l1 = q[1][0] * v[0] + q[1][1] * v[1]\\n            if min(max(l0, l1), hi) - max(min(l0, l1), lo) >= 0.9 * f[\\'w\\']:\\n                if end == 0:\\n                    f[\\'s\\'].insert(0, q0)\\n                else:\\n                    f[\\'s\\'].append(q0)\\n                f[\\'ext\\'].append(\\'start\\' if end == 0 else \\'end\\')\\n                break\\n\\n\\ndef _pt(f, s, lat=None):\\n    lat = f[\\'lat\\'] if lat is None else lat\\n    return (f[\\'u\\'][0] * s + f[\\'v\\'][0] * lat, f[\\'u\\'][1] * s + f[\\'v\\'][1] * lat)\\n\\n\\ndef group_stairs(flights, near=1.6):\\n    \"\"\"flights close to each other belong to one stair\"\"\"\\n    n = len(flights)\\n    par = list(range(n))\\n\\n    def fnd(a):\\n        while par[a] != a:\\n            par[a] = par[par[a]]\\n            a = par[a]\\n        return a\\n    ends = [[_pt(f, f[\\'s\\'][0]), _pt(f, f[\\'s\\'][-1])] for f in flights]\\n    for i in range(n):\\n        for j in range(i + 1, n):\\n            d = min(math.hypot(a[0] - b[0], a[1] - b[1]) for a in ends[i] for b in ends[j])\\n            if d < near * max(flights[i][\\'w\\'], flights[j][\\'w\\']):\\n                par[fnd(i)] = fnd(j)\\n    groups = {}\\n    for i in range(n):\\n        groups.setdefault(fnd(i), []).append(flights[i])\\n    return list(groups.values())\\n\\n\\ndef _free_gap(f, end, segs):\\n    \"\"\"free space in front of this flight end (to the next parallel line across the flight)\"\"\"\\n    u, v = f[\\'u\\'], f[\\'v\\']\\n    s_end = f[\\'s\\'][end]\\n    sgn = 1.0 if (end == -1) == (f[\\'s\\'][-1] > f[\\'s\\'][0]) else -1.0\\n    best = 6000.0\\n    for q in segs:\\n        if _adiff(_ang(q), f[\\'a\\']) > 5.0:\\n            continue\\n        l0 = q[0][0] * v[0] + q[0][1] * v[1]\\n        l1 = q[1][0] * v[0] + q[1][1] * v[1]\\n        ov = min(max(l0, l1), f[\\'lat\\'] + f[\\'w\\'] / 2.0) - max(min(l0, l1), f[\\'lat\\'] - f[\\'w\\'] / 2.0)\\n        if ov < 0.5 * f[\\'w\\']:\\n            continue\\n        d = (q[0][0] * u[0] + q[0][1] * u[1] - s_end) * sgn\\n        if 30.0 < d < best:\\n            best = d\\n    return best\\n\\n\\ndef _on_line(pt, q, tol=15.0):\\n    L = _len(q)\\n    d = (q[1][0] - q[0][0], q[1][1] - q[0][1])\\n    t = ((pt[0] - q[0][0]) * d[0] + (pt[1] - q[0][1]) * d[1]) / L\\n    off = abs((pt[0] - q[0][0]) * d[1] - (pt[1] - q[0][1]) * d[0]) / L\\n    return off < tol and -20.0 < t < L + 20.0\\n\\n\\ndef _shared_edge(fi, ei, fj, ej, merged):\\n    \"\"\"one line (landing edge) runs through the end riser of both flights -> they meet at that landing\"\"\"\\n    if _adiff(fi[\\'a\\'], fj[\\'a\\']) > 1.5:\\n        return False\\n    a, b = _pt(fi, fi[\\'s\\'][ei]), _pt(fj, fj[\\'s\\'][ej])\\n    for q in merged:\\n        if _adiff(_ang(q), fi[\\'a\\']) <= 1.5 and _len(q) > fi[\\'w\\'] * 1.15 and _on_line(a, q) and _on_line(b, q):\\n            return True\\n    return False\\n\\n\\ndef order_stair(flights, segs):\\n    \"\"\"flights bottom -> top, each with \\'s\\' in walking order (first riser .. last riser)\"\"\"\\n    merged = _merge_collinear(segs)\\n    if len(flights) == 1:\\n        f = dict(flights[0])\\n        s = list(f[\\'s\\'])\\n        if _free_gap(f, 0, segs) > _free_gap(f, -1, segs):     # bottom = the end with less free space in front\\n            s.reverse()\\n        f[\\'s\\'] = s\\n        return [f]\\n    n = len(flights)\\n    cands = []\\n    for i in range(n):\\n        for j in range(i + 1, n):\\n            for ei in (0, -1):\\n                for ej in (0, -1):\\n                    a, b = _pt(flights[i], flights[i][\\'s\\'][ei]), _pt(flights[j], flights[j][\\'s\\'][ej])\\n                    # flights meet at the landing: the closest ends, and a landing is closed in (little free space\\n                    # beyond it), while the floor ends open onto the room\\n                    score = math.hypot(a[0] - b[0], a[1] - b[1]) + 0.5 * (\\n                        min(_free_gap(flights[i], ei, segs), 3000.0) + min(_free_gap(flights[j], ej, segs), 3000.0))\\n                    if _shared_edge(flights[i], ei, flights[j], ej, merged):\\n                        score -= 100000.0\\n                    cands.append((score, i, ei, j, ej))\\n    cands.sort()\\n    deg = [0] * n\\n    used_end, links = set(), {}\\n    par = list(range(n))\\n\\n    def fnd(a):\\n        while par[a] != a:\\n            a = par[a]\\n        return a\\n    for score, i, ei, j, ej in cands:\\n        if (i, ei) in used_end or (j, ej) in used_end or fnd(i) == fnd(j):\\n            continue\\n        used_end.add((i, ei))\\n        used_end.add((j, ej))\\n        links.setdefault(i, []).append((j, ei, ej))\\n        links.setdefault(j, []).append((i, ej, ei))\\n        par[fnd(i)] = fnd(j)\\n        deg[i] += 1\\n        deg[j] += 1\\n        if sum(deg) == 2 * (n - 1):\\n            break\\n    starts = [i for i in range(n) if deg[i] <= 1]\\n    starts.sort(key=lambda i: (flights[i][\\'lat\\'], flights[i][\\'s\\'][0]))\\n    cur = starts[0]\\n    order, prev, into_end = [], None, None\\n    while cur is not None:\\n        f = dict(flights[cur])\\n        s = list(f[\\'s\\'])\\n        nxt = [l for l in links.get(cur, []) if l[0] != prev]\\n        if nxt:\\n            if nxt[0][1] == 0:                            # leaves through its first line -> reverse\\n                s.reverse()\\n        elif into_end == -1:\\n            s.reverse()\\n        f[\\'s\\'] = s\\n        order.append(f)\\n        if nxt:\\n            prev, cur, into_end = cur, nxt[0][0], nxt[0][2]\\n        else:\\n            cur = None\\n    if len(order) != n:\\n        return None\\n    return order\\n\\n\\ndef _reverse(order):\\n    out = []\\n    for f in reversed(order):\\n        g = dict(f)\\n        g[\\'s\\'] = list(reversed(f[\\'s\\']))\\n        out.append(g)\\n    return out\\n\\n\\ndef arrow_tips(segs):\\n    \"\"\"walk line arrow heads: 2 short lines (60-700 mm) meeting at a point at an angle 15-120 deg\"\"\"\\n    short = [s for s in segs if 60.0 <= _len(s) <= 700.0]\\n    tips = []\\n    for i in range(len(short)):\\n        for j in range(i + 1, len(short)):\\n            a, b = short[i], short[j]\\n            for pa in (0, 1):\\n                for pb in (0, 1):\\n                    if math.hypot(a[pa][0] - b[pb][0], a[pa][1] - b[pb][1]) < 5.0:\\n                        da = (a[1 - pa][0] - a[pa][0], a[1 - pa][1] - a[pa][1])\\n                        db = (b[1 - pb][0] - b[pb][0], b[1 - pb][1] - b[pb][1])\\n                        c = (da[0] * db[0] + da[1] * db[1]) / (_len(a) * _len(b))\\n                        ang = math.degrees(math.acos(max(-1.0, min(1.0, c))))\\n                        if 15.0 <= ang <= 120.0:\\n                            tips.append(a[pa])\\n    return tips\\n\\n\\ndef orient(order, segs, tips, flip=False):\\n    \"\"\"walking order: arrow tip near an end = top; flip turns it round\"\"\"\\n    how = \\'free space\\'\\n    if tips:\\n        bot = _pt(order[0], order[0][\\'s\\'][0])\\n        top = _pt(order[-1], order[-1][\\'s\\'][-1])\\n        reach = 1.6 * max(f[\\'w\\'] for f in order)\\n        db = min(math.hypot(t[0] - bot[0], t[1] - bot[1]) for t in tips)\\n        dt = min(math.hypot(t[0] - top[0], t[1] - top[1]) for t in tips)\\n        if min(db, dt) < reach:\\n            how = \\'arrow\\'\\n            if db < dt:\\n                order = _reverse(order)\\n    if flip:\\n        order = _reverse(order)\\n        how += \\' + flipped\\'\\n    return order, how\\n\\n\\ndef footprint(order, pad=150.0):\\n    pts = []\\n    for f in order:\\n        for s in (f[\\'s\\'][0], f[\\'s\\'][-1]):\\n            for lat in (f[\\'lat\\'] - f[\\'w\\'] / 2.0, f[\\'lat\\'] + f[\\'w\\'] / 2.0):\\n                pts.append(_pt(f, s, lat))\\n    xs, ys = [p[0] for p in pts], [p[1] for p in pts]\\n    return (min(xs) - pad, min(ys) - pad, max(xs) + pad, max(ys) + pad)\\n\\n\\n# ------------------------------------------------------------------ Revit\\nREVIT_ERRORS = []\\n\\ntry:\\n    import uuid as _uuid\\n\\n    class _Quiet(IFailuresPreprocessor):\\n        __namespace__ = \\'B18_\\' + _uuid.uuid4().hex[:10]\\n\\n        def PreprocessFailures(self, fa):\\n            err = False\\n            try:\\n                for m in fa.GetFailureMessages():\\n                    if m.GetSeverity() == FailureSeverity.Warning:\\n                        fa.DeleteWarning(m)\\n                    else:\\n                        err = True\\n                        try:\\n                            REVIT_ERRORS.append(m.GetDescriptionText())\\n                        except Exception:\\n                            REVIT_ERRORS.append(\\'Revit error\\')\\n            except Exception:\\n                pass\\n            if err:\\n                return FailureProcessingResult.ProceedWithRollBack\\n            return FailureProcessingResult.Continue\\nexcept Exception:\\n    _Quiet = None\\n\\n\\ndef _pre():\\n    try:\\n        return _Quiet() if _Quiet is not None else None\\n    except Exception:\\n        return None\\n\\n\\ndef in_tx(doc, name, fn):\\n    t = Transaction(doc, name)\\n    p = _pre()\\n    if p is not None:\\n        try:\\n            o = t.GetFailureHandlingOptions()\\n            o.SetFailuresPreprocessor(p)\\n            t.SetFailureHandlingOptions(o)\\n        except Exception:\\n            pass\\n    t.Start()\\n    try:\\n        r = fn()\\n    except Exception:\\n        if t.HasStarted() and not t.HasEnded():\\n            t.RollBack()\\n        raise\\n    t.Commit()\\n    return r\\n\\n\\ndef _setp(e, bip, val):\\n    try:\\n        p = e.get_Parameter(bip)\\n        if p is not None and not p.IsReadOnly:\\n            p.Set(val)\\n            return True\\n    except Exception:\\n        pass\\n    return False\\n\\n\\ndef _comment(e):\\n    try:\\n        p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\\n        return (p.AsString() or \\'\\') if p is not None else \\'\\'\\n    except Exception:\\n        return \\'\\'\\n\\n\\ndef old_stairs(doc, base, boxes):\\n    \"\"\"B18 stairs on this base level whose plan box overlaps a new stair\\'s footprint\"\"\"\\n    out = []\\n    for s in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Stairs).WhereElementIsNotElementType():\\n        if tname_of(s) != \\'Stairs\\' or not _comment(s).startswith(TAG):\\n            continue\\n        try:\\n            p = s.get_Parameter(BuiltInParameter.STAIRS_BASE_LEVEL_PARAM)\\n            if p is not None and idv(p.AsElementId()) != idv(base.Id):\\n                continue\\n            bb = s.get_BoundingBox(None)\\n            x0, y0, x1, y1 = bb.Min.X / MMF, bb.Min.Y / MMF, bb.Max.X / MMF, bb.Max.Y / MMF\\n            if any(x0 < b[2] and b[0] < x1 and y0 < b[3] and b[1] < y1 for b in boxes):\\n                out.append(s.Id)\\n        except Exception:\\n            pass\\n    return out\\n\\n\\ndef stair_type(doc, rh, tread, width):\\n    types = list(FilteredElementCollector(doc).OfClass(StairsType))\\n    if not types:\\n        raise Exception(\\'No stair type in the project - load / make one first\\')\\n    st = [t for t in types if type_name(t) == TYPE_NAME]\\n    if st:\\n        st = st[0]\\n    else:\\n        pref = [t for t in types if any(k in type_name(t).upper() for k in (\\'CAST\\', \\'MONOLITHIC\\', \\'CONCRETE\\', \\'RCC\\'))]\\n        st = (pref or types)[0].Duplicate(TYPE_NAME)\\n    for attr, val, fn in ((\\'MaxRiserHeight\\', (rh + 1.0) * MMF, max), (\\'MinTreadDepth\\', (tread - 1.0) * MMF, min),\\n                          (\\'MinRunWidth\\', (width - 1.0) * MMF, min)):\\n        try:\\n            setattr(st, attr, fn(getattr(st, attr), val))\\n        except Exception as ex:\\n            log(\\'type {0}: {1}\\'.format(attr, ex))\\n    return st\\n\\n\\ndef railing_type(doc):\\n    rts = list(FilteredElementCollector(doc).OfClass(RailingType))\\n    for keys in ((\\'HANDRAIL\\',), (\\'900\\',), (\\'1100\\',), (\\'GUARD\\',)):\\n        for t in rts:\\n            if any(k in type_name(t).upper() for k in keys):\\n                return t\\n    return rts[0] if rts else None\\n\\n\\ndef risers_fit(order, H, maxr):\\n    \"\"\"risers per flight so that riser <= maxr (spread like the drawn line counts)\"\"\"\\n    R = int(math.ceil(H / maxr - 1e-6))\\n    base = [len(f[\\'s\\']) for f in order]\\n    tot = float(sum(base))\\n    rs = [max(2, int(round(R * b / tot))) for b in base]\\n    while sum(rs) > R:\\n        rs[rs.index(max(rs))] -= 1\\n    while sum(rs) < R:\\n        rs[rs.index(min(rs))] += 1\\n    return rs\\n\\n\\ndef run_start(order, i, r, tread):\\n    \"\"\"where run i starts (mm along its walking axis): the first flight of a multi-flight stair is anchored at its\\n    landing end, so the landing sits exactly where it is drawn; the other flights start at their first line\"\"\"\\n    f = order[i]\\n    sgn = 1.0 if f[\\'s\\'][-1] > f[\\'s\\'][0] else -1.0\\n    if i == 0 and len(order) > 1:\\n        return f[\\'s\\'][-1] - sgn * (r - 1) * tread\\n    return f[\\'s\\'][0]\\n\\n\\ndef landing_rect(f1, r1, f2, tread, width_ovr=0.0, start1=None):\\n    \"\"\"landing between flight 1 (its last riser) and flight 2 (its first riser) -> 4 corner points (mm)\"\"\"\\n    w1 = width_ovr if width_ovr > 0 else f1[\\'w\\']\\n    w2 = width_ovr if width_ovr > 0 else f2[\\'w\\']\\n    u1, v1 = f1[\\'u\\'], f1[\\'v\\']\\n    sgn = 1.0 if f1[\\'s\\'][-1] > f1[\\'s\\'][0] else -1.0\\n    e = (f1[\\'s\\'][0] if start1 is None else start1) + sgn * (r1 - 1) * tread   # last riser of flight 1\\n    lat2 = f2[\\'lat\\']\\n    p2 = [_pt(f2, f2[\\'s\\'][0], lat2 - w2 / 2.0), _pt(f2, f2[\\'s\\'][0], lat2 + w2 / 2.0)]   # first riser of flight 2\\n    pu = [(p[0] * u1[0] + p[1] * u1[1]) for p in p2]\\n    pv = [(p[0] * v1[0] + p[1] * v1[1]) for p in p2]\\n    D = max(sgn * (x - e) for x in pu)\\n    if D < 0.5 * min(w1, w2):                              # flight 2 starts level with the landing edge (U stair)\\n        D = max(w1, w2)\\n    v_lo = min([f1[\\'lat\\'] - w1 / 2.0] + pv)\\n    v_hi = max([f1[\\'lat\\'] + w1 / 2.0] + pv)\\n\\n    def P(s_, l_):\\n        return (u1[0] * s_ + v1[0] * l_, u1[1] * s_ + v1[1] * l_)\\n    return [P(e, v_lo), P(e + sgn * D, v_lo), P(e + sgn * D, v_hi), P(e, v_hi)]\\n\\n\\ndef build_stair(doc, base, top, height_ft, order, rs, tread, width_ovr, stype, tag):\\n    \"\"\"StairsEditScope -> straight runs (+ automatic landings). returns (stairs id, riser mm, notes)\"\"\"\\n    R = sum(rs)\\n    H = (top.Elevation - base.Elevation) if top is not None else height_ft\\n    rh = H / R\\n    scope = StairsEditScope(doc, \\'B18 stair\\')\\n    sid = scope.Start(base.Id, top.Id if top is not None else base.Id)\\n    t = Transaction(doc, \\'B18 stair runs\\')\\n    t.Start()\\n    notes = []\\n    try:\\n        st = doc.GetElement(sid)\\n        try:\\n            tp = st.get_Parameter(BuiltInParameter.ELEM_TYPE_PARAM)\\n            if tp is not None and not tp.IsReadOnly and idv(tp.AsElementId()) != idv(stype.Id):\\n                tp.Set(stype.Id)\\n        except Exception as ex:\\n            notes.append(\\'type: {0}\\'.format(ex))\\n        if top is None:\\n            _setp(st, BuiltInParameter.STAIRS_TOP_LEVEL_PARAM, ElementId.InvalidElementId)\\n            if not _setp(st, BuiltInParameter.STAIRS_STAIRS_HEIGHT, H):\\n                notes.append(\\'height not set - set \"Desired Stair Height\" by hand\\')\\n        st.DesiredRisersNumber = R\\n        st.ActualTreadDepth = tread * MMF\\n        runs, zrel, starts = [], 0.0, []\\n        for i_, (f, r) in enumerate(zip(order, rs)):\\n            s0 = run_start(order, i_, r, tread)\\n            starts.append(s0)\\n            sgn = 1.0 if f[\\'s\\'][-1] > f[\\'s\\'][0] else -1.0\\n            a = _pt(f, s0)\\n            b = _pt(f, s0 + sgn * (r - 1) * tread)\\n            ln = Line.CreateBound(XYZ(a[0] * MMF, a[1] * MMF, zrel), XYZ(b[0] * MMF, b[1] * MMF, zrel))\\n            run = StairsRun.CreateStraightRun(doc, sid, ln, StairsRunJustification.Center)\\n            run.ActualRunWidth = (width_ovr if width_ovr > 0 else f[\\'w\\']) * MMF\\n            try:\\n                if abs(run.BaseElevation - zrel) > 1e-4:\\n                    run.TopElevation = zrel + r * rh\\n                    run.BaseElevation = zrel\\n            except Exception as ex:\\n                notes.append(\\'run elevation: {0}\\'.format(ex))\\n            runs.append(run)\\n            zrel += r * rh\\n        for i in range(len(runs) - 1):\\n            try:\\n                StairsLanding.CreateAutomaticLanding(doc, runs[i].Id, runs[i + 1].Id)\\n                continue\\n            except Exception as ex:\\n                log(\\'auto landing {0}: {1}\\'.format(i + 1, ex))\\n            try:\\n                pts = landing_rect(order[i], rs[i], order[i + 1], tread, width_ovr, starts[i])\\n                loop = CurveLoop()\\n                xyz = [XYZ(p[0] * MMF, p[1] * MMF, 0.0) for p in pts]\\n                for k in range(4):\\n                    loop.Append(Line.CreateBound(xyz[k], xyz[(k + 1) % 4]))\\n                StairsLanding.CreateSketchedLanding(doc, sid, loop, runs[i].TopElevation)\\n            except Exception as ex:\\n                log(\\'sketched landing {0}: {1}\\'.format(i + 1, ex))\\n                notes.append(\\'landing {0}-{1} not made - sketch it in Edit Stairs\\'.format(i + 1, i + 2))\\n        _setp(st, BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS, tag)\\n        t.Commit()\\n    except Exception:\\n        if t.HasStarted() and not t.HasEnded():\\n            t.RollBack()\\n        scope.Cancel()\\n        raise\\n    scope.Commit(_pre())\\n    return sid, rh / MMF, notes\\n\\n\\ndef collect_segments(doc, uidoc, view, source, layer):\\n    src = (source or \\'AUTO\\').strip().upper()[:1]\\n    sel = selected_ids(uidoc)\\n    sel_lines = [i for i in sel if tname_of(doc.GetElement(i)) in LINE_KINDS]\\n    sel_cad = [i for i in sel if tname_of(doc.GetElement(i)) == \\'ImportInstance\\']\\n    use_sel = bool(sel_lines or sel_cad)\\n    segs, how = [], []\\n    if src in (\\'A\\', \\'R\\'):\\n        r = revit_segments(doc, view, layer, sel_lines if use_sel else None) if (sel_lines or not use_sel) else []\\n        segs += r\\n        how.append(\\'{0} Revit lines{1}\\'.format(len(r), \\' (selected)\\' if use_sel else \\'\\'))\\n    if src in (\\'A\\', \\'C\\'):\\n        c = cad_segments(doc, view, layer, sel_cad if use_sel else None) if (sel_cad or not use_sel) else []\\n        segs += c\\n        how.append(\\'{0} CAD lines{1}\\'.format(len(c), \\' (selected CAD)\\' if use_sel else \\'\\'))\\n    return segs, how\\n\\n\\ndef find_stairs(segs, flip=False):\\n    flights = find_flights(segs)\\n    tips = arrow_tips(segs)\\n    stairs = []\\n    for grp in group_stairs(flights):\\n        order = order_stair(grp, segs)\\n        if order is None:                                 # could not chain them: each flight its own stair\\n            for f in grp:\\n                o, how = orient(order_stair([f], segs), segs, tips, flip)\\n                stairs.append((o, how))\\n            continue\\n        o, how = orient(order, segs, tips, flip)\\n        stairs.append((o, how))\\n    stairs.sort(key=lambda sh: (round(_pt(sh[0][0], sh[0][0][\\'s\\'][0])[1] / 1000.0), _pt(sh[0][0], sh[0][0][\\'s\\'][0])[0]))\\n    return stairs\\n\\n\\ndef run(doc, uidoc, source=\\'AUTO\\', layer=\\'\\', top_name=\\'\\', height=0.0, max_riser=190.0, riser_mode=\\'LINES\\',\\n        tread=0.0, width=0.0, flip=False, rails=True, make=True):\\n    view = plan_view(doc, uidoc)\\n    height = float(height or 0.0)\\n    max_riser = float(max_riser or 190.0)\\n    tread = float(tread or 0.0)\\n    width = float(width or 0.0)\\n    if view is None:\\n        raise Exception(\\'Open the floor plan with the stair lines first.\\')\\n    base = view.GenLevel if view.GenLevel is not None else levels_of(doc)[0]\\n    segs, how = collect_segments(doc, uidoc, view, source, (layer or \\'\\').strip())\\n    stairs = find_stairs(segs, flip)\\n    out = [\\'{0} stair(s) found in \"{1}\" ({2})\\'.format(len(stairs), view.Name, \\', \\'.join(how))]\\n    if not stairs:\\n        out.append(\\'CHECK no stair found: a flight = 3+ parallel tread lines, same length (600-3500 mm), evenly spaced \\'\\n                   \\'100-450 mm. Use the layer / line style filter, or select the stair lines first.\\')\\n        return out\\n    top = find_level(doc, top_name)\\n    if top is None and height <= 0:\\n        above = [l for l in levels_of(doc) if l.Elevation > base.Elevation + 1e-6]\\n        if not above:\\n            raise Exception(\\'No level above \"{0}\" - give the stair height in mm\\'.format(base.Name))\\n        top = above[0]\\n    if top is not None and height > 0 and not top_name:\\n        top = None\\n    if top is not None and top.Elevation <= base.Elevation + 1e-6:\\n        raise Exception(\\'Top level \"{0}\" is not above \"{1}\"\\'.format(top.Name, base.Name))\\n    H_mm = (top.Elevation - base.Elevation) / MMF if top is not None else height\\n    fit = str(riser_mode or \\'LINES\\').strip().upper().startswith(\\'F\\')\\n    plans, warn = [], []\\n    for k, (order, how_dir) in enumerate(stairs):\\n        rs = risers_fit(order, H_mm, max_riser) if fit else [len(f[\\'s\\']) for f in order]\\n        R = sum(rs)\\n        tr = tread if tread > 0 else round(sum(f[\\'spacing\\'] for f in order) / len(order))\\n        rh = H_mm / R\\n        plans.append((order, rs, tr, rh, how_dir))\\n        if rh > max_riser + 0.5:\\n            need = int(math.ceil(H_mm / max_riser - 1e-6))\\n            warn.append(\\'CHECK stair {0}: riser {1:.1f} mm > max {2:.0f} ({3} risers for {4:.0f} mm) - needs {5} risers: \\'\\n                        \\'draw more treads, or Risers = FIT\\'.format(k + 1, rh, float(max_riser), R, H_mm, need))\\n        elif rh < 100.0:\\n            warn.append(\\'CHECK stair {0}: riser only {1:.1f} mm - too many risers for {2:.0f} mm\\'.format(k + 1, rh, H_mm))\\n        blondel = 2 * rh + tr\\n        if not 550.0 <= blondel <= 700.0:\\n            warn.append(\\'CHECK stair {0}: 2 x riser + tread = {1:.0f} mm (comfortable 550-700)\\'.format(k + 1, blondel))\\n    tdesc = \\'to \"{0}\"\\'.format(top.Name) if top is not None else \\'height {0:.0f} mm\\'.format(H_mm)\\n    out.append(\\'Base \"{0}\" {1}  ->  storey height {2:.0f} mm, risers from {3}\\'.format(\\n        base.Name, tdesc, H_mm, \\'FIT (max {0:.0f} mm)\\'.format(float(max_riser)) if fit else \\'the lines\\'))\\n    st = {\\'new\\': 0, \\'del\\': 0, \\'rail\\': 0, \\'rows\\': [], \\'fail\\': [], \\'notes\\': []}\\n\\n    def work():\\n        boxes = [footprint(p[0]) for p in plans]\\n        old = old_stairs(doc, base, boxes)\\n        if old:\\n            def kill():\\n                for i in old:\\n                    try:\\n                        doc.Delete(i)\\n                        st[\\'del\\'] += 1\\n                    except Exception:\\n                        pass\\n            in_tx(doc, \\'B18 remove old stairs\\', kill)\\n        stype = in_tx(doc, \\'B18 stair type\\', lambda: stair_type(\\n            doc, max(p[3] for p in plans), min(p[2] for p in plans),\\n            min(width if width > 0 else min(f[\\'w\\'] for f in p[0]) for p in plans)))\\n        rtype = railing_type(doc) if rails else None\\n        for k, (order, rs, tr, rh, how_dir) in enumerate(plans):\\n            tag = \\'{0}|{1}|{2}\\'.format(TAG, base.Name, k + 1)\\n            del REVIT_ERRORS[:]\\n            try:\\n                sid, rh_real, notes = build_stair(doc, base, top, H_mm * MMF, order, rs, tr, width, stype, tag)\\n                st[\\'new\\'] += 1\\n                s_el = doc.GetElement(sid)\\n                try:\\n                    act = s_el.ActualRisersNumber\\n                    rh_real = s_el.ActualRiserHeight / MMF\\n                except Exception:\\n                    act = sum(rs)\\n                ws = \\'/\\'.join(\\'{0:.0f}\\'.format(width if width > 0 else f[\\'w\\']) for f in order)\\n                st[\\'rows\\'].append(\\'  stair {0}: {1} flight(s) {2} risers ({3} built) | riser {4:.1f} x tread {5:.0f} | \\'\\n                                  \\'width {6} | up by {7}{8}\\'.format(\\n                                      k + 1, len(order), \\'+\\'.join(str(r) for r in rs), act, rh_real, float(tr), ws, how_dir,\\n                                      \\' | landing/floor edge counted as riser\\' if any(f[\\'ext\\'] for f in order) else \\'\\'))\\n                st[\\'notes\\'] += [\\'stair {0}: {1}\\'.format(k + 1, n) for n in notes]\\n                try:\\n                    have = list(s_el.GetAssociatedRailings())\\n                except Exception:\\n                    have = []\\n                if rtype is not None and not have:\\n                    def rail():\\n                        try:\\n                            ids = Railing.Create(doc, sid, rtype.Id, RailingPlacementPosition.Treads)\\n                            st[\\'rail\\'] += len(list(ids))\\n                        except Exception as ex:\\n                            if \\'already has associated railings\\' not in str(ex):\\n                                st[\\'notes\\'].append(\\'stair {0} railing: {1}\\'.format(k + 1, str(ex)[:80]))\\n                    in_tx(doc, \\'B18 railings\\', rail)\\n                elif rtype is None and have:\\n                    def unrail():\\n                        for r_ in have:\\n                            doc.Delete(r_)\\n                    in_tx(doc, \\'B18 no railings\\', unrail)\\n                else:\\n                    st[\\'rail\\'] += len(have)\\n            except Exception as ex:\\n                why = REVIT_ERRORS[-1] if REVIT_ERRORS else (str(ex).splitlines() or [\\'?\\'])[0]\\n                st[\\'fail\\'].append(\\'stair {0}: Revit could not make it - {1}\\'.format(k + 1, why[:140]))\\n\\n    tg = TransactionGroup(doc, \\'B18 Stairs\\')\\n    tg.Start()\\n    try:\\n        work()\\n    except Exception:\\n        tg.RollBack()\\n        raise\\n    if make:\\n        tg.Assimilate()\\n    else:\\n        tg.RollBack()\\n        out.insert(0, \\'PREVIEW (Make it = False): built to test, then rolled back - nothing changed\\')\\n    out.append(\\'Stairs: {0} {1}, {2} old B18 stair(s) replaced, {3} railing(s), type \"{4}\"\\'.format(\\n        st[\\'new\\'], \\'made\\' if make else \\'would be made\\', st[\\'del\\'], st[\\'rail\\'], TYPE_NAME))\\n    out += st[\\'rows\\']\\n    out += warn\\n    for f_ in st[\\'fail\\'][:6]:\\n        out.append(\\'FAILED \\' + f_)\\n    for n_ in st[\\'notes\\'][:6]:\\n        out.append(\\'NOTE \\' + n_)\\n    out.append(\\'Run again = these stairs are replaced (no doubles).  Wrong way up? Run with Flip.\\')\\n    log(\\'\\\\n\\'.join(out))\\n    return out\\n'\n\n\n# =====================================================================\n#  DYNAMO / DYNAMO PLAYER PART  -  inputs:\n#    0  Plan picture or PDF   File Path (JPG / PNG / WebP / PDF of a floor plan)\n#    1  PDF page              1\n#    2  Scale                 AUTO = the tool decides and checks the scale BEFORE anything is placed:\n#                               1. dimensions written on the plan are read (walls / grids on a dimension point = exactly\n#                                  the written distance);  2. no dimension: the thickest walls = standard 200 or 150 mm;\n#                               3. no scale that can be trusted (dimensions disagree, a photo, no walls): NOTHING is placed\n#                                  and the result says why.\n#                             DIM 8850   = text too small to read: the result marks one dimension D1 on the plan\n#                                          picture - type here what D1 says (mm, or DIM 27'10\"), run again\n#                             WALL 230   = the outer (thickest) walls are 230 mm  (plan without dimensions)\n#                             ... ONLY   = e.g. WALL 230 ONLY: do not use the dimensions on the plan\n#                             1:100      = PDF drawn at 1:100 (exact)\n#                             LINE 2000  = after a first run: draw a detail line over a dimension / the scale bar\n#                                          on the picture, select it, type its real length, run again (exact)\n#                             WIDTH 12000 = overall building width\n#    3  Wall height mm        3000\n#    4  Level                 '' = level of the open plan\n#    5  Wall material         Brick   (types A_WAL_BRK_230 ...)\n#    6  Doors + windows       True\n#    7  Door height mm        2100\n#    8  Window height mm      1200\n#    9  Window sill mm        900\n#    10 Picture under walls   True (true scale, in the open plan)\n#    11 Make it               True  (False = only read the plan, show what it finds)\n#    12 Floors in rooms       True  (a floor slab in every closed room)\n#    13 Stairs                True  (real Revit stairs where the picture shows treads: tread 300, riser 150, risers from\n#                             the floor-to-floor height; no furniture blocks are made any more)\n#    14 Shaft openings        True  (boxes with an X in the picture + X drawn with symbolic / detail lines in the plan;\n#                             no picture in 0 = only the shafts from the X lines)\n#    15 Grids                 True  (grid lines with bubbles in the picture -> Revit grids, names from the bubbles)\n#    16 Concrete columns      True  (solid blocks thicker than the walls -> concrete structural columns, size from the picture)\n#    17 Rooms + room tags     True  (rooms in the closed spaces, named from the names written in the picture)\n#    Doors (input 6) are hung and open as their leaf is drawn in the picture.\n#  Run again = walls / doors / windows from this plan are replaced.  Ctrl+Z in Revit undoes.\n# =====================================================================\nimport traceback\n\ntry:\n    IN                                                    # noqa - Dynamo\n    DYNAMO = True\nexcept NameError:\n    DYNAMO = False\nTM = None\ndoc = globals().get('doc')\nuidoc = globals().get('uidoc')\nif DYNAMO:\n    try:\n        clr.AddReference('RevitServices')\n        from RevitServices.Persistence import DocumentManager\n        from RevitServices.Transactions import TransactionManager\n        _d = DocumentManager.Instance.CurrentDBDocument\n        if _d is not None:\n            doc = _d\n            try:\n                uidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n            except Exception:\n                pass\n            TM = TransactionManager\n    except Exception:\n        pass\n    RAW = list(IN)\nelse:\n    RAW = list(globals().get('PLAN_INPUTS', []))\n\n\ndef _inp(i, default):\n    try:\n        v = RAW[i]\n    except Exception:\n        return default\n    if v is None or (isinstance(v, str) and (not v.strip() or v.strip().lower() == 'no file selected.')):\n        return default\n    return v\n\n\ndef _num(i, default):\n    try:\n        return float(str(_inp(i, default)).lower().replace('mm', '').strip())\n    except Exception:\n        return float(default)\n\n\ndef _flag(i, default):\n    v = _inp(i, default)\n    if isinstance(v, str):\n        return v.strip().upper() in ('TRUE', 'YES', '1', 'Y')\n    return bool(v)\n\n\nout = []\ninfo = {}\ntry:\n    PATH = str(_inp(0, '')).strip().strip('\"')\n    if doc is None:\n        raise Exception('No Revit document.')\n    if PATH and not os.path.isfile(PATH):\n        raise Exception('File not found: ' + PATH)\n    if TM is not None and _flag(11, True):\n        TM.Instance.ForceCloseTransaction()\n    if not PATH:                                          # no picture: only shaft openings from X lines in the plan\n        if not _flag(14, True):\n            raise Exception('Pick the plan picture or PDF (input 0) - or set 14 = True for shafts from X lines only.')\n        out = shafts_from_lines(doc, uidoc, str(_inp(4, '')).strip(), _num(3, 3000))\n    else:\n        out, info = run(doc, uidoc, PATH, str(_inp(2, 'AUTO')), int(_num(1, 1)), _num(3, 3000), str(_inp(4, '')).strip(),\n                        str(_inp(5, 'Brick')).strip() or 'Brick', _flag(6, True), _num(7, 2100), _num(8, 1200), _num(9, 900),\n                        _flag(10, True), _flag(11, True), floors=_flag(12, True), objects=False, stairs=_flag(13, True),\n                        columns=_flag(16, True), rooms=_flag(17, True),\n                        shafts=_flag(14, True), grids=_flag(15, True))\n    if info.get('view3d') is not None and uidoc is not None and not globals().get('NO_DIALOG'):\n        try:\n            uidoc.RequestViewChange(info['view3d'])\n        except Exception:\n            pass\nexcept Exception as ex:\n    out.append('FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nif DYNAMO and not globals().get('NO_DIALOG'):\n    try:\n        clr.AddReference('RevitAPIUI')\n        from Autodesk.Revit.UI import TaskDialog\n        td = TaskDialog('PLAN2BIM - B14 3D walls from plan')\n        td.MainInstruction = 'Failed' if any(l.startswith('FAILED') for l in out) else 'Nothing placed - see why' if info.get('not_placed') else (\n            'Only read the plan' if not _flag(11, True) else 'Walls built - see the 3D view')\n        td.MainContent = '\\n'.join(out)[:1900]\n        td.Show()\n    except Exception:\n        pass\nOUT = out\n",
