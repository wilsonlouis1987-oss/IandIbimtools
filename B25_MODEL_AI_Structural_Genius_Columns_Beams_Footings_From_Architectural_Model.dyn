    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - code / reference library            (pure Python, IronPython 2.7 + CPython 3)\n#\n#  Every number the engine uses sits in a library item with a SOURCE TAG:\n#    OFFICIAL    value / clause read in a public copy of the standard (law.resource.org PDF, text-extracted, OCR noise\n#                possible) on 2026-11-24.  Still: confirm in the CURRENT edition + amendments before relying on it.\n#    SECONDARY   value found only in secondary sources (design handbooks, university notes, software help pages);\n#                the standard itself was not read for it.  Clause number given only if the sources agree.\n#    TEXTBOOK    standard engineering mechanics (e.g. w*L^2/8) - no code clause needed.\n#    ASSUMPTION  an editable default chosen by this tool (NOT from a code).  Change it in the window / Dynamo input.\n#    PROPOSAL    something this tool proposes (sizes, layouts) - never an approved design.\n#    UNVERIFIED  could not be verified - used only as a provisional placeholder; every check that uses it is flagged.\n#  The engine NEVER invents a clause number: where a clause was not verified the 'ref' says so.\n#\n#  Modules of this tool share ONE namespace (they are exec'd one after another, or pasted into one Dynamo node), so\n#  there are no imports between them; private helpers start with an underscore + module prefix.\n# =====================================================================\nimport math\nimport json\n\nPRELIM_STATUS = 'PRELIMINARY PROPOSAL - NOT CHECKED BY A STRUCTURAL ENGINEER'\nDISCLAIMER = ('AI STRUCTURAL GENIUS assists structural engineers and does not replace them. Every size, layout and number '\n              'here is a PROPOSAL from simplified hand-calculation methods (no frame analysis). Final design, reinforcement '\n              'detailing, code compliance and construction approval need sign-off by a qualified structural engineer using '\n              'real geotechnical data and the current edition of the governing codes.')\n\nVERIF_TEXT = {\n    'OFFICIAL': 'read in a public copy of the standard (confirm current edition)',\n    'SECONDARY': 'secondary source only - standard not read for this value',\n    'TEXTBOOK': 'standard engineering mechanics',\n    'ASSUMPTION': 'tool default - editable assumption, not from a code',\n    'PROPOSAL': 'proposal by this tool',\n    'UNVERIFIED': 'UNVERIFIED - confirm in the current edition before use',\n}\n\n\ndef sg_item(value, unit, source, ref, note=''):\n    return {'value': value, 'unit': unit, 'source': source, 'ref': ref, 'note': note}\n\n\ndef _sgc_india():\n    L = {}\n    I = sg_item\n    # ---- unit weights (IS 875 Part 1) -------------------------------------------------------------------------\n    L['gamma_rcc'] = I(25.0, 'kN/m3', 'SECONDARY', 'IS 875 (Part 1) Table 1 - reinforced cement concrete',\n                       'public-copy table rows depend on steel % and were not cleanly readable; 25 kN/m3 is the commonly quoted design value')\n    L['gamma_mortar'] = I(20.4, 'kN/m3', 'OFFICIAL', 'IS 875 (Part 1) Table 1 - cement mortar / cement plaster')\n    L['gamma_brick'] = I(19.0, 'kN/m3', 'SECONDARY', 'IS 875 (Part 1) Table 1 - masonry brick',\n                         'secondary sources quote 19 and 20 kN/m3; row not readable in the public copy - EDIT to your brick')\n    L['gamma_block'] = I(8.0, 'kN/m3', 'ASSUMPTION', '-', 'hollow / AAC block wall - edit to your block')\n    L['gamma_steel'] = I(78.5, 'kN/m3', 'TEXTBOOK', '-')\n    # ---- dead load allowances (not code values) ----------------------------------------------------------------\n    L['dl_floor_finish'] = I(1.0, 'kN/m2', 'ASSUMPTION', '-', 'tiles + screed allowance')\n    L['dl_ceiling_services'] = I(0.5, 'kN/m2', 'ASSUMPTION', '-')\n    L['dl_partition'] = I(1.0, 'kN/m2', 'ASSUMPTION', '-', 'movable / light partition allowance on floors (set 0 if all walls are modelled)')\n    L['dl_roof_finish'] = I(1.5, 'kN/m2', 'ASSUMPTION', '-', 'terrace waterproofing + brick-bat coba + finish')\n    L['dl_stair_extra'] = I(1.5, 'kN/m2', 'ASSUMPTION', '-', 'steps + finishes on top of the waist slab')\n    # ---- imposed loads (IS 875 Part 2) -------------------------------------------------------------------------\n    L['ll_residential'] = I(2.0, 'kN/m2', 'OFFICIAL', 'IS 875 (Part 2) Table 1, residential: rooms and kitchens')\n    L['ll_residential_corridor'] = I(3.0, 'kN/m2', 'OFFICIAL', 'IS 875 (Part 2) Table 1, residential: corridors, passages, staircases')\n    L['ll_balcony'] = I(3.0, 'kN/m2', 'OFFICIAL', 'IS 875 (Part 2) Table 1, residential: balconies')\n    L['ll_office'] = I(2.5, 'kN/m2', 'SECONDARY', 'IS 875 (Part 2) Table 1, offices (table row not readable in the public copy)')\n    L['ll_office_corridor'] = I(4.0, 'kN/m2', 'SECONDARY', 'IS 875 (Part 2) Table 1, business: corridors / stairs')\n    L['ll_commercial'] = I(4.0, 'kN/m2', 'UNVERIFIED', 'IS 875 (Part 2) Table 1, mercantile - UNVERIFIED - confirm in the current edition')\n    L['ll_hospital'] = I(2.0, 'kN/m2', 'UNVERIFIED', 'IS 875 (Part 2) Table 1, institutional wards - UNVERIFIED - confirm in the current edition')\n    L['ll_roof_access'] = I(1.5, 'kN/m2', 'OFFICIAL', 'IS 875 (Part 2) Table 2, flat roof up to 10 deg, access provided')\n    L['ll_roof_noaccess'] = I(0.75, 'kN/m2', 'OFFICIAL', 'IS 875 (Part 2) Table 2, flat roof up to 10 deg, access not provided')\n    L['ll_reduction_table'] = I([[1, 0.0], [2, 10.0], [3, 20.0], [4, 30.0], [5, 40.0]], '% by floors carried', 'OFFICIAL',\n                                'IS 875 (Part 2) clause 3.2 reduction of imposed load on columns / walls',\n                                '5 to 10 floors: 40 %; not applied to beams; not applied when the load is >= 5 kN/m2; this tool does NOT apply it unless you switch it on')\n    # ---- limit state factors (IS 456 Table 18) --------------------------------------------------------------------\n    L['gf_dl'] = I(1.5, '-', 'OFFICIAL', 'IS 456:2000 Table 18, DL+IL, limit state of collapse')\n    L['gf_ll'] = I(1.5, '-', 'OFFICIAL', 'IS 456:2000 Table 18, DL+IL, limit state of collapse')\n    L['gs_dl'] = I(1.0, '-', 'OFFICIAL', 'IS 456:2000 Table 18, DL+IL, serviceability')\n    L['gs_ll'] = I(1.0, '-', 'OFFICIAL', 'IS 456:2000 Table 18, DL+IL, serviceability')\n    # ---- deflection / depth ------------------------------------------------------------------------------------\n    L['ld_ss'] = I(20.0, '-', 'OFFICIAL', 'IS 456:2000 cl. 23.2.1 (a), simply supported, spans up to 10 m')\n    L['ld_cont'] = I(26.0, '-', 'OFFICIAL', 'IS 456:2000 cl. 23.2.1 (a), continuous')\n    L['ld_cant'] = I(7.0, '-', 'OFFICIAL', 'IS 456:2000 cl. 23.2.1 (a), cantilever')\n    L['ld_modfactor'] = I(1.0, '-', 'ASSUMPTION', 'IS 456:2000 cl. 23.2.1 (c) / Fig. 4',\n                          'tension-steel modification factor NOT computed - 1.0 is conservative (the real factor can be > 1)')\n    # ---- flexure (Annex G) -------------------------------------------------------------------------------------\n    L['xu_max_d'] = I({250: 0.53, 415: 0.48, 500: 0.46}, 'xu,max/d', 'OFFICIAL', 'IS 456:2000 cl. 38.1 note (fy 250 / 415 / 500)',\n                      'OCR of the 250 value is faint (0.53 matches the usual figure); other fy: NOT CHECKED')\n    L['stress_block'] = I({'a': 0.36, 'b': 0.42}, '-', 'OFFICIAL', 'IS 456:2000 cl. 38.1 / Annex G: 0.36 fck b xu, lever arm d - 0.42 xu')\n    L['beam_ast_min_k'] = I(0.85, '-', 'SECONDARY', 'IS 456:2000 cl. 26.5.1.1 (a): As/(b d) >= 0.85 / fy')\n    L['beam_pt_max'] = I(4.0, '% of b D', 'SECONDARY', 'IS 456:2000 cl. 26.5.1.1 (b)')\n    # ---- shear (Table 19 / 20) ---------------------------------------------------------------------------------\n    L['tau_c_pt'] = I([0.15, 0.25, 0.50, 0.75, 1.00, 1.25, 1.50, 1.75, 2.00, 2.25, 2.50, 2.75, 3.00], '100As/bd', 'OFFICIAL',\n                      'IS 456:2000 Table 19 rows (100As/bd)')\n    L['tau_c'] = I({\n        20: [0.28, 0.36, 0.48, 0.56, 0.62, 0.67, 0.72, 0.75, 0.79, 0.81, 0.82, 0.82, 0.82],\n        25: [0.29, 0.36, 0.49, 0.57, 0.64, 0.70, 0.74, 0.78, 0.82, 0.85, 0.88, 0.90, 0.92],\n        30: [0.29, 0.37, 0.50, 0.59, 0.66, 0.71, 0.76, 0.80, 0.84, 0.88, 0.91, 0.94, 0.96],\n        35: [0.29, 0.37, 0.50, 0.59, 0.67, 0.73, 0.78, 0.82, 0.86, 0.90, 0.93, 0.96, 0.99],\n        40: [0.30, 0.38, 0.51, 0.60, 0.68, 0.74, 0.79, 0.84, 0.88, 0.92, 0.95, 0.98, 1.01]},\n        'N/mm2', 'OFFICIAL', 'IS 456:2000 Table 19 design shear strength of concrete (M20..M40 and above)',\n        'read from the text-extracted public copy (some digits had OCR noise and were matched to the neighbouring cells); '\n        'for 100As/bd below 0.15 use the 0.15 value, above 3.0 use the 3.0 value; M40 values are used for grades above M40')\n    L['tau_c_max'] = I({15: 2.5, 20: 2.8, 25: 3.1, 30: 3.5, 35: 3.7, 40: 4.0}, 'N/mm2', 'OFFICIAL',\n                       'IS 456:2000 Table 20 maximum shear stress (M40 value used above M40)')\n    # ---- columns ---------------------------------------------------------------------------------------------\n    L['col_pu_formula'] = I({'k_c': 0.4, 'k_s': 0.67}, '-', 'SECONDARY',\n                            'IS 456:2000 cl. 39.3 short axially loaded member: Pu = 0.4 fck Ac + 0.67 fy Asc (valid when e_min <= 0.05 x lateral dimension)')\n    L['col_pt_min'] = I(0.8, '% of gross area', 'OFFICIAL', 'IS 456:2000 cl. 26.5.3.1 (a)')\n    L['col_pt_max'] = I(6.0, '% of gross area', 'OFFICIAL', 'IS 456:2000 cl. 26.5.3.1 (a)', 'practical limit is lower (laps) - this tool proposes max 4 %')\n    L['col_pt_design'] = I(2.0, '% of gross area', 'ASSUMPTION', '-', 'steel % assumed when proposing the concrete size')\n    L['col_slender_limit'] = I(12.0, 'le/D', 'SECONDARY', 'IS 456:2000 cl. 25.1.2 (short column when le/D < 12)')\n    L['col_emin'] = I({'L_div': 500.0, 'D_div': 30.0, 'min_mm': 20.0}, '-', 'OFFICIAL', 'IS 456:2000 cl. 25.4 minimum eccentricity')\n    L['col_k_eff'] = I(1.0, 'le / unsupported length', 'ASSUMPTION', 'IS 456:2000 Table 28 / Annex E (not computed)',\n                       'effective length factor needs the real end restraint - edit; 1.0 assumes pinned-pinned')\n    L['col_min_mm'] = I(230.0, 'mm', 'ASSUMPTION', '-', 'smallest column dimension the tool will propose (seismic zones: IS 13920 may require more - NOT CHECKED)')\n    # ---- slab ------------------------------------------------------------------------------------------------------\n    L['slab_ast_min'] = I({'HYSD': 0.12, 'MILD': 0.15}, '% of b D', 'OFFICIAL', 'IS 456:2000 slab minimum reinforcement (HYSD 0.12 %, mild steel 0.15 %); clause number not readable in the public copy')\n    L['slab_oneway_ratio'] = I(2.0, 'ly/lx', 'SECONDARY', 'one-way action when ly/lx > 2 (IS 456 cl. 24.4 / Annex D deals with two-way slabs; ratio quoted in handbooks)')\n    # ---- footings ----------------------------------------------------------------------------------------------\n    L['ftg_punch'] = I({'k': 0.25}, '-', 'SECONDARY',\n                       'IS 456:2000 cl. 31.6.3.1: permissible punching stress ks*tau_c, ks = 0.5 + betac (<= 1), tau_c = 0.25 sqrt(fck); critical section d/2 from the column face (31.6.1)')\n    L['ftg_oneway_section'] = I('d from column face', '-', 'OFFICIAL', 'IS 456:2000 cl. 34.2.4.1 (a) one-way shear critical section')\n    L['ftg_bend_section'] = I('at the column face', '-', 'SECONDARY', 'IS 456:2000 cl. 34.2.3.2 bending section')\n    L['ftg_self_weight_frac'] = I(0.10, 'of column service load', 'ASSUMPTION', '-', 'footing + backfill weight allowance when sizing the plan area (common practice, not a code value)')\n    L['ftg_min_thk'] = I(300.0, 'mm', 'ASSUMPTION', '-')\n    L['ftg_cover'] = I(50.0, 'mm', 'ASSUMPTION', 'IS 456 Table 16 not verified', 'footing cover assumed for d')\n    L['raft_ratio'] = I(0.5, 'footing area / plan area', 'ASSUMPTION', '-', 'above this ratio the tool suggests a raft (rule of thumb, not a code value)')\n    # ---- seismic (IS 1893 Part 1) - parameters are USER INPUTS; only the formula structure is built in ---------------\n    L['seis_ah'] = I('Ah = (Z/2) * (Sa/g) / (R/I)', '-', 'SECONDARY', 'IS 1893 (Part 1):2016 design horizontal seismic coefficient (clause number not confirmed)')\n    L['seis_vb'] = I('VB = Ah * W', '-', 'SECONDARY', 'IS 1893 (Part 1):2016 design seismic base shear (clause number not confirmed)')\n    L['seis_ll_frac'] = I({'le3': 0.25, 'gt3': 0.50}, 'of imposed load', 'UNVERIFIED', 'IS 1893 (Part 1) seismic weight rule - UNVERIFIED - confirm in the current edition (roof imposed load taken as 0)')\n    L['seis_dist'] = I('Qi = VB * Wi hi^2 / sum(Wj hj^2)', '-', 'UNVERIFIED', 'IS 1893 (Part 1) lateral force distribution over height - UNVERIFIED - confirm in the current edition')\n    return L\n\n\n# name -> {'name', 'codes', 'items'} ; other countries plug in with register_country()\nCOUNTRIES = {}\n\n\ndef register_country(key, name, codes, items):\n    \"\"\"add a country: items = dict of library items (same keys as INDIA where the engine needs them)\"\"\"\n    COUNTRIES[key] = {'name': name, 'codes': codes, 'items': items}\n\n\nregister_country('INDIA', 'India', ['IS 456', 'IS 875 (1-3, 5)', 'IS 1893', 'IS 13920', 'IS 1904', 'IS 6403', 'IS 2911'], _sgc_india())\n# A country with NO values: every check that needs a missing item reports NOT CHECKED (item named). Fill it in to plug a code in.\nregister_country('OTHER', 'Other / user-defined (empty library)', [], {})\n\n# which IS codes the tool knows about, and how far each one is used (honest scope list for the UI + report)\nINDIA_CODE_USE = [\n    ('IS 456:2000', 'USED (partly)', 'limit-state factors, Table 19/20 shear, span/depth, column axial formula, footing shear sections'),\n    ('IS 875 Part 1', 'USED (partly)', 'unit weights (RCC value from a secondary source)'),\n    ('IS 875 Part 2', 'USED (partly)', 'imposed floor + roof loads (residential / roof verified, others flagged)'),\n    ('IS 875 Part 3', 'NOT DONE', 'wind load: NOT CHECKED'),\n    ('IS 875 Part 5', 'NOT DONE', 'load combinations beyond DL+IL: NOT CHECKED'),\n    ('IS 1893', 'INPUT-DRIVEN', 'base shear coefficient method only if you type Z, I, R, Sa/g; no member design for lateral load'),\n    ('IS 13920', 'NOT DONE', 'ductile detailing: NOT CHECKED'),\n    ('IS 1904', 'NOT DONE', 'foundations in soil: needs real soil data - only bearing / punching / shear sketch checks'),\n    ('IS 6403', 'NOT DONE', 'bearing capacity: you type the allowable bearing capacity from the geotechnical report'),\n    ('IS 2911', 'NOT DONE', 'pile foundations: NOT DONE'),\n]\n\n\ndef get_lib(country):\n    c = COUNTRIES.get(str(country or 'INDIA').upper())\n    return c['items'] if c else {}\n\n\ndef lib(country, key):\n    \"\"\"library item or None (missing = the check using it must say NOT CHECKED)\"\"\"\n    return get_lib(country).get(key)\n\n\ndef libv(country, key, default=None):\n    it = lib(country, key)\n    return it['value'] if it is not None else default\n\n\ndef src_line(country, key):\n    it = lib(country, key)\n    if it is None:\n        return '%s: MISSING from the %s library' % (key, country)\n    return '%s [%s] %s' % (it['ref'], it['source'], it.get('note', ''))\n\n\ndef lib_table(country):\n    \"\"\"rows for the code-library report / export\"\"\"\n    rows = []\n    for k in sorted(get_lib(country)):\n        it = get_lib(country)[k]\n        v = it['value']\n        if isinstance(v, (dict, list)):\n            v = json.dumps(v, sort_keys=True)\n        rows.append((k, v, it['unit'], it['source'], it['ref'], it.get('note', '')))\n    return rows\n\n\ndef interp_tau_c(country, fck, pt):\n    \"\"\"design shear strength of concrete tau_c (N/mm2) for 100As/bd = pt; None when the grade is outside the library\"\"\"\n    tbl = libv(country, 'tau_c')\n    rows = libv(country, 'tau_c_pt')\n    if not tbl or not rows:\n        return None\n    g = int(round(fck / 5.0) * 5)\n    if g < 20:\n        return None\n    g = min(g, 40)\n    col = tbl.get(g)\n    if col is None:\n        return None\n    p = max(rows[0], min(rows[-1], float(pt)))\n    for i in range(len(rows) - 1):\n        if rows[i] <= p <= rows[i + 1]:\n            t = (p - rows[i]) / (rows[i + 1] - rows[i])\n            return col[i] + t * (col[i + 1] - col[i])\n    return col[-1]\n\n\ndef tau_c_max(country, fck):\n    tbl = libv(country, 'tau_c_max')\n    if not tbl:\n        return None\n    g = int(round(fck / 5.0) * 5)\n    g = max(15, min(40, g))\n    return tbl.get(g)\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - load engine (pure Python; needs sg_codes.py in the same namespace)\n#  Units: lengths mm unless the name says _m; loads kN, kN/m, kN/m2; stresses N/mm2.\n#  Each function returns the number AND the list of library keys / sources it used, so the report can show them.\n# =====================================================================\n\n\ndef sg_floor_dead(country, slab_t_mm, kind='floor'):\n    \"\"\"dead load on a slab (kN/m2): self weight + finishes + services (+ partitions on floors).\n    returns (total, rows) rows = [(label, value, source, ref)]\"\"\"\n    rows = []\n    g = lib(country, 'gamma_rcc')\n    if g is None:\n        return None, [('slab self weight', None, 'MISSING', 'gamma_rcc missing from the library')]\n    rows.append(('slab self weight %.0f mm x %.1f kN/m3' % (slab_t_mm, g['value']), slab_t_mm / 1000.0 * g['value'], g['source'], g['ref']))\n    keys = ['dl_roof_finish', 'dl_ceiling_services'] if kind == 'roof' else ['dl_floor_finish', 'dl_ceiling_services', 'dl_partition']\n    for k in keys:\n        it = lib(country, k)\n        if it is None:\n            rows.append((k, None, 'MISSING', k + ' missing from the library'))\n        else:\n            rows.append((k, it['value'], it['source'], it['ref']))\n    tot = sum(r[1] for r in rows if r[1] is not None)\n    return tot, rows\n\n\ndef sg_live(country, use, zone='room'):\n    \"\"\"imposed load kN/m2 for a building use and zone ('room','corridor','balcony','roof_access','roof_noaccess').\n    returns (value or None, source, ref)\"\"\"\n    use = str(use or '').lower()\n    if zone == 'roof_access':\n        key = 'll_roof_access'\n    elif zone == 'roof_noaccess':\n        key = 'll_roof_noaccess'\n    elif use.startswith('res'):\n        key = {'room': 'll_residential', 'corridor': 'll_residential_corridor', 'balcony': 'll_balcony'}.get(zone, 'll_residential')\n    elif use.startswith('off'):\n        key = 'll_office_corridor' if zone == 'corridor' else 'll_office'\n    elif use.startswith('com'):\n        key = 'll_commercial'\n    elif use.startswith('hos'):\n        key = 'll_hospital'\n    else:\n        return None, 'MISSING', 'no imposed-load value for use \"%s\" (storage / industrial / assembly: type the value from IS 875 Part 2 yourself)' % use\n    it = lib(country, key)\n    if it is None:\n        return None, 'MISSING', key + ' missing from the library'\n    return it['value'], it['source'], it['ref']\n\n\ndef sg_ll_reduction_pct(country, n_floors):\n    \"\"\"% reduction of imposed load on a column carrying n floors (incl. roof). 0 when the table is missing.\"\"\"\n    t = libv(country, 'll_reduction_table')\n    if not t:\n        return 0.0\n    pct = 0.0\n    for n, p in t:\n        if n_floors >= n:\n            pct = p\n    return pct\n\n\ndef sg_wall_line_load(t_mm, h_mm, gamma, plaster_mm=24.0, open_frac=0.0, plaster_gamma=20.4):\n    \"\"\"kN/m of wall: brick/block + plaster both sides (plaster_mm total), minus an opening fraction. TEXTBOOK (weight = volume x unit weight)\"\"\"\n    t, h = t_mm / 1000.0, h_mm / 1000.0\n    w = (t * gamma + plaster_mm / 1000.0 * plaster_gamma) * h\n    return w * (1.0 - open_frac)\n\n\ndef sg_beam_self(b_mm, h_mm, gamma, slab_t_mm=0.0):\n    \"\"\"kN/m beam self weight (web below the slab if slab_t given). TEXTBOOK\"\"\"\n    return b_mm / 1000.0 * max(0.0, (h_mm - slab_t_mm)) / 1000.0 * gamma\n\n\ndef sg_panel_to_beams(w, lx_m, ly_m, oneway_ratio=2.0):\n    \"\"\"Slab panel load w (kN/m2) lx<=ly -> equivalent UDL (kN/m) on the supporting beams.\n    TEXTBOOK 45-degree load distribution (e.g. Pillai & Menon, Reinforced Concrete Design):\n      two-way (ly/lx <= ratio): short-span beam  shear-equivalent w lx/4 , moment-equivalent w lx/3\n                                long-span beam   shear-equivalent w lx (2-m)/4 , moment-equivalent w lx (3-m^2)/6 , m = lx/ly\n      one-way (ly/lx >  ratio): the two LONG edges carry w lx/2, the short edges nothing.\n    returns dict\"\"\"\n    lx, ly = min(lx_m, ly_m), max(lx_m, ly_m)\n    if lx <= 0:\n        return {'mode': 'NONE', 'short_shear': 0.0, 'short_mom': 0.0, 'long_shear': 0.0, 'long_mom': 0.0, 'lx': lx, 'ly': ly, 'ratio': 0.0}\n    r = ly / lx\n    if r > oneway_ratio:\n        q = w * lx / 2.0\n        return {'mode': 'ONE-WAY', 'short_shear': 0.0, 'short_mom': 0.0, 'long_shear': q, 'long_mom': q, 'lx': lx, 'ly': ly, 'ratio': r}\n    m = lx / ly\n    return {'mode': 'TWO-WAY', 'short_shear': w * lx / 4.0, 'short_mom': w * lx / 3.0,\n            'long_shear': w * lx * (2.0 - m) / 4.0, 'long_mom': w * lx * (3.0 - m * m) / 6.0, 'lx': lx, 'ly': ly, 'ratio': r}\n\n\ndef sg_factored(country, DL, LL):\n    \"\"\"ultimate load (collapse limit state, DL+IL) and service load. returns (Pu, Ps, gf_dl, gf_ll, rows)\"\"\"\n    a, b, c, d = lib(country, 'gf_dl'), lib(country, 'gf_ll'), lib(country, 'gs_dl'), lib(country, 'gs_ll')\n    if a is None or b is None:\n        return None, DL + LL, None, None, ['load factors missing from the library -> factored load NOT CHECKED']\n    return (a['value'] * DL + b['value'] * LL, (c['value'] if c else 1.0) * DL + (d['value'] if d else 1.0) * LL, a['value'], b['value'],\n            [a['ref'] + ' [' + a['source'] + ']'])\n\n\ndef sg_seismic(W_list, h_list, Z, I, R, SaG):\n    \"\"\"INPUT-DRIVEN coefficient method (formula structure only; every parameter is typed by the user, no defaults):\n       Ah = (Z/2)(Sa/g)/(R/I) ; VB = Ah * W ; Qi = VB Wi hi^2 / sum(Wj hj^2).\n       W_list: seismic weight of each storey (kN), h_list: height of each floor above base (m).  returns dict or None\"\"\"\n    if None in (Z, I, R, SaG) or R == 0:\n        return None\n    Ah = (Z / 2.0) * SaG / (R / float(I))\n    W = sum(W_list)\n    VB = Ah * W\n    den = sum(w * h * h for w, h in zip(W_list, h_list))\n    Q = [VB * w * h * h / den if den > 0 else 0.0 for w, h in zip(W_list, h_list)]\n    return {'Ah': Ah, 'W': W, 'VB': VB, 'Q': Q}\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - member design / checks (pure Python; needs sg_codes.py + sg_loads.py in the namespace)\n#  Simplified hand-calculation methods only: simply-supported beam moments (conservative for continuous beams),\n#  short axially loaded columns, one-way slab strip.  No frame analysis.  Results are PROPOSALS.\n#  Every check returns a dict {id, name, status PASS|FAIL|NOT CHECKED, detail, basis:[...], flags:[...]}.\n# =====================================================================\n\n\ndef sg_chk(cid, name, status, detail, country=None, keys=None, extra=None):\n    \"\"\"one check result. basis = source line of every library item used; flags = UNVERIFIED / SECONDARY items it relies on\"\"\"\n    basis, flags = [], []\n    for k in (keys or []):\n        it = lib(country, k)\n        if it is None:\n            basis.append('%s: MISSING from the library' % k)\n            flags.append('MISSING ' + k)\n        else:\n            basis.append('%s [%s]' % (it['ref'], it['source']))\n            if it['source'] in ('UNVERIFIED', 'SECONDARY'):\n                flags.append('%s relies on %s value' % (k, it['source']))\n    r = {'id': cid, 'name': name, 'status': status, 'detail': detail, 'basis': basis, 'flags': flags}\n    if extra:\n        r.update(extra)\n    return r\n\n\ndef sg_nc(cid, name, why):\n    \"\"\"NOT CHECKED - why names the missing input / method\"\"\"\n    return {'id': cid, 'name': name, 'status': 'NOT CHECKED', 'detail': why, 'basis': [], 'flags': []}\n\n\n# ------------------------------------------------------------------ flexure helpers (IS 456 Annex G forms, OFFICIAL)\ndef sg_ast_required(Mu_kNm, b, d, fck, fy):\n    \"\"\"Ast (mm2) of a singly reinforced rectangular section for Mu: Mu = 0.87 fy Ast d (1 - Ast fy/(b d fck)).\n    returns None when Mu is beyond what a section of this size can carry in bending alone\"\"\"\n    Mu = Mu_kNm * 1e6\n    A = 0.87 * fy * fy / (b * fck)\n    B = 0.87 * fy * d\n    disc = B * B - 4.0 * A * Mu\n    if disc < 0:\n        return None\n    return (B - math.sqrt(disc)) / (2.0 * A)\n\n\ndef sg_mu_lim_kNm(country, b, d, fck, fy):\n    x = libv(country, 'xu_max_d', {}).get(int(fy)) if libv(country, 'xu_max_d') else None\n    if x is None:\n        return None\n    return 0.36 * x * (1.0 - 0.42 * x) * fck * b * d * d / 1e6\n\n\n# ------------------------------------------------------------------ beams\ndef sg_beam_design(country, span_m, wu_shear, wu_mom, b, D, fck, fy, support='SS', eff_cover=40.0, cid='BEAM'):\n    \"\"\"check ONE beam span. wu_* = factored UDL kN/m (shear-equivalent / moment-equivalent, incl. self weight).\n    support SS (simply supported / default) | CONT (continuous: depth ratio 26 but moments still wL2/8 = conservative) | CANT.\n    returns dict with the numbers and a list of checks\"\"\"\n    d = D - eff_cover\n    out = {'span_m': span_m, 'b': b, 'D': D, 'd': d, 'checks': []}\n    chks = out['checks']\n    # depth / deflection (simplified): span/d against the basic ratio * modification factor (assumed 1.0)\n    lk = {'SS': 'ld_ss', 'CONT': 'ld_cont', 'CANT': 'ld_cant'}[support]\n    basic = lib(country, lk)\n    mf = libv(country, 'ld_modfactor', 1.0)\n    if basic is None:\n        chks.append(sg_nc(cid + '.defl', 'beam depth (span/d)', lk + ' missing from the library'))\n    else:\n        dreq = span_m * 1000.0 / (basic['value'] * mf)\n        chks.append(sg_chk(cid + '.defl', 'beam depth (span/d)', 'PASS' if d >= dreq else 'FAIL',\n                           'span %.2f m, d %.0f mm, need d >= %.0f mm (span/%.0f x mf %.1f)' % (span_m, d, dreq, basic['value'], mf),\n                           country, [lk, 'ld_modfactor'], {'d_req': dreq}))\n        out['d_req'] = dreq\n    # bending\n    k = 0.5 if support == 'CANT' else 1.0 / 8.0\n    Mu = wu_mom * span_m * span_m * (k if support != 'CANT' else 0.5)\n    Vu = wu_shear * span_m / 2.0 if support != 'CANT' else wu_shear * span_m\n    out['Mu'], out['Vu'] = Mu, Vu\n    mlim = sg_mu_lim_kNm(country, b, d, fck, fy)\n    ast = sg_ast_required(Mu, b, d, fck, fy)\n    if mlim is None:\n        chks.append(sg_nc(cid + '.bend', 'beam bending', 'xu,max/d for fy %s is not in the library' % fy))\n        ast = None\n    else:\n        ok = (Mu <= mlim) and ast is not None\n        chks.append(sg_chk(cid + '.bend', 'beam bending (singly reinforced)', 'PASS' if ok else 'FAIL',\n                           'Mu %.1f kNm vs Mu,lim %.1f kNm; Ast about %s mm2 (indicative, NOT a reinforcement design)' % (\n                               Mu, mlim, ('%.0f' % ast) if ast else 'n/a'), country, ['xu_max_d', 'stress_block', 'gf_dl'],\n                           {'mu_lim': mlim, 'ast': ast}))\n    out['ast'] = ast\n    # shear\n    if ast is not None:\n        amin = (libv(country, 'beam_ast_min_k', 0.85) / fy) * b * d\n        a_use = max(ast, amin)\n        pt = 100.0 * a_use / (b * d)\n        tc = interp_tau_c(country, fck, pt)\n        tmax = tau_c_max(country, fck)\n        tv = Vu * 1000.0 / (b * d)\n        if tc is None or tmax is None:\n            chks.append(sg_nc(cid + '.shear', 'beam shear', 'tau_c / tau_c,max for grade M%d not in the library (library covers M20 and above)' % fck))\n        else:\n            st = 'PASS' if tv <= tmax else 'FAIL'\n            txt = 'Vu %.1f kN, tau_v %.2f N/mm2, tau_c %.2f (100As/bd %.2f), tau_c,max %.2f; ' % (Vu, tv, tc, pt, tmax)\n            txt += 'stirrups to be DESIGNED' if tv > tc else 'nominal stirrups only'\n            chks.append(sg_chk(cid + '.shear', 'beam shear', st, txt, country, ['tau_c', 'tau_c_max'], {'tau_v': tv, 'tau_c': tc}))\n        # tension steel limits\n        pmax = libv(country, 'beam_pt_max', 4.0)\n        pt_gross = 100.0 * a_use / (b * D)\n        chks.append(sg_chk(cid + '.pt', 'beam tension steel limit', 'PASS' if pt_gross <= pmax else 'FAIL',\n                           'Ast/bD = %.2f %% (limit %.1f %%)' % (pt_gross, pmax), country, ['beam_pt_max']))\n    return out\n\n\ndef sg_propose_beam(country, span_m, wu_shear_fn, fck, fy, b_min=230.0, support='SS', step=25.0, dmax=1200.0):\n    \"\"\"smallest depth (mm, step 25) that passes depth + bending + shear. wu_shear_fn(D) -> (wu_shear, wu_mom) (self weight depends on D).\n    returns (b, D, design dict) - D is capped at dmax and the design then FAILs visibly\"\"\"\n    b = b_min\n    D = max(300.0, math.ceil(span_m * 1000.0 / 20.0 / step) * step * 0.6)\n    best = None\n    while D <= dmax:\n        ws, wm = wu_shear_fn(b, D)\n        des = sg_beam_design(country, span_m, ws, wm, b, D, fck, fy, support)\n        best = (b, D, des)\n        if all(c['status'] != 'FAIL' for c in des['checks']):\n            return best\n        D += step\n    return best\n\n\n# ------------------------------------------------------------------ columns\ndef sg_col_capacity_kN(country, b, h, fck, fy, pt_pct):\n    \"\"\"Pu = 0.4 fck Ac + 0.67 fy Asc  (SECONDARY source for the formula); Asc = pt % of gross, Ac = gross - Asc\"\"\"\n    f = libv(country, 'col_pu_formula')\n    if not f:\n        return None\n    Ag = b * h\n    Asc = Ag * pt_pct / 100.0\n    return (f['k_c'] * fck * (Ag - Asc) + f['k_s'] * fy * Asc) / 1000.0\n\n\ndef sg_col_check(country, Pu_kN, b, h, L_mm, fck, fy, pt_pct=None, strict=True, cid='COL'):\n    \"\"\"check one column section for axial load only (frame / lateral moments are NOT included).\n    returns list of checks + the steel % needed\"\"\"\n    chks = []\n    cf = libv(country, 'col_pu_formula')\n    emin = libv(country, 'col_emin')\n    k_eff = libv(country, 'col_k_eff', 1.0)\n    lim = libv(country, 'col_slender_limit')\n    pmin, pmax = libv(country, 'col_pt_min'), libv(country, 'col_pt_max')\n    if not (cf and emin and pmin and pmax):\n        return [sg_nc(cid + '.axial', 'column axial capacity', 'column formula / limits missing from the %s library' % country)], None\n    le = k_eff * L_mm\n    if lim:\n        ratio = max(le / min(b, h), le / max(b, h))\n        chks.append(sg_chk(cid + '.slender', 'column slenderness', 'PASS' if le / min(b, h) < lim else 'FAIL',\n                           'le = %.2f x %.0f = %.0f mm, le/D = %.1f (short column if < %.0f); slender-column additional moments are NOT implemented' % (\n                               k_eff, L_mm, le, le / min(b, h), lim), country, ['col_slender_limit', 'col_k_eff']))\n    ex = max(emin['min_mm'], L_mm / emin['L_div'] + h / emin['D_div'])\n    ey = max(emin['min_mm'], L_mm / emin['L_div'] + b / emin['D_div'])\n    applicable = ex <= 0.05 * h and ey <= 0.05 * b\n    # steel needed for Pu:  Pu = 0.4 fck (Ag - Asc) + 0.67 fy Asc\n    Ag = b * h\n    den = cf['k_s'] * fy - cf['k_c'] * fck\n    asc = (Pu_kN * 1000.0 - cf['k_c'] * fck * Ag) / den if den > 0 else None\n    pt_req = None if asc is None else max(pmin, 100.0 * asc / Ag)\n    cap_max = sg_col_capacity_kN(country, b, h, fck, fy, pmax)\n    cap_min = sg_col_capacity_kN(country, b, h, fck, fy, pmin)\n    fits = Pu_kN <= cap_max\n    if not applicable and strict:\n        st = 'NOT CHECKED'\n        why = 'minimum eccentricity %.0f / %.0f mm exceeds 0.05 x dimension (%.0f / %.0f mm): the short-column axial formula does not apply, a bending design with the minimum eccentricity is needed (not implemented)' % (\n            ex, ey, 0.05 * h, 0.05 * b)\n    elif fits:\n        st = 'PASS'\n        why = ''\n    else:\n        st = 'FAIL'\n        why = ''\n    detail = 'Pu %.0f kN vs capacity %.0f kN at %.1f %% steel (%.0f kN at %.1f %%); steel needed about %.2f %% of gross (indicative); %s' % (\n        Pu_kN, cap_max, pmax, cap_min, pmin, pt_req if pt_req else 0.0, why or 'e_min ok')\n    chks.append(sg_chk(cid + '.axial', 'column axial capacity (no frame moments)', st, detail, country,\n                       ['col_pu_formula', 'col_emin', 'col_pt_min', 'col_pt_max', 'gf_dl'], {'pt_req': pt_req, 'applicable': applicable}))\n    return chks, pt_req\n\n\ndef sg_propose_column(country, Pu_kN, L_mm, fck, fy, b_pref=None, min_mm=230.0, step=25.0, strict=True, pt_design=None, max_mm=1500.0):\n    \"\"\"smallest column (b, h) mm, h >= b, that carries Pu with at most the design steel % (ASSUMPTION) and, when strict, whose\n    both sides satisfy the applicability rule of the short-column axial formula (e_min <= 0.05 x side, IS 456 39.3).\n    b_pref = preferred width (the wall thickness) - used when it is large enough, otherwise the smallest applicable side\"\"\"\n    cf = libv(country, 'col_pu_formula')\n    emin = libv(country, 'col_emin')\n    if not cf or not emin:\n        return None\n    ptd = pt_design if pt_design else libv(country, 'col_pt_design', 2.0)\n\n    def applicable(D):\n        return max(emin['min_mm'], L_mm / emin['L_div'] + D / emin['D_div']) <= 0.05 * D + 1e-9\n    b = math.ceil(max(min_mm, b_pref or min_mm) / step - 1e-9) * step\n    if strict:\n        while not applicable(b) and b < max_mm:\n            b += step\n    h = b\n    while h <= max_mm:\n        bb = max(b, math.ceil(h / 2.0 / step - 1e-9) * step)          # keep the aspect ratio <= 2: the width grows with the depth\n        if sg_col_capacity_kN(country, bb, h, fck, fy, ptd) >= Pu_kN:\n            return (bb, h)\n        h += step\n    return (max(b, math.ceil(max_mm / 2.0 / step) * step), max_mm)\n\n\n# ------------------------------------------------------------------ slab (one-way strip, thickness)\ndef sg_slab_thickness(country, lx_m, kind='SS', cover=25.0, step=5.0, tmin=125.0):\n    \"\"\"slab overall thickness from the span/effective-depth ratio (IS 456 23.2.1, mf = ASSUMED 1.0; short span lx). PROPOSAL\"\"\"\n    lk = {'SS': 'ld_ss', 'CONT': 'ld_cont', 'CANT': 'ld_cant'}[kind]\n    r = libv(country, lk)\n    mf = libv(country, 'ld_modfactor', 1.0)\n    if r is None:\n        return None\n    d = lx_m * 1000.0 / (r * mf)\n    return max(tmin, math.ceil((d + cover) / step) * step)\n\n\ndef sg_slab_check(country, lx_m, ly_m, t_mm, kind='SS', cover=25.0, cid='SLAB'):\n    \"\"\"slab thickness check only (span/d). Strength of two-way panels needs the Annex D moment coefficients (not implemented): NOT CHECKED\"\"\"\n    lk = {'SS': 'ld_ss', 'CONT': 'ld_cont', 'CANT': 'ld_cant'}[kind]\n    r = libv(country, lk)\n    mf = libv(country, 'ld_modfactor', 1.0)\n    out = []\n    if r is None:\n        return [sg_nc(cid + '.defl', 'slab thickness (span/d)', lk + ' missing from the library')]\n    d = t_mm - cover\n    need = lx_m * 1000.0 / (r * mf)\n    out.append(sg_chk(cid + '.defl', 'slab thickness (span/d)', 'PASS' if d >= need else 'FAIL',\n                      'short span %.2f m, d %.0f mm, need d >= %.0f mm' % (lx_m, d, need), country, [lk, 'ld_modfactor']))\n    out.append(sg_nc(cid + '.str', 'slab strength / reinforcement', 'two-way slab moment coefficients (IS 456 Annex D) are not implemented - design the slab separately'))\n    return out\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - foundation engine (pure Python; needs sg_codes / sg_loads / sg_design in the namespace)\n#  Isolated + combined RECTANGULAR pad footings under axial load only (no moments, no eccentricity, no groundwater,\n#  no settlement).  Strip / raft / pile: the engine only RECOMMENDS (overlap + coverage rule), it does not design them.\n#  SOIL DATA ARE MANDATORY INPUTS: allowable bearing pressure (kN/m2) and founding depth (m) from a geotechnical report.\n#  There are NO defaults - without them no footing size is produced.\n# =====================================================================\n\n\ndef sg_soil_ok(soil):\n    \"\"\"soil = {'sbc': kN/m2, 'df': m, 'gw': m or None, 'placeholder': bool}. returns (ok, [what is missing])\"\"\"\n    miss = []\n    if not soil or not soil.get('sbc') or float(soil.get('sbc') or 0) <= 0:\n        miss.append('allowable bearing pressure (kN/m2) from the geotechnical report')\n    if not soil or not soil.get('df') or float(soil.get('df') or 0) <= 0:\n        miss.append('founding depth (m) from the geotechnical report')\n    return (len(miss) == 0), miss\n\n\ndef _sgf_up(v, step):\n    return math.ceil(v / step - 1e-9) * step\n\n\ndef sg_footing_plan(country, P_service_kN, sbc, col_b, col_h, step=50.0, ratio=True):\n    \"\"\"plan size (L along col_h, B along col_b) mm so that P(1+self weight allowance)/(L B) <= sbc.\n    TEXTBOOK: A = P / q_allowable.  returns dict\"\"\"\n    f = libv(country, 'ftg_self_weight_frac', 0.10)\n    A_m2 = P_service_kN * (1.0 + f) / sbc\n    asp = (col_h / float(col_b)) if (ratio and col_b > 0) else 1.0\n    asp = max(1.0, min(asp, 2.0))\n    B = math.sqrt(A_m2 / asp) * 1000.0\n    Bm = _sgf_up(B, step)\n    Lm = _sgf_up(B * asp, step)\n    area = Bm * Lm / 1e6\n    return {'L': Lm, 'B': Bm, 'area_req_m2': A_m2, 'area_m2': area, 'pressure': P_service_kN * (1.0 + f) / area, 'allow': f}\n\n\ndef sg_footing_design(country, Pu_kN, L, B, col_b, col_h, fck, fy, thk=None, cover=None):\n    \"\"\"thickness + shear / punching checks for a pad footing under axial Pu (kN). L (mm) is along col_h, B along col_b.\n    When thk is None the smallest thickness (step 25 mm) that passes one-way shear and punching is searched.\n    Flexure gives an INDICATIVE Ast only. returns dict {D, d, checks[], ast_L, ast_B}\"\"\"\n    cov = cover if cover is not None else libv(country, 'ftg_cover', 50.0)\n    tmin = libv(country, 'ftg_min_thk', 300.0)\n    pk = libv(country, 'ftg_punch')\n    chks_all = None\n    D = thk if thk else tmin\n    qu = Pu_kN / (L * B / 1e6)             # kN/m2 net factored upward pressure (axial only)\n    while True:\n        d = D - cov - 8.0                  # 16 mm bars assumed: cover + half bar\n        chks = []\n        res = {'D': D, 'd': d, 'qu': qu}\n        # bending at the column face (both directions) -> indicative steel\n        pts = []\n        for nm, span, w, cdim in (('long', L, B, col_h), ('short', B, L, col_b)):\n            a = (span - cdim) / 2.0 / 1000.0                       # m, projection beyond the column face\n            Mu = qu * (w / 1000.0) * a * a / 2.0                   # kNm\n            ast = sg_ast_required(Mu, w, d, fck, fy)\n            res['ast_' + nm] = ast\n            res['Mu_' + nm] = Mu\n            if ast is not None:\n                astmin = (libv(country, 'slab_ast_min', {}).get('HYSD', 0.12) / 100.0) * w * D\n                ast = max(ast, astmin)\n                res['ast_' + nm] = ast\n                pts.append(100.0 * ast / (w * d))\n            else:\n                pts.append(None)\n        # one-way shear at d from the column face - the larger projection governs\n        worst = None\n        for nm, span, w, cdim, pt in (('long', L, B, col_h, pts[0]), ('short', B, L, col_b, pts[1])):\n            a = (span - cdim) / 2.0\n            Vu = qu * (w / 1000.0) * max(0.0, a - d) / 1000.0      # kN\n            tv = Vu * 1000.0 / (w * d)\n            tc = interp_tau_c(country, fck, pt if pt else 0.15)\n            if worst is None or tv > worst[0]:\n                worst = (tv, tc, nm, Vu)\n        tv, tc, nm, Vu = worst\n        if tc is None:\n            chks.append(sg_nc('FTG.shear', 'footing one-way shear', 'tau_c for grade M%d not in the library' % fck))\n            ok1 = True\n        else:\n            ok1 = tv <= tc\n            chks.append(sg_chk('FTG.shear', 'footing one-way shear (section d from the column face)', 'PASS' if ok1 else 'FAIL',\n                               'tau_v %.2f vs tau_c %.2f N/mm2 (%s direction, Vu %.0f kN)' % (tv, tc, nm, Vu), country,\n                               ['ftg_oneway_section', 'tau_c']))\n        # punching at d/2\n        if pk is None:\n            chks.append(sg_nc('FTG.punch', 'footing punching shear', 'ftg_punch missing from the library'))\n            ok2 = True\n        else:\n            b1, h1 = col_b + d, col_h + d\n            b0 = 2.0 * (b1 + h1)\n            Vp = Pu_kN - qu * (b1 * h1 / 1e6)\n            tp = Vp * 1000.0 / (b0 * d)\n            beta = min(col_b, col_h) / float(max(col_b, col_h))\n            ks = min(1.0, 0.5 + beta)\n            allow = ks * pk['k'] * math.sqrt(fck)\n            ok2 = tp <= allow\n            chks.append(sg_chk('FTG.punch', 'footing punching shear (perimeter d/2 from the column face)', 'PASS' if ok2 else 'FAIL',\n                               'tau_p %.2f vs ks*0.25*sqrt(fck) = %.2f N/mm2 (ks %.2f, Vp %.0f kN)' % (tp, allow, ks, Vp), country, ['ftg_punch']))\n        if thk or (ok1 and ok2) or D >= 2500:\n            res['checks'] = chks\n            return res\n        D += 25.0\n\n\ndef sg_footing_boxes(cols):\n    \"\"\"cols = [{'id','x','y','L','B'}] -> axis-aligned boxes (mm)\"\"\"\n    return [(c['id'], c['x'] - c['L'] / 2.0, c['y'] - c['B'] / 2.0, c['x'] + c['L'] / 2.0, c['y'] + c['B'] / 2.0) for c in cols]\n\n\ndef sg_overlaps(cols, clear=150.0):\n    \"\"\"pairs of footings closer than `clear` mm (overlap or practically touching). TEXTBOOK geometry\"\"\"\n    bx = sg_footing_boxes(cols)\n    out = []\n    for i in range(len(bx)):\n        for j in range(i + 1, len(bx)):\n            a, b = bx[i], bx[j]\n            gx = max(a[1] - b[3], b[1] - a[3])\n            gy = max(a[2] - b[4], b[2] - a[4])\n            gap = max(gx, gy)\n            if gap < clear:\n                out.append((a[0], b[0], gap))\n    return out\n\n\ndef sg_combined(country, c1, c2, P1_service, P2_service, sbc, step=50.0):\n    \"\"\"rectangular combined footing for two columns c = {'x','y'} (service loads kN). Centroid of the footing = resultant of the loads\n    (TEXTBOOK). The long side runs along the line joining the columns. returns dict\"\"\"\n    f = libv(country, 'ftg_self_weight_frac', 0.10)\n    P = P1_service + P2_service\n    A = P * (1.0 + f) / sbc\n    dx, dy = c2['x'] - c1['x'], c2['y'] - c1['y']\n    s = math.hypot(dx, dy)\n    if s < 1e-6:\n        return None\n    ux, uy = dx / s, dy / s\n    xbar = P2_service * s / P                                 # resultant measured from column 1 along the line (mm)\n    e1 = max(300.0, c1.get('half', 150.0) + 150.0)          # projection beyond the outer column faces (ASSUMPTION)\n    e2 = max(300.0, c2.get('half', 150.0) + 150.0)\n    # footing centroid = load resultant: the footing must reach e beyond both columns measured from the centroid\n    Lc = _sgf_up(2.0 * max(xbar + e1, (s - xbar) + e2), step)\n    Bc = _sgf_up(A * 1e6 / Lc, step)\n    cx0 = c1['x'] + ux * xbar\n    cy0 = c1['y'] + uy * xbar\n    return {'cx': cx0, 'cy': cy0, 'L': Lc, 'B': Bc, 'ux': ux, 'uy': uy, 'area_m2': Lc * Bc / 1e6, 'area_req_m2': A, 'xbar': xbar}\n\n\ndef sg_foundation_advice(country, plan_area_m2, footings, overlaps, raft_ratio=None):\n    \"\"\"recommendations with reasons. footings = list of {'L','B'} mm\"\"\"\n    rr = raft_ratio if raft_ratio else libv(country, 'raft_ratio', 0.5)\n    tot = sum(f['L'] * f['B'] for f in footings) / 1e6\n    out = []\n    if plan_area_m2 > 0:\n        ratio = tot / plan_area_m2\n        if ratio > rr:\n            out.append('Footing area %.1f m2 is %.0f %% of the building plan area (> %.0f %% rule of thumb [ASSUMPTION]) - consider a RAFT foundation. Not designed by this tool.' % (\n                tot, 100.0 * ratio, 100.0 * rr))\n        else:\n            out.append('Footing area %.1f m2 = %.0f %% of the plan area (<= %.0f %%): isolated footings are plausible on this load/bearing basis.' % (tot, 100.0 * ratio, 100.0 * rr))\n    if overlaps:\n        out.append('%d footing pair(s) overlap or nearly touch: combine them (combined footing) or use strip footings / raft. Reason: isolated pads cannot be built through each other.' % len(overlaps))\n    return out\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - structural layout generation (pure Python, no Revit; needs sg_codes in the namespace)\n#  Input  = plain geometry dict (see sg_geometry.py / tests): mm, plan x/y of ONE reference storey\n#      walls   [{id,a:(x,y),b:(x,y),t,h,ext,openings:[(pos_from_a,width)]}]   rooms [{id,name,poly}]   floors [{poly}]\n#      grids   [{name,a,b}]   stairs [{id,poly}]   openings [{id,poly,kind}]   existing_columns [(x,y)]\n#  Output = columns (with the engineering REASON for each), beams (primary / secondary / stair), slab panels, tributary\n#  areas, warnings and the junctions that were deliberately NOT turned into columns.\n#\n#  Method (all PROPOSAL / ASSUMPTION - there is no code clause for \"where to put a column\"):\n#   1 rotate the plan to its dominant wall direction; walls >= min thickness become structural lines (X lines and Y lines)\n#   2 mandatory columns: building corners, free wall ends, stair/lift core corners that coincide with a wall junction\n#     (grid mode: every grid crossing inside the building)\n#   3 junctions (T / X) are NOT columns by default; a junction becomes a column only when it is needed to cut a beam\n#     span longer than the maximum span; if no junction fits, a column is added on the line at the ideal spacing\n#     (kept out of door / window openings)\n#   4 beams between consecutive supports on every structural line; a beam end that lands on another beam is a\n#     beam-on-beam (secondary) connection\n#   5 slab panels = cells enclosed by beams; short span > max slab span -> secondary beams; stair / lift openings get\n#     trimmer beams where no beam exists\n# =====================================================================\n\nSG_DEFAULTS = {\n    'min_wall_t': 150.0,        # ASSUMPTION: walls thinner than this are partitions (no structural line)\n    'max_span': 4500.0,         # ASSUMPTION: maximum beam / column spacing in mm\n    'slab_max_span': 4500.0,    # ASSUMPTION: maximum slab short span in mm before a secondary beam is proposed\n    'core_min_area': 4.0,       # ASSUMPTION: stair / lift openings >= this (m2) get core-corner columns and trimmer beams\n    'col_size': 300.0,          # nominal column size used to keep columns away from openings\n    'source': 'AUTO',           # AUTO / WALLS / GRIDS\n    'tol': 100.0,\n}\n\n\ndef sg_rot(p, ang):\n    c, s = math.cos(ang), math.sin(ang)\n    return (p[0] * c - p[1] * s, p[0] * s + p[1] * c)\n\n\ndef sg_poly_area(poly):\n    a = 0.0\n    n = len(poly)\n    for i in range(n):\n        x1, y1 = poly[i]\n        x2, y2 = poly[(i + 1) % n]\n        a += x1 * y2 - x2 * y1\n    return abs(a) / 2.0\n\n\ndef sg_in_poly(p, poly):\n    x, y = p\n    inside = False\n    n = len(poly)\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / ((yj - yi) or 1e-12) + xi:\n            inside = not inside\n        j = i\n    return inside\n\n\ndef sg_dominant_angle(walls):\n    \"\"\"dominant wall direction in radians, folded to (-45, 45] deg, length weighted histogram (1 deg bins)\"\"\"\n    hist = {}\n    for w in walls:\n        dx, dy = w['b'][0] - w['a'][0], w['b'][1] - w['a'][1]\n        L = math.hypot(dx, dy)\n        if L < 1.0:\n            continue\n        a = math.degrees(math.atan2(dy, dx)) % 90.0\n        if a > 45.0:\n            a -= 90.0\n        k = int(round(a))\n        hist[k] = hist.get(k, 0.0) + L\n    if not hist:\n        return 0.0\n    best = max(hist, key=lambda k: hist[k])\n    # refine: weighted mean of angles within 2 deg of the best bin\n    num = den = 0.0\n    for w in walls:\n        dx, dy = w['b'][0] - w['a'][0], w['b'][1] - w['a'][1]\n        L = math.hypot(dx, dy)\n        if L < 1.0:\n            continue\n        a = math.degrees(math.atan2(dy, dx)) % 90.0\n        if a > 45.0:\n            a -= 90.0\n        if abs(a - best) <= 2.0:\n            num += a * L\n            den += L\n    return math.radians(num / den) if den > 0 else math.radians(best)\n\n\ndef _sgl_cluster(vals, tol):\n    \"\"\"1-D clustering -> list of [mean, count]\"\"\"\n    out = []\n    for v in sorted(vals):\n        if out and v - out[-1][-1] <= tol:\n            out[-1].append(v)\n        else:\n            out.append([v])\n    return [sum(c) / len(c) for c in out]\n\n\ndef _sgl_nearest(vals, v):\n    best, bi = None, -1\n    for i, x in enumerate(vals):\n        if best is None or abs(x - v) < best:\n            best, bi = abs(x - v), i\n    return bi, best\n\n\ndef sg_wall_lines(walls, ang, min_t, tol):\n    \"\"\"structural lines in the rotated frame. returns (X lines, Y lines, skew walls, thin count)\n    each line = {'pos','fam','runs':[{'s0','s1','t','ext','h','open':[(s,w)],'wall_ids'}]}  X lines are x=const (walls running along y).\"\"\"\n    vs, hs, skew, thin = [], [], [], 0\n    for w in walls:\n        a, b = sg_rot(w['a'], -ang), sg_rot(w['b'], -ang)\n        dx, dy = b[0] - a[0], b[1] - a[1]\n        L = math.hypot(dx, dy)\n        if L < 50.0:\n            continue\n        if w.get('t', 0) + 0.5 < min_t:\n            thin += 1\n            continue\n        if abs(dx) <= 0.0875 * L:                      # within ~5 deg of the y axis\n            vs.append((w, a, b))\n        elif abs(dy) <= 0.0875 * L:\n            hs.append((w, a, b))\n        else:\n            skew.append(w['id'])\n    lines = {}\n    for fam, items in (('X', vs), ('Y', hs)):\n        poss = _sgl_cluster([(a[0] + b[0]) / 2.0 if fam == 'X' else (a[1] + b[1]) / 2.0 for w, a, b in items],\n                            max(tol, 0.6 * max([w['t'] for w, a, b in items] or [0])))\n        L_ = [{'pos': p, 'fam': fam, 'runs': []} for p in poss]\n        for w, a, b in items:\n            c = (a[0] + b[0]) / 2.0 if fam == 'X' else (a[1] + b[1]) / 2.0\n            i, _d = _sgl_nearest(poss, c)\n            s0, s1 = (a[1], b[1]) if fam == 'X' else (a[0], b[0])\n            flip = s0 > s1\n            if flip:\n                s0, s1 = s1, s0\n            op = []\n            for (pos, wd) in w.get('openings', []):\n                p0 = (s1 - pos - wd) if flip else s0 + pos          # position of the opening start along the line\n                op.append((p0, wd))\n            L_[i]['runs'].append({'s0': s0, 's1': s1, 't': w['t'], 'ext': bool(w.get('ext')), 'h': w.get('h', 3000.0),\n                                  'open': op, 'wall_ids': [w['id']]})\n        for ln in L_:                                      # merge overlapping runs\n            ln['runs'].sort(key=lambda r: r['s0'])\n            m = []\n            for r in ln['runs']:\n                if m and r['s0'] <= m[-1]['s1'] + tol:\n                    q = m[-1]\n                    q['s1'] = max(q['s1'], r['s1'])\n                    q['t'] = max(q['t'], r['t'])\n                    q['ext'] = q['ext'] or r['ext']\n                    q['open'] += r['open']\n                    q['wall_ids'] += r['wall_ids']\n                else:\n                    m.append(dict(r))\n            ln['runs'] = m\n        lines[fam] = L_\n    return lines['X'], lines['Y'], skew, thin\n\n\ndef sg_grid_lines(grids, ang, extent_tol=0.0):\n    \"\"\"grids -> X / Y lines (rotated frame) with one run per grid\"\"\"\n    X, Y = [], []\n    for g in grids:\n        a, b = sg_rot(g['a'], -ang), sg_rot(g['b'], -ang)\n        dx, dy = b[0] - a[0], b[1] - a[1]\n        L = math.hypot(dx, dy)\n        if L < 1.0:\n            continue\n        if abs(dx) <= 0.0875 * L:\n            X.append({'pos': (a[0] + b[0]) / 2.0, 'fam': 'X', 'name': g.get('name', ''),\n                      'runs': [{'s0': min(a[1], b[1]), 's1': max(a[1], b[1]), 't': 0.0, 'ext': False, 'h': 0.0, 'open': [], 'wall_ids': []}]})\n        elif abs(dy) <= 0.0875 * L:\n            Y.append({'pos': (a[1] + b[1]) / 2.0, 'fam': 'Y', 'name': g.get('name', ''),\n                      'runs': [{'s0': min(a[0], b[0]), 's1': max(a[0], b[0]), 't': 0.0, 'ext': False, 'h': 0.0, 'open': [], 'wall_ids': []}]})\n    return X, Y\n\n\ndef _sgl_pt(X, Y, fam, line, s):\n    \"\"\"local (x, y) of position s along a line\"\"\"\n    return (line['pos'], s) if fam == 'X' else (s, line['pos'])\n\n\ndef sg_nodes(X, Y, tol):\n    \"\"\"crossings of X and Y lines where both lines have a run + free line ends. returns list of node dicts\"\"\"\n    nodes = []\n    for i, lx in enumerate(X):\n        for j, ly in enumerate(Y):\n            x, y = lx['pos'], ly['pos']\n            rx = [r for r in lx['runs'] if r['s0'] - tol <= y <= r['s1'] + tol]\n            ry = [r for r in ly['runs'] if r['s0'] - tol <= x <= r['s1'] + tol]\n            if not rx or not ry:\n                continue\n            arms = {'+y': any(r['s1'] > y + tol for r in rx), '-y': any(r['s0'] < y - tol for r in rx),\n                    '+x': any(r['s1'] > x + tol for r in ry), '-x': any(r['s0'] < x - tol for r in ry)}\n            n = sum(1 for v in arms.values() if v)\n            if n >= 3:\n                t = 'T' if n == 3 else 'X'\n            elif n == 2:\n                t = 'through' if (arms['+y'] and arms['-y']) or (arms['+x'] and arms['-x']) else 'corner'\n            else:\n                t = 'end'\n            ext = any(r['ext'] for r in rx + ry)\n            nodes.append({'key': ('C', i, j), 'x': x, 'y': y, 'type': t, 'arms': n, 'ext': ext, 'xi': i, 'yj': j})\n    # free ends: a run end that is not at any crossing\n    for fam, lines, others in (('X', X, Y), ('Y', Y, X)):\n        for i, ln in enumerate(lines):\n            for ri, r in enumerate(ln['runs']):\n                for s in (r['s0'], r['s1']):\n                    p = _sgl_pt(X, Y, fam, ln, s)\n                    if not any(abs(nd['x'] - p[0]) <= tol and abs(nd['y'] - p[1]) <= tol for nd in nodes):\n                        nodes.append({'key': ('E', fam, i, ri, s), 'x': p[0], 'y': p[1], 'type': 'end', 'arms': 1, 'ext': r['ext'], 'xi': None, 'yj': None})\n    return nodes\n\n\ndef _sgl_in_opening(run, s, half):\n    for (p0, wd) in run['open']:\n        if p0 - half <= s <= p0 + wd + half:\n            return True\n    return False\n\n\ndef sg_select_columns(X, Y, nodes, opt, core_pts, grid_mode, inside_fn):\n    \"\"\"choose columns. returns dict key -> {'x','y','type','reason','mandatory'} plus 'span' columns keyed ('S',..)\"\"\"\n    tol = opt['tol']\n    max_span = opt['max_span']\n    half = opt['col_size'] / 2.0 + 100.0\n    sel = {}\n    for nd in nodes:\n        why = None\n        if grid_mode:\n            if inside_fn((nd['x'], nd['y'])):\n                why = 'grid crossing inside the building (engineer-defined grid)'\n        elif nd['type'] == 'corner':\n            why = 'wall corner' + (' on the building perimeter' if nd['ext'] else '')\n        elif nd['type'] == 'end':\n            why = 'free wall end (a beam end needs a support)'\n        if why is None and not grid_mode:\n            for cp in core_pts:\n                if abs(cp[0] - nd['x']) <= max(tol, 250.0) and abs(cp[1] - nd['y']) <= max(tol, 250.0):\n                    why = 'stair / lift core corner'\n                    break\n        if why:\n            sel[nd['key']] = {'x': nd['x'], 'y': nd['y'], 'type': nd['type'] if not grid_mode else 'grid', 'reason': why, 'mandatory': True, 'ext': nd['ext']}\n    bynode = dict((nd['key'], nd) for nd in nodes)\n    # span splitting, repeated because a column chosen on one line also cuts the crossing line\n    for _pass in range(12):\n        added = 0\n        for fam, lines in (('X', X), ('Y', Y)):\n            for li, ln in enumerate(lines):\n                for ri, r in enumerate(ln['runs']):\n                    pts = []         # (s, key or None) of every support on this run\n                    for nd in nodes:\n                        s = nd['y'] if fam == 'X' else nd['x']\n                        c = nd['x'] if fam == 'X' else nd['y']\n                        if abs(c - ln['pos']) <= tol and r['s0'] - tol <= s <= r['s1'] + tol:\n                            pts.append((s, nd))\n                    for k, v in list(sel.items()):                       # span columns that live on this line only\n                        if k[0] == 'S' and k[1] == fam and k[2] == li and k[3] == ri:\n                            pts.append((v['s'], None))\n                    sup = [r['s0'], r['s1']]\n                    for s, nd in pts:\n                        if nd is None or nd['key'] in sel:\n                            sup.append(s)\n                    sup = sorted(set(round(s, 1) for s in sup))\n                    for a, b in zip(sup[:-1], sup[1:]):\n                        gap = b - a\n                        if gap <= max_span + 1.0:\n                            continue\n                        n = int(math.ceil(gap / max_span - 1e-9))\n                        for k in range(1, n):\n                            ideal = a + gap * k / float(n)\n                            cand = [(abs(s - ideal), s, nd) for s, nd in pts if nd is not None and nd['key'] not in sel\n                                    and nd['type'] in ('T', 'X') and a + tol < s < b - tol and abs(s - ideal) <= 0.3 * (gap / n)\n                                    and not _sgl_in_opening(r, s, half)]\n                            if cand:\n                                cand.sort(key=lambda c: c[0])\n                                _d, s, nd = cand[0]\n                                sel[nd['key']] = {'x': nd['x'], 'y': nd['y'], 'type': nd['type'], 'mandatory': False, 'ext': nd['ext'],\n                                                  'reason': 'junction used as intermediate support: beam span %.1f m > %.1f m max' % (gap / 1000.0, max_span / 1000.0)}\n                                added += 1\n                                continue\n                            s = ideal\n                            moved = ''\n                            if _sgl_in_opening(r, s, half):\n                                for off in range(100, int(0.4 * gap / n), 100):\n                                    for sg in (1, -1):\n                                        t = ideal + sg * off\n                                        if a + half < t < b - half and not _sgl_in_opening(r, t, half):\n                                            s, moved = t, ' (moved %d mm off a door / window)' % off\n                                            break\n                                    if moved:\n                                        break\n                                if not moved:\n                                    moved = ' (WARNING: inside an opening zone - check by hand)'\n                            xy = _sgl_pt(X, Y, fam, ln, s)\n                            sel[('S', fam, li, ri, int(s))] = {'x': xy[0], 'y': xy[1], 'type': 'span', 's': s, 'mandatory': False, 'ext': r['ext'],\n                                                              'reason': 'added on the line to cut a %.1f m span (> %.1f m max)%s' % (gap / 1000.0, max_span / 1000.0, moved)}\n                            added += 1\n        if not added:\n            break\n    return sel, bynode\n\n\ndef sg_build_beams(X, Y, nodes, sel, opt):\n    \"\"\"beam segments between consecutive supports on each run. a support is a selected column, or a run end (beam-on-beam).\"\"\"\n    tol = opt['tol']\n    beams = []\n    n = 0\n    for fam, lines in (('X', X), ('Y', Y)):\n        for li, ln in enumerate(lines):\n            for ri, r in enumerate(ln['runs']):\n                sup = {}\n                sup[round(r['s0'], 1)] = None\n                sup[round(r['s1'], 1)] = None\n                for k, v in sel.items():\n                    s = v['y'] if fam == 'X' else v['x']\n                    c = v['x'] if fam == 'X' else v['y']\n                    if abs(c - ln['pos']) <= tol and r['s0'] - tol <= s <= r['s1'] + tol:\n                        sup[round(s, 1)] = k\n                keys = sorted(sup)\n                for a, b in zip(keys[:-1], keys[1:]):\n                    if b - a < 200.0:\n                        continue\n                    pa, pb = _sgl_pt(X, Y, fam, ln, a), _sgl_pt(X, Y, fam, ln, b)\n                    ea = 'COL' if sup[a] is not None else 'BEAM'\n                    eb = 'COL' if sup[b] is not None else 'BEAM'\n                    op = sum(max(0.0, min(b, p0 + wd) - max(a, p0)) for (p0, wd) in r['open'])\n                    n += 1\n                    beams.append({'id': 'BM%03d' % n, 'a': pa, 'b': pb, 'len': b - a, 'fam': fam, 'line': li, 'end_a': ea, 'end_b': eb,\n                                  'kind': 'primary' if (ea == 'COL' and eb == 'COL') else 'secondary', 'wall_t': r['t'], 'wall_h': r['h'],\n                                  'open_frac': min(1.0, op / (b - a)), 'ext': r['ext'], 'ka': sup[a], 'kb': sup[b]})\n    return beams\n\n\ndef _sgl_covered(beams, fam, pos, s0, s1, tol):\n    \"\"\"is [s0,s1] on line (fam,pos) covered by beams? (fam X: x=pos)\"\"\"\n    segs = []\n    for b in beams:\n        if b['fam'] == fam:\n            c = b['a'][0] if fam == 'X' else b['a'][1]\n            if abs(c - pos) <= tol:\n                u0, u1 = (b['a'][1], b['b'][1]) if fam == 'X' else (b['a'][0], b['b'][0])\n                segs.append((min(u0, u1), max(u0, u1)))\n    segs.sort()\n    cur = s0\n    for u0, u1 in segs:\n        if u0 <= cur + tol:\n            cur = max(cur, u1)\n    return cur >= s1 - tol\n\n\ndef sg_panels(beams, cells_ext, plate_fn, hole_polys, tol):\n    \"\"\"slab panels from the beam network (orthogonal frame). returns list of panel dicts (rotated-frame coordinates)\n    plate_fn(p) -> bool (point is slab area); hole_polys: stair / shaft polygons (excluded)\"\"\"\n    xs, ys = set(), set()\n    for b in beams:\n        xs.update([b['a'][0], b['b'][0]])\n        ys.update([b['a'][1], b['b'][1]])\n    for poly in hole_polys:\n        xs.update([p[0] for p in poly])\n        ys.update([p[1] for p in poly])\n    X = _sgl_cluster(list(xs), tol)\n    Y = _sgl_cluster(list(ys), tol)\n    if len(X) < 2 or len(Y) < 2:\n        return []\n    cell = {}\n    for i in range(len(X) - 1):\n        for j in range(len(Y) - 1):\n            c = ((X[i] + X[i + 1]) / 2.0, (Y[j] + Y[j + 1]) / 2.0)\n            if not plate_fn(c):\n                continue\n            if any(sg_in_poly(c, hp) for hp in hole_polys):\n                continue\n            cell[(i, j)] = 1\n    parent = dict((k, k) for k in cell)\n\n    def find(k):\n        while parent[k] != k:\n            parent[k] = parent[parent[k]]\n            k = parent[k]\n        return k\n    for (i, j) in list(cell):\n        if (i + 1, j) in cell and not _sgl_covered(beams, 'X', X[i + 1], Y[j], Y[j + 1], tol):\n            parent[find((i, j))] = find((i + 1, j))\n        if (i, j + 1) in cell and not _sgl_covered(beams, 'Y', Y[j + 1], X[i], X[i + 1], tol):\n            parent[find((i, j))] = find((i, j + 1))\n    groups = {}\n    for k in cell:\n        groups.setdefault(find(k), []).append(k)\n    out = []\n    for gi, (root, ks) in enumerate(sorted(groups.items())):\n        x0 = min(X[i] for i, j in ks)\n        x1 = max(X[i + 1] for i, j in ks)\n        y0 = min(Y[j] for i, j in ks)\n        y1 = max(Y[j + 1] for i, j in ks)\n        area = sum((X[i + 1] - X[i]) * (Y[j + 1] - Y[j]) for i, j in ks) / 1e6\n        bb = (x1 - x0) * (y1 - y0) / 1e6\n        out.append({'id': 'P%02d' % (gi + 1), 'x0': x0, 'x1': x1, 'y0': y0, 'y1': y1, 'area_m2': area, 'fill': area / bb if bb > 0 else 0.0,\n                    'lx': min(x1 - x0, y1 - y0), 'ly': max(x1 - x0, y1 - y0), 'cells': len(ks)})\n    return out\n\n\ndef sg_add_secondary(layout_beams, panels, opt, start_n):\n    \"\"\"secondary beams for panels whose short span exceeds the slab limit. Two ways to cut a panel are tried:\n       A = beams parallel to the LONG side (beam span = long side, cuts the short span)\n       B = beams parallel to the SHORT side (beam span = short side, cuts the long side so the short span is the old long / (k+1))\n    the smallest number of beams that brings the short span within the limit wins; ties -> the shorter beam span. returns (new beams, notes)\"\"\"\n    new, notes = [], []\n    n = start_n\n    lim = opt['slab_max_span']\n    for p in panels:\n        if p['fill'] < 0.9 or p['lx'] <= lim + 1.0:\n            continue\n        wx, wy = p['x1'] - p['x0'], p['y1'] - p['y0']\n        short_is_x = wx <= wy\n        lx_, ly_ = p['lx'], p['ly']\n        pick = None\n        for k in range(1, 5):\n            optA = (min(lx_ / (k + 1), ly_), ly_)                 # (resulting short span, beam span)\n            optB = (min(lx_, ly_ / (k + 1)), lx_)\n            ok = [(o[1], nm, o) for nm, o in (('A', optA), ('B', optB)) if o[0] <= lim + 1.0]\n            if ok:\n                ok.sort()\n                pick = (k, ok[0][1], ok[0][2])\n                break\n        if pick is None:\n            notes.append('Panel %s (%.1f x %.1f m): short span exceeds %.1f m and 4 secondary beams do not cure it - revise the layout / use a different system' % (\n                p['id'], lx_ / 1000.0, ly_ / 1000.0, lim / 1000.0))\n            continue\n        k, way, res = pick\n        for q in range(1, k + 1):\n            f = q / float(k + 1)\n            # A: beam runs along the long side, placed across the short side;  B: beam runs along the short side, placed along the long side\n            runs_along_y = (short_is_x and way == 'A') or ((not short_is_x) and way == 'B')\n            if runs_along_y:\n                xx = p['x0'] + wx * f\n                a_, b_, fam = (xx, p['y0']), (xx, p['y1']), 'X'\n            else:\n                yy = p['y0'] + wy * f\n                a_, b_, fam = (p['x0'], yy), (p['x1'], yy), 'Y'\n            n += 1\n            ln = math.hypot(b_[0] - a_[0], b_[1] - a_[1])\n            new.append({'id': 'BM%03d' % n, 'a': a_, 'b': b_, 'len': ln, 'fam': fam, 'line': -1, 'end_a': 'BEAM', 'end_b': 'BEAM',\n                        'kind': 'secondary', 'wall_t': 0.0, 'wall_h': 0.0, 'open_frac': 0.0, 'ext': False, 'ka': None, 'kb': None,\n                        'why': 'slab panel %s short span %.1f m > %.1f m: secondary beam gives a short span of %.1f m' % (\n                            p['id'], lx_ / 1000.0, lim / 1000.0, res[0] / 1000.0)})\n        notes.append('Panel %s (%.1f x %.1f m): %d secondary beam(s) of %.1f m span proposed, slab short span becomes %.1f m' % (\n            p['id'], lx_ / 1000.0, ly_ / 1000.0, k, res[1] / 1000.0, res[0] / 1000.0))\n    return new, notes\n\n\ndef sg_trimmer_beams(opens, beams, opt, start_n, tol):\n    \"\"\"trimmer beams around stair / lift openings (rotated frame) where the edge has no beam. returns (beams, notes)\"\"\"\n    new, notes = [], []\n    n = start_n\n    for o in opens:\n        poly = o['poly']\n        x0, x1 = min(p[0] for p in poly), max(p[0] for p in poly)\n        y0, y1 = min(p[1] for p in poly), max(p[1] for p in poly)\n        for fam, pos, s0, s1 in (('Y', y0, x0, x1), ('Y', y1, x0, x1), ('X', x0, y0, y1), ('X', x1, y0, y1)):\n            if _sgl_covered(beams + new, fam, pos, s0, s1, tol + 50.0):\n                continue\n            # extend to the nearest perpendicular beams on both sides\n            lo, hi = None, None\n            for b in beams + new:\n                if b['fam'] == fam:\n                    continue\n                c = b['a'][0] if b['fam'] == 'X' else b['a'][1]\n                u0, u1 = (b['a'][1], b['b'][1]) if b['fam'] == 'X' else (b['a'][0], b['b'][0])\n                if min(u0, u1) - tol <= pos <= max(u0, u1) + tol:\n                    if c <= s0 + tol and (lo is None or c > lo):\n                        lo = c\n                    if c >= s1 - tol and (hi is None or c < hi):\n                        hi = c\n            if lo is None or hi is None:\n                notes.append('Opening %s: edge at %.0f has no supporting beam on one side - NO trimmer beam proposed, support it by hand' % (o.get('id', ''), pos))\n                continue\n            n += 1\n            a, b = ((lo, pos), (hi, pos)) if fam == 'Y' else ((pos, lo), (pos, hi))\n            new.append({'id': 'BM%03d' % n, 'a': a, 'b': b, 'len': hi - lo, 'fam': fam, 'line': -1, 'end_a': 'BEAM', 'end_b': 'BEAM', 'kind': 'stair',\n                        'wall_t': 0.0, 'wall_h': 0.0, 'open_frac': 0.0, 'ext': False, 'ka': None, 'kb': None,\n                        'why': 'trimmer beam on the edge of %s opening %s (no beam existed there)' % (o.get('kind', 'stair'), o.get('id', ''))})\n    return new, notes\n\n\ndef sg_tributary(cols_xy, plate_pts, hole_polys, step_mm):\n    \"\"\"Thiessen (nearest-column) tributary area in m2 per column index: samples the slab plate. APPROXIMATION (ASSUMPTION)\n    used only as a cross-check of the beam-reaction method.  plate_pts = list of sample points already inside the plate\"\"\"\n    if not cols_xy:\n        return []\n    area = [0.0] * len(cols_xy)\n    a = (step_mm / 1000.0) ** 2\n    for p in plate_pts:\n        if any(sg_in_poly(p, h) for h in hole_polys):\n            continue\n        best, bi = None, 0\n        for i, c in enumerate(cols_xy):\n            d = (c[0] - p[0]) ** 2 + (c[1] - p[1]) ** 2\n            if best is None or d < best:\n                best, bi = d, i\n        area[bi] += a\n    return area\n\n\ndef sg_generate_layout(geo, opt=None):\n    \"\"\"MAIN entry of the layout engine. geo: geometry dict (mm, world plan coordinates). returns layout dict (world coordinates)\"\"\"\n    o = dict(SG_DEFAULTS)\n    if opt:\n        o.update(opt)\n    tol = o['tol']\n    warn, notes = [], []\n    walls = geo.get('walls', [])\n    ang = sg_dominant_angle(walls) if walls else 0.0\n    if abs(ang) > 1e-6:\n        notes.append('Plan rotated by %.1f deg to the dominant wall direction for the layout; results are rotated back.' % math.degrees(ang))\n    # plate (slab area) test in the rotated frame\n    fl = [[sg_rot(p, -ang) for p in f['poly']] for f in geo.get('floors', []) if f.get('poly')]\n    rm = [[sg_rot(p, -ang) for p in r['poly']] for r in geo.get('rooms', []) if r.get('poly')]\n    plate_polys = fl or rm\n    if not plate_polys:\n        warn.append('No floor or room outlines: slab area approximated by the wall bounding box.')\n        pts = [sg_rot(w[k], -ang) for w in walls for k in ('a', 'b')]\n        if pts:\n            plate_polys = [[(min(p[0] for p in pts), min(p[1] for p in pts)), (max(p[0] for p in pts), min(p[1] for p in pts)),\n                            (max(p[0] for p in pts), max(p[1] for p in pts)), (min(p[0] for p in pts), max(p[1] for p in pts))]]\n\n    def plate_fn(p):\n        return any(sg_in_poly(p, pl) for pl in plate_polys)\n\n    def near_building(p):\n        if plate_fn(p):\n            return True\n        for w in walls:\n            a, b = sg_rot(w['a'], -ang), sg_rot(w['b'], -ang)\n            L2 = (b[0] - a[0]) ** 2 + (b[1] - a[1]) ** 2 or 1.0\n            t = max(0.0, min(1.0, ((p[0] - a[0]) * (b[0] - a[0]) + (p[1] - a[1]) * (b[1] - a[1])) / L2))\n            if math.hypot(p[0] - (a[0] + t * (b[0] - a[0])), p[1] - (a[1] + t * (b[1] - a[1]))) <= max(600.0, w.get('t', 0)):\n                return True\n        return False\n    holes = []\n    for o_ in list(geo.get('stairs', [])) + list(geo.get('openings', [])):\n        if o_.get('poly'):\n            hp = [sg_rot(p, -ang) for p in o_['poly']]\n            ar = sg_poly_area(hp) / 1e6\n            holes.append({'id': o_.get('id', ''), 'poly': hp, 'kind': o_.get('kind', 'stair' if o_ in geo.get('stairs', []) else 'shaft'), 'area': ar})\n    cores = [h for h in holes if h['area'] >= o['core_min_area']]\n    core_pts = []\n    for h in cores:\n        xs, ys = [p[0] for p in h['poly']], [p[1] for p in h['poly']]\n        core_pts += [(min(xs), min(ys)), (max(xs), min(ys)), (max(xs), max(ys)), (min(xs), max(ys))]\n    # lines\n    src = str(o['source']).upper()[:1]\n    gX, gY = sg_grid_lines(geo.get('grids', []), ang)\n    wX, wY, skew, thin = sg_wall_lines(walls, ang, o['min_wall_t'], tol)\n    gx_ = [(a['pos']) for a in gX]\n    use_grid = (src == 'G') or (src == 'A' and len(gX) >= 2 and len(gY) >= 2)\n    if use_grid and src == 'A':\n        # grids too sparse to frame the building -> walls\n        gp = sorted(a['pos'] for a in gX)\n        gq = sorted(a['pos'] for a in gY)\n        gaps = [b - a for a, b in zip(gp[:-1], gp[1:])] + [b - a for a, b in zip(gq[:-1], gq[1:])]\n        if gaps and max(gaps) > 2.0 * o['max_span'] and (wX or wY):\n            use_grid = False\n            notes.append('Grids are up to %.1f m apart (> 2 x max span): the walls were used instead.' % (max(gaps) / 1000.0))\n    if use_grid:\n        X, Y = gX, gY\n        # grid lines run across the whole drawing - trim every run to the building\n        if not (X and Y):\n            warn.append('GRIDS selected but fewer than 2 crossing directions.')\n    else:\n        X, Y = wX, wY\n    if skew:\n        warn.append('%d wall(s) are not parallel to the dominant direction (skew): no structural line for them - %s' % (len(skew), ', '.join(str(s) for s in skew[:8])))\n    if thin:\n        notes.append('%d wall(s) thinner than %.0f mm treated as partitions (no columns / beams; their weight is an allowance).' % (thin, o['min_wall_t']))\n    if not X or not Y:\n        return {'ok': False, 'cols': [], 'beams': [], 'warnings': warn + ['Not enough structural lines (need walls / grids in both directions).'], 'notes': notes,\n                'angle': ang, 'panels': [], 'unused': [], 'source': 'GRIDS' if use_grid else 'WALLS'}\n    nodes = sg_nodes(X, Y, tol)\n    if use_grid:\n        nodes = [nd for nd in nodes if near_building((nd['x'], nd['y']))]\n    sel, bynode = sg_select_columns(X, Y, nodes, o, core_pts, use_grid, near_building)\n    if use_grid:                                           # trim grid runs to the building extent\n        for ln in X + Y:\n            for r in ln['runs']:\n                ss = [nd['y'] if ln['fam'] == 'X' else nd['x'] for nd in nodes\n                      if abs((nd['x'] if ln['fam'] == 'X' else nd['y']) - ln['pos']) <= tol]\n                if ss:\n                    r['s0'], r['s1'] = min(ss), max(ss)\n        # re-run span logic with trimmed runs\n        sel, bynode = sg_select_columns(X, Y, nodes, o, core_pts, True, near_building)\n    beams = sg_build_beams(X, Y, nodes, sel, o)\n    # existing columns: those within 300 mm of a proposed column are reported (B19 / user columns)\n    # panels, secondary + trimmer beams\n    panels = sg_panels(beams, None, plate_fn, [h['poly'] for h in holes], tol)\n    extra, nts = sg_add_secondary(beams, panels, o, len(beams))\n    notes += nts\n    beams += extra\n    tb, nts = sg_trimmer_beams([h for h in cores], beams, o, len(beams), tol)\n    notes += nts\n    beams += tb\n    if extra or tb:\n        panels = sg_panels(beams, None, plate_fn, [h['poly'] for h in holes], tol)\n    # unused junctions\n    used = set(sel)\n    unused = []\n    for nd in nodes:\n        if nd['key'] in used or nd['type'] in ('through',):\n            continue\n        unused.append({'x': nd['x'], 'y': nd['y'], 'type': nd['type'],\n                       'reason': 'no column: %s junction; the beams on every arm are <= %.1f m long and can be carried by the beams they frame into (beam-on-beam)' % (\n                           nd['type'], o['max_span'] / 1000.0)})\n    cols = []\n    for i, (k, v) in enumerate(sorted(sel.items(), key=lambda kv: (round(kv[1]['x'] / 50.0), round(kv[1]['y'] / 50.0)))):\n        cols.append({'id': 'C%03d' % (i + 1), 'lx': v['x'], 'ly': v['y'], 'type': v['type'], 'reason': v['reason'], 'mandatory': v['mandatory'],\n                     'perimeter': bool(v.get('ext')), 'key': k})\n    kmap = dict((c['key'], c['id']) for c in cols)\n    for b in beams:\n        b['ca'] = kmap.get(b.get('ka'))\n        b['cb'] = kmap.get(b.get('kb'))\n        # carry the line direction of the beam into the world frame (angle)\n    # rotate back to the world frame\n    def back(p):\n        return sg_rot(p, ang)\n    ex_cols = geo.get('existing_columns', [])\n    for c in cols:\n        c['x'], c['y'] = back((c['lx'], c['ly']))\n        c['existing'] = any(math.hypot(c['x'] - p[0], c['y'] - p[1]) <= 300.0 for p in ex_cols)      # a column of another tool stands here\n    for b in beams:\n        b['wa'], b['wb'] = back(b['a']), back(b['b'])\n    for u in unused:\n        u['wx'], u['wy'] = back((u['x'], u['y']))\n    for p in panels:\n        p['poly_w'] = [back(q) for q in ((p['x0'], p['y0']), (p['x1'], p['y0']), (p['x1'], p['y1']), (p['x0'], p['y1']))]\n    plate_area = sum(sg_poly_area(pl) for pl in plate_polys) / 1e6\n    panel_area = sum(p['area_m2'] for p in panels)\n    hole_area = sum(h['area'] for h in holes)\n    overhang = max(0.0, plate_area - hole_area - panel_area)\n    if overhang > 0.5:\n        notes.append('%.1f m2 of floor lies outside the beam frame (balcony / cantilever / uncovered corridor): NOT analysed, check by hand.' % overhang)\n    return {'ok': True, 'angle': ang, 'source': 'GRIDS' if use_grid else 'WALLS', 'cols': cols, 'beams': beams, 'panels': panels, 'unused': unused,\n            'warnings': warn, 'notes': notes, 'plate_area': plate_area, 'panel_area': panel_area, 'overhang': overhang,\n            'holes': holes, 'plate_polys': plate_polys, 'options': o}\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - analysis pipeline (pure Python; needs sg_codes, sg_loads, sg_design, sg_foundation, sg_layout)\n#  geometry -> layout -> slab loads -> beam loads / reactions / sizes -> column load take-down + sizes -> footings -> checks\n#  Simplified hand methods only (see the README): slab panels load the beams by the 45-degree rule, beams are treated as\n#  simply supported between their supports (conservative bending), beam-on-beam reactions go to the carrier beam as point\n#  loads, column loads are the sum of the beam reactions floor by floor.  NO frame analysis, NO lateral analysis.\n# =====================================================================\n\nSG_SETTINGS = {\n    'country': 'INDIA', 'use': 'residential', 'fck': 25.0, 'fy': 500.0,\n    'n_floors': None,          # storeys above the base level (None = all levels above the plan level)\n    'floor_h': 3000.0,         # ASSUMPTION: used only when the model has no levels above the plan level\n    'slab_support': 'CONT',    # slab depth ratio: CONT (26) / SS (20)   [IS 456 23.2.1]\n    'slab_t': None,            # None = proposed from the span/depth ratio\n    'cont_factor': 1.10,       # ASSUMPTION: continuity amplification of beam reactions at columns the beam passes over\n    'col_strict': True,        # strict applicability of the short-column axial formula (IS 456 39.3)\n    'll_reduction': False,     # IS 875 Part 2 reduction of imposed load on columns (off = conservative)\n    'parapet_mm': 900.0,       # ASSUMPTION: roof parapet height on external walls\n    'wall_material': 'brick',  # brick / block  (unit weight from the library, editable)\n    'beam_b_min': 230.0, 'col_min': 230.0,\n    'plinth_offset': 0.0,      # mm: plinth beam level above the base level\n    'soil': {'sbc': None, 'df': None, 'gw': None},   # NO DEFAULTS - geotechnical report\n    'seismic': {'Z': None, 'I': None, 'R': None, 'SaG': None},\n    'switch': {'columns': True, 'col_sizing': True, 'plinth': True, 'floor_beams': True, 'roof_beams': True, 'footings': True,\n               'slab': True, 'stairs': True},\n}\nfor _k, _v in SG_DEFAULTS.items():\n    SG_SETTINGS.setdefault(_k, _v)\n\n\ndef sg_merge_settings(user):\n    S = json.loads(json.dumps(SG_SETTINGS))\n    for k, v in (user or {}).items():\n        if isinstance(v, dict) and isinstance(S.get(k), dict):\n            S[k].update(v)\n        else:\n            S[k] = v\n    return S\n\n\ndef _sga_room_zone(name):\n    n = str(name or '').lower()\n    if 'balcon' in n or 'terrace' in n or 'verand' in n:\n        return 'balcony'\n    for k in ('corridor', 'passage', 'lobby', 'stair', 'landing', 'lift'):\n        if k in n:\n            return 'corridor'\n    return 'room'\n\n\ndef _sga_seg(b):\n    \"\"\"(fam, c, u0, u1) of a beam in the rotated frame\"\"\"\n    if b['fam'] == 'X':\n        return 'X', b['a'][0], min(b['a'][1], b['b'][1]), max(b['a'][1], b['b'][1])\n    return 'Y', b['a'][1], min(b['a'][0], b['b'][0]), max(b['a'][0], b['b'][0])\n\n\ndef sg_levels(geo, S):\n    \"\"\"storey data: list of dicts {'j','name','elev','h'} for j = 0 (base) .. n (roof)\"\"\"\n    lv = sorted(geo.get('levels', []), key=lambda l: l['elev'])\n    base = geo.get('base_level')\n    bi = 0\n    for i, l in enumerate(lv):\n        if l['name'] == base:\n            bi = i\n    above = lv[bi + 1:]\n    notes = []\n    if S.get('n_floors'):\n        above = above[:int(S['n_floors'])]\n    out = []\n    if lv:\n        out.append({'j': 0, 'name': lv[bi]['name'], 'elev': lv[bi]['elev'], 'h': 0.0})\n    else:\n        out.append({'j': 0, 'name': 'BASE', 'elev': 0.0, 'h': 0.0})\n    prev = out[0]['elev']\n    for k, l in enumerate(above):\n        h = l['elev'] - prev\n        if h < 1500.0:\n            notes.append('Level \"%s\" is only %.0f mm above the previous one - skipped as a storey' % (l['name'], h))\n            continue\n        out.append({'j': len(out), 'name': l['name'], 'elev': l['elev'], 'h': h})\n        prev = l['elev']\n    if len(out) == 1:\n        n = int(S.get('n_floors') or 1)\n        for k in range(n):\n            out.append({'j': k + 1, 'name': 'STOREY %d (assumed height)' % (k + 1), 'elev': out[-1]['elev'] + S['floor_h'], 'h': S['floor_h']})\n        notes.append('The model has no levels above the plan level: %d storey(s) of %.0f mm ASSUMED.' % (n, S['floor_h']))\n    return out, notes\n\n\ndef _sga_overlap(a0, a1, b0, b1):\n    return max(0.0, min(a1, b1) - max(a0, b0))\n\n\ndef sg_slab_to_beams(panels, beams, w_dl, ll_by_zone, zone_of, tol, ratio):\n    \"\"\"distribute slab panel loads to beam segments. returns {beam id: {'dl','ll','mdl','mll'}} totals in kN (moment ones = UDL-eq x length)\"\"\"\n    res = dict([(_g25_b['id'], {'dl': 0.0, 'll': 0.0, 'mdl': 0.0, 'mll': 0.0}) for _g25_b in beams])\n    segs = [(b, _sga_seg(b)) for b in beams]\n    for p in panels:\n        zone = zone_of(((p['x0'] + p['x1']) / 2.0, (p['y0'] + p['y1']) / 2.0))\n        wl = ll_by_zone.get(zone, ll_by_zone.get('room', 0.0)) or 0.0\n        fill = p['fill']\n        pd = sg_panel_to_beams(w_dl * fill, p['lx'] / 1000.0, p['ly'] / 1000.0, ratio)\n        pl = sg_panel_to_beams(wl * fill, p['lx'] / 1000.0, p['ly'] / 1000.0, ratio)\n        horiz_long = (p['x1'] - p['x0']) >= (p['y1'] - p['y0'])\n        edges = [('Y', p['y0'], p['x0'], p['x1'], horiz_long), ('Y', p['y1'], p['x0'], p['x1'], horiz_long),\n                 ('X', p['x0'], p['y0'], p['y1'], not horiz_long), ('X', p['x1'], p['y0'], p['y1'], not horiz_long)]\n        for fam, c, e0, e1, is_long in edges:\n            for b, (bf, bc, u0, u1) in segs:\n                if bf != fam or abs(bc - c) > tol:\n                    continue\n                ov = _sga_overlap(u0, u1, e0, e1) / 1000.0\n                if ov <= 0:\n                    continue\n                k = 'long' if is_long else 'short'\n                r = res[b['id']]\n                r['dl'] += pd[k + '_shear'] * ov\n                r['mdl'] += pd[k + '_mom'] * ov\n                r['ll'] += pl[k + '_shear'] * ov\n                r['mll'] += pl[k + '_mom'] * ov\n    return res\n\n\ndef sg_opening_loads(holes, beams, w_dl_stair, w_ll_stair, tol, only_kind=None):\n    \"\"\"total stair/landing load of each stair opening shared to the beams on its edges (by overlap length)\"\"\"\n    res = {}\n    segs = [(b, _sga_seg(b)) for b in beams]\n    for h in holes:\n        if only_kind and h['kind'] != only_kind:\n            continue\n        xs, ys = [p[0] for p in h['poly']], [p[1] for p in h['poly']]\n        x0, x1, y0, y1 = min(xs), max(xs), min(ys), max(ys)\n        A = (x1 - x0) * (y1 - y0) / 1e6\n        edges = [('Y', y0, x0, x1), ('Y', y1, x0, x1), ('X', x0, y0, y1), ('X', x1, y0, y1)]\n        hits, tot = [], 0.0\n        for fam, c, e0, e1 in edges:\n            for b, (bf, bc, u0, u1) in segs:\n                if bf == fam and abs(bc - c) <= tol + 50.0:\n                    ov = _sga_overlap(u0, u1, e0, e1)\n                    if ov > 0:\n                        hits.append((b['id'], ov))\n                        tot += ov\n        for bid, ov in hits:\n            r = res.setdefault(bid, {'dl': 0.0, 'll': 0.0})\n            r['dl'] += A * w_dl_stair * ov / tot\n            r['ll'] += A * w_ll_stair * ov / tot\n    return res\n\n\ndef _sga_carrier(beams, b, end, tol):\n    \"\"\"beam segment that carries the BEAM end of b ('a' or 'b') -> (carrier, t 0..1) or (None, 0)\"\"\"\n    pt = b['a'] if end == 'a' else b['b']\n    best = None\n    for c in beams:\n        if c['id'] == b['id'] or c['fam'] == b['fam']:\n            continue\n        fam, cc, u0, u1 = _sga_seg(c)\n        along = pt[1] if fam == 'X' else pt[0]\n        across = pt[0] if fam == 'X' else pt[1]\n        if abs(across - cc) <= tol + 50.0 and u0 - tol <= along <= u1 + tol:\n            t = (along - u0) / max(1.0, (u1 - u0))\n            return c, max(0.0, min(1.0, t))\n    return None, 0.0\n\n\ndef sg_reactions(beams, base_load, tol):\n    \"\"\"base_load[id] = (DL kN, LL kN) UDL totals on each beam (slab + wall + self + stair). Secondary beams hand their end\n    reactions to the carrier as point loads. returns {id: {'ra':(dl,ll),'rb':(dl,ll),'pts':[(t,dl,ll)], 'unsupported':[ends]}}\"\"\"\n    by = dict([(_g24_b['id'], _g24_b) for _g24_b in beams])\n    memo = {}\n    carriers = {}\n    unsup = {}\n    for b in beams:\n        for e in ('a', 'b'):\n            if b['end_' + e] == 'BEAM':\n                c, t = _sga_carrier(beams, b, e, tol)\n                carriers[(b['id'], e)] = (c, t)\n                if c is None:\n                    unsup.setdefault(b['id'], []).append(e)\n    incoming = {}\n    for (bid, e), (c, t) in carriers.items():\n        if c is not None:\n            incoming.setdefault(c['id'], []).append((bid, e, t))\n\n    def react(bid, stack):\n        if bid in memo:\n            return memo[bid]\n        if bid in stack:\n            return {'ra': (0.0, 0.0), 'rb': (0.0, 0.0), 'pts': [], 'cycle': True}\n        stack = stack + [bid]\n        dl, ll = base_load.get(bid, (0.0, 0.0))\n        ra = [dl / 2.0, ll / 2.0]\n        rb = [dl / 2.0, ll / 2.0]\n        pts = []\n        for (sid, e, t) in incoming.get(bid, []):\n            r = react(sid, stack)\n            R = r['ra'] if e == 'a' else r['rb']\n            pts.append((t, R[0], R[1]))\n            ra[0] += R[0] * (1.0 - t)\n            ra[1] += R[1] * (1.0 - t)\n            rb[0] += R[0] * t\n            rb[1] += R[1] * t\n        out = {'ra': tuple(ra), 'rb': tuple(rb), 'pts': pts}\n        if bid in unsup:\n            out['unsupported'] = unsup[bid]\n        memo[bid] = out\n        return out\n    res = {}\n    for b in beams:\n        res[b['id']] = react(b['id'], [])\n    return res, unsup\n\n\ndef sg_analyse(geo, user_settings=None):\n    \"\"\"MAIN entry. geo: geometry dict, user_settings: overrides of SG_SETTINGS. returns the full result dict (JSON friendly)\"\"\"\n    S = sg_merge_settings(user_settings)\n    C = S['country']\n    opt = {}\n    for k in SG_DEFAULTS:                  # (loop, not dict(generator): IronPython on .NET 8 fails with 'Sequence contains no elements' here)\n        if k in S:\n            opt[k] = S[k]\n    R = {'settings': S, 'status': PRELIM_STATUS, 'disclaimer': DISCLAIMER, 'checks': [], 'notes': [], 'warnings': [], 'missing': []}\n    lay = sg_generate_layout(geo, opt)\n    R['layout'] = lay\n    R['notes'] += lay.get('notes', [])\n    R['warnings'] += lay.get('warnings', [])\n    if not lay['ok'] or not lay['cols']:\n        R['ok'] = False\n        return R\n    R['ok'] = True\n    tol = lay['options']['tol']\n    levels, ln = sg_levels(geo, S)\n    R['levels'] = levels\n    R['notes'] += ln\n    n = len(levels) - 1\n    beams, cols, panels, holes = lay['beams'], lay['cols'], lay['panels'], lay['holes']\n    ang = lay['angle']\n    # ---- libraries ---------------------------------------------------------------------------------------------\n    for k in ('gamma_rcc', 'gamma_brick', 'gf_dl', 'gf_ll'):\n        if lib(C, k) is None:\n            R['missing'].append('library item \"%s\" missing for country %s - load / member checks depending on it are NOT CHECKED' % (k, C))\n    if R['missing']:\n        R['ok'] = False\n        return R\n    gam = libv(C, 'gamma_rcc')\n    wmat = 'gamma_block' if str(S['wall_material']).startswith('bl') else 'gamma_brick'\n    gwall = libv(C, wmat, 19.0)\n    gf_d, gf_l = libv(C, 'gf_dl'), libv(C, 'gf_ll')\n    fck, fy = float(S['fck']), float(S['fy'])\n    ratio = libv(C, 'slab_oneway_ratio', 2.0)\n    # ---- slab thickness proposal ----------------------------------------------------------------------------------\n    lx_max = max([p['lx'] for p in panels] or [3000.0]) / 1000.0\n    t_slab = S['slab_t'] or sg_slab_thickness(C, lx_max, S['slab_support'])\n    R['slab'] = {'t': t_slab, 'lx_max': lx_max, 'proposed': S['slab_t'] is None, 'checks': []}\n    if t_slab is None:\n        t_slab = 150.0\n        R['notes'].append('Slab thickness could not be proposed (library) - 150 mm ASSUMED.')\n    sl_checks = []\n    for p in panels:\n        sl_checks += sg_slab_check(C, p['lx'] / 1000.0, p['ly'] / 1000.0, t_slab, S['slab_support'], cid='SLAB.' + p['id'])\n    R['slab']['checks'] = sl_checks\n    R['checks'] += sl_checks\n    # ---- loads per level class --------------------------------------------------------------------------------------\n    def zone_of(p):\n        for r in geo.get('rooms', []):\n            pl = [sg_rot(q, -ang) for q in r.get('poly', [])]\n            if pl and sg_in_poly(p, pl):\n                return _sga_room_zone(r.get('name'))\n        return 'room'\n    use = S['use']\n    ll_room, s1, r1 = sg_live(C, use, 'room')\n    ll_cor, _s, _r = sg_live(C, use, 'corridor')\n    ll_bal, _s, _r = sg_live(C, use, 'balcony')\n    ll_roof, s2, r2 = sg_live(C, use, 'roof_access')\n    if ll_room is None:\n        R['missing'].append('imposed load for building use \"%s\" - %s' % (use, r1))\n        R['ok'] = False\n        return R\n    dl_floor, rows_f = sg_floor_dead(C, t_slab, 'floor')\n    dl_roof, rows_r = sg_floor_dead(C, t_slab, 'roof')\n    R['load_rows'] = {'floor_dead': rows_f, 'roof_dead': rows_r, 'll_room': (ll_room, s1, r1), 'll_roof': (ll_roof, s2, r2)}\n    dl_stair = 0.15 * gam * 1.15 + libv(C, 'dl_stair_extra', 1.5)       # waist 150 mm x slope factor 1.15 (ASSUMPTION) + steps / finish\n    ll_stair = ll_cor if ll_cor is not None else ll_room\n    classes = {}\n    cls_of = ['plinth'] + ['floor'] * max(0, n - 1) + (['roof'] if n >= 1 else [])\n    if n == 1:\n        cls_of = ['plinth', 'roof']\n    storey_h = dict([(_g23_l['j'], _g23_l['h']) for _g23_l in levels])\n    for cname in sorted(set(cls_of)):\n        j = cls_of.index(cname)\n        if cname == 'plinth':\n            classes[cname] = {'j': 0, 'slab': dict([(_g22_b['id'], {'dl': 0.0, 'll': 0.0, 'mdl': 0.0, 'mll': 0.0}) for _g22_b in beams]), 'stair': {}}\n            continue\n        wd = dl_roof if cname == 'roof' else dl_floor\n        lls = {'room': ll_roof if cname == 'roof' else ll_room, 'corridor': ll_roof if cname == 'roof' else (ll_cor if ll_cor is not None else ll_room),\n               'balcony': ll_roof if cname == 'roof' else (ll_bal if ll_bal is not None else ll_room)}\n        sb = sg_slab_to_beams(panels, beams, wd, lls, zone_of, tol, ratio)\n        if cname == 'roof':\n            st = sg_opening_loads(holes, beams, dl_roof, ll_roof or 0.0, tol)       # stair opening is roofed over at the top\n        else:\n            st = sg_opening_loads(holes, beams, dl_stair, ll_stair, tol, 'stair')\n        classes[cname] = {'j': j, 'slab': sb, 'stair': st}\n    # ---- beam sizing per class (2 passes: wall height depends on the beam depth) -------------------------------------------\n    sizes = {}                      # (loops, not nested generator expressions: IronPython on .NET 8 fails on those inside this long function)\n    for cname in classes:\n        sizes[cname] = {}\n        for b in beams:\n            sizes[cname][b['id']] = (S['beam_b_min'], 450.0)\n    designs = {}\n    results = {}\n    for _pass in range(3):\n        for cname, cd in classes.items():\n            j = cd['j']\n            base = {}\n            wallu = {}\n            for b in beams:\n                bw, D = sizes[cname][b['id']]\n                L_ = b['len'] / 1000.0\n                sb = cd['slab'][b['id']]\n                stl = cd['stair'].get(b['id'], {'dl': 0.0, 'll': 0.0})\n                self_w = sg_beam_self(bw, D, gam, t_slab if cname != 'plinth' else 0.0)\n                wall = 0.0\n                if b['wall_t'] > 0:\n                    if cname == 'roof':\n                        hh = S['parapet_mm'] if b['ext'] else 0.0\n                    else:\n                        hh = max(0.0, storey_h.get(j + 1, S['floor_h']) - D)\n                    wall = sg_wall_line_load(b['wall_t'], hh, gwall, 24.0, b['open_frac'], libv(C, 'gamma_mortar', 20.4))\n                wallu[b['id']] = wall\n                base[b['id']] = (sb['dl'] + stl['dl'] + (self_w + wall) * L_, sb['ll'] + stl['ll'])\n            rx, unsup = sg_reactions(beams, base, tol)\n            results[cname] = (base, rx, unsup)\n            for b in beams:\n                bid = b['id']\n                L_ = b['len'] / 1000.0\n                r = rx[bid]\n                sb = cd['slab'][bid]\n                stl = cd['stair'].get(bid, {'dl': 0.0, 'll': 0.0})\n                pts = r['pts']\n                # carried beams = point loads; equivalent UDLs: moment P t(1-t) L = w L^2/8 ; shear P max(t,1-t) = w L/2\n                pm_dl = sum([8.0 * _g21_p[1] * _g21_p[0] * (1.0 - _g21_p[0]) / L_ for _g21_p in pts])\n                pm_ll = sum([8.0 * _g20_p[2] * _g20_p[0] * (1.0 - _g20_p[0]) / L_ for _g20_p in pts])\n                ps_dl = sum([2.0 * _g19_p[1] * max(_g19_p[0], 1.0 - _g19_p[0]) / L_ for _g19_p in pts])\n                ps_ll = sum([2.0 * _g18_p[2] * max(_g18_p[0], 1.0 - _g18_p[0]) / L_ for _g18_p in pts])\n                tslab = t_slab if cname != 'plinth' else 0.0\n\n                def fn(bw_, D_, sb=sb, stl=stl, L_=L_, wall=wallu[bid], tslab=tslab, pm_dl=pm_dl, pm_ll=pm_ll, ps_dl=ps_dl, ps_ll=ps_ll):\n                    sw = sg_beam_self(bw_, D_, gam, tslab)\n                    fixed_dl = stl['dl'] / L_ + wall + sw\n                    fixed_ll = stl['ll'] / L_\n                    sh = gf_d * (sb['dl'] / L_ + fixed_dl + ps_dl) + gf_l * (sb['ll'] / L_ + fixed_ll + ps_ll)\n                    mo = gf_d * (sb['mdl'] / L_ + fixed_dl + pm_dl) + gf_l * (sb['mll'] / L_ + fixed_ll + pm_ll)\n                    return sh, mo\n                sup = 'CONT' if (b['end_a'] == 'COL' and b['end_b'] == 'COL' and b['kind'] == 'primary') else 'SS'\n                bmin = S['beam_b_min'] if b['wall_t'] <= 0 else max(S['beam_b_min'], min(b['wall_t'], 300.0))\n                bsel, Dsel, des = sg_propose_beam(C, L_, fn, fck, fy, bmin, sup)\n                sizes[cname][bid] = (bsel, Dsel)\n                designs[(cname, bid)] = des\n    # ---- beam size per segment = governing over classes (floor/roof) so the same beam size is modelled on every floor ---------------\n    beam_out = []\n    chk = R['checks']\n    for b in beams:\n        per = {}\n        for cname in classes:\n            bw, D = sizes[cname][b['id']]\n            per[cname] = (bw, D)\n        fl = per.get('floor') or per.get('roof')\n        gov = max([v for k, v in per.items() if k != 'plinth'] or [(S['beam_b_min'], 450.0)], key=lambda v: v[1])\n        r_ = {'id': b['id'], 'kind': b['kind'], 'len': b['len'], 'wa': b['wa'], 'wb': b['wb'], 'end_a': b['end_a'], 'end_b': b['end_b'],\n              'ca': b.get('ca'), 'cb': b.get('cb'), 'why': b.get('why', ''), 'plinth': per.get('plinth', gov), 'floor': per.get('floor', gov),\n              'roof': per.get('roof', gov), 'size': gov}\n        for cname in classes:\n            des = designs[(cname, b['id'])]\n            for c in des['checks']:\n                c = dict(c)\n                c['id'] = '%s.%s.%s' % (b['id'], cname, c['id'].split('.')[-1])\n                c['name'] = '%s (%s level)' % (c['name'], cname)\n                chk.append(c)\n        beam_out.append(r_)\n    R['beams'] = beam_out\n    # ---- column take-down ---------------------------------------------------------------------------------------------------\n    cmap = dict([(_g17_c['id'], _g17_c) for _g17_c in cols])\n    cost = dict([(_g16_c['id'], dict([(_g15_j, [0.0, 0.0]) for _g15_j in range(0, n + 1)])) for _g16_c in cols])      # reaction at column from beams of level j: [dl, ll]\n    contf = S['cont_factor']\n    unsupported_total = 0\n    for cname, (base, rx, unsup) in results.items():\n        for b in beams:\n            r = rx[b['id']]\n            for e, cid, R_ in (('a', b.get('ca'), r['ra']), ('b', b.get('cb'), r['rb'])):\n                if cid is None:\n                    continue\n                # continuity amplification: the beam continues past the column when another beam of the same line starts here\n                cont = any([(_g14_o is not b) and _g14_o['fam'] == b['fam'] and (_g14_o.get('ca') == cid or _g14_o.get('cb') == cid) for _g14_o in beams])\n                f = contf if cont else 1.0\n                for j in range(0, n + 1):\n                    if cls_of[j] == cname:\n                        cost[cid][j][0] += R_[0] * f\n                        cost[cid][j][1] += R_[1] * f\n        unsupported_total += sum([len(_g13_v) for _g13_v in unsup.values()])\n    R['unsupported_beam_ends'] = unsupported_total\n    # column sizes per storey s (1..n): carries beams of levels s..n\n    col_out = []\n    wmax = {}\n    for c in cols:\n        wt = 0.0\n        for b in beams:\n            if (b.get('ca') == c['id'] or b.get('cb') == c['id']) and b['wall_t'] > wt:\n                wt = b['wall_t']\n                c['h_along'] = b['fam']\n        c['wall_t'] = wt\n    redu_info = []\n    sizes_col = {}\n    prev_size = None\n    for c in cols:\n        stor = []\n        for s in range(n, 0, -1):         # top storey first so sizes only grow downwards\n            dl = sum([cost[c['id']][_g12_j][0] for _g12_j in range(s, n + 1)])\n            ll = sum([cost[c['id']][_g11_j][1] for _g11_j in range(s, n + 1)])\n            floors_carried = n - s + 1\n            if S['ll_reduction']:\n                red = sg_ll_reduction_pct(C, floors_carried)\n                ll_floors = sum([cost[c['id']][_g10_j][1] for _g10_j in range(s, n)])      # roof (level n) is not reduced\n                ll = (ll - ll_floors) + ll_floors * (1.0 - red / 100.0)\n            self_w = 0.0\n            Hc = storey_h.get(s, S['floor_h'])\n            bb, hh = (None, None)\n            for it in range(3):\n                Pdl = dl + self_w\n                Pu, Ps, _a, _b, _rows = sg_factored(C, Pdl, ll)\n                if Pu is None:\n                    break\n                size = sg_propose_column(C, Pu, Hc - 400.0, fck, fy, c['wall_t'] if c['wall_t'] >= S['col_min'] else None, S['col_min'], 25.0, S['col_strict'])\n                if size is None:\n                    break\n                bb, hh = size\n                self_w = 0.0\n                for q in range(s, n + 1):\n                    self_w += bb * hh / 1e6 * storey_h.get(q, S['floor_h']) / 1000.0 * gam\n            stor.append({'storey': s, 'level_from': levels[s - 1]['name'], 'level_to': levels[s]['name'], 'Pdl': dl + self_w, 'Pll': ll,\n                         'Pu': Pu, 'Ps': Ps, 'b': bb, 'h': hh, 'H': Hc})\n        stor.sort(key=lambda x: x['storey'])\n        # sizes can only stay equal or increase downwards\n        for i in range(1, len(stor)):\n            top = stor[i - 1]\n        for i in range(len(stor) - 2, -1, -1):\n            up, me = stor[i + 1], stor[i]\n            if me['b'] is not None and up['b'] is not None:\n                if me['b'] < up['b']:\n                    me['b'] = up['b']\n                if me['h'] < up['h']:\n                    me['h'] = up['h']\n        # plinth level beam reactions add to the foundation load (they do not go up the column)\n        plinth_dl, plinth_ll = cost[c['id']][0]\n        dl0 = stor[0]['Pdl'] + plinth_dl\n        ll0 = stor[0]['Pll'] + plinth_ll\n        Pu0, Ps0, _a, _b, _rows = sg_factored(C, dl0, ll0)\n        co = {'id': c['id'], 'x': c['x'], 'y': c['y'], 'type': c['type'], 'reason': c['reason'], 'perimeter': c['perimeter'], 'storeys': stor,\n              'foundation': {'Pdl': dl0, 'Pll': ll0, 'Pu': Pu0, 'Ps': Ps0}, 'h_along': c.get('h_along', 'Y'), 'wall_t': c['wall_t'], 'existing': c.get('existing', False)}\n        for st in stor:\n            if st['b'] is None:\n                continue\n            cks, ptq = sg_col_check(C, st['Pu'], st['b'], st['h'], st['H'] - 400.0, fck, fy, None, S['col_strict'], '%s.S%d' % (c['id'], st['storey']))\n            for k_ in cks:\n                chk.append(k_)\n            st['pt_req'] = ptq\n        col_out.append(co)\n    R['columns'] = col_out\n    # ---- tributary area cross-check (Thiessen) -------------------------------------------------------------------------------\n    plate_pts = []\n    xs = [p[0] for pl in lay['plate_polys'] for p in pl]\n    ys = [p[1] for pl in lay['plate_polys'] for p in pl]\n    if xs:\n        area = (max(xs) - min(xs)) * (max(ys) - min(ys)) / 1e6\n        step = max(250.0, math.sqrt(max(area, 1.0) / 6000.0) * 1000.0)\n        x = min(xs) + step / 2.0\n        while x < max(xs):\n            y = min(ys) + step / 2.0\n            while y < max(ys):\n                if any([sg_in_poly((x, y), _g9_pl) for _g9_pl in lay['plate_polys']]):\n                    plate_pts.append((x, y))\n                y += step\n            x += step\n        trib = sg_tributary([(c['lx'], c['ly']) for c in cols], plate_pts, [h['poly'] for h in holes], step)\n        tot_trib = sum(trib)\n        w_fl = (dl_floor or 0.0) + (ll_room or 0.0)\n        for c, a in zip(col_out, trib):\n            c['trib_area'] = a\n            s_ = c['storeys'][-1]\n            floor_rx = sum([cost[c['id']][_g8_j][0] + cost[c['id']][_g8_j][1] for _g8_j in range(1, max(2, n))])       # reaction of ONE typical floor (j = 1)\n            c['trib_check'] = {'area_m2': a, 'slab_only_kN': a * w_fl}\n        R['trib_total'] = tot_trib\n    # ---- equilibrium (load path) check ---------------------------------------------------------------------------------------\n    applied = 0.0\n    for cname, (base, rx, unsup) in results.items():\n        cnt = sum([1 for _g7_j in range(0, n + 1) if cls_of[_g7_j] == cname])\n        applied += cnt * sum([_g6_v[0] + _g6_v[1] for _g6_v in base.values()])\n    carried = 0.0\n    for cname, (base, rx, unsup) in results.items():\n        cnt = sum([1 for _g5_j in range(0, n + 1) if cls_of[_g5_j] == cname])\n        for b in beams:\n            r = rx[b['id']]\n            if b.get('ca') is not None:\n                carried += cnt * (r['ra'][0] + r['ra'][1])\n            if b.get('cb') is not None:\n                carried += cnt * (r['rb'][0] + r['rb'][1])\n    # beam-on-beam points are already inside ra/rb of the carriers, so compare against applied load directly\n    R['equilibrium'] = {'applied_kN': applied, 'to_columns_kN': carried}\n    # ---- seismic (input-driven only) --------------------------------------------------------------------------------------------\n    sz = S['seismic']\n    if all([sz.get(_g4_k) is not None for _g4_k in ('Z', 'I', 'R', 'SaG')]):\n        frac = libv(C, 'seis_ll_frac')\n        Wl, hl = [], []\n        for j in range(1, n + 1):\n            dlj = sum([results[cls_of[j]][0][_g3_b['id']][0] for _g3_b in beams])\n            llj = sum([results[cls_of[j]][0][_g2_b['id']][1] for _g2_b in beams])\n            wll = 0.0 if j == n else (frac['le3'] if (ll_room or 0) <= 3.0 else frac['gt3']) * llj\n            Wl.append(dlj + wll)\n            hl.append((levels[j]['elev'] - levels[0]['elev']) / 1000.0)\n        R['seismic'] = sg_seismic(Wl, hl, sz['Z'], sz['I'], sz['R'], sz['SaG'])\n        R['seismic']['inputs'] = dict(sz)\n    else:\n        R['seismic'] = None\n    R['n'] = n\n    R['cls_of'] = cls_of\n    R['dl'] = {'floor': dl_floor, 'roof': dl_roof, 'stair': dl_stair, 'll_room': ll_room, 'll_roof': ll_roof}\n    # ---- foundations ----------------------------------------------------------------------------------------------------------\n    R['footings'] = sg_design_footings(R, S, lay)\n    return R\n\n\ndef sg_design_footings(R, S, lay):\n    \"\"\"isolated footings (+ combined for overlapping pairs). NO soil data -> no sizes (reason given).\"\"\"\n    C = S['country']\n    soil = S['soil']\n    ok, miss = sg_soil_ok(soil)\n    out = {'ok': ok, 'missing': miss, 'items': [], 'combined': [], 'advice': [], 'checks': [], 'overlaps': []}\n    if not ok:\n        out['advice'].append('FOOTINGS NOT SIZED - missing: ' + '; '.join(miss) + '. Soil bearing capacity and founding depth are mandatory inputs from a geotechnical report; the tool never assumes them.')\n        return out\n    sbc = float(soil['sbc'])\n    fck, fy = float(S['fck']), float(S['fy'])\n    items = []\n    for c in R['columns']:\n        s1 = c['storeys'][0]\n        P = c['foundation']\n        if s1['b'] is None or P['Pu'] is None:\n            continue\n        pl = sg_footing_plan(C, P['Ps'], sbc, s1['b'] if c['h_along'] else s1['b'], s1['h'])\n        des = sg_footing_design(C, P['Pu'], pl['L'], pl['B'], s1['b'], s1['h'], fck, fy)\n        it = {'id': 'F-' + c['id'], 'col': c['id'], 'x': c['x'], 'y': c['y'], 'L': pl['L'], 'B': pl['B'], 'D': des['D'], 'Ps': P['Ps'], 'Pu': P['Pu'],\n              'pressure': pl['pressure'], 'allow': sbc, 'ast_long': des.get('ast_long'), 'ast_short': des.get('ast_short'), 'checks': des['checks'],\n              'h_along': c['h_along'], 'col_b': s1['b'], 'col_h': s1['h']}\n        it['checks'].append(sg_chk('%s.bearing' % it['id'], 'footing bearing pressure', 'PASS' if pl['pressure'] <= sbc + 1e-6 else 'FAIL',\n                                   '%.0f kN/m2 (service load +%.0f%% self-weight allowance) vs allowable %.0f kN/m2 as typed by the user' % (\n                                       pl['pressure'], 100 * pl['allow'], sbc), C, ['ftg_self_weight_frac']))\n        items.append(it)\n    # overlap detection in world coordinates -> footings oriented along the local frame; boxes are axis aligned in LOCAL frame\n    ang = lay['angle']\n    loc = []\n    for it in items:\n        x, y = sg_rot((it['x'], it['y']), -ang)\n        loc.append({'id': it['id'], 'x': x, 'y': y, 'L': it['L'], 'B': it['B']})\n    # footing long side follows the column's h direction (X family walls run along y -> h along y)\n    for l_, it in zip(loc, items):\n        if it['h_along'] == 'Y':          # line family Y = wall along x: h along x\n            l_['L'], l_['B'] = it['L'], it['B']\n        else:\n            l_['L'], l_['B'] = it['B'], it['L']\n    ov = sg_overlaps(loc, 150.0)\n    out['overlaps'] = ov\n    byid = dict([(_g1_i['id'], _g1_i) for _g1_i in items])\n    used = set()\n    for a, b, gap in ov:\n        if a in used or b in used:\n            continue\n        ia, ib = byid[a], byid[b]\n        la = [l for l in loc if l['id'] == a][0]\n        lb = [l for l in loc if l['id'] == b][0]\n        cb = sg_combined(C, {'x': la['x'], 'y': la['y'], 'half': max(ia['col_b'], ia['col_h']) / 2.0},\n                         {'x': lb['x'], 'y': lb['y'], 'half': max(ib['col_b'], ib['col_h']) / 2.0}, ia['Ps'], ib['Ps'], sbc)\n        if cb is None:\n            continue\n        cb['members'] = [a, b]\n        cb['Ps'] = ia['Ps'] + ib['Ps']\n        cb['Pu'] = ia['Pu'] + ib['Pu']\n        cb['wx'], cb['wy'] = sg_rot((cb['cx'], cb['cy']), ang)\n        cb['ang'] = ang + math.atan2(cb['uy'], cb['ux'])\n        out['combined'].append(cb)\n        used.update([a, b])\n    out['items'] = [i for i in items if i['id'] not in used]\n    out['consumed'] = sorted(used)\n    out['advice'] += sg_foundation_advice(C, lay['plate_area'], [{'L': i['L'], 'B': i['B']} for i in items], ov)\n    rest = [x for x in ov if x[0] not in used or x[1] not in used]\n    if len(ov) > len(out['combined']):\n        out['advice'].append('More than two footings overlap in a cluster: use strip footings or a raft - not designed by this tool.')\n    out['advice'].append('Footing plan size uses SERVICE load + %.0f %% allowance for self weight / backfill [ASSUMPTION]; thickness from one-way shear and punching shear only; '\n                         'bending steel quantities are INDICATIVE. Eccentricity / moments, groundwater, settlement, uplift and plot-boundary limits are NOT CHECKED.' % (100 * libv(C, 'ftg_self_weight_frac', 0.1)))\n    return out\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - validation (pure Python; needs sg_design in the namespace)\n#  Adds the model-level checks to R['checks'] and builds R['summary'].  Wording rule: a check is PASS, FAIL or NOT CHECKED.\n#  The tool NEVER declares a design \"safe\" or \"code compliant\".\n# =====================================================================\n\n\ndef sg_validate(R):\n    chk = R['checks']\n    if not R.get('ok'):\n        R['summary'] = {'PASS': 0, 'FAIL': 0, 'NOT CHECKED': 0, 'flags': [],\n                        'verdict': PRELIM_STATUS + ' - analysis could not run: ' + '; '.join(R.get('missing', []) + R.get('warnings', []))}\n        return R['summary']\n    lay = R['layout']\n    # --- load path continuity / connectivity\n    nun = R.get('unsupported_beam_ends', 0)\n    chk.append(sg_chk('V01', 'load-path continuity: every beam end rests on a column or on another beam', 'PASS' if nun == 0 else 'FAIL',\n                      '%d beam end(s) have no support found' % nun))\n    eq = R['equilibrium']\n    d = abs(eq['applied_kN'] - eq['to_columns_kN'])\n    chk.append(sg_chk('V02', 'vertical equilibrium of the load take-down (internal consistency only, not a safety check)',\n                      'PASS' if d <= 0.005 * max(1.0, eq['applied_kN']) else 'FAIL',\n                      'applied floor/beam load %.0f kN, delivered to columns %.0f kN' % (eq['applied_kN'], eq['to_columns_kN'])))\n    inc = {}\n    for b in R['beams']:\n        for k in ('ca', 'cb'):\n            if b.get(k):\n                inc[b[k]] = inc.get(b[k], 0) + 1\n    lone = [c['id'] for c in R['columns'] if inc.get(c['id'], 0) < 2]\n    chk.append(sg_chk('V03', 'beam-column connectivity: every column has at least two beams framing in', 'PASS' if not lone else 'FAIL',\n                      'columns with fewer than 2 beams: %s' % (', '.join(lone) if lone else 'none')))\n    chk.append(sg_chk('V04', 'column alignment across floors', 'PASS',\n                      'every storey uses the same column positions (one typical plan, by construction of this tool); columns already in the model were NOT compared'))\n    bad = [b['id'] for b in R['beams'] if b['kind'] == 'primary' and (b['end_a'] != 'COL' or b['end_b'] != 'COL')]\n    chk.append(sg_chk('V05', 'primary beams span between columns', 'PASS' if not bad else 'FAIL', 'not between two columns: %s' % (', '.join(bad) if bad else 'none')))\n    ov = lay.get('overhang', 0.0)\n    chk.append(sg_chk('V06', 'every slab area is enclosed by beams (no unsupported / cantilever slab)', 'PASS' if ov <= 0.5 else 'NOT CHECKED',\n                      '%.1f m2 of floor outside the beam frame (cantilever / balcony): cantilever slabs and beams are NOT analysed' % ov))\n    # --- foundations\n    f = R['footings']\n    if not f['ok']:\n        chk.append(sg_nc('V07', 'foundation load transfer / footing bearing / punching / one-way shear', 'missing soil input: ' + '; '.join(f['missing'])))\n    else:\n        for it in f['items']:\n            chk += it['checks']\n        ok_n = len(f['items']) + 2 * len(f['combined'])\n        chk.append(sg_chk('V07', 'foundation load transfer: every column has a footing', 'PASS' if ok_n >= len(R['columns']) else 'FAIL',\n                          '%d isolated + %d combined footing(s) for %d columns' % (len(f['items']), len(f['combined']), len(R['columns']))))\n        chk.append(sg_chk('V08', 'footing overlap', 'PASS' if not f['overlaps'] or f['combined'] else 'FAIL',\n                          '%d overlapping pair(s), %d combined footing(s) proposed' % (len(f['overlaps']), len(f['combined']))))\n        for cb in f['combined']:\n            chk.append(sg_nc('V08.' + '+'.join(cb['members']), 'combined footing %s thickness / shear / flexure' % '+'.join(cb['members']),\n                             'combined footing plan size only (centroid of loads); thickness, shear, punching and steel are NOT designed'))\n    chk.append(sg_nc('V09', 'settlement', 'needs soil compressibility data - not implemented'))\n    gw = R['settings']['soil'].get('gw')\n    chk.append(sg_nc('V10', 'groundwater effects (uplift, reduced bearing)', 'groundwater depth %s given but no check is implemented' % ('(%.1f m)' % float(gw) if gw else 'NOT')))\n    chk.append(sg_nc('V11', 'footing eccentricity / moments / plot boundaries', 'no moments and no boundary data: footings are centred under the column, axial load only'))\n    # --- lateral\n    sm = R.get('seismic')\n    if sm:\n        chk.append(sg_nc('V12', 'seismic design of members', 'base shear from your inputs: Ah %.4f, VB %.0f kN (formula structure [SECONDARY], seismic weight rule [UNVERIFIED]); member design / drift / irregularity under lateral load is NOT DONE' % (sm['Ah'], sm['VB'])))\n    else:\n        chk.append(sg_nc('V12', 'seismic', 'type Z, I, R and Sa/g to get a base shear; no defaults are assumed. Member design for lateral load is NOT DONE in any case'))\n    chk.append(sg_nc('V13', 'wind (IS 875 Part 3)', 'not implemented'))\n    chk.append(sg_nc('V14', 'structural irregularities (plan / vertical / soft storey / torsion)', 'needs a lateral analysis - not implemented'))\n    chk.append(sg_nc('V15', 'reinforcement detailing, ductile detailing (IS 13920), development / lap lengths', 'not implemented - Ast values are indicative only'))\n    chk.append(sg_nc('V16', 'frame action: column moments, beam-column joints, slender-column additional moments', 'no frame analysis: columns carry axial load + minimum eccentricity only'))\n    chk.append(sg_nc('V17', 'slab strength and reinforcement (two-way panels)', 'moment coefficients not implemented; slab thickness only'))\n    # --- summary\n    cnt = {'PASS': 0, 'FAIL': 0, 'NOT CHECKED': 0}\n    for c in chk:\n        cnt[c['status']] = cnt.get(c['status'], 0) + 1\n    unv = sorted(set(x for c in chk for x in c.get('flags', [])))\n    R['summary'] = {'PASS': cnt['PASS'], 'FAIL': cnt['FAIL'], 'NOT CHECKED': cnt['NOT CHECKED'], 'flags': unv,\n                    'verdict': PRELIM_STATUS + ' - %d PASS, %d FAIL, %d NOT CHECKED (a PASS only means that simplified check passed; it is not a statement of safety or code compliance)' % (\n                        cnt['PASS'], cnt['FAIL'], cnt['NOT CHECKED'])}\n    return R['summary']\n\n\ndef sg_span_advice(R):\n    \"\"\"flag long spans / failing beams and recommend a measure WITH the engineering reason\"\"\"\n    out = []\n    mx = R['layout']['options']['max_span']\n    fails = {}\n    for c in R['checks']:\n        if c['status'] == 'FAIL' and c['id'].startswith('BM'):\n            fails.setdefault(c['id'].split('.')[0], []).append(c['name'])\n    for b in R['beams']:\n        L = b['len'] / 1000.0\n        if b['id'] in fails:\n            out.append('%s (%s, %.1f m): %s fails at the largest allowed depth. Add an intermediate column or a secondary beam: bending moment grows with span squared (M = wL^2/8), so halving the span cuts the moment to a quarter and the depth needed to about half.' % (\n                b['id'], b['kind'], L, ', '.join(sorted(set(fails[b['id']])))))\n        elif b['kind'] == 'primary' and b['len'] > mx + 1.0:\n            out.append('%s (%.1f m) is longer than the %.1f m maximum span: add an intermediate column (shorter span = smaller moment, shear and deflection).' % (b['id'], L, mx / 1000.0))\n        elif b['kind'] == 'secondary' and L > 6.0:\n            out.append('%s is a %.1f m beam-on-beam: it loads its carrier beam with a large point load; consider a column under that point or a different beam layout.' % (b['id'], L))\n    for p in R['layout']['panels']:\n        if p['ly'] / max(p['lx'], 1.0) > 2.0:\n            out.append('Panel %s (%.1f x %.1f m): ly/lx > 2, behaves as a ONE-WAY slab: load goes to the two long edges; thickness governed by the short span.' % (p['id'], p['lx'] / 1000.0, p['ly'] / 1000.0))\n    return out\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - report writer (pure Python; needs all earlier modules in the namespace)\n#  sg_run(geo, settings) = analyse + validate + text report.  The report has: status line, disclaimer, inputs and\n#  assumptions, formulas and their sources, layout with reasons, loads, members, footings, every check with\n#  PASS / FAIL / NOT CHECKED, unverified items and the NOT DONE list.\n# =====================================================================\n\nSG_NOT_DONE = [\n    'Frame analysis (continuous beams, column moments, joint design, slender-column moments) - NOT DONE',\n    'Wind load (IS 875 Part 3) - NOT DONE',\n    'Seismic: only a base shear from the numbers YOU type (formula structure); member design, drift, irregularity checks - NOT DONE',\n    'Two-way slab strength / reinforcement (IS 456 Annex D) - NOT DONE; slab thickness only',\n    'Reinforcement detailing, ductile detailing (IS 13920), bar bending - NOT DONE; steel quantities are indicative',\n    'Strip footings, raft, piles (IS 2911) - recommended only, not designed or modelled',\n    'Combined footing thickness / shear / steel - NOT DONE (plan size from the load centroid only)',\n    'Settlement, groundwater, eccentric / moment footings, plot-boundary limits - NOT CHECKED',\n    'Cantilever slabs / beams, lintels (use B21), tie beams other than plinth beams - NOT DONE',\n    'Structural slab modelling in Revit - NOT DONE (existing architectural floors are left untouched)',\n    'Other countries: only a pluggable empty library exists - NOT POPULATED',\n]\n\n\ndef _sgr_f(v, d=0):\n    return ('%.' + str(d) + 'f') % v if v is not None else 'n/a'\n\n\ndef sg_report_text(R, run_id='-'):\n    L = []\n    A = L.append\n    S = R['settings']\n    A('=' * 100)\n    A('AI STRUCTURAL GENIUS - structural layout, load take-down and preliminary sizing report')\n    A('Run id: %s' % run_id)\n    A('STATUS: ' + PRELIM_STATUS)\n    A('=' * 100)\n    A(DISCLAIMER)\n    A('')\n    if not R.get('ok'):\n        A('ANALYSIS DID NOT RUN:')\n        for m in R.get('missing', []) + R.get('warnings', []) + R.get('notes', []):\n            A('  - ' + m)\n        A(R['summary']['verdict'] if R.get('summary') else '')\n        return '\\n'.join(L)\n    A('1. INPUTS AND ASSUMPTIONS')\n    A('-' * 100)\n    A('Country / codes: %s   use: %s   concrete M%.0f   steel Fe%.0f' % (S['country'], S['use'], S['fck'], S['fy']))\n    A('Layout source: %s   max beam / column spacing %.0f mm [ASSUMPTION]   max slab short span %.0f mm [ASSUMPTION]   min structural wall %.0f mm [ASSUMPTION]' % (\n        R['layout']['source'], S['max_span'], S['slab_max_span'], S['min_wall_t']))\n    A('Storeys above the plan level: %d   %s' % (R['n'], ', '.join('%s %.0f' % (l['name'], l['elev']) for l in R['levels'])))\n    sl = R['slab']\n    A('Slab thickness %.0f mm (%s), support condition %s' % (sl['t'], 'PROPOSED from span/depth' if sl['proposed'] else 'typed by user', S['slab_support']))\n    A('Soil: allowable bearing pressure %s kN/m2, founding depth %s m, groundwater %s  (typed by the user from the geotechnical report; NO defaults)' % (\n        S['soil'].get('sbc') or 'NOT GIVEN', S['soil'].get('df') or 'NOT GIVEN', S['soil'].get('gw') or 'not given'))\n    A('Other assumptions: beam reaction continuity factor %.2f [ASSUMPTION], column axial formula strict applicability %s, imposed-load reduction %s, parapet %.0f mm [ASSUMPTION], walls %s' % (\n        S['cont_factor'], S['col_strict'], S['ll_reduction'], S['parapet_mm'], S['wall_material']))\n    A('')\n    A('2. LOADS (kN/m2) - source tags in [ ]')\n    A('-' * 100)\n    for kind, key in (('Floor dead load', 'floor_dead'), ('Roof dead load', 'roof_dead')):\n        A(kind + ':')\n        tot = 0.0\n        for lab, v, src, ref in R['load_rows'][key]:\n            A('   %-48s %6s   [%s] %s' % (lab, _sgr_f(v, 2), src, ref))\n            tot += v or 0.0\n        A('   TOTAL %.2f' % tot)\n    v, s_, r_ = R['load_rows']['ll_room']\n    A('Imposed (floors): %.2f kN/m2  [%s] %s' % (v, s_, r_))\n    v, s_, r_ = R['load_rows']['ll_roof']\n    A('Imposed (roof):   %s kN/m2  [%s] %s' % (_sgr_f(v, 2), s_, r_))\n    A('Stair dead load %.2f kN/m2 [ASSUMPTION: 150 mm waist x 1.15 slope factor + steps/finish]' % R['dl']['stair'])\n    A('Factored load = %.1f DL + %.1f LL   [%s]' % (libv(S['country'], 'gf_dl'), libv(S['country'], 'gf_ll'), lib(S['country'], 'gf_dl')['ref']))\n    A('Slab -> beam load: 45-degree rule [TEXTBOOK]; two-way short beam shear-eq w lx/4, moment-eq w lx/3; long beam shear-eq w lx(2-m)/4, moment-eq w lx(3-m^2)/6, m = lx/ly; one-way when ly/lx > 2')\n    A('Beam moment w L^2/8 and shear w L/2 (simply supported, conservative for bending) [TEXTBOOK]; column load = sum of beam reactions floor by floor [TEXTBOOK]')\n    A('')\n    A('3. STRUCTURAL LAYOUT (PROPOSAL)')\n    A('-' * 100)\n    lay = R['layout']\n    for n_ in lay.get('notes', []) + lay.get('warnings', []):\n        A('  * ' + n_)\n    A('Columns: %d   beams per floor: %d (primary %d, secondary %d, stair %d)   slab panels: %d' % (\n        len(R['columns']), len(R['beams']), sum(1 for b in R['beams'] if b['kind'] == 'primary'), sum(1 for b in R['beams'] if b['kind'] == 'secondary'),\n        sum(1 for b in R['beams'] if b['kind'] == 'stair'), len(lay['panels'])))\n    A('Junctions deliberately NOT made columns: %d' % len(lay['unused']))\n    for u in lay['unused'][:40]:\n        A('   (%.0f, %.0f) %s' % (u['wx'], u['wy'], u['reason']))\n    A('')\n    A('Column placement reasons:')\n    for c in R['columns']:\n        A('   %-5s (%.0f, %.0f)  %s' % (c['id'], c['x'], c['y'], c['reason']))\n    A('')\n    A('Span flags and recommendations (with reasons):')\n    adv = sg_span_advice(R)\n    for a in adv or ['none - every beam is within the maximum span and passes its simplified checks']:\n        A('   - ' + a)\n    A('')\n    A('4. BEAMS (size b x D mm; plinth / floor / roof level classes)')\n    A('-' * 100)\n    for b in R['beams']:\n        A('   %-6s %-9s %6.2f m  ends %s/%s   plinth %.0fx%.0f   floor %.0fx%.0f   roof %.0fx%.0f   -> modelled %.0fx%.0f %s' % (\n            b['id'], b['kind'], b['len'] / 1000.0, b['end_a'], b['end_b'], b['plinth'][0], b['plinth'][1], b['floor'][0], b['floor'][1], b['roof'][0], b['roof'][1],\n            b['size'][0], b['size'][1], b.get('why', '')))\n    A('')\n    A('5. COLUMNS (axial take-down, factored Pu kN; size b x h mm) - no frame moments')\n    A('-' * 100)\n    for c in R['columns']:\n        A('   %s at (%.0f, %.0f) %s' % (c['id'], c['x'], c['y'], c['type']))\n        for st in c['storeys']:\n            A('        storey %d (%s -> %s): Pu %.0f kN, service %.0f kN  -> %s x %s mm, steel about %s %% (indicative)' % (\n                st['storey'], st['level_from'], st['level_to'], st['Pu'], st['Ps'], _sgr_f(st['b']), _sgr_f(st['h']), _sgr_f(st.get('pt_req'), 2)))\n        A('        at the foundation: Pu %.0f kN, service %.0f kN' % (c['foundation']['Pu'], c['foundation']['Ps']))\n    A('')\n    A('6. FOUNDATIONS')\n    A('-' * 100)\n    f = R['footings']\n    for a in f['advice']:\n        A('   * ' + a)\n    for it in f['items']:\n        A('   %-8s %5.0f x %5.0f x %4.0f mm  service %.0f kN  pressure %.0f / %.0f kN/m2   Ast(indicative) long %s short %s mm2' % (\n            it['id'], it['L'], it['B'], it['D'], it['Ps'], it['pressure'], it['allow'], _sgr_f(it.get('ast_long')), _sgr_f(it.get('ast_short'))))\n    for cb in f['combined']:\n        A('   COMBINED %s  %.0f x %.0f mm (plan size only)  service %.0f kN' % ('+'.join(cb['members']), cb['L'], cb['B'], cb['Ps']))\n    A('')\n    if R.get('seismic'):\n        sm = R['seismic']\n        A('7. SEISMIC (input-driven, formula structure only): Ah %.4f  W %.0f kN  VB %.0f kN; storey forces %s kN' % (sm['Ah'], sm['W'], sm['VB'], ', '.join('%.0f' % q for q in sm['Q'])))\n        A('   Z %s I %s R %s Sa/g %s typed by the user. Seismic weight rule is UNVERIFIED. No member design for lateral load.' % (\n            sm['inputs']['Z'], sm['inputs']['I'], sm['inputs']['R'], sm['inputs']['SaG']))\n        A('')\n    A('8. CHECKS - PASS / FAIL / NOT CHECKED')\n    A('-' * 100)\n    sm_ = R['summary']\n    A(sm_['verdict'])\n    for status in ('FAIL', 'NOT CHECKED', 'PASS'):\n        A('')\n        A('--- %s ---' % status)\n        seen = 0\n        for c in R['checks']:\n            if c['status'] != status:\n                continue\n            seen += 1\n            if status == 'PASS' and seen > 60:\n                continue\n            A(' [%s] %s: %s' % (status, c['name'] if c['id'][:1] in 'VF' else c['id'] + ' ' + c['name'], c['detail']))\n            for b in c.get('basis', [])[:3]:\n                A('        basis: ' + b)\n            for fl in c.get('flags', []):\n                A('        FLAG: ' + fl)\n        if status == 'PASS' and seen > 60:\n            A(' ... %d more PASS lines not printed (see the .json file)' % (seen - 60))\n    A('')\n    A('9. UNVERIFIED / SECONDARY-ONLY VALUES USED')\n    A('-' * 100)\n    for fl in sm_.get('flags', []) or ['none flagged']:\n        A('   - ' + fl)\n    A('   Library source legend: ' + '; '.join('%s = %s' % (k, VERIF_TEXT[k]) for k in ('OFFICIAL', 'SECONDARY', 'TEXTBOOK', 'ASSUMPTION', 'PROPOSAL', 'UNVERIFIED')))\n    A('')\n    A('10. NOT DONE / OUT OF SCOPE')\n    A('-' * 100)\n    for x in SG_NOT_DONE:\n        A('   - ' + x)\n    A('')\n    A('STATUS: ' + PRELIM_STATUS)\n    return '\\n'.join(L)\n\n\ndef sg_report_csv(R):\n    rows = ['kind,id,x_or_ax,y_or_ay,bx,by,length_mm,b_mm,h_mm,Pu_kN,note']\n    for c in R.get('columns', []):\n        for st in c['storeys']:\n            rows.append('column,%s_S%d,%.0f,%.0f,,,%.0f,%s,%s,%.0f,\"%s\"' % (c['id'], st['storey'], c['x'], c['y'], st['H'], _sgr_f(st['b']), _sgr_f(st['h']), st['Pu'], c['reason']))\n    for b in R.get('beams', []):\n        rows.append('beam,%s,%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,%.0f,,\"%s %s\"' % (b['id'], b['wa'][0], b['wa'][1], b['wb'][0], b['wb'][1], b['len'], b['size'][0], b['size'][1], b['kind'], b.get('why', '')))\n    for it in R.get('footings', {}).get('items', []):\n        rows.append('footing,%s,%.0f,%.0f,,,%.0f,%.0f,%.0f,%.0f,\"L x B x D = %.0f x %.0f x %.0f; PROPOSED\"' % (it['id'], it['x'], it['y'], it['L'], it['L'], it['B'], it['Pu'], it['L'], it['B'], it['D']))\n    return '\\n'.join(rows)\n\n\ndef sg_run(geo, user_settings=None, run_id='-'):\n    \"\"\"analyse + validate + report in one call (pure Python). returns (R, text)\"\"\"\n    R = sg_analyse(geo, user_settings)\n    sg_validate(R)\n    text = sg_report_text(R, run_id)\n    return R, text\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - architectural geometry recognition (Revit -> plain dict, mm)       Revit 2022+ / IronPython 2.7 / Dynamo CPython3\n#  READ ONLY: this module never changes the model.\n#  Output geometry dict (see sg_layout.py): levels, walls (+ door / window openings), rooms, floors, stairs, shaft openings,\n#  grids, existing columns.  Everything is for ONE plan level (the open floor plan, or the level you name); the layout engine\n#  repeats that plan on the storeys above.\n#  Version care: ElementId.Value (2024+) vs IntegerValue (older) is handled by sg_idv(); Floor outline from the top face\n#  (works in every version); no API that exists only in 2025+ is used without a fallback.\n# =====================================================================\nimport os\nimport math\n\nimport clr\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *                           # noqa\n\nSG_MMF = 1.0 / 304.8\n\n\ndef sg_tname(o):\n    try:\n        return o.GetType().Name\n    except Exception:\n        return type(o).__name__\n\n\ndef sg_idv(eid):\n    try:\n        return int(eid.Value)\n    except Exception:\n        try:\n            return int(eid.IntegerValue)\n        except Exception:\n            return -1\n\n\ndef sg_log(msg):\n    try:\n        with open(os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'B25_structural_genius_log.txt'), 'a') as f:\n            f.write(str(msg) + '\\n')\n    except Exception:\n        pass\n\n\ndef sg_mm(p):\n    return (p.X / SG_MMF, p.Y / SG_MMF)\n\n\ndef sg_levels_of(doc):\n    return sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)\n\n\ndef sg_plan_view(doc, uidoc):\n    \"\"\"the open floor plan (or any open plan) - same rule as B19\"\"\"\n    try:\n        v = uidoc.ActiveView if uidoc is not None else doc.ActiveView\n    except Exception:\n        v = doc.ActiveView\n    if v is not None and sg_tname(v) == 'ViewPlan' and not v.IsTemplate and v.GenLevel is not None:\n        return v\n    try:\n        for uv in uidoc.GetOpenUIViews():\n            ov = doc.GetElement(uv.ViewId)\n            if ov is not None and sg_tname(ov) == 'ViewPlan' and not ov.IsTemplate and ov.GenLevel is not None:\n                return ov\n    except Exception:\n        pass\n    return None\n\n\ndef _sg_curve_pts(c, n=8):\n    \"\"\"polyline (mm) of a curve: line = 2 points, arc / other = tessellated\"\"\"\n    try:\n        if sg_tname(c) == 'Line':\n            return [sg_mm(c.GetEndPoint(0)), sg_mm(c.GetEndPoint(1))]\n        return [sg_mm(p) for p in c.Tessellate()]\n    except Exception:\n        return []\n\n\ndef _sg_loop_to_poly(curves):\n    pts = []\n    for c in curves:\n        seg = _sg_curve_pts(c)\n        for p in seg[:-1]:\n            pts.append(p)\n    return pts\n\n\ndef sg_wall_height(w, lvl, levels):\n    try:\n        p = w.get_Parameter(BuiltInParameter.WALL_USER_HEIGHT_PARAM)\n        if p is not None and p.AsDouble() > 0:\n            return p.AsDouble() / SG_MMF\n    except Exception:\n        pass\n    try:\n        bb = w.get_BoundingBox(None)\n        return (bb.Max.Z - bb.Min.Z) / SG_MMF\n    except Exception:\n        return 3000.0\n\n\ndef sg_is_exterior(w):\n    try:\n        p = w.get_Parameter(BuiltInParameter.FUNCTION_PARAM)\n        if p is not None:\n            return int(p.AsInteger()) == 1                  # WallFunction.Exterior\n    except Exception:\n        pass\n    try:\n        return str(w.WallType.Function) in ('Exterior', '1')\n    except Exception:\n        return False\n\n\ndef sg_opening_width(fi):\n    for bip in (BuiltInParameter.DOOR_WIDTH, BuiltInParameter.WINDOW_WIDTH, BuiltInParameter.FAMILY_WIDTH_PARAM):\n        for src in (fi, fi.Symbol):\n            try:\n                p = src.get_Parameter(bip)\n                if p is not None and p.AsDouble() > 0:\n                    return p.AsDouble() / SG_MMF\n            except Exception:\n                pass\n    for nm in ('Width', 'Rough Width'):\n        for src in (fi, fi.Symbol):\n            try:\n                p = src.LookupParameter(nm)\n                if p is not None and p.AsDouble() > 0:\n                    return p.AsDouble() / SG_MMF\n            except Exception:\n                pass\n    return 900.0\n\n\ndef sg_wall_openings(doc, w, a, b):\n    \"\"\"[(start offset from a mm, width mm)] of doors / windows hosted in wall w\"\"\"\n    out = []\n    L = math.hypot(b[0] - a[0], b[1] - a[1])\n    if L < 1.0:\n        return out\n    d = ((b[0] - a[0]) / L, (b[1] - a[1]) / L)\n    try:\n        ids = w.FindInserts(True, False, False, False)\n    except Exception:\n        ids = []\n    for i in ids:\n        try:\n            fi = doc.GetElement(i)\n            cat = fi.Category.Id\n            if sg_idv(cat) not in (int(BuiltInCategory.OST_Doors), int(BuiltInCategory.OST_Windows)):\n                continue\n            lp = fi.Location.Point\n            t0 = (lp.X / SG_MMF - a[0]) * d[0] + (lp.Y / SG_MMF - a[1]) * d[1]\n            wd = sg_opening_width(fi)\n            out.append((t0 - wd / 2.0, wd))\n        except Exception:\n            pass\n    return out\n\n\ndef _sg_floor_outline(doc, fl):\n    \"\"\"outer boundary of a floor from its top face (mm polygon) or the bounding box\"\"\"\n    try:\n        opt = Options()\n        geo = fl.get_Geometry(opt)\n        best, bz = None, None\n        for g in geo:\n            solids = [g] if sg_tname(g) == 'Solid' else []\n            if sg_tname(g) == 'GeometryInstance':\n                solids = [s for s in g.GetInstanceGeometry() if sg_tname(s) == 'Solid']\n            for s in solids:\n                for f in s.Faces:\n                    if sg_tname(f) != 'PlanarFace':\n                        continue\n                    if f.FaceNormal.Z < 0.9:\n                        continue\n                    if bz is None or f.Origin.Z > bz:\n                        bz, best = f.Origin.Z, f\n        if best is not None:\n            loops = best.GetEdgesAsCurveLoops()\n            polys = []\n            for lp in loops:\n                polys.append(_sg_loop_to_poly(list(lp)))\n            polys = [p for p in polys if len(p) >= 3]\n            if polys:\n                polys.sort(key=lambda p: -abs(sum(p[i][0] * p[(i + 1) % len(p)][1] - p[(i + 1) % len(p)][0] * p[i][1] for i in range(len(p)))))\n                return polys[0]\n    except Exception as ex:\n        sg_log('floor outline: ' + str(ex))\n    try:\n        bb = fl.get_BoundingBox(None)\n        return [(bb.Min.X / SG_MMF, bb.Min.Y / SG_MMF), (bb.Max.X / SG_MMF, bb.Min.Y / SG_MMF), (bb.Max.X / SG_MMF, bb.Max.Y / SG_MMF), (bb.Min.X / SG_MMF, bb.Max.Y / SG_MMF)]\n    except Exception:\n        return []\n\n\ndef _sg_bbox_poly(e):\n    try:\n        bb = e.get_BoundingBox(None)\n        return [(bb.Min.X / SG_MMF, bb.Min.Y / SG_MMF), (bb.Max.X / SG_MMF, bb.Min.Y / SG_MMF), (bb.Max.X / SG_MMF, bb.Max.Y / SG_MMF), (bb.Min.X / SG_MMF, bb.Max.Y / SG_MMF)]\n    except Exception:\n        return []\n\n\ndef _sg_on_level(e, lvl, extra_bips=()):\n    for bip in extra_bips:\n        try:\n            p = e.get_Parameter(bip)\n            if p is not None and sg_idv(p.AsElementId()) == sg_idv(lvl.Id):\n                return True\n        except Exception:\n            pass\n    try:\n        return sg_idv(e.LevelId) == sg_idv(lvl.Id)\n    except Exception:\n        return False\n\n\ndef sg_read_model(doc, uidoc=None, level_name=None, use_selection=True):\n    \"\"\"Read the architectural model of ONE level into the geometry dict. Never modifies the model.\n    level_name None = level of the open plan. use_selection: when walls / rooms / floors are selected only those are read.\"\"\"\n    view = sg_plan_view(doc, uidoc)\n    lvls = sg_levels_of(doc)\n    lvl = None\n    if level_name:\n        for l in lvls:\n            if l.Name.strip().upper() == str(level_name).strip().upper():\n                lvl = l\n    if lvl is None and view is not None:\n        lvl = view.GenLevel\n    if lvl is None:\n        raise Exception('Open the floor plan to study (or name the level).')\n    geo = {'levels': [{'name': l.Name, 'elev': l.Elevation / SG_MMF} for l in lvls], 'base_level': lvl.Name, 'walls': [], 'rooms': [], 'floors': [],\n           'stairs': [], 'openings': [], 'grids': [], 'existing_columns': [], 'meta': {'skipped': [], 'selection': False, 'view': view.Name if view is not None else ''}}\n    sel_ids = set()\n    if use_selection and uidoc is not None:\n        try:\n            sel_ids = set(sg_idv(i) for i in uidoc.Selection.GetElementIds())\n        except Exception:\n            sel_ids = set()\n    chosen = {'walls': set(), 'rooms': set(), 'floors': set()}\n    if sel_ids:\n        for i in sel_ids:\n            try:\n                try:\n                    import System\n                    e = doc.GetElement(ElementId(System.Int64(int(i))))     # Revit 2026: ElementId(int) is ambiguous\n                except Exception:\n                    e = doc.GetElement(ElementId(int(i)))\n                t = sg_tname(e)\n                if t == 'Wall':\n                    chosen['walls'].add(i)\n                elif t in ('Room',):\n                    chosen['rooms'].add(i)\n                elif t == 'Floor':\n                    chosen['floors'].add(i)\n            except Exception:\n                pass\n        if any(chosen.values()):\n            geo['meta']['selection'] = True\n    selmode = geo['meta']['selection']\n    # walls\n    for w in FilteredElementCollector(doc).OfClass(Wall):\n        try:\n            wid = sg_idv(w.Id)\n            if selmode and wid not in chosen['walls']:\n                continue\n            if not _sg_on_level(w, lvl, (BuiltInParameter.WALL_BASE_CONSTRAINT,)):\n                continue\n            kind = str(w.WallType.Kind)\n            if kind not in ('Basic', '0') and w.WallType.Kind != WallKind.Basic:\n                continue\n            c = w.Location.Curve\n            if sg_tname(c) != 'Line':\n                geo['meta']['skipped'].append('curved wall %s' % wid)\n                continue\n            a, b = sg_mm(c.GetEndPoint(0)), sg_mm(c.GetEndPoint(1))\n            t = w.Width / SG_MMF\n            geo['walls'].append({'id': wid, 'a': a, 'b': b, 't': t, 'h': sg_wall_height(w, lvl, lvls), 'ext': sg_is_exterior(w),\n                                 'openings': sg_wall_openings(doc, w, a, b)})\n        except Exception as ex:\n            sg_log('wall: ' + str(ex))\n    # rooms\n    try:\n        opt = SpatialElementBoundaryOptions()\n        for r in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Rooms).WhereElementIsNotElementType():\n            try:\n                rid = sg_idv(r.Id)\n                if selmode and chosen['rooms'] and rid not in chosen['rooms']:\n                    continue\n                if r.Area <= 0 or not _sg_on_level(r, lvl):\n                    continue\n                loops = r.GetBoundarySegments(opt)\n                if not loops:\n                    continue\n                best = None\n                for lp in loops:\n                    poly = _sg_loop_to_poly([s.GetCurve() for s in lp])\n                    if len(poly) >= 3 and (best is None or len(poly) > len(best)):\n                        best = poly\n                if best:\n                    nm = ''\n                    try:\n                        nm = r.get_Parameter(BuiltInParameter.ROOM_NAME).AsString() or ''\n                    except Exception:\n                        pass\n                    geo['rooms'].append({'id': rid, 'name': nm, 'poly': best, 'area_m2': r.Area / (SG_MMF * SG_MMF) / 1e6})\n            except Exception as ex:\n                sg_log('room: ' + str(ex))\n    except Exception as ex:\n        sg_log('rooms: ' + str(ex))\n    # floors\n    for fl in FilteredElementCollector(doc).OfClass(Floor):\n        try:\n            fid = sg_idv(fl.Id)\n            if selmode and chosen['floors'] and fid not in chosen['floors']:\n                continue\n            if not _sg_on_level(fl, lvl, (BuiltInParameter.LEVEL_PARAM,)):\n                continue\n            poly = _sg_floor_outline(doc, fl)\n            if len(poly) >= 3:\n                geo['floors'].append({'id': fid, 'poly': poly})\n        except Exception as ex:\n            sg_log('floor: ' + str(ex))\n    # stairs (bounding box footprint: a rotated stair gets a larger box - noted)\n    try:\n        for st in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Stairs).WhereElementIsNotElementType():\n            bips = [getattr(BuiltInParameter, n) for n in ('STAIRS_BASE_LEVEL_PARAM', 'STAIRS_BASELEVEL_PARAM') if hasattr(BuiltInParameter, n)]\n            near = False\n            try:\n                bb0 = st.get_BoundingBox(None)\n                near = abs(bb0.Min.Z - lvl.Elevation) <= 500.0 * SG_MMF\n            except Exception:\n                pass\n            if _sg_on_level(st, lvl, bips) or near:\n                poly = _sg_bbox_poly(st)\n                if poly:\n                    geo['stairs'].append({'id': sg_idv(st.Id), 'poly': poly, 'kind': 'stair'})\n    except Exception as ex:\n        sg_log('stairs: ' + str(ex))\n    # shaft / lift openings\n    try:\n        for sh in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_ShaftOpening).WhereElementIsNotElementType():\n            try:\n                bb = sh.get_BoundingBox(None)\n                if bb is None or not (bb.Min.Z - 1e-6 <= lvl.Elevation + 1e-6 and bb.Max.Z > lvl.Elevation):\n                    continue\n                geo['openings'].append({'id': sg_idv(sh.Id), 'poly': _sg_bbox_poly(sh), 'kind': 'shaft'})\n            except Exception:\n                pass\n    except Exception as ex:\n        sg_log('shafts: ' + str(ex))\n    # grids (straight only)\n    try:\n        for g in FilteredElementCollector(doc).OfClass(Grid):\n            c = g.Curve\n            if sg_tname(c) == 'Line':\n                geo['grids'].append({'name': g.Name, 'a': sg_mm(c.GetEndPoint(0)), 'b': sg_mm(c.GetEndPoint(1))})\n    except Exception as ex:\n        sg_log('grids: ' + str(ex))\n    # existing structural columns (not ours)\n    try:\n        for e in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_StructuralColumns).WhereElementIsNotElementType():\n            try:\n                cm = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).AsString() or ''\n                if cm.startswith('B25 STRUCT'):\n                    continue\n                if _sg_on_level(e, lvl, (BuiltInParameter.FAMILY_BASE_LEVEL_PARAM,)):\n                    geo['existing_columns'].append(sg_mm(e.Location.Point))\n            except Exception:\n                pass\n    except Exception as ex:\n        sg_log('columns: ' + str(ex))\n    geo['meta']['counts'] = dict((k, len(geo[k])) for k in ('walls', 'rooms', 'floors', 'stairs', 'openings', 'grids', 'existing_columns'))\n    return geo\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - Revit BIM modelling engine (creates NATIVE structural elements)       Revit 2022+ / IronPython 2.7 / Dynamo CPython3\n#  Reused from B19 (adapted, not edited there): family pick + type duplicate by size, quiet failure handler, transaction helper,\n#  column rotation convention (family depth h along the wall).  New here: footings, plinth / floor / roof / stair beams, Mark +\n#  Comments tag `B25 STRUCT|<run>|<kind>|n`, structural material / usage, one TransactionGroup per run, kind-wise replace on rerun.\n#  Every element is labelled PROPOSED - B25 - NOT CHECKED BY A STRUCTURAL ENGINEER in its Comments.\n#  Needs sg_geometry.py (sg_tname, sg_idv, SG_MMF, sg_log) in the same namespace.\n# =====================================================================\nimport glob\n\nfrom Autodesk.Revit.DB.Structure import StructuralType      # noqa\n\nSG_TAG = 'B25 STRUCT'\nSG_PREV = 'B25 PREVIEW'\nSG_KINDS = ('COL', 'PLINTH', 'FLOOR', 'ROOF', 'STAIR', 'FOOT')\n\ntry:\n    import uuid as _sg_uuid\n\n    class _SgQuiet(IFailuresPreprocessor):\n        __namespace__ = 'B25_' + _sg_uuid.uuid4().hex[:10]\n\n        def PreprocessFailures(self, fa):\n            try:\n                for m in fa.GetFailureMessages():\n                    if m.GetSeverity() == FailureSeverity.Warning:\n                        fa.DeleteWarning(m)\n            except Exception:\n                pass\n            return FailureProcessingResult.Continue\nexcept Exception:\n    _SgQuiet = None\n\n\ndef sg_in_tx(doc, name, fn):\n    t = Transaction(doc, name)\n    if _SgQuiet is not None:\n        try:\n            o = t.GetFailureHandlingOptions()\n            o.SetFailuresPreprocessor(_SgQuiet())\n            t.SetFailureHandlingOptions(o)\n        except Exception:\n            pass\n    t.Start()\n    try:\n        r = fn()\n    except Exception:\n        if t.HasStarted() and not t.HasEnded():\n            t.RollBack()\n        raise\n    t.Commit()\n    return r\n\n\ndef sg_type_name(t):\n    try:\n        p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n        if p is not None and p.AsString():\n            return p.AsString()\n    except Exception:\n        pass\n    try:\n        return Element.Name.__get__(t)\n    except Exception:\n        return ''\n\n\ndef sg_comment(e):\n    try:\n        p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n        return (p.AsString() or '') if p is not None else ''\n    except Exception:\n        return ''\n\n\ndef sg_set_text(e, bip, txt):\n    try:\n        p = e.get_Parameter(bip)\n        if p is not None and not p.IsReadOnly:\n            p.Set(txt)\n            return True\n    except Exception:\n        pass\n    return False\n\n\ndef sg_symbols(doc, bic):\n    return [s for s in FilteredElementCollector(doc).OfCategory(bic).OfClass(FamilySymbol)]\n\n\n# family file patterns searched when the project has NO family of a category (Revit library paths)\nSG_FAMILY_FILES = {\n    'column': ['*Concrete-Rectangular-Column*.rfa', '*Concrete-Rectangular Column*.rfa'],\n    'beam': ['*Concrete-Rectangular Beam*.rfa', '*Concrete-Rectangular-Beam*.rfa'],\n    'footing': ['*Footing-Rectangular*.rfa'],\n}\n\n\ndef sg_try_load_family(doc, what, log):\n    \"\"\"load a library family when the project has none. Searches the Revit library paths + ProgramData. returns True when loaded\"\"\"\n    roots = []\n    try:\n        for p in doc.Application.GetLibraryPaths().Values:\n            roots.append(p)\n    except Exception:\n        pass\n    pd = os.environ.get('ProgramData', r'C:\\ProgramData')\n    roots += glob.glob(os.path.join(pd, 'Autodesk', 'RVT *', 'Libraries', '*'))\n    seen = set()\n    for r in roots:\n        if r in seen or not os.path.isdir(r):\n            continue\n        seen.add(r)\n        for pat in SG_FAMILY_FILES[what]:\n            for f in glob.glob(os.path.join(r, '**', pat)) + glob.glob(os.path.join(r, '*', '*', pat)):\n                try:\n                    ok = [False]\n\n                    def go(f=f):\n                        res = doc.LoadFamily(f)\n                        ok[0] = bool(res)\n                    sg_in_tx(doc, 'B25 load family', go)\n                    if ok[0]:\n                        log.append('Loaded family from the Revit library: %s' % f)\n                        return True\n                except Exception as ex:\n                    sg_log('load family: ' + str(ex))\n    return False\n\n\ndef sg_pick_symbol(doc, bic, what, log):\n    syms = sg_symbols(doc, bic)\n    if not syms:\n        if sg_try_load_family(doc, what, log):\n            syms = sg_symbols(doc, bic)\n    if not syms:\n        raise Exception('No %s family in this project (and none found in the Revit library paths). Load one: Insert > Load Autodesk Family > %s' % (\n            what, {'column': 'Structural Columns > Concrete > Concrete-Rectangular-Column', 'beam': 'Structural Framing > Concrete > Concrete-Rectangular Beam',\n                   'footing': 'Structural Foundations > Footings > Footing-Rectangular'}[what]))\n\n    def score(s):\n        fn = (s.Family.Name or '').upper()\n        return (('CONCRETE' in fn) * 2 + ('RECT' in fn) * 2 + ('B25' in sg_type_name(s).upper()) + ('B19' in sg_type_name(s).upper()) * 0.5, fn)\n    return sorted(syms, key=score, reverse=True)[0]\n\n\nSG_DIMS = {'column': [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')],\n           'beam': [('b', 'h'), ('Width', 'Depth'), ('Width', 'Height')],\n           'footing': [('Length', 'Width', 'Foundation Thickness'), ('Length', 'Width', 'Thickness'), ('Length', 'Width', 'Depth'), ('L', 'B', 'h')]}\n\n\ndef sg_sized_type(doc, base, what, dims, log):\n    \"\"\"type 'B25 <what> <dims>' of the base family. dims = (b, h) or footing (L, B, D) in mm. returns (symbol, name, sized?)\"\"\"\n    nm = 'B25 %s %s' % ({'column': 'C', 'beam': 'B', 'footing': 'F'}[what], 'x'.join('%.0f' % d for d in dims))\n    for sid in base.Family.GetFamilySymbolIds():\n        e = doc.GetElement(sid)\n        if sg_type_name(e) == nm:\n            return e, nm, True\n    pair = None\n    for cand in SG_DIMS[what]:\n        if all(base.LookupParameter(c) is not None for c in cand):\n            pair = cand\n            break\n    if pair is None:\n        log.append('WARNING: the %s family has no parameters %s - elements get the size the family was loaded with (%s)' % (\n            what, ' / '.join('+'.join(c) for c in SG_DIMS[what]), sg_type_name(base)))\n        return base, sg_type_name(base), False\n    t = base.Duplicate(nm)\n    for pn, v in zip(pair, dims):\n        p = t.LookupParameter(pn)\n        if p is not None and not p.IsReadOnly:\n            p.Set(v * SG_MMF)\n    return t, nm, True\n\n\ndef sg_concrete_material(doc):\n    best = None\n    for m in FilteredElementCollector(doc).OfClass(Material):\n        n = (m.Name or '').lower()\n        if 'concrete' in n:\n            if 'cast' in n or 'in-place' in n or 'in situ' in n:\n                return m.Id\n            if best is None:\n                best = m.Id\n    return best\n\n\ndef sg_label(e, run, kind, n, mark, note):\n    sg_set_text(e, BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS,\n                '%s|%s|%s|%d | PROPOSED - B25 %s - NOT CHECKED BY A STRUCTURAL ENGINEER %s' % (SG_TAG, run, kind, n, run, note))\n    sg_set_text(e, BuiltInParameter.ALL_MODEL_MARK, mark)\n\n\ndef sg_old_elements(doc, kinds):\n    \"\"\"ids of B25 STRUCT elements of these kinds (collected first, deleted later - never delete inside a collector loop)\"\"\"\n    out = []\n    for bic in (BuiltInCategory.OST_StructuralColumns, BuiltInCategory.OST_StructuralFraming, BuiltInCategory.OST_StructuralFoundation):\n        for e in FilteredElementCollector(doc).OfCategory(bic).WhereElementIsNotElementType():\n            c = sg_comment(e)\n            if c.startswith(SG_TAG):\n                parts = c.split('|')\n                if len(parts) > 2 and parts[2].split(' ')[0] in kinds:\n                    out.append(e.Id)\n    return out\n\n\ndef sg_level_by_name(levels, name):\n    for l in levels:\n        if l.Name == name:\n            return l\n    return None\n\n\ndef sg_place_column(doc, sym, x, y, base, top, off_base_mm, th_h, run, n, mark, note):\n    p0 = XYZ(x * SG_MMF, y * SG_MMF, base.Elevation)\n    fi = doc.Create.NewFamilyInstance(p0, sym, base, StructuralType.Column)\n    for bip, val in ((BuiltInParameter.FAMILY_BASE_LEVEL_PARAM, base.Id), (BuiltInParameter.FAMILY_TOP_LEVEL_PARAM, top.Id)):\n        try:\n            fi.get_Parameter(bip).Set(val)\n        except Exception:\n            pass\n    try:\n        fi.get_Parameter(BuiltInParameter.FAMILY_BASE_LEVEL_OFFSET_PARAM).Set(off_base_mm * SG_MMF)\n        fi.get_Parameter(BuiltInParameter.FAMILY_TOP_LEVEL_OFFSET_PARAM).Set(0.0)\n    except Exception:\n        pass\n    rot = th_h - math.pi / 2.0                       # family depth h (local Y) along th_h  (same convention as B19)\n    if abs(math.sin(rot)) > 1e-6 or abs(math.cos(rot) - 1.0) > 1e-6:\n        ax = Line.CreateBound(p0, XYZ(p0.X, p0.Y, p0.Z + 1.0))\n        ElementTransformUtils.RotateElement(doc, fi.Id, ax, rot)\n    sg_label(fi, run, 'COL', n, mark, note)\n    return fi\n\n\ndef sg_place_beam(doc, sym, a, b, z_mm, level, kind, run, n, mark, usage, mat, note):\n    z = z_mm * SG_MMF\n    ln = Line.CreateBound(XYZ(a[0] * SG_MMF, a[1] * SG_MMF, z), XYZ(b[0] * SG_MMF, b[1] * SG_MMF, z))\n    fi = doc.Create.NewFamilyInstance(ln, sym, level, StructuralType.Beam)\n    sg_label(fi, run, kind, n, mark, note)\n    if usage:\n        try:\n            p = fi.get_Parameter(BuiltInParameter.INSTANCE_STRUCT_USAGE_PARAM)\n            if p is not None and not p.IsReadOnly:\n                p.SetValueString(usage)\n        except Exception:\n            pass\n    if mat is not None:\n        try:\n            p = fi.get_Parameter(BuiltInParameter.STRUCTURAL_MATERIAL_PARAM)\n            if p is not None and not p.IsReadOnly:\n                p.Set(mat)\n        except Exception:\n            pass\n    return fi\n\n\ndef sg_place_footing(doc, sym, x, y, base, bottom_z_mm, th_h, run, n, mark, mat, note):\n    \"\"\"footing centred at x, y; its BOTTOM is moved to bottom_z_mm (absolute) whatever the family origin convention is\"\"\"\n    p0 = XYZ(x * SG_MMF, y * SG_MMF, base.Elevation)\n    fi = doc.Create.NewFamilyInstance(p0, sym, base, StructuralType.Footing)\n    if abs(th_h) > 1e-6:\n        ax = Line.CreateBound(p0, XYZ(p0.X, p0.Y, p0.Z + 1.0))\n        ElementTransformUtils.RotateElement(doc, fi.Id, ax, th_h)\n    doc.Regenerate()\n    try:\n        bb = fi.get_BoundingBox(None)\n        dz = bottom_z_mm * SG_MMF - bb.Min.Z\n        if abs(dz) > 0.001:\n            ElementTransformUtils.MoveElement(doc, fi.Id, XYZ(0, 0, dz))\n    except Exception as ex:\n        sg_log('footing z: ' + str(ex))\n    sg_label(fi, run, 'FOOT', n, mark, note)\n    if mat is not None:\n        try:\n            p = fi.get_Parameter(BuiltInParameter.STRUCTURAL_MATERIAL_PARAM)\n            if p is not None and not p.IsReadOnly:\n                p.Set(mat)\n        except Exception:\n            pass\n    return fi\n\n\ndef sg_parse_size(txt, default):\n    t = str(txt or '').strip().lower().replace('mm', '').replace('*', 'x').replace(' ', '')\n    p = [x for x in t.split('x') if x]\n    try:\n        if len(p) == 1:\n            return (float(p[0]), float(p[0]))\n        if len(p) >= 2:\n            return (float(p[0]), float(p[1]))\n    except Exception:\n        pass\n    return default\n\n\ndef sg_build(doc, R, S, approve, kinds, run_id):\n    \"\"\"create the approved + switched-on components in the model. kinds: set of 'COL','PLINTH','FLOOR','ROOF','STAIR','FOOT'.\n    returns report lines. One TransactionGroup = one Ctrl+Z.\"\"\"\n    out = []\n    ang = R['layout']['angle']\n    levels = sg_levels_of(doc)\n    lv_names = [l['name'] for l in R['levels']]\n    LV = [sg_level_by_name(levels, nm) for nm in lv_names]\n    if any(l is None for l in LV):\n        raise Exception('Levels of the analysis are not all in the model any more - run Analyse again.')\n    base = LV[0]\n    n = R['n']\n    note = '[M%.0f / Fe%.0f; load Pu from B25 take-down]' % (S['fck'], S['fy'])\n    sw = S['switch']\n    want = set(kinds)\n    res = {'COL': 0, 'PLINTH': 0, 'FLOOR': 0, 'ROOF': 0, 'STAIR': 0, 'FOOT': 0, 'del': 0, 'fail': []}\n    foot_ok = bool(R['footings']['ok'])\n    df = float(S['soil'].get('df') or 0.0) * 1000.0\n    tg = TransactionGroup(doc, 'B25 AI Structural Genius')\n    tg.Start()\n    try:\n        def prep():\n            old = sg_old_elements(doc, want)\n            for i in old:\n                try:\n                    doc.Delete(i)\n                    res['del'] += 1\n                except Exception:\n                    pass\n            types = {}\n            if 'COL' in want:\n                types['colbase'] = sg_pick_symbol(doc, BuiltInCategory.OST_StructuralColumns, 'column', out)\n            if want & set(['PLINTH', 'FLOOR', 'ROOF', 'STAIR']):\n                types['beambase'] = sg_pick_symbol(doc, BuiltInCategory.OST_StructuralFraming, 'beam', out)\n            if 'FOOT' in want and foot_ok:\n                try:\n                    types['footbase'] = sg_pick_symbol(doc, BuiltInCategory.OST_StructuralFoundation, 'footing', out)\n                except Exception as ex:\n                    out.append('FOOTINGS NOT BUILT: ' + str(ex))\n                    want.discard('FOOT')\n            # sized types\n            cs, bs, fs = {}, {}, {}\n            if 'COL' in want:\n                for c in R['columns']:\n                    for st in c['storeys']:\n                        dims = (st['b'], st['h']) if sw.get('col_sizing', True) else sg_parse_size(S.get('col_fixed', '300x300'), (300.0, 300.0))\n                        if dims not in cs:\n                            cs[dims] = sg_sized_type(doc, types['colbase'], 'column', dims, out)\n            if 'beambase' in types:\n                for b in R['beams']:\n                    for key in ('plinth', 'floor', 'roof'):\n                        d = tuple(b[key])\n                        if d not in bs:\n                            bs[d] = sg_sized_type(doc, types['beambase'], 'beam', d, out)\n            if 'footbase' in types:\n                for it in R['footings']['items']:\n                    d = (it['L'], it['B'], it['D'])\n                    if d not in fs:\n                        fs[d] = sg_sized_type(doc, types['footbase'], 'footing', d, out)\n                for cb in R['footings']['combined']:\n                    pass\n            for tdict in (cs, bs, fs):\n                for k, v in tdict.items():\n                    if not v[0].IsActive:\n                        v[0].Activate()\n            if 'footbase' in types:\n                for cb in R['footings']['combined']:\n                    d = (cb['L'], cb['B'], max([it['D'] for it in R['footings']['items']] or [600.0]))\n                    cb['D'] = d[2]\n                    if d not in fs:\n                        fs[d] = sg_sized_type(doc, types['footbase'], 'footing', d, out)\n                        if not fs[d][0].IsActive:\n                            fs[d][0].Activate()\n            doc.Regenerate()\n            return cs, bs, fs\n        cs, bs, fs = sg_in_tx(doc, 'B25 types', prep)\n        mat = sg_concrete_material(doc)\n        if mat is None:\n            out.append('NOTE: no material with \"Concrete\" in its name - structural material parameter left as the family default.')\n\n        def build():\n            k = {'c': 0, 'b': 0, 'f': 0}\n            # footings first (their depth sets the column base)\n            foot_top_off = 0.0\n            if 'FOOT' in want and foot_ok:\n                for it in R['footings']['items']:\n                    try:\n                        sym = fs[(it['L'], it['B'], it['D'])][0]\n                        th = ang + (0.0 if it['h_along'] == 'Y' else math.pi / 2.0)\n                        k['f'] += 1\n                        sg_place_footing(doc, sym, it['x'], it['y'], base, base.Elevation / SG_MMF - df, th, run_id, k['f'], it['id'], mat, note)\n                        res['FOOT'] += 1\n                    except Exception as ex:\n                        res['fail'].append('footing %s: %s' % (it['id'], str(ex).splitlines()[0][:90]))\n                for cb in R['footings']['combined']:\n                    try:\n                        sym = fs[(cb['L'], cb['B'], cb['D'])][0]\n                        k['f'] += 1\n                        sg_place_footing(doc, sym, cb['wx'], cb['wy'], base, base.Elevation / SG_MMF - df, cb['ang'], run_id, k['f'], 'F-' + '+'.join(cb['members']), mat, note + ' combined')\n                        res['FOOT'] += 1\n                    except Exception as ex:\n                        res['fail'].append('combined footing: ' + str(ex).splitlines()[0][:90])\n            if 'COL' in want:\n                fthk = dict((it['col'], it['D']) for it in R['footings']['items']) if (foot_ok and 'FOOT' in want) else {}\n                for cb in R['footings']['combined']:\n                    for mbr in cb['members']:\n                        fthk[mbr[2:]] = cb.get('D', 600.0)\n                for c in R['columns']:\n                    th = ang + (0.0 if c['h_along'] == 'Y' else math.pi / 2.0)\n                    for st in c['storeys']:\n                        if st['storey'] == 1 and c.get('existing'):\n                            res['skipcol'] = res.get('skipcol', 0) + 1          # B19 / user column already stands here: keep it, build no second one\n                            continue\n                        try:\n                            dims = (st['b'], st['h']) if sw.get('col_sizing', True) else sg_parse_size(S.get('col_fixed', '300x300'), (300.0, 300.0))\n                            sym = cs[dims][0]\n                            off = 0.0\n                            if st['storey'] == 1 and df > 0 and c['id'] in fthk:\n                                off = -(df - fthk[c['id']])\n                            k['c'] += 1\n                            sg_place_column(doc, sym, c['x'], c['y'], LV[st['storey'] - 1], LV[st['storey']], off, th, run_id, k['c'], c['id'], note)\n                            res['COL'] += 1\n                        except Exception as ex:\n                            res['fail'].append('column %s: %s' % (c['id'], str(ex).splitlines()[0][:90]))\n            for b in R['beams']:\n                bk = 'STAIR' if b['kind'] == 'stair' else None\n                usage = 'Girder' if b['kind'] == 'primary' else ('Joist' if b['kind'] == 'secondary' else 'Other')\n                plan = []\n                if bk is None or True:\n                    if 'PLINTH' in want and b['kind'] != 'stair':\n                        plan.append(('PLINTH', 0, 'plinth', base.Elevation / SG_MMF + float(S.get('plinth_offset', 0.0))))\n                    if b['kind'] == 'stair':\n                        if 'STAIR' in want:\n                            for j in range(1, n + 1):\n                                plan.append(('STAIR', j, 'floor' if j < n else 'roof', LV[j].Elevation / SG_MMF))\n                    else:\n                        for j in range(1, n + 1):\n                            kk = 'ROOF' if j == n else 'FLOOR'\n                            if kk in want:\n                                plan.append((kk, j, 'floor' if j < n else 'roof', LV[j].Elevation / SG_MMF))\n                for kind, j, cls, z in plan:\n                    try:\n                        sym = bs[tuple(b[cls])][0]\n                        k['b'] += 1\n                        sg_place_beam(doc, sym, b['wa'], b['wb'], z, LV[j], kind, run_id, k['b'], '%s-%s' % (b['id'], LV[j].Name), usage, mat, note)\n                        res[kind] += 1\n                    except Exception as ex:\n                        res['fail'].append('beam %s: %s' % (b['id'], str(ex).splitlines()[0][:90]))\n        sg_in_tx(doc, 'B25 place elements', build)\n    except Exception:\n        tg.RollBack()\n        raise\n    tg.Assimilate()\n    out.insert(0, 'BUILT (PROPOSED - not checked by a structural engineer): columns %d, plinth beams %d, floor beams %d, roof beams %d, stair beams %d, footings %d; %d old B25 element(s) of these kinds replaced. Run %s. Ctrl+Z undoes the whole run.' % (\n        res['COL'], res['PLINTH'], res['FLOOR'], res['ROOF'], res['STAIR'], res['FOOT'], res['del'], run_id))\n    if res.get('skipcol'):\n        out.append('%d first-storey column position(s) already have a column of another tool (e.g. B19): kept, no second column built (upper storeys built).' % res['skipcol'])\n    for f_ in res['fail'][:8]:\n        out.append('FAILED ' + f_)\n    if len(res['fail']) > 8:\n        out.append('... %d more failures (see the log)' % (len(res['fail']) - 8))\n        sg_log('\\n'.join(res['fail']))\n    return out\n\n\ndef sg_delete_all(doc, kinds=None):\n    \"\"\"remove every B25 STRUCT element (of these kinds, default all) and every B25 PREVIEW line\"\"\"\n    ids = sg_old_elements(doc, set(kinds or SG_KINDS))\n    ids += sg_preview_ids(doc)\n\n    def go():\n        n = 0\n        for i in ids:\n            try:\n                doc.Delete(i)\n                n += 1\n            except Exception:\n                pass\n        return n\n    return sg_in_tx(doc, 'B25 delete', go)\n\n\ndef sg_preview_ids(doc):\n    out = []\n    for bic in (BuiltInCategory.OST_Lines,):\n        for e in FilteredElementCollector(doc).OfCategory(bic).WhereElementIsNotElementType():\n            if sg_comment(e).startswith(SG_PREV):\n                out.append(e.Id)\n    return out\n\n\ndef sg_preview(doc, view, R, S, mode='PLAN'):\n    \"\"\"PREVIEW layout as lines (nothing structural is created): PLAN = detail lines in the open plan, 3D = model lines at the real levels.\n    Columns = rectangles (red), primary beams blue, secondary green, stair orange, footings brown. Tag 'B25 PREVIEW' (Delete removes them).\"\"\"\n    levels = sg_levels_of(doc)\n    LV = [sg_level_by_name(levels, nm['name']) for nm in R['levels']]\n    ang = R['layout']['angle']\n    n = R['n']\n    cnt = {'lines': 0}\n    colour = {'c': Color(220, 30, 30), 'primary': Color(30, 60, 220), 'secondary': Color(20, 150, 40), 'stair': Color(240, 130, 0), 'foot': Color(130, 80, 30)}\n\n    def rect(cx, cy, b, h, th):\n        ca, sa = math.cos(th), math.sin(th)\n        pts = []\n        for dx, dy in ((-h / 2.0, -b / 2.0), (h / 2.0, -b / 2.0), (h / 2.0, b / 2.0), (-h / 2.0, b / 2.0)):\n            pts.append((cx + dx * ca - dy * sa, cy + dx * sa + dy * ca))\n        return pts\n\n    def draw():\n        old = sg_preview_ids(doc)\n        for i in old:\n            try:\n                doc.Delete(i)\n            except Exception:\n                pass\n        items = []\n        for c in R['columns']:\n            st = c['storeys'][0]\n            th = ang + (0.0 if c['h_along'] == 'Y' else math.pi / 2.0)\n            p = rect(c['x'], c['y'], st['b'] or 300.0, st['h'] or 300.0, th)\n            items.append(('c', [(p[i], p[(i + 1) % 4]) for i in range(4)], 0))\n        for b in R['beams']:\n            items.append((b['kind'], [(b['wa'], b['wb'])], 1))\n        for it in R['footings']['items']:\n            th = ang + (0.0 if it['h_along'] == 'Y' else math.pi / 2.0)\n            p = rect(it['x'], it['y'], it['B'], it['L'], th)\n            items.append(('foot', [(p[i], p[(i + 1) % 4]) for i in range(4)], 2))\n        for cb in R['footings']['combined']:\n            p = rect(cb['wx'], cb['wy'], cb['B'], cb['L'], cb['ang'])\n            items.append(('foot', [(p[i], p[(i + 1) % 4]) for i in range(4)], 2))\n        for kind, segs, grp in items:\n            for a, b_ in segs:\n                try:\n                    if mode == '3D':\n                        zs = [LV[j].Elevation for j in range(1, n + 1)] if grp == 1 else [LV[0].Elevation]\n                        for z in zs:\n                            ln = Line.CreateBound(XYZ(a[0] * SG_MMF, a[1] * SG_MMF, z), XYZ(b_[0] * SG_MMF, b_[1] * SG_MMF, z))\n                            pl = Plane.CreateByNormalAndOrigin(XYZ.BasisZ, XYZ(0, 0, z))\n                            sk = SketchPlane.Create(doc, pl)\n                            e = doc.Create.NewModelCurve(ln, sk)\n                            sg_set_text(e, BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS, SG_PREV)\n                            cnt['lines'] += 1\n                    else:\n                        ln = Line.CreateBound(XYZ(a[0] * SG_MMF, a[1] * SG_MMF, 0.0), XYZ(b_[0] * SG_MMF, b_[1] * SG_MMF, 0.0))\n                        e = doc.Create.NewDetailCurve(view, ln)\n                        sg_set_text(e, BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS, SG_PREV)\n                        try:\n                            ogs = OverrideGraphicsSettings()\n                            ogs.SetProjectionLineColor(colour[kind])\n                            ogs.SetProjectionLineWeight(5 if grp == 0 else 3)\n                            view.SetElementOverrides(e.Id, ogs)\n                        except Exception:\n                            pass\n                        cnt['lines'] += 1\n                except Exception as ex:\n                    sg_log('preview: ' + str(ex))\n        return cnt['lines']\n    return sg_in_tx(doc, 'B25 preview', draw)\n\n# -*- coding: utf-8 -*-\n# =====================================================================\n#  AI STRUCTURAL GENIUS - application layer shared by the pyRevit window and the Dynamo graph\n#  Workflow: read -> analyse (layout, loads, beams, columns, footings, checks) -> preview -> approve -> generate -> report\n#  Needs every other sg_*.py module in the same namespace.\n# =====================================================================\nimport time\n\nSG_APPDIR = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit')\nSG_SETTINGS_FILE = os.path.join(SG_APPDIR, 'B25_settings.json')\n\n\ndef sg_new_run_id():\n    return 'R' + time.strftime('%y%m%d-%H%M%S')\n\n\ndef sg_out_dir(run_id):\n    home = os.environ.get('USERPROFILE') or os.path.expanduser('~')\n    d = os.path.join(home, 'Documents', 'SD_Structural_Genius', run_id)\n    if not os.path.isdir(d):\n        os.makedirs(d)\n    return d\n\n\ndef sg_load_saved():\n    try:\n        with open(SG_SETTINGS_FILE) as f:\n            return json.load(f)\n    except Exception:\n        return {}\n\n\ndef sg_save_saved(d):\n    try:\n        if not os.path.isdir(SG_APPDIR):\n            os.makedirs(SG_APPDIR)\n        with open(SG_SETTINGS_FILE, 'w') as f:\n            json.dump(d, f, indent=1)\n    except Exception:\n        pass\n\n\ndef sg_analyse_model(doc, uidoc, settings, level_name=None, use_selection=True, run_id=None):\n    \"\"\"read the model + analyse + validate + report. returns dict {run, geo, R, text}\"\"\"\n    run_id = run_id or sg_new_run_id()\n    geo = sg_read_model(doc, uidoc, level_name, use_selection)\n    R, text = sg_run(geo, settings, run_id)\n    sg_log('analyse %s: %s' % (run_id, R['summary']['verdict'] if R.get('summary') else 'no summary'))\n    return {'run': run_id, 'geo': geo, 'R': R, 'text': text}\n\n\ndef sg_export(res):\n    \"\"\"write report.txt, members.csv, results.json, geometry.json, code_library.csv to Documents\\\\SD_Structural_Genius\\\\<run>\"\"\"\n    d = sg_out_dir(res['run'])\n    paths = {}\n    for name, content in (('report.txt', res['text']), ('members.csv', sg_report_csv(res['R'])),\n                          ('results.json', json.dumps(res['R'], default=str, indent=1)), ('geometry.json', json.dumps(res['geo'], default=str, indent=1)),\n                          ('code_library.csv', sg_library_csv(res['R']['settings']['country']))):\n        p = os.path.join(d, name)\n        with open(p, 'w') as f:\n            f.write(content)\n        paths[name] = p\n    return d, paths\n\n\ndef sg_library_csv(country):\n    rows = ['key,value,unit,source,reference,note']\n    for k, v, u, s, r, n in lib_table(country):\n        rows.append('\"%s\",\"%s\",\"%s\",\"%s\",\"%s\",\"%s\"' % (k, str(v).replace('\"', \"'\"), u, s, str(r).replace('\"', \"'\"), str(n).replace('\"', \"'\")))\n    return '\\n'.join(rows)\n\n\ndef sg_summary_lines(res):\n    \"\"\"short text for message boxes / the window log\"\"\"\n    R = res['R']\n    if not R.get('ok'):\n        return ['ANALYSIS DID NOT RUN:'] + ['  ' + m for m in R.get('missing', []) + R.get('warnings', [])]\n    s = R['summary']\n    lay = R['layout']\n    L = [PRELIM_STATUS, 'Run %s   source %s   %d storey(s)' % (res['run'], lay['source'], R['n']),\n         'Columns %d | beams per floor %d | slab panels %d | junctions left without a column %d' % (len(R['columns']), len(R['beams']), len(lay['panels']), len(lay['unused'])),\n         'Checks: %d PASS, %d FAIL, %d NOT CHECKED' % (s['PASS'], s['FAIL'], s['NOT CHECKED'])]\n    if not R['footings']['ok']:\n        L.append('FOOTINGS NOT SIZED - missing: ' + '; '.join(R['footings']['missing']))\n    else:\n        L.append('Footings: %d isolated + %d combined (PROPOSALS, axial load only)' % (len(R['footings']['items']), len(R['footings']['combined'])))\n    for a in sg_span_advice(R)[:6]:\n        L.append('  ! ' + a)\n    for n_ in (lay.get('notes') or [])[:5] + (lay.get('warnings') or [])[:5]:\n        L.append('  * ' + n_)\n    return L\n\n\ndef sg_run_action(doc, uidoc, action, settings, approve, state=None, level_name=None, use_selection=True):\n    \"\"\"one entry for the window + Dynamo. action: ANALYSE / PREVIEW / PREVIEW3D / GENERATE / DELETE / EXPORT / LIBRARY.\n    state = the dict returned by a previous ANALYSE (so Preview / Generate use the reviewed result). returns (state, lines)\"\"\"\n    act = str(action).upper()\n    lines = []\n    if act == 'LIBRARY':\n        d = sg_out_dir('library')\n        p = os.path.join(d, 'code_library_%s.csv' % settings.get('country', 'INDIA'))\n        with open(p, 'w') as f:\n            f.write(sg_library_csv(settings.get('country', 'INDIA')))\n        return state, ['Code / reference library written: ' + p] + ['%s: %s - %s' % x for x in INDIA_CODE_USE]\n    if act == 'DELETE':\n        n = sg_delete_all(doc)\n        return state, ['Deleted %d B25 element(s) / preview line(s). Existing columns / beams of other tools are untouched.' % n]\n    if act == 'ANALYSE' or state is None:\n        state = sg_analyse_model(doc, uidoc, settings, level_name, use_selection)\n        lines += sg_summary_lines(state)\n        d, paths = sg_export(state)\n        lines.append('Report + members.csv + results.json saved in ' + d)\n        if act == 'ANALYSE':\n            return state, lines\n    R = state['R']\n    if not R.get('ok'):\n        return state, lines + ['Nothing to do: the analysis did not run.']\n    if act in ('PREVIEW', 'PREVIEW3D'):\n        view = sg_plan_view(doc, uidoc)\n        mode = '3D' if act == 'PREVIEW3D' else 'PLAN'\n        if view is None and mode == 'PLAN':\n            return state, lines + ['Open a floor plan to draw the preview in.']\n        n = sg_preview(doc, view, R, R['settings'], mode)\n        return state, lines + ['PREVIEW drawn (%d lines, %s) - NOT structural elements; red = columns, blue = primary beams, green = secondary, orange = stair beams, brown = footings. '\n                               'Use Delete to remove them.' % (n, mode)]\n    if act == 'GENERATE':\n        sw = R['settings']['switch']\n        kinds = set()\n        if approve.get('columns') and sw.get('columns'):\n            kinds.add('COL')\n        if approve.get('beams'):\n            if sw.get('plinth'):\n                kinds.add('PLINTH')\n            if sw.get('floor_beams'):\n                kinds.add('FLOOR')\n            if sw.get('roof_beams'):\n                kinds.add('ROOF')\n            if sw.get('stairs'):\n                kinds.add('STAIR')\n        if approve.get('footings') and sw.get('footings'):\n            if R['footings']['ok']:\n                kinds.add('FOOT')\n            else:\n                lines.append('Footings skipped: ' + '; '.join(R['footings']['missing']) + ' (never assumed).')\n        if not kinds:\n            return state, lines + ['Nothing to generate: tick the components AND the engineer approval boxes first (columns / beams / footings).']\n        lines += sg_build(doc, R, R['settings'], approve, kinds, state['run'])\n        lines.append('Approval recorded in the elements: every element says PROPOSED - B25 - NOT CHECKED BY A STRUCTURAL ENGINEER.')\n        return state, lines\n    if act == 'EXPORT':\n        d, paths = sg_export(state)\n        return state, lines + ['Exported to ' + d]\n    return state, lines + ['Unknown action ' + act]\n\n\n\n# =====================================================================\n#  DYNAMO / DYNAMO PLAYER PART - AI STRUCTURAL GENIUS  (inputs 0..28, same engine as the B25 button)\n#   0 ACTION  ANALYSE / PREVIEW / PREVIEW3D / GENERATE / DELETE / EXPORT / LIBRARY      (ANALYSE reads + analyses + saves the report, builds nothing)\n#   1 country  2 building use  3 fck  4 fy  5 layout source  6 max span  7 max slab span  8 min wall thickness\n#   9 storeys above (blank = all)  10 plan level name (blank = open plan)\n#  11 allowable bearing pressure kN/m2 (REQUIRED for footings)  12 founding depth m (REQUIRED)  13 groundwater depth m (not used yet)\n#  14 Z  15 I  16 R  17 Sa/g   (optional seismic, no defaults)\n#  18..24 switches: columns, column sizing, plinth beams, floor beams, roof beams, footings, stair beams\n#  25..27 ENGINEER APPROVAL: columns, beams, footings  (GENERATE builds only what is approved AND switched on)   28 use the selection only\n#  Everything created is a PROPOSAL - NOT CHECKED BY A STRUCTURAL ENGINEER.  Ctrl+Z undoes a run; a rerun replaces the earlier B25 elements.\n# =====================================================================\nimport traceback\n\ntry:\n    IN                                                    # noqa - Dynamo\n    DYNAMO = True\nexcept NameError:\n    DYNAMO = False\nTM = None\ndoc = globals().get('doc')\nuidoc = globals().get('uidoc')\nif DYNAMO:\n    try:\n        clr.AddReference('RevitServices')\n        from RevitServices.Persistence import DocumentManager\n        from RevitServices.Transactions import TransactionManager\n        _dyn_doc = DocumentManager.Instance.CurrentDBDocument\n        if _dyn_doc is not None:\n            doc = _dyn_doc\n            try:\n                uidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n            except Exception:\n                pass\n            TM = TransactionManager\n    except Exception:\n        pass\n    RAW = list(IN)\nelse:\n    RAW = list(globals().get('FRAME_INPUTS', []))\n\n\ndef _inp(i, default):\n    try:\n        v = RAW[i]\n    except Exception:\n        return default\n    if v is None or (isinstance(v, str) and not v.strip()):\n        return default\n    return v\n\n\ndef _num(i, default=None):\n    v = _inp(i, None)\n    if v is None:\n        return default\n    try:\n        return float(str(v).lower().replace('mm', '').strip())\n    except Exception:\n        raise Exception('Input %d must be a number (got \"%s\")' % (i, v))\n\n\ndef _flag(i, default):\n    v = _inp(i, default)\n    if isinstance(v, str):\n        return v.strip().upper() in ('TRUE', 'YES', '1', 'Y')\n    return bool(v)\n\n\nout = []\ntry:\n    if doc is None:\n        raise Exception('No Revit document.')\n    if TM is not None:\n        TM.Instance.ForceCloseTransaction()\n    act = str(_inp(0, 'ANALYSE')).strip().upper()\n    S = {'country': str(_inp(1, 'INDIA')).upper(), 'use': str(_inp(2, 'residential')).lower(), 'fck': _num(3, 25.0), 'fy': _num(4, 500.0),\n         'source': str(_inp(5, 'AUTO')).upper(), 'max_span': _num(6, 4500.0), 'slab_max_span': _num(7, 4500.0), 'min_wall_t': _num(8, 150.0),\n         'soil': {'sbc': _num(11), 'df': _num(12), 'gw': _num(13)}, 'seismic': {'Z': _num(14), 'I': _num(15), 'R': _num(16), 'SaG': _num(17)},\n         'switch': {'columns': _flag(18, True), 'col_sizing': _flag(19, True), 'plinth': _flag(20, True), 'floor_beams': _flag(21, True),\n                    'roof_beams': _flag(22, True), 'footings': _flag(23, True), 'slab': True, 'stairs': _flag(24, True)}}\n    nf = _num(9)\n    S['n_floors'] = int(nf) if nf else None\n    approve = {'columns': _flag(25, False), 'beams': _flag(26, False), 'footings': _flag(27, False)}\n    lvl = str(_inp(10, '')).strip() or None\n    state, out = sg_run_action(doc, uidoc, act, S, approve, None, lvl, _flag(28, True))\n    out = list(out)\nexcept Exception as ex:\n    out.append('FAILED: ' + str(ex))\n    sg_log(traceback.format_exc())\nif DYNAMO and not globals().get('NO_DIALOG'):\n    try:\n        clr.AddReference('RevitAPIUI')\n        from Autodesk.Revit.UI import TaskDialog\n        td = TaskDialog('AI STRUCTURAL GENIUS')\n        td.MainInstruction = 'Failed' if any(l.startswith('FAILED') for l in out) else 'PRELIMINARY PROPOSAL - not checked by a structural engineer'\n        td.MainContent = '\\n'.join(out)[:1900]\n        td.Show()\n    except Exception:\n        pass\nOUT = out\n",
      "Engine": "CPython3",
