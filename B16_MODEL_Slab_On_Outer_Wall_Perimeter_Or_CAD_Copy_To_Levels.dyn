    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =====================================================================\n#  B16 SLAB ON THE OUTER PERIMETER OF THE WALLS   (Revit 2026)   v1\n#  Open plan -> outline from WALLS (outer face perimeter of the walls of its level, Revit joins the footprints)\n#                       or CAD (biggest closed polyline / lines in a linked CAD, closed loops inside = holes) -> floor slab\n#    thickness you set (type A_SLB_<mat>_<mm>), top offset, edge offset (+ = beyond the outer face)\n#    copy to levels above: '' = none, ALL = every level above, or names \"L2, L3\"\n#  Run again = the B16 slabs on those levels are replaced.  Runs in pyRevit (IronPython 2.7) and Dynamo CPython3.\n# =====================================================================\nimport math, os, re\n\nimport clr\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *                           # noqa\nclr.AddReference('System')\nfrom System.Collections.Generic import List\n\nMMF = 1.0 / 304.8\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'B16_slab_log.txt')\nTAG = 'B16 SLAB|'\n\n\ndef log(msg):\n    try:\n        with open(LOG, 'a') as f:\n            f.write(str(msg) + '\\n')\n    except Exception:\n        pass\n\n\ndef tname_of(o):\n    try:\n        return o.GetType().Name\n    except Exception:\n        return type(o).__name__\n\n\ndef ename(e):\n    for bip in (BuiltInParameter.SYMBOL_NAME_PARAM, BuiltInParameter.ALL_MODEL_TYPE_NAME):\n        try:\n            p = e.get_Parameter(bip)\n            if p is not None and p.AsString():\n                return p.AsString()\n        except Exception:\n            pass\n    try:\n        return Element.Name.GetValue(e)\n    except Exception:\n        return ''\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\ndef plan_view(doc, uidoc):\n    try:\n        v = uidoc.ActiveView if uidoc is not None else doc.ActiveView\n    except Exception:\n        v = doc.ActiveView\n    if v is not None and tname_of(v) == 'ViewPlan' and not v.IsTemplate and v.GenLevel is not None:\n        return v\n    try:\n        for uv in uidoc.GetOpenUIViews():\n            ov = doc.GetElement(uv.ViewId)\n            if ov is not None and tname_of(ov) == 'ViewPlan' and not ov.IsTemplate and ov.GenLevel is not None:\n                return ov\n    except Exception:\n        pass\n    return None\n\n\ndef levels_of(doc):\n    return sorted(FilteredElementCollector(doc).OfClass(Level), key=lambda l: l.Elevation)\n\n\ndef copy_levels(doc, base, text):\n    t = str(text or '').strip()\n    if not t or t.upper() in ('NONE', 'NO', 'FALSE'):\n        return []\n    above = [l for l in levels_of(doc) if l.Elevation > base.Elevation + 1e-6]\n    if t.upper() in ('ALL', 'ALL ABOVE', 'YES', 'TRUE'):\n        return above\n    out = []\n    for n in re.split(r'[,;|]+', t):\n        n = n.strip()\n        if not n:\n            continue\n        hit = [l for l in levels_of(doc) if l.Name.strip().upper() == n.upper()] or \\\n              [l for l in levels_of(doc) if n.upper() in l.Name.upper()]\n        if not hit:\n            raise Exception('No level \"{0}\". Levels: {1}'.format(n, ', '.join(l.Name for l in levels_of(doc))))\n        if hit[0].Id != base.Id and hit[0] not in out:\n            out.append(hit[0])\n    return out\n\n\n# ------------------------------------------------------------------ outer perimeter of the walls\ndef walls_on(doc, view, level):\n    ws = [w for w in FilteredElementCollector(doc, view.Id).OfClass(Wall) if w.LevelId == level.Id]\n    if not ws:\n        ws = [w for w in FilteredElementCollector(doc).OfClass(Wall) if w.LevelId == level.Id]\n    return [w for w in ws if w.Location is not None and hasattr(w.Location, 'Curve') and w.WallType.Kind != WallKind.Curtain] + \\\n           [w for w in ws if w.Location is not None and hasattr(w.Location, 'Curve') and w.WallType.Kind == WallKind.Curtain]\n\n\ndef _centre_curve(w):\n    \"\"\"the wall's centre line (Location Line may be a face)\"\"\"\n    c = w.Location.Curve\n    t = w.Width\n    key = 0\n    try:\n        key = w.get_Parameter(BuiltInParameter.WALL_KEY_REF_PARAM).AsInteger()\n    except Exception:\n        pass\n    shift = {2: -t / 2.0, 4: -t / 2.0, 3: t / 2.0, 5: t / 2.0}.get(key, 0.0)   # face of exterior / interior\n    if abs(shift) < 1e-9:\n        return c\n    o = w.Orientation                                     # points to the exterior side\n    if w.Flipped:\n        o = o.Negate()\n    try:\n        return c.CreateTransformed(Transform.CreateTranslation(o.Multiply(shift)))\n    except Exception:\n        return c\n\n\ndef wall_prism(w, z, h, extend):\n    \"\"\"plan footprint of the wall as a thin prism (ends stretched to close corners)\"\"\"\n    c = _centre_curve(w)\n    t = max(w.Width, 10 * MMF)\n    p0, p1 = c.GetEndPoint(0), c.GetEndPoint(1)\n    flat = Transform.CreateTranslation(XYZ(0, 0, z - p0.Z))\n    if tname_of(c) == 'Line':\n        d = p1.Subtract(p0).Normalize()                   # no XYZ + / - operators: Dynamo CPython3 has none\n        a = XYZ(p0.X, p0.Y, z).Subtract(d.Multiply(extend))\n        b = XYZ(p1.X, p1.Y, z).Add(d.Multiply(extend))\n        n = XYZ(-d.Y, d.X, 0).Multiply(t / 2.0)\n        pts = [a.Add(n), b.Add(n), b.Subtract(n), a.Subtract(n)]\n        cl = CurveLoop()\n        for i in range(4):\n            cl.Append(Line.CreateBound(pts[i], pts[(i + 1) % 4]))\n    else:\n        cc = c.CreateTransformed(flat)\n        o1 = cc.CreateOffset(t / 2.0, XYZ.BasisZ)\n        o2 = cc.CreateOffset(-t / 2.0, XYZ.BasisZ)\n        cl = CurveLoop()\n        cl.Append(o1)\n        cl.Append(Line.CreateBound(o1.GetEndPoint(1), o2.GetEndPoint(1)))\n        cl.Append(o2.CreateReversed())\n        cl.Append(Line.CreateBound(o2.GetEndPoint(0), o1.GetEndPoint(0)))\n    loops = List[CurveLoop]()\n    loops.Add(cl)\n    return GeometryCreationUtilities.CreateExtrusionGeometry(loops, XYZ.BasisZ, h)\n\n\ndef _loop_area(loop):\n    pts = []\n    for c in loop:\n        pts.extend(list(c.Tessellate())[:-1])\n    a = 0.0\n    for i in range(len(pts)):\n        p, q = pts[i], pts[(i + 1) % len(pts)]\n        a += p.X * q.Y - q.X * p.Y\n    return a / 2.0\n\n\ndef _merge_collinear(curves, z):\n    \"\"\"flatten to z and join straight pieces in one line\"\"\"\n    flat = []\n    for c in curves:\n        p0, p1 = c.GetEndPoint(0), c.GetEndPoint(1)\n        if tname_of(c) == 'Line':\n            flat.append(Line.CreateBound(XYZ(p0.X, p0.Y, z), XYZ(p1.X, p1.Y, z)))\n        else:\n            flat.append(c.CreateTransformed(Transform.CreateTranslation(XYZ(0, 0, z - p0.Z))))\n    out = []\n    for c in flat:\n        if out and tname_of(c) == 'Line' and tname_of(out[-1]) == 'Line':\n            a, b = out[-1], c\n            da, db = a.Direction, b.Direction\n            if abs(da.X * db.Y - da.Y * db.X) < 1e-6 and da.DotProduct(db) > 0:\n                out[-1] = Line.CreateBound(a.GetEndPoint(0), b.GetEndPoint(1))\n                continue\n        out.append(c)\n    if len(out) > 2 and tname_of(out[0]) == 'Line' and tname_of(out[-1]) == 'Line':\n        a, b = out[-1], out[0]\n        da, db = a.Direction, b.Direction\n        if abs(da.X * db.Y - da.Y * db.X) < 1e-6 and da.DotProduct(db) > 0:\n            out[0] = Line.CreateBound(a.GetEndPoint(0), b.GetEndPoint(1))\n            out.pop()\n    cl = CurveLoop()\n    for c in out:\n        cl.Append(c)\n    return cl\n\n\ndef outer_loop(walls, z, gap_mm=100.0):\n    \"\"\"union of the wall footprints -> its outer boundary at height z (CurveLoop)\"\"\"\n    h = 1.0\n    union = None\n    skipped = 0\n    why = ''\n    for w in walls:\n        try:\n            s = wall_prism(w, z - 0.5, h, max(w.Width / 2.0, gap_mm * MMF))\n        except Exception as ex:\n            skipped += 1\n            if not why:\n                why = 'wall id {0}: {1}'.format(idv(w.Id), str(ex).split(chr(10))[0])\n                log('wall footprint failed - ' + why)\n            continue\n        if union is None:\n            union = s\n        else:\n            try:\n                union = BooleanOperationsUtils.ExecuteBooleanOperation(union, s, BooleanOperationsType.Union)\n            except Exception:\n                skipped += 1\n    if union is None:\n        raise Exception('none of the {0} wall(s) on this level could be used for the outline{1}'.format(\n            len(walls), ' - ' + why if why else ''))\n    best = None\n    for f in union.Faces:\n        try:\n            if tname_of(f) != 'PlanarFace' or f.FaceNormal.Z < 0.99:\n                continue\n        except Exception:\n            continue\n        for el in f.EdgeLoops:\n            curves = [e.AsCurve() for e in el]\n            cl = CurveLoop()\n            try:\n                for c in curves:\n                    cl.Append(c)\n            except Exception:\n                cl = CurveLoop.Create(List[Curve](curves))\n            a = abs(_loop_area(cl))\n            if best is None or a > best[0]:\n                best = (a, curves)\n    if best is None:\n        raise Exception('could not find the outer outline of the walls')\n    loop = _merge_collinear(best[1], z)\n    if _loop_area(loop) < 0:\n        loop.Flip()\n    return loop, best[0] * 0.092903, skipped\n\n\n# ------------------------------------------------------------------ CAD outline (closed polylines / lines end to end)\ndef _cad_walk(doc, geo, tf, out, layer):\n    for g in geo:\n        n = tname_of(g)\n        if n == 'GeometryInstance':\n            _cad_walk(doc, g.GetSymbolGeometry(), tf.Multiply(g.Transform), out, layer)\n            continue\n        if layer:\n            try:\n                gs = doc.GetElement(g.GraphicsStyleId)\n                nm = gs.GraphicsStyleCategory.Name if gs is not None else ''\n                if layer.upper() not in nm.upper():\n                    continue\n            except Exception:\n                continue\n        try:\n            if n in ('Line', 'Arc'):\n                c = g.CreateTransformed(tf)\n                if c.IsBound:\n                    out.append(c)\n                elif n == 'Arc':                          # full circle = a closed loop by itself (two half arcs)\n                    import math as _m\n                    CLOSED.append([Arc.Create(c.Center, c.Radius, 0.0, _m.pi, c.XDirection, c.YDirection),\n                                   Arc.Create(c.Center, c.Radius, _m.pi, 2 * _m.pi, c.XDirection, c.YDirection)])\n            elif n == 'PolyLine':\n                pts = [tf.OfPoint(p) for p in g.GetCoordinates()]\n                segs = [Line.CreateBound(a, b) for a, b in zip(pts, pts[1:]) if a.DistanceTo(b) > 1e-4]\n                if len(pts) > 3 and pts[0].DistanceTo(pts[-1]) < 0.01 and len(segs) >= 3:\n                    CLOSED.append(segs)                   # a closed polyline is a loop by itself\n                else:\n                    out.extend(segs)\n        except Exception:\n            pass\n\n\nCLOSED = []\n\n\ndef cad_curves(doc, view, layer=''):\n    del CLOSED[:]\n    out = []\n    opt = Options()\n    opt.View = view\n    for ii in FilteredElementCollector(doc, view.Id).OfClass(ImportInstance):\n        try:\n            _cad_walk(doc, ii.get_Geometry(opt), Transform.Identity, out, layer)\n        except Exception as ex:\n            log('cad: ' + str(ex))\n    return out\n\n\ndef _flat(c, z):\n    p0 = c.GetEndPoint(0)\n    if tname_of(c) == 'Line':\n        p1 = c.GetEndPoint(1)\n        return Line.CreateBound(XYZ(p0.X, p0.Y, z), XYZ(p1.X, p1.Y, z))\n    return c.CreateTransformed(Transform.CreateTranslation(XYZ(0, 0, z - p0.Z)))\n\n\ndef cad_loops(curves, z, tol_mm=5.0):\n    \"\"\"closed chains of CAD curves -> [CurveLoop] biggest first\"\"\"\n    tol = tol_mm * MMF\n\n    def key(p):\n        return (int(round(p.X / tol)), int(round(p.Y / tol)))\n    curves = [_flat(c, z) for c in curves if c.IsBound and c.Length > tol]\n    adj = {}\n    for i, c in enumerate(curves):\n        for e in (0, 1):\n            adj.setdefault(key(c.GetEndPoint(e)), []).append((i, e))\n    used = set()\n    loops = []\n    for i0 in range(len(curves)):\n        if i0 in used:\n            continue\n        chain = [curves[i0]]\n        used.add(i0)\n        start = key(curves[i0].GetEndPoint(0))\n        cur = key(curves[i0].GetEndPoint(1))\n        ok = True\n        while cur != start:\n            nxt = [(i, e) for i, e in adj.get(cur, []) if i not in used]\n            if len(nxt) != 1 or len(adj.get(cur, [])) != 2:\n                ok = False                                # open end or a branch: not a clean loop\n                break\n            i, e = nxt[0]\n            used.add(i)\n            c = curves[i] if e == 0 else curves[i].CreateReversed()\n            last = chain[-1].GetEndPoint(1)\n            if tname_of(c) == 'Line':                     # weld the small gap at the joint\n                c = Line.CreateBound(last, c.GetEndPoint(1))\n            chain.append(c)\n            cur = key(c.GetEndPoint(1))\n        if not ok or len(chain) < 3:\n            continue\n        try:\n            first = chain[0].GetEndPoint(0)\n            if tname_of(chain[-1]) == 'Line':\n                chain[-1] = Line.CreateBound(chain[-1].GetEndPoint(0), first)\n            cl = CurveLoop()\n            for c in chain:\n                cl.Append(c)\n            if not cl.IsOpen():\n                loops.append(cl)\n        except Exception as ex:\n            log('cad loop: ' + str(ex))\n    loops.sort(key=lambda l: -abs(_loop_area(l)))\n    return loops\n\n\ndef _inside(pt, loop):\n    pts = []\n    for c in loop:\n        pts.extend(list(c.Tessellate())[:-1])\n    n, inside = len(pts), False\n    for i in range(n):\n        a, b = pts[i], pts[(i + 1) % n]\n        if (a.Y > pt.Y) != (b.Y > pt.Y) and pt.X < (b.X - a.X) * (pt.Y - a.Y) / ((b.Y - a.Y) or 1e-12) + a.X:\n            inside = not inside\n    return inside\n\n\ndef cad_outline(doc, view, z, layer=''):\n    \"\"\"biggest closed CAD loop = slab edge; closed loops inside it = holes\"\"\"\n    loops = cad_loops(cad_curves(doc, view, layer), z)\n    for segs in CLOSED:                                   # closed polylines / circles straight in\n        try:\n            cl = CurveLoop()\n            if all(tname_of(sg) == 'Line' for sg in segs):\n                pts = [sg.GetEndPoint(0) for sg in segs]\n                for i in range(len(pts)):\n                    a, b = pts[i], pts[(i + 1) % len(pts)]\n                    cl.Append(Line.CreateBound(XYZ(a.X, a.Y, z), XYZ(b.X, b.Y, z)))\n            else:\n                for sg in segs:\n                    cl.Append(_flat(sg, z))\n            loops.append(cl)\n        except Exception as ex:\n            log('polyline loop: ' + str(ex))\n    loops.sort(key=lambda l: -abs(_loop_area(l)))\n    if not loops:\n        raise Exception('no closed outline in the CAD{0} - draw the slab edge as a closed polyline'.format(\n            ' (layer contains \"{0}\")'.format(layer) if layer else ''))\n    outer = loops[0]\n    if _loop_area(outer) < 0:\n        outer.Flip()\n    holes = []\n    for l in loops[1:]:\n        p = list(l)[0].GetEndPoint(0)\n        if _inside(p, outer) and abs(_loop_area(l)) * 0.092903 >= 0.05:\n            if _loop_area(l) > 0:\n                l.Flip()\n            holes.append(l)\n    return outer, holes\n\n\n# ------------------------------------------------------------------ slab type + slab\ndef material_id(doc, name):\n    mats = list(FilteredElementCollector(doc).OfClass(Material))\n    for m in mats:\n        if m.Name.upper() == name.upper():\n            return m.Id\n    for m in mats:\n        if name.upper() in m.Name.upper():\n            return m.Id\n    return Material.Create(doc, name)\n\n\ndef mat_code(m):\n    u = m.upper()\n    for k, c in (('CONCRETE', 'RCC'), ('RCC', 'RCC'), ('TIMBER', 'TMB'), ('WOOD', 'TMB'), ('STEEL', 'STL')):\n        if k in u:\n            return c\n    return re.sub(r'[^A-Z]', '', u)[:3] or 'GEN'\n\n\ndef slab_type(doc, thk_mm, material, name=''):\n    name = name or 'A_SLB_{0}_{1}'.format(mat_code(material), int(round(thk_mm)))\n    ft = next((t for t in FilteredElementCollector(doc).OfClass(FloorType) if ename(t) == name), None)\n    if ft is None:\n        base = doc.GetElement(doc.GetDefaultElementTypeId(ElementTypeGroup.FloorType))\n        if base is None or base.GetCompoundStructure() is None:\n            base = next(t for t in FilteredElementCollector(doc).OfClass(FloorType) if t.GetCompoundStructure() is not None)\n        ft = base.Duplicate(name)\n    cs = ft.GetCompoundStructure()\n    lay = List[CompoundStructureLayer]()\n    lay.Add(CompoundStructureLayer(thk_mm * MMF, MaterialFunctionAssignment.Structure, material_id(doc, material)))\n    cs.SetLayers(lay)\n    for side in (ShellLayerType.Exterior, ShellLayerType.Interior):\n        try:\n            cs.SetNumberOfShellLayers(side, 0)\n        except Exception:\n            pass\n    try:\n        cs.StructuralMaterialIndex = 0\n    except Exception:\n        pass\n    ft.SetCompoundStructure(cs)\n    return ft\n\n\ntry:\n    class _Cap(IFailuresPreprocessor):\n        __namespace__ = 'B16_SLAB'\n\n        def PreprocessFailures(self, fa):\n            for f in fa.GetFailureMessages():\n                try:\n                    if f.GetSeverity() == FailureSeverity.Warning:\n                        fa.DeleteWarning(f)\n                except Exception:\n                    pass\n            return FailureProcessingResult.Continue\nexcept Exception:\n    _Cap = None\n\n\ndef in_tx(doc, name, fn):\n    t = Transaction(doc, name)\n    if _Cap is not None:\n        try:\n            o = t.GetFailureHandlingOptions()\n            o.SetFailuresPreprocessor(_Cap())\n            t.SetFailureHandlingOptions(o)\n        except Exception:\n            pass\n    t.Start()\n    try:\n        r = fn()\n    except Exception:\n        if t.HasStarted() and not t.HasEnded():\n            t.RollBack()\n        raise\n    t.Commit()\n    return r\n\n\ndef tagged_floors(doc, tag):\n    res = []\n    for e in FilteredElementCollector(doc).OfClass(Floor):\n        try:\n            c = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n            if c is not None and (c.AsString() or '') == tag:\n                res.append(e.Id)\n        except Exception:\n            pass\n    return res\n\n\ndef run(doc, uidoc, thk=150.0, type_name='', material='Concrete', edge_off=0.0, top_off=0.0, copy_to='',\n        structural=False, make=True, source='WALLS', layer=''):\n    view = plan_view(doc, uidoc)\n    if view is None:\n        raise Exception('Open the floor plan of the level with the walls first.')\n    level = view.GenLevel\n    holes = []\n    if str(source or 'WALLS').strip().upper().startswith('C'):\n        loop, holes = cad_outline(doc, view, level.Elevation, layer)\n        area, skipped = abs(_loop_area(loop)) * 0.092903, 0\n        what = 'CAD outline{0}'.format(' (layer \"{0}\")'.format(layer) if layer else '')\n    else:\n        walls = walls_on(doc, view, level)\n        if not walls:\n            raise Exception('No walls on level \"{0}\" - or use Outline from = CAD'.format(level.Name))\n        loop, area, skipped = outer_loop(walls, level.Elevation)\n        what = 'outer outline of {0} wall(s)'.format(len(walls))\n    if abs(edge_off) > 1e-6:\n        try:\n            l2 = CurveLoop.CreateViaOffset(loop, edge_off * MMF, XYZ.BasisZ)\n            if (abs(_loop_area(l2)) > abs(_loop_area(loop))) != (edge_off > 0):\n                l2 = CurveLoop.CreateViaOffset(loop, -edge_off * MMF, XYZ.BasisZ)\n            loop = l2\n            area = abs(_loop_area(loop)) * 0.092903\n        except Exception as ex:\n            log('offset: ' + str(ex))\n    targets = [level] + copy_levels(doc, level, copy_to)\n    out = ['{0} on \"{1}\": {2} edges, {3:.1f} m2{4}'.format(what[0].upper() + what[1:], level.Name, loop.NumberOfCurves(), area,\n                                                          ', {0} hole(s)'.format(len(holes)) if holes else '')]\n    if skipped:\n        out.append('CHECK {0} wall(s) could not be joined into the outline'.format(skipped))\n    if not make:\n        out.insert(0, 'ONLY CHECK (Make it = False): slab would go on ' + ', '.join(l.Name for l in targets))\n        return out\n    st = {'made': [], 'fail': []}\n\n    def work():\n        ft = slab_type(doc, thk, material, type_name)\n        st['type'] = ename(ft)\n        for lv in targets:\n            tag = TAG + lv.Name\n            for i in tagged_floors(doc, tag):\n                try:\n                    doc.Delete(i)\n                except Exception:\n                    pass\n            try:\n                dz = lv.Elevation - level.Elevation\n                mv = Transform.CreateTranslation(XYZ(0, 0, dz))\n                loops = List[CurveLoop]()\n                for l in [loop] + holes:\n                    loops.Add(l if abs(dz) < 1e-9 else CurveLoop.CreateViaTransform(l, mv))\n                f = Floor.Create(doc, loops, ft.Id, lv.Id, bool(structural), None, 0.0)\n                f.get_Parameter(BuiltInParameter.FLOOR_HEIGHTABOVELEVEL_PARAM).Set(top_off * MMF)\n                f.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS).Set(tag)\n                st['made'].append(lv.Name)\n            except Exception as ex:\n                st['fail'].append('{0}: {1}'.format(lv.Name, (str(ex).splitlines() or ['?'])[0][:100]))\n\n    in_tx(doc, 'B16 Slab on outer wall perimeter', work)\n    out.append('Slab \"{0}\" ({1:.0f} mm, top {2:+.0f} mm, edge {3:+.0f} mm from the outer wall face) on: {4}'.format(\n        st.get('type', ''), float(thk), float(top_off), float(edge_off), ', '.join(st['made']) or 'none'))\n    for f_ in st['fail']:\n        out.append('CHECK ' + f_)\n    out.append('Run again = the B16 slab on each of these levels is replaced (Comments = \"{0}<level>\")'.format(TAG))\n    log('\\n'.join(out))\n    return out\n\n\n# =====================================================================\n#  DYNAMO / DYNAMO PLAYER PART  -  inputs:\n#    0  Outline from       WALLS = outer face perimeter of the walls of the open plan's level,  CAD = closed polyline in a linked CAD\n#    1  CAD layer contains '' = all layers (CAD only)\n#    2  Slab thickness mm  150\n#    3  Material           Concrete   (type A_SLB_RCC_150)\n#    4  Slab type name     '' = automatic\n#    5  Edge offset mm     0  (+ = beyond the outer wall face, - = inside)\n#    6  Top offset mm      0  (slab top from the level)\n#    7  Copy to levels     '' = only this level, ALL = every level above, or names \"L2, L3\"\n#    8  Structural         False\n#    9  Make it            True  (False = only check the outline)\n#  Run again = the B16 slab on each of those levels is replaced.  Ctrl+Z in Revit undoes.\n# =====================================================================\nimport traceback\n\ntry:\n    IN                                                    # noqa - Dynamo\n    DYNAMO = True\nexcept NameError:\n    DYNAMO = False\nTM = None\ndoc = globals().get('doc')\nuidoc = globals().get('uidoc')\nif DYNAMO:\n    try:\n        clr.AddReference('RevitServices')\n        from RevitServices.Persistence import DocumentManager\n        from RevitServices.Transactions import TransactionManager\n        _d = DocumentManager.Instance.CurrentDBDocument\n        if _d is not None:\n            doc = _d\n            try:\n                uidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n            except Exception:\n                pass\n            TM = TransactionManager\n    except Exception:\n        pass\n    RAW = list(IN)\nelse:\n    RAW = list(globals().get('SLAB_INPUTS', []))\n\n\ndef _inp(i, default):\n    try:\n        v = RAW[i]\n    except Exception:\n        return default\n    if v is None or (isinstance(v, str) and not v.strip()):\n        return default\n    return v\n\n\ndef _num(i, default):\n    try:\n        return float(str(_inp(i, default)).lower().replace('mm', '').strip())\n    except Exception:\n        return float(default)\n\n\ndef _flag(i, default):\n    v = _inp(i, default)\n    if isinstance(v, str):\n        return v.strip().upper() in ('TRUE', 'YES', '1', 'Y')\n    return bool(v)\n\n\nout = []\ntry:\n    if doc is None:\n        raise Exception('No Revit document.')\n    if TM is not None and _flag(9, True):\n        TM.Instance.ForceCloseTransaction()\n    out = run(doc, uidoc, _num(2, 150), str(_inp(4, '')).strip(), str(_inp(3, 'Concrete')).strip() or 'Concrete', _num(5, 0),\n              _num(6, 0), str(_inp(7, '')).strip(), _flag(8, False), _flag(9, True), str(_inp(0, 'WALLS')), str(_inp(1, '')).strip())\nexcept Exception as ex:\n    out.append('FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nif DYNAMO and not globals().get('NO_DIALOG'):\n    try:\n        clr.AddReference('RevitAPIUI')\n        from Autodesk.Revit.UI import TaskDialog\n        td = TaskDialog('B16 Slab')\n        td.MainInstruction = 'Failed' if any(l.startswith('FAILED') for l in out) else 'Slab made'\n        td.MainContent = '\\n'.join(out)[:1900]\n        td.Show()\n    except Exception:\n        pass\nOUT = out\n",
      "Engine": "CPython3",
