    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "S2",
      "Id": "dad339c8009b410a955cc1da5a405eac",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "aaee47ea61204298b2fd2274fc184527",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
