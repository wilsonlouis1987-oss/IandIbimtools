    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# CAD2BIM - DOORS FROM CAD + REVIT LINES (professional)\n#  reads door symbols (swing ARC = leaf, centre = hinge) from linked CAD (any layer / door layers) and from\n#  Revit detail / model lines; single leaf -> single door, two leaves meeting -> double door\n#  width = CAD width, height = 2100 (controlled), placed in the wall at the same location, same hinge + swing side.\n#  all doors or only the selected walls / lines / doors.  Re-run = updated, never doubled.\nimport os\nLOG = os.path.join(os.environ.get('APPDATA', ''), 'pyRevit', 'CAD2BIM_dynamo_log.txt')\ndef log(msg):\n    try:\n        with open(LOG, 'a') as fh:\n            fh.write(str(msg) + '\\n')\n    except Exception:\n        pass\nlog('--- doors v1 started')\nimport clr, math, re, traceback\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.DB.Architecture import *\nfrom Autodesk.Revit.DB.Structure import StructuralType\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nclr.AddReference('System')\nfrom System.Collections.Generic import List\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\nMMF = 1.0 / 304.8\nCOL_PARAMS = [('b', 'h'), ('Width', 'Depth'), ('Width', 'Length')]\nout = []\n\n\ndef num(v, d=0.0):\n    try:\n        return float(v)\n    except Exception:\n        return d\n\n\ndef f(v):\n    return '{0:.0f}'.format(v)\n\n\ndef idv(eid):\n    try:\n        return eid.Value\n    except Exception:\n        return eid.IntegerValue\n\n\n_CAT = {}\ndef catid(bic):\n    if bic not in _CAT:\n        _CAT[bic] = idv(Category.GetCategory(doc, bic).Id)\n    return _CAT[bic]\n\n\ndef cat_is(e, bic):\n    return e is not None and e.Category is not None and idv(e.Category.Id) == catid(bic)\n\n\ndef tname(t):\n    p = t.get_Parameter(BuiltInParameter.SYMBOL_NAME_PARAM)\n    return p.AsString() if p else ''\n\n\ndef setp(e, bip, val):\n    p = e.get_Parameter(bip)\n    if p is not None and not p.IsReadOnly:\n        p.Set(val)\n        return True\n    return False\n\n\ndef getd(e, bip):\n    p = e.get_Parameter(bip)\n    return p.AsDouble() if p is not None else None\n\n\ndef getlvl(e, bip):\n    p = e.get_Parameter(bip)\n    if p is None:\n        return None\n    x = doc.GetElement(p.AsElementId())\n    return x if isinstance(x, Level) else None\n\n\n\ndef tagged(e):\n    p = e.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n    return (p.AsString() or '') if p is not None else ''\n\n\ndef to_mm(v):\n    return v / MMF\n\n\ndef pt(p):\n    return (to_mm(p.X), to_mm(p.Y))\n\n\ndef layer_name(g, inherited):\n    name = None\n    try:\n        gs = doc.GetElement(g.GraphicsStyleId)\n        if gs is not None and gs.GraphicsStyleCategory is not None:\n            name = gs.GraphicsStyleCategory.Name\n    except Exception:\n        name = None\n    if not name or name == '0':\n        return inherited or name or '0'\n    return name\n\n\nCIRCLES = {}\n\n\n\n\n# ================================================================== DOOR ENGINE\nTAG = 'CAD2BIM-DOOR'\nDOOR_WORDS = ('DOOR', 'DR', 'A-DOOR', 'DOORS', 'OPENING', 'SHUTTER')\n\n\ndef v2(p):\n    return (p.X / MMF, p.Y / MMF)\n\n\ndef dist2(a, b):\n    return math.hypot(a[0] - b[0], a[1] - b[1])\n\n\ndef arc_info(arc, src, lid, layer=''):\n    \"\"\"door leaf from a swing arc: hinge = centre, r = leaf width, two ends, sweep (deg), mid point\"\"\"\n    try:\n        if not arc.IsBound:\n            return None\n        r = arc.Radius / MMF\n        a0, a1 = arc.GetEndParameter(0), arc.GetEndParameter(1)\n        sweep = abs(math.degrees(a1 - a0))\n        if not (60.0 <= sweep <= 120.0):\n            return None\n        return {'h': v2(arc.Center), 'r': r, 'e': [v2(arc.GetEndPoint(0)), v2(arc.GetEndPoint(1))],\n                'm': v2(arc.Evaluate(0.5, True)), 'src': src, 'lid': lid, 'layer': layer}\n    except Exception:\n        return None\n\n\ndef cad_arcs(name_txt, layer_txt, levels):\n    cads = [c for c in FilteredElementCollector(doc).OfClass(ImportInstance)]\n    if name_txt:\n        cads = [c for c in cads if c.Category is not None and name_txt.lower() in c.Category.Name.lower()]\n    auto = layer_txt.upper() in ('', 'AUTO', '*', 'ALL')\n    keys = [k.strip().upper() for k in layer_txt.split(',') if k.strip()] if not auto else []\n    res, layers_hit = [], {}\n    for c in cads:\n        lid = None\n        try:\n            if c.ViewSpecific:\n                v = doc.GetElement(c.OwnerViewId)\n                if isinstance(v, ViewPlan) and v.GenLevel is not None:\n                    lid = idv(v.GenLevel.Id)\n            if lid is None and c.LevelId is not None and idv(c.LevelId) > 0:\n                lid = idv(c.LevelId)\n            if lid is None:\n                z = c.GetTotalTransform().Origin.Z\n                below = [l for l in levels if l.Elevation <= z + 0.05]\n                lid = idv((below[-1] if below else levels[0]).Id)\n        except Exception:\n            lid = None\n        opt = Options()\n        if c.ViewSpecific:\n            opt.View = doc.GetElement(c.OwnerViewId)\n        found = []\n\n        def walk(geom, inherited):\n            for g in geom:\n                ln = layer_name(g, inherited)\n                if isinstance(g, GeometryInstance):\n                    walk(g.GetInstanceGeometry(), ln)\n                elif isinstance(g, Arc):\n                    a = arc_info(g, 'CAD', lid, ln)\n                    if a is not None:\n                        found.append(a)\n        try:\n            for g in c.get_Geometry(opt):\n                if isinstance(g, GeometryInstance):\n                    walk(g.GetInstanceGeometry(), None)\n        except Exception as ex:\n            log('cad read: {0}'.format(ex))\n        door_layers = [a for a in found if any(k in (a['layer'] or '').upper() for k in (keys or DOOR_WORDS))]\n        use = door_layers if (door_layers or keys) else found      # AUTO: door layers, else every arc\n        for a in use:\n            layers_hit[a['layer']] = layers_hit.get(a['layer'], 0) + 1\n        res.extend(use)\n    return res, layers_hit, len(cads)\n\n\ndef revit_lines(style_txt, levels, only_ids=None):\n    \"\"\"arcs + straight lines from Revit detail / model lines -> (arcs, lines)\"\"\"\n    arcs, lines = [], []\n    for ce in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Lines).WhereElementIsNotElementType():\n        if not isinstance(ce, CurveElement):\n            continue\n        if only_ids is not None and idv(ce.Id) not in only_ids:\n            continue\n        try:\n            if style_txt:\n                ls = ce.LineStyle\n                if ls is None or style_txt.upper() not in ls.Name.upper():\n                    continue\n            cv = ce.GeometryCurve\n            if ce.ViewSpecific:\n                v = doc.GetElement(ce.OwnerViewId)\n                if not isinstance(v, ViewPlan) or v.GenLevel is None:\n                    continue\n                lid = idv(v.GenLevel.Id)\n            else:\n                z = cv.GetEndPoint(0).Z\n                below = [l for l in levels if l.Elevation <= z + 0.05]\n                lid = idv((below[-1] if below else levels[0]).Id)\n            if isinstance(cv, Arc):\n                a = arc_info(cv, 'Revit line', lid)\n                if a is not None:\n                    a['eid'] = idv(ce.Id)\n                    arcs.append(a)\n            elif isinstance(cv, Line):\n                lines.append({'p': v2(cv.GetEndPoint(0)), 'q': v2(cv.GetEndPoint(1)), 'lid': lid, 'eid': idv(ce.Id)})\n        except Exception as ex:\n            log('line {0}: {1}'.format(idv(ce.Id), ex))\n    return arcs, lines\n\n\n# ------------------------------------------------------------------ walls\ndef walls_by_level():\n    d = {}\n    for w in FilteredElementCollector(doc).OfClass(Wall).WhereElementIsNotElementType():\n        try:\n            if w.WallType.Kind != WallKind.Basic or not isinstance(w.Location.Curve, Line):\n                continue\n            ln = w.Location.Curve\n            p, q = v2(ln.GetEndPoint(0)), v2(ln.GetEndPoint(1))\n            L = dist2(p, q)\n            if L < 1.0:\n                continue\n            d.setdefault(idv(w.LevelId), []).append({'w': w, 'p': p, 'u': ((q[0] - p[0]) / L, (q[1] - p[1]) / L),\n                                                     'L': L, 'half': w.Width / MMF / 2.0})\n        except Exception:\n            pass\n    return d\n\n\ndef host_for(a, b, walls, sel_walls):\n    \"\"\"wall that runs along a -> b (door opening chord), with the projected centre (mm) and the wall normal\"\"\"\n    dx, dy = b[0] - a[0], b[1] - a[1]\n    L = math.hypot(dx, dy)\n    if L < 1.0:\n        return None\n    ux, uy = dx / L, dy / L\n    mid = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0)\n    best = None\n    for W in walls:\n        if sel_walls is not None and idv(W['w'].Id) not in sel_walls:\n            continue\n        if abs(ux * W['u'][0] + uy * W['u'][1]) < 0.985:\n            continue\n        rx, ry = mid[0] - W['p'][0], mid[1] - W['p'][1]\n        t = rx * W['u'][0] + ry * W['u'][1]\n        off = rx * -W['u'][1] + ry * W['u'][0]              # signed distance from the wall centre line\n        if t < -50 or t > W['L'] + 50:\n            continue\n        if abs(off) > W['half'] + 350.0:\n            continue\n        if best is None or abs(off) < best[0]:\n            best = (abs(off), W, t, off)\n    if best is None:\n        return None\n    _, W, t, off = best\n    c = (W['p'][0] + W['u'][0] * t, W['p'][1] + W['u'][1] * t)\n    return {'W': W, 'c': c, 'n': (-W['u'][1], W['u'][0])}\n\n\ndef leaf_on_wall(a, walls, sel_walls):\n    \"\"\"which arc end is the CLOSED position (on the wall line)? -> door candidate\"\"\"\n    best = None\n    for k in (0, 1):\n        e = a['e'][k]\n        h = host_for(a['h'], e, walls, sel_walls)\n        if h is None:\n            continue\n        d = abs((e[0] - h['c'][0]) * h['n'][0] + (e[1] - h['c'][1]) * h['n'][1])\n        if best is None or d < best[0]:\n            best = (d, k, h)\n    if best is None:\n        return None\n    _, k, h = best\n    W = h['W']\n    side = (a['m'][0] - h['c'][0]) * h['n'][0] + (a['m'][1] - h['c'][1]) * h['n'][1]\n    return {'hinge': a['h'], 'closed': a['e'][k], 'r': a['r'], 'W': W, 'side': 1 if side >= 0 else -1, 'src': a['src'],\n            'eid': a.get('eid')}\n\n\ndef snap_on_wall(W, pt_):\n    rx, ry = pt_[0] - W['p'][0], pt_[1] - W['p'][1]\n    t = rx * W['u'][0] + ry * W['u'][1]\n    return (W['p'][0] + W['u'][0] * t, W['p'][1] + W['u'][1] * t), t\n\n\n# ------------------------------------------------------------------ door types\ndef door_symbols():\n    syms = [s for s in FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Doors).OfClass(FamilySymbol)]\n    return syms\n\n\ndef lib_door(kind):\n    \"\"\"load a Single-/Double-Flush door from the Revit library if the project has none\"\"\"\n    imperial = False\n    try:\n        imperial = doc.DisplayUnitSystem == DisplayUnit.IMPERIAL\n    except Exception:\n        pass\n    root = os.path.join(os.environ.get('ProgramData', r'C:\\ProgramData'), 'Autodesk', 'RVT ' + doc.Application.VersionNumber,\n                        'Libraries')\n    want = ['Double-Flush', 'Double-Glass'] if kind == 'double' else ['Single-Flush', 'Single-Panel']\n    langs = ['English-Imperial', 'English_I', 'English'] if imperial else ['English', 'English-Imperial', 'English_I']\n    for lg in langs:\n        base = os.path.join(root, lg)\n        if not os.path.isdir(base):\n            continue\n        for dp, dn, fn in os.walk(base):\n            for w in want:\n                for f_ in fn:\n                    if f_.lower().endswith('.rfa') and w.lower() in f_.lower() and 'vision' not in f_.lower():\n                        p = os.path.join(dp, f_)\n                        try:\n                            doc.LoadFamily(p)\n                            log('loaded door family ' + p)\n                            return os.path.splitext(f_)[0]\n                        except Exception as ex:\n                            log('load {0}: {1}'.format(p, ex))\n    return None\n\n\ndef is_double(s):\n    n = (s.Family.Name + ' ' + tname(s)).upper()\n    return 'DOUBLE' in n or 'DBL' in n or '2 PANEL' in n or 'PAIR' in n\n\n\ndef base_symbol(kind, name_txt):\n    syms = door_symbols()\n    cand = [s for s in syms if (is_double(s) if kind == 'double' else not is_double(s))]\n    if name_txt:\n        named = [s for s in syms if name_txt.upper() in (s.Family.Name + ' ' + tname(s)).upper()]\n        if named:\n            return named[0]\n    pref = [s for s in cand if 'FLUSH' in s.Family.Name.upper()]\n    if pref or cand:\n        return (pref or cand)[0]\n    fam = lib_door(kind)\n    if fam:\n        syms = door_symbols()\n        cand = [s for s in syms if s.Family.Name == fam]\n        if cand:\n            return cand[0]\n    return None\n\n\ndef set_len(s, names, mm):\n    for n in names:\n        bip = getattr(BuiltInParameter, n, None)\n        p = s.get_Parameter(bip) if bip is not None else None\n        if p is None:\n            p = s.LookupParameter(n)\n        if p is not None and not p.IsReadOnly:\n            try:\n                p.Set(mm * MMF)\n                return True\n            except Exception:\n                pass\n    return False\n\n\n_TYPES = {}\n\n\ndef set_type(e, t):\n    try:\n        e.Symbol = t\n    except Exception:\n        setp(e, BuiltInParameter.ELEM_TYPE_PARAM, t.Id)\n\n\ndef door_type(kind, w_mm, h_mm, name_txt):\n    key = (kind, int(round(w_mm)), int(round(h_mm)))\n    if key in _TYPES:\n        return _TYPES[key]\n    base = base_symbol(kind, name_txt)\n    if base is None:\n        raise Exception('no {0} door family in the project or the Revit library - load one (Insert > Load Family)'.format(kind))\n    name = 'A_DR_{0}_{1:04d}x{2:04d}'.format('DBL' if kind == 'double' else 'SGL', key[1], key[2])\n    s = None\n    for sid in base.Family.GetFamilySymbolIds():\n        e = doc.GetElement(sid)\n        if tname(e) == name:\n            s = e\n            break\n    if s is None:\n        s = base.Duplicate(name)\n    ok_w = set_len(s, ['DOOR_WIDTH', 'FAMILY_WIDTH_PARAM', 'Width', 'Rough Width'], key[1])\n    ok_h = set_len(s, ['DOOR_HEIGHT', 'FAMILY_HEIGHT_PARAM', 'Height', 'Rough Height'], key[2])\n    if not ok_w or not ok_h:\n        log('door type {0}: width set {1}, height set {2}'.format(name, ok_w, ok_h))\n    if not s.IsActive:\n        s.Activate()\n    _TYPES[key] = s\n    return s\n\n\n# ------------------------------------------------------------------ swing / hinge check from the door's plan symbol\ndef plan_view(lid):\n    for v in FilteredElementCollector(doc).OfClass(ViewPlan):\n        try:\n            if not v.IsTemplate and v.ViewType == ViewType.FloorPlan and v.GenLevel is not None and idv(v.GenLevel.Id) == lid:\n                return v\n        except Exception:\n            pass\n    return None\n\n\ndef swing_arcs(d, view):\n    opt = Options()\n    opt.View = view\n    res = []\n\n    def walk(geom):\n        for g in geom:\n            if isinstance(g, GeometryInstance):\n                walk(g.GetInstanceGeometry())\n            elif isinstance(g, Arc) and g.IsBound:\n                res.append(g)\n    try:\n        walk(d.get_Geometry(opt))\n    except Exception:\n        pass\n    return res\n\n\ndef match_swing(d, cand, view):\n    \"\"\"flip facing / hand until the door's swing arc sits like the drawn one\"\"\"\n    if view is None:\n        return 'no plan view'\n    doc.Regenerate()\n    W = cand['W']\n    n = (-W['u'][1], W['u'][0])\n    for step in range(2):\n        arcs = swing_arcs(d, view)\n        if not arcs:\n            return 'no swing in family'\n        arc = max(arcs, key=lambda a: a.Radius)\n        m = v2(arc.Evaluate(0.5, True))\n        c = cand['c']\n        side = 1 if (m[0] - c[0]) * n[0] + (m[1] - c[1]) * n[1] >= 0 else -1\n        if side != cand['side']:\n            d.flipFacing()\n            doc.Regenerate()\n            continue\n        if cand['kind'] == 'single':\n            hc = v2(arc.Center)\n            if dist2(hc, cand['hinge']) > cand['w'] / 2.0:\n                d.flipHand()\n                doc.Regenerate()\n        return 'ok'\n    return 'ok'\n\n\ntry:\n    PICKED = IN[0]\n    ALL = bool(IN[1])\n    USE_CAD, CAD_TXT, LAYER_TXT = bool(IN[2]), str(IN[3] or '').strip(), str(IN[4] or 'AUTO').strip()\n    USE_RVT, STYLE = bool(IN[5]), str(IN[6] or '').strip()\n    LINE_OPEN = bool(IN[7])\n    H, RND = num(IN[8], 2100), num(IN[9], 10)\n    WMIN, WMAX = num(IN[10], 500), num(IN[11], 1300)\n    SGL_TXT, DBL_TXT = str(IN[12] or '').strip(), str(IN[13] or '').strip()\n    MATCH, DO = bool(IN[14]), bool(IN[15])\n    log('inputs all {0} cad {1} \"{2}\" \"{3}\" rvt {4} \"{5}\" lineopen {6} | H {7} round {8} leaf {9}-{10} | '\n        'sgl \"{11}\" dbl \"{12}\" | swing {13} run {14}'.format(ALL, USE_CAD, CAD_TXT, LAYER_TXT, USE_RVT, STYLE, LINE_OPEN,\n                                                           H, RND, WMIN, WMAX, SGL_TXT, DBL_TXT, MATCH, DO))\n    levels = sorted([l for l in FilteredElementCollector(doc).OfClass(Level)], key=lambda l: l.Elevation)\n    lvl_by_id = dict((idv(l.Id), l) for l in levels)\n\n    # ---------------- selection: walls -> only those walls, lines -> only those lines, doors -> resize those doors\n    sel_walls = sel_lines = None\n    sel_doors = []\n    if not ALL:\n        picked = PICKED if isinstance(PICKED, (list, tuple)) else ([PICKED] if PICKED is not None else [])\n        els = []\n        for x in picked:\n            e = getattr(x, 'InternalElement', None)\n            if e is None:\n                try:\n                    e = doc.GetElement(ElementId(int(x.Id)))\n                except Exception:\n                    e = x\n            els.append(e)\n        if not els:\n            els = [doc.GetElement(i) for i in uidoc.Selection.GetElementIds()]\n        ws = [idv(e.Id) for e in els if isinstance(e, Wall)]\n        ls = [idv(e.Id) for e in els if isinstance(e, CurveElement)]\n        sel_doors = [e for e in els if isinstance(e, FamilyInstance) and e.Category is not None and\n                     idv(e.Category.Id) == catid(BuiltInCategory.OST_Doors)]\n        sel_walls = set(ws) if ws else None\n        sel_lines = set(ls) if ls else None\n        if not (ws or ls or sel_doors):\n            raise Exception('Nothing picked - click SELECT and pick walls, door lines or doors (or switch on ALL doors)')\n\n    walls = walls_by_level()\n    arcs, lines, cad_layers, n_cad = [], [], {}, 0\n    if USE_CAD and sel_lines is None:\n        a_, cad_layers, n_cad = cad_arcs(CAD_TXT, LAYER_TXT, levels)\n        arcs.extend(a_)\n    if USE_RVT:\n        a_, l_ = revit_lines(STYLE, levels, sel_lines)\n        arcs.extend(a_)\n        lines.extend(l_ if LINE_OPEN else [])\n    arcs = [a for a in arcs if WMIN * 0.45 <= a['r'] <= WMAX]\n    log('door arcs {0} (cad layers {1}), revit straight lines {2}'.format(len(arcs), cad_layers, len(lines)))\n\n    # ---------------- leaves on walls\n    leaves = []\n    for a in arcs:\n        lw = walls.get(a['lid']) if a['lid'] is not None else None\n        cands = lw if lw else [W for v in walls.values() for W in v]\n        lf = leaf_on_wall(a, cands, sel_walls)\n        if lf is not None:\n            lf['lid'] = idv(lf['W']['w'].LevelId)\n            leaves.append(lf)\n    # duplicates (same leaf drawn twice, CAD + Revit)\n    uniq = []\n    for lf in leaves:\n        if any(dist2(lf['hinge'], u['hinge']) < 30 and abs(lf['r'] - u['r']) < 30 for u in uniq):\n            continue\n        uniq.append(lf)\n    leaves = uniq\n    # pair leaves into double doors: same wall, closed ends meet, hinges r1 + r2 apart\n    used, cands = set(), []\n    for i, a in enumerate(leaves):\n        if i in used:\n            continue\n        mate = None\n        for j in range(i + 1, len(leaves)):\n            b = leaves[j]\n            if j in used or idv(b['W']['w'].Id) != idv(a['W']['w'].Id):\n                continue\n            if dist2(a['closed'], b['closed']) < 60 and abs(dist2(a['hinge'], b['hinge']) - (a['r'] + b['r'])) < 80:\n                mate = j\n                break\n        if mate is not None:\n            b = leaves[mate]\n            used.update([i, mate])\n            c, _ = snap_on_wall(a['W'], ((a['hinge'][0] + b['hinge'][0]) / 2.0, (a['hinge'][1] + b['hinge'][1]) / 2.0))\n            cands.append({'kind': 'double', 'w': a['r'] + b['r'], 'c': c, 'W': a['W'], 'side': a['side'],\n                          'hinge': a['hinge'], 'src': a['src'], 'lid': a['lid']})\n        else:\n            used.add(i)\n            c, _ = snap_on_wall(a['W'], ((a['hinge'][0] + a['closed'][0]) / 2.0, (a['hinge'][1] + a['closed'][1]) / 2.0))\n            cands.append({'kind': 'single', 'w': a['r'], 'c': c, 'W': a['W'], 'side': a['side'], 'hinge': a['hinge'],\n                          'src': a['src'], 'lid': a['lid']})\n    # straight Revit lines drawn along a wall = opening (no swing info)\n    for ln in lines:\n        lw = walls.get(ln['lid'], [])\n        h = host_for(ln['p'], ln['q'], lw, sel_walls)\n        if h is None:\n            continue\n        if abs((ln['p'][0] - h['c'][0]) * h['n'][0] + (ln['p'][1] - h['c'][1]) * h['n'][1]) > h['W']['half'] + 30:\n            continue\n        L = dist2(ln['p'], ln['q'])\n        if not (WMIN <= L <= 2 * WMAX):\n            continue\n        if any(dist2(h['c'], c['c']) < max(L, c['w']) / 2.0 for c in cands):\n            continue\n        cands.append({'kind': 'double' if L > WMAX else 'single', 'w': L, 'c': h['c'], 'W': h['W'], 'side': 1,\n                      'hinge': ln['p'], 'src': 'Revit line (opening)', 'lid': idv(h['W']['w'].LevelId), 'noswing': True})\n\n    TransactionManager.Instance.EnsureInTransaction(doc)\n    # ---------------- selected existing doors: just set the height (keep their width)\n    resized = 0\n    for d in sel_doors:\n        try:\n            s = d.Symbol\n            wp = s.get_Parameter(BuiltInParameter.DOOR_WIDTH) or s.LookupParameter('Width')\n            w_mm = wp.AsDouble() / MMF if wp is not None else 900\n            nt = door_type('double' if is_double(s) else 'single', w_mm, H, '' if not is_double(s) else DBL_TXT)\n            if idv(nt.Id) != idv(s.Id):\n                set_type(d, nt)\n            resized += 1\n        except Exception as ex:\n            log('resize door {0}: {1}'.format(idv(d.Id), ex))\n\n    # ---------------- place / update\n    existing = list(FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_Doors).WhereElementIsNotElementType())\n    made, updated, kept, failed = 0, 0, 0, []\n    stats = {'single': 0, 'double': 0}\n    sizes = {}\n    views = {}\n    for c in cands:\n        w_mm = c['w']\n        if c['kind'] == 'single' and w_mm < WMIN:\n            continue\n        if RND > 0:\n            w_mm = round(w_mm / RND) * RND\n        W = c['W']\n        wall = W['w']\n        lvl = lvl_by_id.get(idv(wall.LevelId))\n        z = lvl.Elevation if lvl is not None else 0.0\n        pt_ = XYZ(c['c'][0] * MMF, c['c'][1] * MMF, z)\n        try:\n            # a door already there?  script door -> update, other door -> keep\n            near = None\n            for e in existing:\n                try:\n                    lp = e.Location.Point\n                    if dist2(v2(lp), c['c']) < max(200.0, w_mm / 3.0) and abs(lp.Z - z) < 3.0:\n                        near = e\n                        break\n                except Exception:\n                    pass\n            if near is not None and not tagged(near).startswith(TAG):\n                kept += 1\n                continue\n            sym = door_type(c['kind'], w_mm, H, DBL_TXT if c['kind'] == 'double' else SGL_TXT)\n            if near is not None:\n                if idv(near.Symbol.Id) != idv(sym.Id):\n                    set_type(near, sym)\n                d = near\n                updated += 1\n            else:\n                d = doc.Create.NewFamilyInstance(pt_, sym, wall, lvl, StructuralType.NonStructural)\n                existing.append(d)\n                made += 1\n            p = d.get_Parameter(BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS)\n            if p is not None:\n                p.Set(TAG + '|' + c['src'])\n            setp(d, BuiltInParameter.INSTANCE_SILL_HEIGHT_PARAM, 0.0)\n            if MATCH and not c.get('noswing'):\n                lid = idv(wall.LevelId)\n                if lid not in views:\n                    views[lid] = plan_view(lid)\n                r = match_swing(d, c, views[lid])\n                if r != 'ok':\n                    log('swing {0}: {1}'.format(idv(d.Id), r))\n            stats[c['kind']] += 1\n            k = '{0} {1:.0f} x {2:.0f}'.format('DOUBLE' if c['kind'] == 'double' else 'single', w_mm, H)\n            sizes[k] = sizes.get(k, 0) + 1\n        except Exception as ex:\n            failed.append('{0} door {1:.0f} at ({2:.0f}, {3:.0f}): {4}'.format(c['kind'], w_mm, c['c'][0], c['c'][1], ex))\n            log(traceback.format_exc())\n    TransactionManager.Instance.TransactionTaskDone()\n\n    out.append('CAD2BIM DOORS  -  DONE  ({0})'.format('ALL doors' if ALL else 'selection'))\n    src = []\n    if USE_CAD:\n        src.append('CAD {0} links, door arcs on layers: {1}'.format(\n            n_cad, ', '.join('{0} ({1})'.format(k or '0', v) for k, v in sorted(cad_layers.items())) or 'none'))\n    if USE_RVT:\n        src.append('Revit lines')\n    out.append('Read from     : ' + ' + '.join(src))\n    out.append('Door symbols  : {0} leaves on walls -> {1} single + {2} double doors'.format(\n        len(leaves), sum(1 for c in cands if c['kind'] == 'single'), sum(1 for c in cands if c['kind'] == 'double')))\n    out.append('Placed        : {0} new, {1} updated, {2} kept (a door was already there)'.format(made, updated, kept))\n    out.append('Height        : {0:.0f} mm for all, width = CAD width (rounded to {1:.0f} mm)'.format(H, RND))\n    for k in sorted(sizes):\n        out.append('  {0:<26} x {1}'.format(k, sizes[k]))\n    if resized:\n        out.append('Selected doors set to {0:.0f} high: {1}'.format(H, resized))\n    if MATCH:\n        out.append('Hinge side + swing direction copied from the drawing')\n    if failed:\n        out.append('Problems ({0}):'.format(len(failed)))\n        out.extend('  ' + x for x in failed[:12])\n    out.append('Save / Sync with Central to keep the changes.')\nexcept Exception as ex:\n    try:\n        TransactionManager.Instance.ForceCloseTransaction()\n    except Exception:\n        pass\n    out.insert(0, 'FAILED: ' + str(ex))\n    log(traceback.format_exc())\nlog('\\n'.join(out))\nOUT = out\n",
